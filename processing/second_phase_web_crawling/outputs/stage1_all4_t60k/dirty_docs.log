{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_11", "reason": "high_symbol_ratio:0.405", "chunk_text": "====يسر==== الْيَسَارُ بِالْفَتْحِ الْجِهَةُ وَالْيَسْرَةُ بِالْفَتْحِ أَيْضًا مِثْلُهُ وَقَعَدَ يَم"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_12", "reason": "high_symbol_ratio:0.403", "chunk_text": "الْأَنْبَارِيِّ فِي كِتَابِ الْمَقْصُورِ وَالْمَمْدُودِ الْيَسَارُ الْجَارِحَةُ مُؤَنَّثَةٌ وَفَتْحُ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_13", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالْيَسَارُ بِالْفَتْحِ لَا غَيْرُ الْغِنَى وَالثَّرْوَةُ مُذَكَّرٌ وَبِهِ سُمِّيَ وَمِنْهُ مَعْقِل"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_14", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَفِي التَّنْزِيلِ { إنَّ مَعَ الْعُسْرِ يُسْرًا } فَطَابَقَ بَيْنَهُمَا وَيَسُرَ الشَّيْءُ مِثْلُ ق"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_15", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْمَيْسِرُ مِثَالُ مَسْجِدٍ قِمَارُ الْعَرَبِ بِالْأَزْلَامِ يُقَالُ مِنْهُ يَسَرَ الرَّجُلُ يَسِ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_16", "reason": "high_symbol_ratio:0.427", "chunk_text": "====يسم==== الْيَاسَمِينُ مَشْمُومٌ مَعْرُوفٌ وَأَصْلُهُ يسم وَهُوَ مُعَرَّبٌ وَسِينُهُ مَكْسُورَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_17", "reason": "high_symbol_ratio:0.403", "chunk_text": "====يس==== يُقَالُ قَرَأْتُ يس وَتُعْرِبُهُ إعْرَابَ مَا لَا يَنْصَرِف إنْ جَعَلْتَهُ اسْمًا لِلسُّو"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_18", "reason": "high_symbol_ratio:0.424", "chunk_text": "====يفع==== الْيَفَاعُ مِثْلُ سَلَامٍ مَا ارْتَفَعَ مِنَ الْأَرْضِ. وَأَيْفَعَ الْغُلَامُ شَبَّ وَيَ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_19", "reason": "high_symbol_ratio:0.429", "chunk_text": "====يقظ==== رَجُلٌ يَقِظٌ بِكَسْرِ الْقَافِ حَذِرٌ وَفَطِنٌ أَيْضًا وَالْجَمْعُ أَيْقَاظٌ وَيَقِظَ ي"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_20", "reason": "high_symbol_ratio:0.424", "chunk_text": "====يقن==== الْيَقِينُ الْعِلْمُ الْحَاصِلُ عَنْ نَظَرٍ وَاسْتِدْلَالٍ وَلِهَذَا لَا يُسَمَّى عِلْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_21", "reason": "high_symbol_ratio:0.423", "chunk_text": "====يمم==== الْيَمَامُ قَالَ الْأَصْمَعِيُّ هُوَ الْحَمَامُ الْوَحْشِيُّ الْوَاحِدَةُ يَمَامَةٌ وَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_23", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَالْيَمُّ الْبَحْرُ وَيَمَّمْتُهُ قَصَدْتُهُ وَتَيَمَّمْتُهُ تَقَصَّدْتُهُ. وَتَيَمَّمْتُ الصَّعِيد"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_24", "reason": "high_symbol_ratio:0.431", "chunk_text": "====يمن==== الْيَمِينُ الْجِهَةُ وَالْجَارِحَةُ وَتَقَدَّمَ فِي الْيَسَارِ قَالَ الزَّمَخْشَرِيُّ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_25", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَيَمِينُ الْحَلِفِ أُنْثَى وَتُجْمَعُ عَلَى أَيْمُنٍ وَأَيْمَانٍ أَيْضًا قَالَهُ ابْنُ الْأَنْبَارِ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_26", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَيَامَنَ فُلَانٌ وَيَاسَرَ أَخَذَ ذَاتَ الْيَمِينِ وَذَاتَ الشِّمَالِ ذَكَرَهُ الْأَزْهَرِيُّ وَغَي"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_27", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ الْفَارَابِيُّ: تَيَاسَرَ بِمَعْنَى يَاسَرَ وَتَيَامَنَ بِمَعْنَى يَامَنَ وَبَعْضُهُمْ يَرُد"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_28", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالْيَمَنُ إقْلِيمٌ مَعْرُوفٌ سُمِّيَ بِذَلِكَ لِأَنَّهُ عَنْ يَمِينِ الشَّمْسِ عِنْدَ طُلُوعِهَا و"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_29", "reason": "high_symbol_ratio:0.415", "chunk_text": "الْأَلِفَ زِيدَتْ بَعْدَ النِّسْبَةِ فَيَبْقَى التَّثْقِيلُ الدَّالُّ عَلَى النِّسْبَةِ تَنْبِيهًا ع"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_30", "reason": "high_symbol_ratio:0.426", "chunk_text": "بِحَذْفِ الْهَمْزَةِ وَالنُّونِ ثُمَّ اُخْتُصِرَ ثَانِيًا فَقِيلَ ( مُ اللَّهِ ) بِضَمِّ الْمِيمِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_31", "reason": "high_symbol_ratio:0.410", "chunk_text": "====يوم==== الْيَوْمُ أَوَّلُهُ مِنْ طُلُوعِ الْفَجْرِ الثَّانِي إلَى غُرُوبِ الشَّمْسِ وَلِهَذَا مَ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_32", "reason": "high_symbol_ratio:0.410", "chunk_text": "لَيْلًا فَتَقُولُ ذَخَرْتُكَ لِهَذَا الْيَوْمِ أَيْ لِهَذَا الْوَقْتِ الَّذِي افْتَقَرْتُ فِيهِ إلَي"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_33", "reason": "high_symbol_ratio:0.431", "chunk_text": "وِيَامٌ قَبِيلَةٌ مِنَ الْيَمَنِ وَالنِّسْبَةُ إلَيْهِ يَامِيٌّ عَلَى لَفْظِهِ. ====يأيأ==== الْيُؤْ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_34", "reason": "high_symbol_ratio:0.431", "chunk_text": "====يأس==== يَئِسَ مِنَ الشَّيْءِ يَيْأَسُ مِنْ بَابِ تَعِبَ فَهُوَ يَائِسٌ وَالشَّيْءُ مَيْئُوسٌ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_35", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَكَسْرُ الْمُضَارِعِ لُغَةٌ قَالَ أَبُو زَيْدٍ الْكَسْرُ فِي ذَلِكَ وَشِبْهِهِ لُغَةُ عُلْيَا مُضَر"}
{"source": "wikisource", "raw_id": "arwikisource:41122:108408#chunk_36", "reason": "high_symbol_ratio:0.404", "chunk_text": "أَنْبَتَكُمْ مِنَ الْأَرْضِ نَبَاتًا } وَيَأْتِي يَئِسَ بِمَعْنَى عَلِمَ فِي لُغَةِ النَّخَعِ وَعَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_61", "reason": "high_symbol_ratio:0.403", "chunk_text": "وقوله: { يَا أَيُّهَا النَّاسُ اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ وَالَّذِينَ مِنْ قَبْلِكُمْ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_63", "reason": "high_symbol_ratio:0.412", "chunk_text": "وقوله { قُلْ مَنْ يَرْزُقُكُمْ مِنَ السَّمَاءِ وَالأَرْضِ أَمَّنْ يَمْلِكُ السَّمْعَ وَالأَبْصَارَ و"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_64", "reason": "high_symbol_ratio:0.406", "chunk_text": "وقوله { اللَّهُ الَّذِي رَفَعَ السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَوْنَهَا ثُمَّ اسْتَوَى عَلَى الْعَر"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_69", "reason": "high_symbol_ratio:0.402", "chunk_text": "وقوله { وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ الْعَزِي"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_70", "reason": "high_symbol_ratio:0.436", "chunk_text": "مُقْرِنِينَ وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ } ."}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_72", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَيَجْعَلُكُمْ خُلَفَاءَ الأَرْضِ أَإِلَهٌ مَعَ اللَّهِ قَلِيلًا مَا تَذَكَّرُونَ أَمَّنْ يَهْدِيكُم"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_74", "reason": "high_symbol_ratio:0.412", "chunk_text": "وقوله { وَهُوَ الَّذِي يُرْسِلُ الرِّيَاحَ بُشْرًا بَيْنَ يَدَيْ رَحْمَتِهِ حَتَّى إِذَا أَقَلَّتْ س"}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_80", "reason": "high_symbol_ratio:0.434", "chunk_text": "ثُمَّ يُنْكِرُونَهَا وَأَكْثَرُهُمُ الْكَافِرُونَ } ."}
{"source": "wikisource", "raw_id": "arwikisource:24936:67665#chunk_97", "reason": "high_symbol_ratio:0.412", "chunk_text": "وقال { فَمَنْ أَظْلَمُ مِمَّنْ كَذَبَ عَلَى اللَّهِ وَكَذَّبَ بِالصِّدْقِ إِذْ جَاءَهُ أَلَيْسَ فِي "}
