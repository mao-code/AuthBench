{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_219", "reason": "high_symbol_ratio:0.422", "chunk_text": "====وكن==== الْوَكْنُ لِلطَّائِرِ مِثْلُ الْوَكْرِ وَزْنًا وَمَعْنًى وَالْمَوْكِنُ وِزَانُ مَسْجِدٍ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_220", "reason": "high_symbol_ratio:0.428", "chunk_text": "====وكي==== الْوِكَاءُ مِثْلُ كِتَابٍ حَبْلٌ يُشَدُّ بِهِ رَأْسُ الْقِرْبَةِ وَقَوْلُهُ { الْعَيْنَا"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_221", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَفِي التَّنْزِيلِ { وَسُرُرًا عَلَيْهَا يَتَّكِئُونَ } أَيْ يَجْلِسُونَ وَقَالَ { وَأَعْتَدَتْ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_222", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ السَّرَقُسْطِيّ أَيْضًا أَتْكَأْتُهُ أَعْطَيْتُهُ مَا يَتَّكِئُ عَلَيْهِ أَيْ مَا يَجْلِسُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_223", "reason": "high_symbol_ratio:0.430", "chunk_text": "====ولج==== وَلَجَ الشَّيْءُ فِي غَيْرِهِ يَلِجُ مِنْ بَابِ وَعَدَ وُلُوجًا وَأَوْلَجْتُهُ إيلَاجًا "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_224", "reason": "high_symbol_ratio:0.418", "chunk_text": "====ولد==== الْوَالِدُ الْأَبُ وَجَمْعُهُ بِالْوَاوِ وَالنُّونِ وَالْوَالِدَةُ الْأُمُّ وَجَمْعُهَا "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_225", "reason": "high_symbol_ratio:0.411", "chunk_text": "أُسْدٍ جَمْعِ أَسَدٍ وَقَدْ وَلَدَ يَلِدُ مِنْ بَابِ وَعَدَ وَكُلُّ مَا لَهُ أُذُنٌ مِنَ الْحَيَوَان"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_226", "reason": "high_symbol_ratio:0.408", "chunk_text": "إلَيْهَا إذَا حَانَ وِلَادُهَا كَمَا يُقَالُ أَحْصَدَ الزَّرْعُ إذَا حَانَ حَصَادُهُ فَلَا يَكُونُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_227", "reason": "high_symbol_ratio:0.417", "chunk_text": "بَعُدَ عَنِ الطَّرَاوَةِ وَالْمَوْلِدُ الْمَوْضِعُ وَالْوَقْتُ أَيْضًا وَالْمِيلَادُ الْوَقْتُ لَا غ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_228", "reason": "high_symbol_ratio:0.406", "chunk_text": "====ولع==== أُولِعَ بِالشَّيْءِ بِالْبِنَاءِ لِلْمَفْعُولِ يُولَعُ وَلُوعًا بِفَتْحِ الْوَاوِ عَلِقَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_229", "reason": "high_symbol_ratio:0.421", "chunk_text": "====ولغ==== وَلَغَ الْكَلْبُ يَلَغُ وَلْغًا مِنْ بَابِ نَفَعَ وَوُلُوغًا شَرِبَ وَسُقُوطُ الْوَاوِ ك"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_230", "reason": "high_symbol_ratio:0.429", "chunk_text": "====ولم==== الْوَلِيمَةُ اسْمٌ لِكُلِّ طَعَامٍ يُتَّخَذُ لِجَمْعٍ وَقَالَ ابْنُ فَارِسٍ هِيَ طَعَامُ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_231", "reason": "high_symbol_ratio:0.414", "chunk_text": "====وله==== وَلِهَ يَوْلَهُ وَلَهًا مِنْ بَابِ تَعِبَ وَفِي لُغَةٍ قَلِيلَةٍ وَلَهَ يَلِهُ مِنْ بَاب"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_233", "reason": "high_symbol_ratio:0.419", "chunk_text": "====ولي==== الْوَلْيُ مِثْلُ فَلْسٍ الْقُرْبُ وَفِي الْفِعْلِ لُغَتَانِ أَكْثَرُهُمَا وَلِيَهُ يَلِي"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_234", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَالْكَسْرِ النُّصْرَةُ وَاسْتَوْلَى عَلَيْهِ غَلَبَ عَلَيْهِ وَتَمَكَّنَ مِنْهُ. وَالْمَوْلَى ابْنُ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_235", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَتَوَالَتِ الْأَخْبَارُ تَتَابَعَتْ وَالْوَلِيُّ فَعِيلٌ بِمَعْنَى فَاعِلٍ مِنْ وَلِيَهُ إذَا قَامَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_236", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَيَكُونُ الْوَلِيُّ بِمَعْنَى مَفْعُولٍ فِي حَقِّ الْمُطِيعِ فَيُقَالُ الْمُؤْمِنُ وَلِيُّ اللَّهِ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_237", "reason": "high_symbol_ratio:0.414", "chunk_text": "====ومس==== مُومِسٌ وَمُومِسَةٌ أَيْ فَاجِرَةٌ وَاقْتَصَرَ الْفَارَابِيُّ عَلَى الْهَاءِ وَكَذَلِكَ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_238", "reason": "high_symbol_ratio:0.422", "chunk_text": "====ومض==== أَوْمَضَ الْبَرْقُ إيمَاضًا لَمَعَ لَمَعَانًا خَفِيفًا وَفِي لُغَةٍ وَمَضَ مِنْ بَابِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_239", "reason": "high_symbol_ratio:0.429", "chunk_text": "====ونم==== وَنَمَ الذُّبَابُ يَنِمُ مِنْ بَابِ وَعَدَ وَنِيمًا ثُمَّ سُمِّيَ خُرْؤُهُ بِالْمَصْدَرِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_240", "reason": "high_symbol_ratio:0.411", "chunk_text": "====وني==== وَنَى فِي الْأَمْرِ وَنًى وَوَنْيًا مِنْ بَابَيْ تَعِبَ وَوَعَدَ ضَعُفَ وَفَتَرَ فَهُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_241", "reason": "high_symbol_ratio:0.443", "chunk_text": "====وهب==== وَهَبْتُ لِزَيْدٍ مَالًا أَهَبُهُ لَهُ هِبَةً أَعْطَيْتُهُ بِلَا عِوَضٍ يَتَعَدَّى إلَى "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_242", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَفِي التَّنْزِيلِ { يَهَبُ لِمَنْ يَشَاءُ إنَاثًا وَيَهَبُ لِمَنْ يَشَاءُ الذُّكُورَ } وَوَهْبًا بِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_243", "reason": "high_symbol_ratio:0.420", "chunk_text": "مَوْهُوبٌ لَهُ وَالْمَالُ مَوْهُوبٌ وَاتَّهَبْتُ الْهِبَةَ قَبِلْتُهَا وَاسْتَوْهَبْتُهَا سَأَلْتُهَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_244", "reason": "high_symbol_ratio:0.436", "chunk_text": "====وهق==== الْوَهَقُ بِفَتْحَتَيْنِ حَبْلٌ يُلْقَى فِي عُنُقِ الشَّخْصِ يُؤْخَذُ بِهِ وَيُوثَقُ وَأ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_245", "reason": "high_symbol_ratio:0.427", "chunk_text": "====وهل==== وَهِلَ وَهَلًا فَهُوَ وَهِلٌ مِنْ بَابِ تَعِبَ فَزِعَ وَيَتَعَدَّى بِالتَّضْعِيفِ فَيُقَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_246", "reason": "high_symbol_ratio:0.416", "chunk_text": "====وهم==== وَهَمْتُ إلَى الشَّيْءِ وَهْمًا مِنْ بَابِ وَعَدَ سَبَقَ الْقَلْبُ إلَيْهِ مَعَ إرَادَةِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_247", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَاتَّهَمْتُهُ فِي قَوْلِهِ شَكَكْتُ فِي صِدْقِهِ وَالِاسْمُ التُّهَمَةُ وِزَانُ رُطَبَةٍ وَالسُّكُو"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_248", "reason": "high_symbol_ratio:0.419", "chunk_text": "====وهن==== وَهَنَ يَهِنُ وَهْنًا مِنْ بَابِ وَعَدَ ضَعُفَ فَهُوَ وَاهِنٌ فِي الْأَمْرِ وَالْعَمَلِ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_249", "reason": "high_symbol_ratio:0.428", "chunk_text": "====وهي==== وَهَى الْحَائِطُ وَهْيًا مِنْ بَابِ وَعَدَ: ضَعُفَ وَاسْتَرْخَى وَكَذَلِكَ الثَّوْبُ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_250", "reason": "high_symbol_ratio:0.418", "chunk_text": "====وأد==== وَأَدَ ابْنَتَهُ وَأْدًا مِنْ بَابِ وَعَدَ دَفَنَهَا حَيَّةً فَهِيَ مَوْءُودَةٌ وَالْوَأ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_251", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وأل==== وَأَلَ إلَى اللَّهِ يَئِلُ مِنْ بَابِ وَعَدَ الْتَجَأَ وَبِاسْمِ الْفَاعِلِ سُمِّيَ وَمِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_252", "reason": "high_symbol_ratio:0.411", "chunk_text": "====وأم==== الْوِئَامُ مِثْلُ الْوِفَاقِ وَزْنًا وَمَعْنًى وَوَاءَمْتُهُ صَنَعْتُ مِثْلَ صَنِيعِهِ. "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_253", "reason": "high_symbol_ratio:0.402", "chunk_text": "====لا==== بَابُ لَا: وَتَأْتِي فِي الْكَلَامِ لِمَعَانٍ تَكُونُ لِلنَّهْيِ عَلَى مُقَابَلَةِ الْأَم"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_254", "reason": "high_symbol_ratio:0.404", "chunk_text": "أَحَدَهُمَا لَمْ يَكُنْ مُخَالِفًا لِأَنَّ النَّهْيَ لَمْ يَشْمَلْهُمَا فَإِذَا أَرَدْتَ الِانْتِهَا"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_256", "reason": "high_symbol_ratio:0.408", "chunk_text": "زَيْدًا وَعَمْرًا غَيْرُ مُتَعَيِّنٍ إذْ يَجُوزُ أَنْ تَكُونَ الْوَاوُ بِمَعْنَى مَعَ فَوَجَبَ إثْبَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_260", "reason": "high_symbol_ratio:0.402", "chunk_text": "وُضُوءَ لِمَنْ لَمْ يُسَمِّ اللَّهَ وَمَا يَحْتَمِلُ الْمَعْنَيَيْنِ فَالْوَجْهُ تَقْدِيرُ نَفْيِ ال"}
