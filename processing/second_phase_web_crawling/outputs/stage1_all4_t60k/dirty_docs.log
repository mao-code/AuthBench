{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_96", "reason": "high_symbol_ratio:0.403", "chunk_text": "قَالَ أَنَسٌ كَانَ رَسُولُ اللَّهِ مِنْ أَحْسَنِ النَّاسِ خُلُقًا فَأَرْسَلَنِي يَوْمًا لِحَاجَةٍ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_98", "reason": "high_symbol_ratio:0.403", "chunk_text": "عَنْ شَقِيقٍ أَبِي وَائِلٍ قَالَ كَانَ عَبْدُ اللَّهِ يُذَكِّرُنَا كُلَّ يَوْمِ خَمِيسٍ فَقَالَ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_102", "reason": "high_symbol_ratio:0.400", "chunk_text": "عن جَابِر بْن عَبْدِ اللَّهِ قَالَ قَالَ رَسُولُ اللَّهِ لَوْ قَدْ جَاءَنَا مَالُ الْبَحْرَيْنِ لَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_108", "reason": "high_symbol_ratio:0.412", "chunk_text": "عَنْ عَمَّارٍ مَوْلَى بَنِي هَاشِمٍ قَالَ سَأَلْتُ ابْنَ عَبَّاسٍ كَمْ أَتَى لِرَسُولِ اللَّهِ يَوْم"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_111", "reason": "high_symbol_ratio:0.401", "chunk_text": "عن عَبْد اللَّهِ بْن الزُّبَيْرِ: أَنَّ رَجُلًا مِنْ الْأَنْصَارِ خَاصَمَ الزُّبَيْرَ عِنْدَ رَسُولِ"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_113", "reason": "high_symbol_ratio:0.401", "chunk_text": "عَنْ أَنَسِ بْنِ مَالِكٍ قَالَ بَلَغَ رَسُولَ اللَّهِ عَنْ أَصْحَابِهِ شَيْءٌ فَخَطَبَ فَقَالَ عُرِض"}
{"source": "wikisource", "raw_id": "arwikisource:6826:21738#chunk_119", "reason": "high_symbol_ratio:0.408", "chunk_text": "عَنْ أَبِي هُرَيْرَةَ أَنَّ رَسُولَ اللَّهِ قَالَ مِنْ أَشَدِّ أُمَّتِي لِي حُبًّا نَاسٌ يَكُونُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_5", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَخَبَرُ الْآحَادِ بِنَقْلِ عَدْلٍ تَامِّ الضَّبْطِ، مُتَّصِلِ السَّنَدِ، غَيْرِ مُعَلَّلٍ وَلَا شَا"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_6", "reason": "high_symbol_ratio:0.456", "chunk_text": "وَتَتَفَاوَتُ رُتَبُهُ بِتَفَاوُتِ هَذِهِ الْأَوْصَافِ. ، وَمِنْ ثَمَّ قُدِّمَ صَحِيحُ الْبُخَارِيِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_7", "reason": "high_symbol_ratio:0.449", "chunk_text": "فَإِنْ خَفَّ الضَّبْطُ: فَالْحَسَنُ لِذَاتِهِ، وَبِكَثْرَةِ طُرُقِهِ يُصَحَّحُ. فَإِنْ جُمِعَا فَلِل"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_8", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَزِيَادَةُ رَاوِيهِمَا مَقْبُولَةٌ مَا لَمْ تَقَعْ مُنَافِيَةً لِـ مَنْ هُوَ أَوْثَقُ. فَإِنْ خُولِ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_9", "reason": "high_symbol_ratio:0.417", "chunk_text": "=== الفرد النسبي === * وَالْفَرْدُ النِّسْبِيُّ: إِنْ وَافَقَهُ غَيْرُهُ فَهُوَ الْمُتَابِعُ. وَإِنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_10", "reason": "high_symbol_ratio:0.434", "chunk_text": "وَتَتَبُّعُ الطُّرُقِ لِذَلِكَ هُوَ الِاعْتِبَارُ. === المقبول === * ثُمَّ الْمَقْبُولُ: إِنْ سَلِمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_11", "reason": "high_symbol_ratio:0.433", "chunk_text": "أَوْ لَا وثَبَتَ الْمُتَأَخِّرُ فَهُوَ النَّاسِخُ، وَالْآخَرُ الْمَنْسُوخُ. وَإِلَّا فَالتَّرْجِيحُ،"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_12", "reason": "high_symbol_ratio:0.432", "chunk_text": "=== المردود === * ثُمَّ الْمَرْدُودُ: إِمَّا أَنْ يَكُونَ لِسَقْطٍ أَوْ طَعْنٍ. ==== السقط ==== * فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_14", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالثَّانِي: هُوَ الْمُرْسَلُ. وَالثَّالِثُ: إِنْ كَانَ بِاثْنَيْنِ فَصَاعِدًا مَعَ التَّوَالِي فَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_15", "reason": "high_symbol_ratio:0.429", "chunk_text": "ثُمَّ قَدْ يَكُونُ وَاضِحًا أَوْ خَفِيًّا. * فَالْأَوَّلُ: يُدْرَكُ بِعَدَمِ التَّلَاقِي، وَمِنْ ثَم"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_17", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَالْأَوَّلُ: الْمَوْضُوعُ وَالثَّانِي: الْمَتْرُوكُ. وَالثَّالِثُ: الْمُنْكَرُ عَلَى رَأْيٍ. وَكَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_18", "reason": "high_symbol_ratio:0.429", "chunk_text": "== الوهم == * ثُمَّ الْوَهْمُ: إِنِ اطُّلِعَ عَلَيْهِ بِالْقَرَائِنِ، وَجَمْعِ الطُّرُقِ: فَالْمُعَل"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_19", "reason": "high_symbol_ratio:0.428", "chunk_text": "أَوْ بِدَمْجِ مَوْقُوفٍ بِمَرْفُوعٍ: فَمُدْرَجُ الْمَتْنِ. أَوْ بِتَقْدِيمٍ أَوْ تَأْخِيرٍ: فَالْمَق"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_20", "reason": "high_symbol_ratio:0.434", "chunk_text": "أَوْ بِإِبْدَالِهِ وَلَا مُرَجِّحَ: فَالْمُضْطَّرِبُ - وَقَدْ يَقَعُ الْإِبْدَالُ عَمْدًا امْتِحَانً"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_22", "reason": "high_symbol_ratio:0.420", "chunk_text": "== الجهالة == * ثُمَّ الْجَهَالَةُ: وَسَبَبُهَا أَنَّ الرَّاوِيَ قَدْ تَكْثُرُ نُعُوتُهُ فَيُذْكَرُ "}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_23", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَدْ يَكُونُ مُقِلًّا فَلَا يَكْثُرُ الأَخْذُ عَنْهُ، وَصَنَّفُوا فِيهِ الوِحْدَانَ، َوْ لَا يُسَم"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_24", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَإِنْ سُمِّيَ وَانْفَرَدَ وَاحِدٌ عَنْهُ فمَجْهُولُ الْعَيْنِ، أَوِ اثْنَانِ فَصَاعِدًا، وَلَمْ يُو"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_27", "reason": "high_symbol_ratio:0.433", "chunk_text": "== الاسناد == * ثُمَّ الْإِسْنَادُ: إِمَّا أَنْ يَنْتَهِيَ إِلَى النَّبيِّ -صَلَّى اللَّهُ تَعَالَى "}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_28", "reason": "high_symbol_ratio:0.433", "chunk_text": "أَوْ إِلَى الصَّحَابِيِّ كَذَلِكَ وَهُوَ: مَنْ لَقِيَ النَّبيَّ -صَلَّى اللَّهُ تَعَالَى عَلَيْهِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_29", "reason": "high_symbol_ratio:0.438", "chunk_text": "أَوْ إِلَى التَّاَّبِعِيِّ: وَهُوَ مَنْ لَقِيَ الصَّحَابِيَّ كَذَلِكَ. . فَالْأَوَّلُ: الْمَرْفُوع ُ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_30", "reason": "high_symbol_ratio:0.443", "chunk_text": "وَيُقَالُ لِلأَخِيرَيْنِ: الْأَثَرُ. وَالْمُسْنَدُ: مَرْفُوعُ صَحَابِيٍّ بِسَنَدٍ ظَاهِرُهُ الْاتِّص"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_31", "reason": "high_symbol_ratio:0.436", "chunk_text": "فَالْأَوَّلُ: الْعُلُوُّ الْمُطْلَقُ. وَالثَّانِي: النِّسْبِيُّ. وَفِيهِ الْمُوَافَقَةُ: وَهِيَ الْو"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_34", "reason": "high_symbol_ratio:0.430", "chunk_text": "كُلٌّ مِنْهُمَا عَنِ الْآَخَرِ: فَالْمُدْبَجُ، وَإِنْ رَوَى عَمَّنْ دُونَهُ: فَالْأَكَابِرُ عَنِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_35", "reason": "high_symbol_ratio:0.411", "chunk_text": ". وَإِنِ اشْتَرَكَ اثْنَانِ عَنْ شَيْخٍ، وَتَقدَّمَ مَوْتُ أَحَدِهِمَا، فَهُوَ: السَّابِقُ وَاللَّاح"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_37", "reason": "high_symbol_ratio:0.442", "chunk_text": "== صيغ الأداء == * وَصِيَغُ الْأَدَاءِ: سَمِعْتُ وَحَدَّثَنِي، ثُمَّ أَخْبَرَنِي، وَقَرَأْتُ عَلَيْه"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_38", "reason": "high_symbol_ratio:0.439", "chunk_text": "ثُمَّ كَتَبَ إِلَيَّ، ثُمَّ عَنْ، وَنَحْوَهَا. . فَالْأَوَّلْانِ: لِمَنْ سَمِعَ وَحْدَهُ مِنْ لَفْظِ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_39", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْإِنْبَاءُ: بِمَعْنَى الْإِخْبَارُ. إِلّا فِي عُرْفِ الْمُتَأَخِرِينَ فَهُوَ لِلْإِجَازَةِ كَعَن"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_41", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَإِنِ اتَّفَقَتِ الْأَسْمَاءُ وَاخْتَلَفَتِ الْآَبَاءُ، أَوْ بِالْعَكْسِ: فَهُوَ الْمُتَشَابِهُ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_42", "reason": "high_symbol_ratio:0.428", "chunk_text": "أَوْ بِالتَّقْدِيمِ وَالتَّأْخِيرِ أَوْ نَحْوَ ذَلِكَ. == خاتمة == وَمِنَ الْمُهِمِّ: مَعْرِفَةُ طَب"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_43", "reason": "high_symbol_ratio:0.452", "chunk_text": "وَمرَاتِبُ الْجَرْحِ: وَأَسْوَؤُهَا الْوَصْفُ بِأَفْعَلَ، كَأَكْذَبِ النَّاسِ، ثُمَّ دَجَّالٍ، أَوْ "}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_44", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَأَسْهَلُهَا: لَيْنٌ، أَوْ سَيِّئُ الْحِفْظِ، أَوْ فِيهِ مَقَالٌ. وَمرَاتِبُ التَّعْدِيلِ: وَأَرْفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_45", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْجَرْحُ مُقَدَّمٌ عَلَى التَّعْدِيلِ إِنْ صَدَرَ مُبَيِنًا مِنْ عَارِفٍ بِأْسْبَابِهِ، فَإِنْ خَ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_47", "reason": "high_symbol_ratio:0.422", "chunk_text": "أَوْ بِالْعَكْسِ، أَوْ كُنْيتُهُ كُنْيَةُ زَوْجَتِهِ، وَمَنْ نُسِبَ إِلَى غَيْرِ أَبِيهِ، أَوْ إِلَى"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_48", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَمَعْرِفَةُ الْأَسْمَاءِ الْمُجَرَّدَةِ وَالْمُفْرَدَةِ، وَالْكُنَى، وَالْأَلْقَابِ، وَالْأَنْسَابِ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_49", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَإِلَى الصَّنائِعَ وَالْحِرَفِ، وَيَقَعُ فِيهَا الْاتِّفَاقُ وَالْاشْتَبَاهُ كَالْأَسْمَاءِ، وَقَدْ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_50", "reason": "high_symbol_ratio:0.443", "chunk_text": ". وَمَعْرِفَةُ أَسْبَابِ ذَلِكَ، وَمَعْرِفَةُ الْمَوَالِي مِنْ أَعْلَى، وَمِنْ أَسْفَلِ، بِالرِّقِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_52", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَمَعْرِفَةُ سَبَبِ الْحَدِيثِ، وَقَدْ صَنَّفَ فِيِهِ بَعْضُ شُيُوخِ القَاضِي أبِي يَعْلَى بْنِ الْف"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_53", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَهِيَ نَقْلٌ مَحْضٌ، ظَاهِرةُ التَّعْرِيفِ، مُسْتَغْنِيَةٌ عَنِ التَّمْثِيلِ، وَحَصْرُهَا مُتَعَسِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40190:127504#chunk_54", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَاللَّهُ الْمُوَفِّقُ وَالْهَادِي، لَا إِلَهَ إِلَّا هُوَ."}
{"source": "wikisource", "raw_id": "arwikisource:63643:469670#chunk_0", "reason": "long_repeat_run:21", "chunk_text": "-------------------------------------------- هوامش: * : \"المواتر\": يقصد بها الشاعر السيارات، وهي كلم"}
{"source": "wikisource", "raw_id": "arwikisource:55409:135928#chunk_0", "reason": "high_symbol_ratio:0.457", "chunk_text": "==خبأ== (خَبَأَهُ) مِنْ بَابِ قَطَعَهُ وَمِنْهُ (الْخَابِيَةُ) إِلَّا أَنَّهُمْ تَرَكُوا هَمْزَهَا. "}
{"source": "wikisource", "raw_id": "arwikisource:55409:135928#chunk_1", "reason": "high_symbol_ratio:0.444", "chunk_text": "وَخَبْءُ السَّمَاءِ الْقَطْرُ، وَخَبْءُ الْأَرْضِ النَّبَاتُ. وَ (اخْتَبَأَ) اسْتَتَرَ. ==خبب== (الْ"}
{"source": "wikisource", "raw_id": "arwikisource:55409:135928#chunk_2", "reason": "high_symbol_ratio:0.453", "chunk_text": "وَ (الْخَبَبُ) ضَرْبٌ مِنَ الْعَدْوِ، وَبَابُهُ رَدَّ وَ (خَبَبًا) وَ (خَبِيبًا) أَيْضًا. ==خبت== (ا"}
