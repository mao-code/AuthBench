{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_0", "reason": "high_symbol_ratio:0.470", "chunk_text": "====وبخ==== وَبَّخْتُهُ تَوْبِيخًا لُمْتُهُ وَعَنَّفْتُهُ وَعَتَبْتُ عَلَيْهِ كُلُّهَا بِمَعْنًى وَق"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_1", "reason": "high_symbol_ratio:0.427", "chunk_text": "====وبر==== الْوَبَرُ لِلْبَعِيرِ كَالصُّوفِ لِلْغَنَمِ وَهُوَ فِي الْأَصْلِ مَصْدَرٌ مِنْ بَابِ تَع"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_2", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَالْوَبْرُ دُوَيْبَّةٌ نَحْوُ السِّنَّوْرِ غَبْرَاءُ اللَّوْنِ كَحْلَاءُ لَا ذَنَبَ لَهَا وَالْجَمْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_3", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وبص==== الْوَبِيصُ مِثْلُ الْبَرِيقِ وَزْنًا وَمَعْنًى وَهُوَ اللَّمَعَانُ يُقَالُ وَبَصَ وَبِيص"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_4", "reason": "high_symbol_ratio:0.434", "chunk_text": "====وبق==== وَبَقَ يَبِقُ مِنْ بَابِ وَعَدَ وُبُوقًا هَلَكَ. وَالْمَوْبِقُ مِثْلُ مَسْجِدٍ مِنَ الْو"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_5", "reason": "high_symbol_ratio:0.425", "chunk_text": "====وبل==== وَبَلَتِ السَّمَاءُ وَبْلًا مِنْ بَابِ وَعَدَ وَوُبُولًا اشْتَدَّ مَطَرُهَا وَكَانَ الْأ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_7", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَاسْتَوْبَلَتِ الْغَنَمُ تَمَارَضَتْ مِنْ وَبَالِ مَرْتَعِهَا. ====وبه==== وَبِهْتُ لَهُ مِنْ بَابِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_8", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وبء==== الْوَبَاءُ بِالْهَمْزِ مَرَضٌ عَامٌّ يُمَدُّ وَيُقْصَرُ وَيُجْمَعُ الْمَمْدُودُ عَلَى أَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_9", "reason": "high_symbol_ratio:0.426", "chunk_text": "====وتد==== الْوَتِدُ بِكَسْرِ التَّاءِ فِي لُغَةِ الْحِجَازِ وَهِيَ الْفُصْحَى وَجَمْعُهُ أَوْتَادٌ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_10", "reason": "high_symbol_ratio:0.434", "chunk_text": "====وتر==== الْوَتَرُ لِلْقَوْسِ جَمْعُهُ أَوْتَارٌ مِثْلُ سَبَبٍ وَأَسْبَابٍ وَأَوْتَرْتُ الْقَوْسَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_12", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالْوِتْرُ الْفَرْدُ وَالْوِتْرُ الذَّحْلُ بِالْكَسْرِ فِيهِمَا لِتَمِيمٍ وَبِفَتْحِ الْعَدَدِ وَكَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_13", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَوَتَرْتُ زَيْدًا حَقَّهُ أَتِرُهُ مِنْ بَابِ وَعَدَ أَيْضًا نَقَصْتُهُ وَمِنْهُ مِنْ فَاتَتْهُ صَل"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_14", "reason": "high_symbol_ratio:0.430", "chunk_text": "====وثب==== وَثَبَ وَثْبًا مِنْ بَابِ وَعَدَ قَفَزَ وَوُثُوبًا وَوَثِيبًا فَهُوَ وَثَّابٌ وَيَتَعَدَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_15", "reason": "high_symbol_ratio:0.422", "chunk_text": "====وثر==== وَثُرَ الشَّيْءُ بِالضَّمِّ وَثَارَةً لَانَ وَسَهُلَ فَهُوَ وَثِيرٌ وَفِرَاشٌ وَثِيرٌ ثَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_16", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وثق==== وَثُقَ الشَّيْءُ بِالضَّمِّ وَثَاقَةً قَوِيَ وَثَبَتَ فَهُوَ وَثِيقٌ ثَابِتٌ مُحْكَمٌ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_18", "reason": "high_symbol_ratio:0.441", "chunk_text": "====وثن==== الْوَثَنُ الصَّنَمُ سَوَاءٌ كَانَ مِنْ خَشَبٍ أَوْ حَجَرٍ أَوْ غَيْرِهِ وَتَقَدَّمَ فِي "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_19", "reason": "high_symbol_ratio:0.455", "chunk_text": "====وجب==== وَجَبَ الْبَيْعُ وَالْحَقُّ يَجِبُ وُجُوبًا وَجِبَةً لَزِمَ وَثَبَتَ. وَوَجَبَتِ الشَّمْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_20", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَوَجَبَ الْحَائِطُ وَنَحْوُهُ وَجْبَةً سَقَطَ. وَوَجَبَ الْقَلْبُ وَجْبًا وَوَجِيبًا رَجَفَ وَاسْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_21", "reason": "high_symbol_ratio:0.447", "chunk_text": "====وجج==== وَجُّ الطَّائِفِ بَلَدٌ بِالطَّائِفِ وَقِيلَ هُوَ الطَّائِفُ وَقِيلَ وَادٍ بَيْنَهُ وَبَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_22", "reason": "high_symbol_ratio:0.404", "chunk_text": "====وجد==== وَجَدْتُهُ أَجِدُهُ وِجْدَانًا بِالْكَسْرِ وَوُجُودًا وَفِي لُغَةٍ لِبَنِي عَامِرٍ يَجِد"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_23", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَأَنَا وَاجِدٌ لِلشَّيْءِ قَادِرٌ عَلَيْهِ وَهُوَ مَوْجُودٌ مَقْدُورٌ عَلَيْهِ. وَوَجَدْتُ عَلَيْهِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_24", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالْوُجُودُ خِلَافُ الْعَدَمِ وَأَوْجَدَ اللَّهُ الشَّيْءَ مِنَ الْعَدَمِ فَوُجِدَ فَهُوَ مَوْجُودٌ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_25", "reason": "high_symbol_ratio:0.419", "chunk_text": "====وجر==== الْوَجُورُ بِفَتْحِ الْوَاوِ وِزَانُ رَسُولٍ الدَّوَاءُ يُصَبُّ فِي الْحَلْقِ وَأَوْجَرْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_26", "reason": "high_symbol_ratio:0.423", "chunk_text": "====وجز==== وَجُزَ اللَّفْظُ بِالضَّمِّ وَجَازَةً فَهُوَ وَجِيزٌ أَيْ قَصِيرٌ سَرِيعُ الْوُصُولِ إلَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_27", "reason": "high_symbol_ratio:0.420", "chunk_text": "====وجع==== وَجِعَ فُلَانًا رَأْسُهُ أَوْ بَطْنُهُ يُجْعَلُ الْإِنْسَانُ مَفْعُولًا وَالْعُضْوُ فَاع"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_28", "reason": "high_symbol_ratio:0.412", "chunk_text": "أَلَمُ رَأْسِهِ لَكِنَّهُ حُذِفَ لِلْعِلْمِ بِهِ وَعَلَى هَذَا فَيُقَالُ فُلَانٌ مَوْجُوعٌ وَالْأَجْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_29", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ غَيْرُ الْفَرَّاءِ نُصِبَ الْبَطْنُ بِنَزْعِ الْخَافِضِ وَالْأَصْلُ وُجِعْت مِنْ بَطْنِكَ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_30", "reason": "high_symbol_ratio:0.413", "chunk_text": "====وجف==== وَجَفَ يَجِفُ وَجِيفًا اضْطَرَبَ وَقَلْبٌ وَاجِفٌ وَوَجَفَ الْفَرَسُ وَالْبَعِيرُ وَجِيف"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_31", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وجل==== وَجِلَ وَجَلًا فَهُوَ وَجِلٌ وَالْأُنْثَى وَجِلَةٌ مِنْ بَابِ تَعِبَ إذَا خَافَ وَجَاءَ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_32", "reason": "high_symbol_ratio:0.431", "chunk_text": "====وجم==== وَجَمَ مِنَ الْأَمْرِ يَجِمُ وُجُومًا أَمْسَكَ عَنْهُ وَهُوَ كَارِهٌ. وَالْوَجَمُ بِفَتْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_33", "reason": "high_symbol_ratio:0.433", "chunk_text": "====وجن==== الْوَجْنَةُ مِنَ الْإِنْسَانِ مَا ارْتَفَعَ مِنْ لَحْمِ خَدِّهِ وَالْأَشْهَرُ فَتْحُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_34", "reason": "high_symbol_ratio:0.420", "chunk_text": "====وجه==== وَجُهَ بِالضَّمِّ وَجَاهَةً فَهُوَ وَجِيهٌ إذَا كَانَ لَهُ حَظٌّ وَرُتْبَةٌ وَالْوَجْهُ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_35", "reason": "high_symbol_ratio:0.411", "chunk_text": "يَدُلُّ عَلَى حُسْنِ الْبَاطِنِ. وَشَرِكَةُ الْوُجُوهِ أَصْلُهَا شَرِكَةٌ بِالْوُجُوهِ فَحُذِفَتِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_37", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَلِهَذَا الْقَوْلِ وَجْهٌ أَيْ مَأْخَذٌ وَجِهَةٌ أُخِذَ مِنْهَا. وَتُجَاهُ الشَّيْءِ وِزَانُ غُرَاب"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_38", "reason": "high_symbol_ratio:0.412", "chunk_text": "====وجء==== وَجَأْتُهُ أَوْجَؤُهُ مَهْمُوزٌ مِنْ بَابِ نَفَعَ وَرُبَّمَا حُذِفَتِ الْوَاوُ فِي الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_39", "reason": "high_symbol_ratio:0.445", "chunk_text": "====وحد==== وَحَدَ يَحِدُ حِدَةُ مِنْ بَابِ وَعَدَ انْفَرَدَ بِنَفْسِهِ فَهُوَ وَحَدٌ بِفَتْحَتَيْنِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_40", "reason": "high_symbol_ratio:0.458", "chunk_text": "وَكُلُّ شَيْءٍ عَلَى حِدَةٍ أَيْ مُتَمَيِّزٌ عَنْ غَيْرِهِ."}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_41", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَجَاءَ زَيْدٌ وَحْدَهُ وَمَرَرْتُ بِرَجُلٍ وَحْدَهُ قَالَ ابْنُ السَّرَّاجِ مَذْهَبُ سِيبَوَيْهِ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_42", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَأُبْدِلَتِ الْوَاوُ هَمْزَةً وَيَقَعُ عَلَى الذَّكَرِ وَالْأُنْثَى. وَفِي التَّنْزِيلِ { يَا نِسَا"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_43", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَيَكُونُ أَحَدٌ مُرَادِفًا لِوَاحِدٍ فِي مَوْضِعَيْنِ سَمَاعًا أَحَدُهُمَا وَصْفُ اسْمِ الْبَارِي ت"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_45", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَأَشْهَادٍ قَالُوا وَإِذَا نُفِيَ أَحَدٌ اخْتَصَّ بِالْعَاقِلِ وَأَطْلَقُوا فِيهِ الْقَوْلَ وَقَدْ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_46", "reason": "high_symbol_ratio:0.421", "chunk_text": "بِالْهَاءِ وَيَوْمُ الْأَحَدِ مَنْقُولٌ مِنْ ذَلِكَ وَهُوَ عَلَمٌ عَلَى مُعَيَّنٍ وَجَمْعُهُ آحَادٌ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_47", "reason": "high_symbol_ratio:0.424", "chunk_text": "====وحش==== الْوَحْشُ مَا لَا يُسْتَأْنَسُ مِنْ دَوَابِّ الْبَرِّ وَجَمْعُهُ وُحُوشٌ وَكُلُّ شَيْءٍ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_48", "reason": "high_symbol_ratio:0.471", "chunk_text": "وَبِالْإِضَافَةِ."}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_49", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالْوَحْشِيُّ مِنْ كُلِّ دَابَّةٍ الْجَانِبُ الْأَيْمَنُ قَالَ الشَّاعِرُ فَمَالَتْ عَلَى شِقِّ وَح"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_50", "reason": "high_symbol_ratio:0.404", "chunk_text": "إلَى الْجَانِبِ الْأَيْمَنِ قَالَ الْأَزْهَرِيُّ وَهُوَ غَيْرُ صَحِيحٍ عِنْدِي قَالَ ابْنُ الْأَنْبَ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_51", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَوَحْشِيُّ الْقَوْسِ ظَهْرُهَا وَإِنْسِيُّهَا مَا أَقْبَلَ عَلَيْكَ مِنْهَا. ====وحل==== وَحِلَ الر"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_52", "reason": "high_symbol_ratio:0.416", "chunk_text": "====وحم==== وَحِمَتِ الْمَرْأَةُ تَوْحَمُ وَحَمًا مِنْ بَابِ تَعِبَ حَبِلَتْ وَاشْتَهَتْ وَالِاسْمُ "}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_53", "reason": "high_symbol_ratio:0.408", "chunk_text": "====وحي==== الْوَحْيُ الْإِشَارَةُ وَالرِّسَالَةُ وَالْكِتَابَةُ وَكُلُّ مَا أَلْقَيْتَهُ إلَى غَيْر"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_54", "reason": "high_symbol_ratio:0.416", "chunk_text": "الْوَحَا السُّرْعَةُ يُمَدُّ وَيُقْصَرُ وَمَوْتٌ وَحِيٌّ مِثْلُ سَرِيعٍ وَزْنًا وَمَعْنًى فَعِيلٌ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:41121:108407#chunk_55", "reason": "high_symbol_ratio:0.447", "chunk_text": "====وخز==== وَخَزَهُ وَخْزًا مِنْ بَابِ وَعَدَ طَعَنَهُ طَعْنَةً غَيْرَ نَافِذَةٍ بِرُمْحٍ أَوْ إبْر"}
