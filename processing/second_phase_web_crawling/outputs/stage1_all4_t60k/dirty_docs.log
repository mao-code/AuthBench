{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_453", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَإِنْ كَانَتِ الْكَلِمَةُ هِيَ الذَّاتُ أَوِ الذَّاتُ وَالصِّفَةُ فَهِيَ رَبُّ الْعَالَمِينَ وَهِيَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_454", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَإِنْ كَانَتِ الْكَلِمَةُ صِفَةً لِلَّهِ - عَزَّ وَجَلَّ - فَصِفَةُ اللَّهِ لَيْسَتْ هِيَ الْإِلَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_455", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَإِنْ قَالُوا: قَوْلُنَا هَذَا كَمَا تَقُولُ طَائِفَةٌ مِنَ الْمُسْلِمِينَ إِنَّ الْقُرْآنَ أَوِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_456", "reason": "high_symbol_ratio:0.406", "chunk_text": "قِيلَ لَوْ كَانَ قَوْلُ هَؤُلَاءِ صَوَابًا لَمْ يَكُنْ لَهُمْ فِيهِ حُجَّةٌ، فَإِنَّهُ عَلَى هَذَا ا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_458", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَلَكِنَّ طَائِفَةً مِنْهُمْ أَطْلَقَتْ لَفْظَ الْحُلُولِ وَطَائِفَةً أَنْكَرَتْ لَفْظَ الْحُلُولِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_459", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَسَلَفُ الْمُسْلِمِينَ وَجُمْهُورُهُمْ يُخَطِّئُونَ هَؤُلَاءِ وَيُبَيِّنُونَ خَطَأَهُمْ عَقْلًا وَن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_460", "reason": "high_symbol_ratio:0.410", "chunk_text": "كَالْمُعْتَزِلَةِ وَالشِّيعَةِ وَأَمْثَالِهِمْ وَإِنَّمَا قَالَ ذَلِكَ طَائِفَةٌ قَلِيلَةٌ انْتُسِبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_461", "reason": "high_symbol_ratio:0.421", "chunk_text": "الْمَسِيحُ بَلْ هُوَ مُشْتَرَكٌ بَيْنَهُ وَبَيْنَ غَيْرِهِ مِنَ الْأَنْبِيَاءِ وَالصَّالِحِينَ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_464", "reason": "high_symbol_ratio:0.409", "chunk_text": "بِهِ إِلَى يَوْمِ الْقِيَامَةِ. وَأَمَّا الْمُسْلِمُونَ فَهُمْ مُؤْمِنُونَ بِهِ لَيْسُوا كَافِرِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_465", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَالَ تَعَالَى: شَرَعَ لَكُمْ مِنَ الدِّينِ مَا وَصَّى بِهِ نُوحًا وَالَّذِي أَوْحَيْنَا إِلَيْكَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_466", "reason": "high_symbol_ratio:0.400", "chunk_text": "تَعَالَى، فَإِنَّ اللَّهَ يَقُولُ فِي كِتَابِهِ إِنَّا لَنَنْصُرُ رُسُلَنَا وَالَّذِينَ آمَنُوا فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_468", "reason": "high_symbol_ratio:0.416", "chunk_text": "أُوتِيَ النَّبِيُّونَ مِنْ رَبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْهُمْ وَنَحْنُ لَهُ مُسْلِمُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_469", "reason": "high_symbol_ratio:0.410", "chunk_text": "لَا تَزَالُ طَائِفَةٌ مِنْ أُمَّتِي ظَاهِرَةً عَلَى الْحَقِّ لَا يَضُرُّهُمْ مَنْ خَالَفَهُمْ وَلَا "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_470", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَقَالَ أَيْضًا: سَأَلْتُ رَبِّي أَنْ لَا يُسَلِّطَ عَلَى أُمَّتِي عَدُوًّا مِنْ غَيْرِهِمْ فَيَجْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_471", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَكَانَ مَا احْتَجُّوا بِهِ حُجَّةً عَلَيْهِمْ لَا لَهُمْ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_473", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَرَفَعَ بَعْضَهُمْ دَرَجَاتٍ وَآتَيْنَا عِيسَى ابْنَ مَرْيَمَ الْبَيِّنَاتِ وَأَيَّدْنَاهُ بِرُوحِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_474", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالْإِنْجِيلَ وَإِذْ تَخْلُقُ مِنَ الطِّينِ كَهَيْئَةِ الطَّيْرِ بِإِذْنِي فَتَنْفُخُ فِيهَا فَتَكُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_475", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَلْبِكَ بِإِذْنِ اللَّهِ مُصَدِّقًا فَرُوحُ الْقُدُسِ الَّذِي نَزَلَ بِالْقُرْآنِ مِنَ اللَّهِ هُوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_476", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَثَبَتَ فِي الصَّحِيحِ عَنْ أَبِي هُرَيْرَةَ أَنَّهُ سَمِعَ النَّبِيَّ يَقُولُ لِحَسَّانِ بْنِ ثَاب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_477", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ وَغَيْرِهِ عَنْ عَائِشَةَ - رَضِيَ اللَّهُ عَنْهَا - قَالَتْ سَمِعْتُ النَّبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_478", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنِ الْبَرَاءِ بْنِ عَازِبٍ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ يَقُولُ لِحَسَّانِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_479", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَهَذَا حَسَّانُ بْنُ ثَابِتٍ وَاحِدٌ مِنَ الْمُؤْمِنِينَ لَمَّا نَافَحَ عَنِ اللَّهِ وَرَسُولِهِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_481", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَإِنَّمَا الْمَقْصُودُ فِي هَذَا الْمَقَامِ بَيَانُ كَذِبِهِمْ عَلَى مُحَمَّدٍ وَهَذَا التَّأْيِيدُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_482", "reason": "high_symbol_ratio:0.420", "chunk_text": "لَمْ يُؤْمِنْ بِالرُّسُلِ وَإِنْ كَانُوا أَقَارِبَ وَهَذِهِ مِلَّةُ إِبْرَاهِيمَ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_483", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَالَ تَعَالَى: قَدْ كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَةٌ فِي إِبْرَاهِيمَ وَالَّذِينَ مَعَهُ إِذْ قَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_484", "reason": "high_symbol_ratio:0.407", "chunk_text": "عَدُوٌّ لِلَّهِ تَبَرَّأَ مِنْهُ وَهَذَا التَّأْيِيدُ بِرُوحِ الْقُدُسِ لِمَنْ يَنْصُرُ الرُّسُلَ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_489", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَلِهَذَا قَالَ كَثِيرٌ مِنَ الْمُفَسِّرِينَ إِنَّهُ جِبْرِيلُ وَقَالَ: بَعْضُهُمْ إِنَّهُ الْوَحْيُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_491", "reason": "high_symbol_ratio:0.413", "chunk_text": "لِلرَّهْبَانِيَّةِ وَلَا لِمَنْ بَدَّلَ دِينَ الْمَسِيحِ وَإِنَّمَا فِيهِ مَدْحٌ لِمَنِ اتَّبَعُهُ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_492", "reason": "high_symbol_ratio:0.421", "chunk_text": "جَعَلَ اللَّهُ مِنْ بَحِيرَةٍ وَلَا سَائِبَةٍ وَلَا وَصِيلَةٍ وَلَا حَامٍ. وَهَذَا الْجَعْلُ الْمَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_493", "reason": "high_symbol_ratio:0.410", "chunk_text": "أَحَدُهُمَا: أَنَّهَا مَنْصُوبَةٌ يَعْنِي ابْتَدَعُوهَا إِمَّا بِفِعْلٍ مُضْمَرٍ يُفَسِّرُهُ مَا بَع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_494", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْقَوْلُ الثَّانِي: أَنَّهَا مَعْطُوفَةٌ عَلَيْهَا فَيَكُونُ اللَّهُ قَدْ جَعَلَ فِي قُلُوبِهِمُ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_495", "reason": "high_symbol_ratio:0.409", "chunk_text": "ثُمَّ قَالَ: إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ أَيْ لَمْ يُكْتَبْ عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِض"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_499", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَذَكَرَ أَنَّهُمُ ابْتَدَعُوا الرَّهْبَانِيَّةَ وَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا وَلَيْسَ فِي ذَل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_500", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَمَنْ آمَنَ بِمُحَمَّدٍ لَمْ يَمْدَحِ النَّصَارَى الَّذِينَ بَدَّلُوا دِينَ الْمَسِيحِ وَلَا الَّذِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_501", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَإِنْ قِيلَ قَدْ قَالَ بَعْضُ النَّاسِ إِنَّ قَوْلَهُ تَعَالَى: \" وَرَهْبَانِيَّةً ابْتَدَعُوهَا \" "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_502", "reason": "high_symbol_ratio:0.431", "chunk_text": "مِنْهَا: أَنَّ الرَّهْبَانِيَّةَ لَمْ تَكُنْ فِي كُلِّ مَنِ اتَّبَعَهُ بَلِ الَّذِينَ صَحِبُوهُ كَال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_503", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمِنْهَا أَنَّهُ أَخْبَرَ أَنَّهُمُ ابْتَدَعُوا الرَّهْبَانِيَّةَ بِخِلَافِ الرَّأْفَةِ وَالرَّحْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_504", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَمِنْهَا أَنَّ الرَّأْفَةَ وَالرَّحْمَةَ جَعَلَهَا فِي الْقُلُوبِ وَالرَّهْبَانِيَّةُ لَا تَخْتَصُّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_506", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَقَامَ النَّبِيُّ خَطِيبًا فَقَالَ: مَا بَالُ رِجَالٍ يَقُولُ أَحَدُهُمْ كَذَا وَكَذَا لَكِنِّي أَص"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_507", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ أَنَّ النَّبِيَّ رَأَى رَجُلًا قَائِمًا فِي الشَّمْسِ فَقَالَ: مَا هَذَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_508", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَثَبَتَ فِي صَحِيحِ مُسْلِمٍ عَنِ النَّبِيِّ أَنَّهُ كَانَ يَقُولُ فِي خُطْبَتِهِ: خَيْرُ الْكَلَام"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_509", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَفِي السُّنَنِ عَنِ الْعِرْبَاضِ بْنِ سَارِيَةَ أَنَّ النَّبِيَّ قَالَ: عَلَيْكُمْ بِسُنَّتِي وَسُن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_510", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ التِّرْمِذِيُّ حَدِيثٌ حَسَنٌ صَحِيحٌ. وَقَدْ بَيَّنَتِ النُّصُوصُ الصَّحِيحَةُ أَنَّ الرَّهْب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_513", "reason": "high_symbol_ratio:0.415", "chunk_text": "قِيلَ كِلَا الْقَوْلَيْنِ خَطَأٌ وَالْأَوَّلُ أَظْهَرُ خَطَأً، فَإِنَّ الرَّهْبَانِيَّةَ لَمْ يَكْتُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_514", "reason": "high_symbol_ratio:0.416", "chunk_text": "ابْتَدَعُوا بِدْعَةً وَأَنَّ تِلْكَ الْبِدْعَةَ لَمْ يَرْعَوْهَا حَقَّ رِعَايَتِهَا. فَإِنْ قِيلَ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_515", "reason": "high_symbol_ratio:0.410", "chunk_text": "قِيلَ لَيْسَ فِي الْكَلَامِ مَا يَدُلُّ عَلَى ذَلِكَ بَلْ يَدُلُّ عَلَى أَنَّهُمْ مَعَ عَدَمِ الرِّع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_516", "reason": "high_symbol_ratio:0.401", "chunk_text": "شَرًّا مِنْهُمْ وَالنَّارُ دَرَكَاتٌ كَمَا أَنَّ الْجَنَّةَ دَرَجَاتٌ. وَأَيْضًا فَاللَّهُ تَعَالَى "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_517", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَأَيْضًا فَتَخْصِيصُ الرَّهْبَانِيَّةِ بِأَنَّهُ كَتَبَهَا ابْتِغَاءَ رِضْوَانِ اللَّهِ دُونَ غَيْر"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_518", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَأَمَّا قَوْلُ مَنْ قَالَ: مَا فَعَلُوهَا إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَهَذَا الْمَعْنَى لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_519", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَلَا قَالَ: مَا ابْتَدَعُوهَا إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ وَلَوْ كَانَ الْمُرَادُ مَا فَعَل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_520", "reason": "high_symbol_ratio:0.408", "chunk_text": "اللَّهِ وَاجِبٌ مَكْتُوبٌ عَلَى الْخَلْقِ وَذَلِكَ يَكُونُ بِفِعْلِ الْمَأْمُورِ وَبِتَرْكِ الْمَحْظ"}
