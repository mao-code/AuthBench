{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_452", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: قُلْتُ: يَا جِبْرِيلُ، مَنْ هَذَا؟ قَالَ: هَذَا آدَمُ، وَهَذِهِ الْأَسْوِدَةُ عَنْ يَمِينِهِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_453", "reason": "high_symbol_ratio:0.422", "chunk_text": "قَالَ الزُّهْرِيُّ: وَأَخْبَرَنِي ابْنُ حَزْمٍ أَنَّ ابْنَ عَبَّاسٍ وَأَبَا حَبَّةَ الْأَنْصَارِيَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_454", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ قَالَ: لَمَّا أُسْرِيَ بِرَسُولِ اللَّهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_455", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: فَرَاشٌ مِنْ ذَهَبٍ، قَالَ: فَأُعْطِيَ رَسُولُ اللَّهِ ثَلَاثًا: أُعْطِيَ الصَّلَوَاتِ الْخَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_456", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَعَنْهُ فِي قَوْلِهِ عَزَّ وَجَلَّ: فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَى. قَالَ: إِنَّ النَّبِيَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_457", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ أَنَّ رَسُولَ اللَّهِ قَالَ: لَمَّا كَذَّبَتْن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_458", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: قَالَ رَسُولُ اللَّهِ : ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_459", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَصُعُودُ الْآدَمِيِّ بِبَدَنِهِ إِلَى السَّمَاءِ قَدْ ثَبَتَ فِي أَمْرِ الْمَسِيحِ عِيسَى بْنِ مَرْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_460", "reason": "high_symbol_ratio:0.434", "chunk_text": "صُلِبَ وَإِنَّهُ قَامَ مِنَ الْقَبْرِ، وَكَثِيرٌ مِنَ الْيَهُودِ يَقُولُونَ إِنَّهُ صُلِبَ وَلَمْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_461", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَأَمَّا الْمُسْلِمُونَ وَكَثِيرٌ مِنَ النَّصَارَى فَيَقُولُونَ: إِنَّهُ لَمْ يُصْلَبْ وَلَكِنْ صَعِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_462", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالْمُسْلِمُونَ، وَمَنْ وَافَقَهُمْ مِنَ النَّصَارَى يَقُولُونَ: إِنَّهُ يَنْزِلُ إِلَى الْأَرْضِ ق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_463", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَكَثِيرٌ مِنَ النَّصَارَى يَقُولُونَ: إِنَّ نُزُولَهُ هُوَ يَوْمُ الْقِيَامَةِ، وَإِنَّهُ هُوَ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_464", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمَنْ أَنْكَرَ صُعُودَ بَدَنٍ إِلَى السَّمَاءِ مِنَ الْمُتَفَلْسِفَةِ فَعُمْدَتُهُ شَيْئَانِ: أَحَد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_465", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَإِنَّ صُعُودَ الْأَجْسَامِ الثَّقِيلَةِ إِلَى الْهَوَاءِ مِمَّا تَوَاتَرَتْ بِهِ الْأَخْبَارُ فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_466", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ هَذَا مِنْ فَضْلِ رَبِّي لِيَبْلُوَنِي أَأَشْكُرُ أَمْ أَكْفُرُ وَمَنْ شَكَرَ فَإِنَّمَا يَشْك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_467", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَمِثْلُ حَمْلِ الرِّيحِ لِسُلَيْمَانَ وَعَسْكَرِهِ لَمَّا كَانَ يَحْمِلُ الْبِسَاطَ فِي الْهَوَاءِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_468", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَبِهَذَا يَظْهَرُ جَوَابُهُمْ عَنْ إِنْكَارِهِمُ انْشِقَاقَ الْقَمَرِ، فَإِنَّ عُمْدَتَهُمْ فِيهِ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_469", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَإِذَا قُدِّرَ أَنَّهُ خُلِقَ وَرَاءَ الْمُحَدِّدِ مُحَدِّدًا آخَرَ، وَخَرْقُ الْأَوَّلِ حَصَلَ بِه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_470", "reason": "high_symbol_ratio:0.404", "chunk_text": "تَكُنْ تِلْكَ الْأَيَّامُ الَّتِي خَلَقَ اللَّهُ فِيهَا السَّمَاوَاتِ وَالْأَرْضَ هِيَ مِقْدَارُ حَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_471", "reason": "high_symbol_ratio:0.411", "chunk_text": "بَلْ وَقَدْ أَخْبَرَ اللَّهُ تَعَالَى أَنَّهُ كَانَ عَرْشُهُ عَلَى الْمَاءِ قَبْلَ أَنْ يَخْلُقَ الس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_472", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَإِذَا كَانَ قَبْلَ هَذِهِ الْحَرَكَاتِ الْمَشْهُودَةِ حَرَكَاتٌ أُخَرُ لِأَجْسَامٍ غَيْرِ هَذِهِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_474", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَأَيْضًا فَمَعْلُومٌ أَنَّ النَّارَ وَالْهَوَاءَ الْخَفِيفَ تُحَرَّكُ حَرَكَةً قَسْرِيَّةً فَيَهْبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_475", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالشُّبْهَةُ الثَّانِيَةُ: ظَنَّ بَعْضُ الْمُتَفَلْسِفَةِ كَأَرِسْطُو وَشِيعَتِهِ أَنَّ الْأَفْلَاك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_476", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَهَذِهِ الْحُجَّةُ فَاسِدَةٌ مِنْ وُجُوهٍ: مِنْهَا: أَنَّهَا تَدُلُّ عَلَى ذَلِكَ فِي الْفَلَكِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_477", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَمِنْهَا: أَنَّ وُجُودَ أَجْسَامٍ خَارِجَ الْفَلَكِ كَوُجُودِ الْفَلَكِ فِي حَيِّزِهِ يَحْتَاجُ إِل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_478", "reason": "high_symbol_ratio:0.441", "chunk_text": "وَإِنْ قِيلَ: إِنَّهُ أَمْرٌ وُجُودِيٌّ لَزِمَ أَنْ يُحْتَاجَ إِلَيْهِ فِي الْمَوْضِعَيْنِ، وَحِينَئ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_479", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَكَذَلِكَ مَا يَذْكُرُونَهُ فِي قِدَمِ الْعَالَمِ، فَلَيْسَ مَعَ الْقَوْمِ دَلِيلٌ وَاحِدٌ عَقْلِيُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_480", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالنَّوْعُ الثَّانِي: آيَاتُ الْجَوِّ، كَاسْتِسْقَائِهِ ، وَاسْتِصْحَائِهِ، وَطَاعَةِ السَّحَابِ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_481", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَفِي الصَّحِيحَيْنِ عَنْ أَنَسِ بْنِ مَالِكٍ أَنَّ رَجُلًا دَخَلَ الْمَسْجِدَ فِي يَوْمِ جُمُعَةٍ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_482", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَأَنَسٌ: فَلَا وَاللَّهِ مَا نَرَى فِي السَّمَاءِ مِنْ سَحَابٍ، وَلَا مِنْ قَزَعَةٍ، وَأَنَّ الس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_483", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَفِي رِوَايَةٍ أُخْرَى: فَطَلَعَتْ مِنْ وَرَائِهِ سَحَابَةٌ مِثْلُ التُّرْسِ فَلَمَّا تَوَسَّطَتِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_484", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَبُطُونِ الْأَوْدِيَةِ، وَمَنَابِتِ الشَّجَرِ. قَالَ: فَمَا يُشِيرُ بِيَدِهِ إِلَى نَاحِيَةٍ إِلَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_486", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَجُنُودًا لَمْ تَرَوْهَا: يَعْنِي الْمَلَائِكَةَ. وَفِي صَحِيحِ مُسْلِمٍ، عَنِ ابْنِ عَبَّاسٍ، عَنِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_487", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَفِي الْمَغَازِي وَالسِّيَرِ قِصَّةُ الْأَحْزَابِ، وَكَيْفَ أُرْسِلَتْ عَلَيْهِمُ الرِّيحُ وَالْمَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_489", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَرُوِيَ عَنْ عَبْدِ اللَّهِ بْنِ جَعْفَرٍ قَالَ: أَرْدَفَنِي رَسُولُ اللَّهِ ذَاتَ يَوْمٍ فَأَسَرَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_490", "reason": "high_symbol_ratio:0.448", "chunk_text": "مَلَّكَكَ اللَّهُ إِيَّاهَا؟ فَإِنَّهُ شَكَا إِلَيَّ أَنَّكَ تُجِيعُهُ، وَتُدْئِبُهُ. رَوَى مُسْلِمٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_491", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَرَوَى أَحْمَدُ، وَالدَّارِمَيُّ وَغَيْرُهُمَا عَنْ جَابِرٍ قَالَ: أَقْبَلْنَا مَعَ رَسُولِ اللَّهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_492", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَخَطَمَهُ وَدَفَعَهُ إِلَى صَاحِبِهِ. قَالَ: ثُمَّ الْتَفَتَ إِلَى النَّاسِ فَقَالَ: إِنَّهُ لَيْسَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_493", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَرَوَى الطَّبَرَانِيُّ، عَنْ جَابِرٍ قَالَ: خَرَجْنَا فِي غَزْوَةِ ذَاتِ الرِّقَاعِ حَتَّى إِذَا كُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_494", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَذَكَرَ قِصَّةَ الشَّجَرَتَيْنِ إِلَى أَنْ قَالَ: فَنَزَلْنَا فِي وَادٍ مِنْ أَوْدِيَةِ بَنِي مُحَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_495", "reason": "high_symbol_ratio:0.426", "chunk_text": "ثُمَّ أَقْبَلْنَا رَاجِعِينَ، فَجَاءَ رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ بِعُشِّ طَيْرٍ يَحْمِلُهُ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_496", "reason": "high_symbol_ratio:0.423", "chunk_text": "هَلْ أَصَابَهُ شَيْءٌ مِمَّا كَانَ يُصِيبُهُ؟ قَالَتْ: لَا، وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أَصَاب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_497", "reason": "high_symbol_ratio:0.432", "chunk_text": "فَائْتِ بِهِ. فَقُلْتُ: مَا أَعْرِفُ صَاحِبَهُ يَا رَسُولَ اللَّهِ. قَالَ: إِنَّهُ سَيَدُلُّكَ عَلَي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_498", "reason": "high_symbol_ratio:0.443", "chunk_text": "فَخَرَجَ مَعِي حَتَّى جَاءَ إِلَى النَّبِيِّ ، فَقَالَ لَهُ رَسُولُ اللَّهِ : إِنَّ جَمَلَكَ هَذَا ي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_499", "reason": "high_symbol_ratio:0.417", "chunk_text": "قَالَ: وَالَّذِي بَعَثَكَ بِالْحَقِّ إِنَّ ذَلِكَ كَذَلِكَ. فَقَالَ لَهُ رَسُولُ اللَّهِ : بِعْنِيهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_500", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَهَذَا الْحَدِيثُ لَهُ شَوَاهِدُ، أَخْرَجَ أَهْلُ الصَّحِيحِ مِنْهُ قِصَّةَ الشَّجَرَتَيْنِ، وَقِصَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_501", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَرَوَى الْإِمَامُ أَحْمَدُ فِي مَسْنَدِهِ عَنْ يَعْلَى بْنِ مَرَّةَ الثَّقَفِيِّ قَالَ: ثَلَاثَةُ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_502", "reason": "high_symbol_ratio:0.438", "chunk_text": "فَقَالَ: بَلْ نَهَبُهُ لَكَ، وَهُوَ لِأَهْلِ بَيْتٍ، مَا لَهُمْ مَعِيشَةٌ غَيْرُهُ. قَالَ: أَمَا إِذ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_503", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَفِي رِوَايَةٍ: أَنَّهُمْ أَرَادُوا نَحْرَهُ. ثُمَّ سِرْنَا فَنَزَلْنَا مَنْزِلًا، فَقَالَ النَّبِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_504", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَانْطَلَقْتُ، فَقُلْتُ لَهُمَا ذَلِكَ، فَانْتُزِعَتْ كُلُّ وَاحِدَةٍ مِنْهُمَا مِنْ أَصْلِهَا، فَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_505", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَتَتْهُ امْرَأَةٌ بِصَبِيٍّ لَهَا بِهِ لَمَمٌ، فَقَالَتْ: يَا رَسُولَ اللَّهِ، إِنَّ ابْنِي هَذَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_506", "reason": "high_symbol_ratio:0.437", "chunk_text": "فَبَرِئَ، فَلَمَّا رَجَعْنَا جَاءَتْ أُمُّ الْغُلَامِ بِكَبْشَيْنِ وَشَيْءٍ مِنْ أَقِطٍ، قَالَتْ: وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_507", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَرَوَى هَذِهِ الْقِصَّةَ أَبُو يَعْلَى الْمَوْصِلِيُّ، عَنْ أُسَامَةَ بْنِ زَيْدٍ رَضِيَ اللَّهُ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_508", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَفِيهِ أَنَّ رَسُولَ اللَّهِ قَالَ: لِلْمَرْأَةِ لَمَّا أَخْرَجَ الشَّيْطَانَ مِنِ ابْنِهَا إِذَا ر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_509", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَرَوَاهُ الدَّارِمِيُّ أَيْضًا. وَرَوَى الدَّارِمِيُّ، عَنِ ابْنِ عَبَّاسٍ أَنَّ امْرَأَةً جَاءَتْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_510", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَرَوَى أَبُو دَاوُدَ الطَّيَالِسِيُّ، عَنِ ابْنِ مَسْعُودٍ قَالَ: كُنَّا مَعَ رَسُولِ اللَّهِ فِي س"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_511", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَقَالَ: رُدَّهُ رَحْمَةً لَهَا. وَرَوَى الْحَاكِمُ فِي صَحِيحِهِ عَنْ سَفِينَةَ مَوْلَى رَسُولِ الل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_512", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَقُلْتُ: يَا أَبَا الْحَارِثِ، أَنَا مَوْلَى رَسُولِ اللَّهِ ، فَطَأْطَأَ رَأْسَهُ وَغَمَزَ بِمَنْك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_513", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَرَوَى الْإِمَامُ أَحْمَدُ فِي مُسْنَدِهِ، عَنْ عَائِشَةَ قَالَتْ: كَانَ لِآلِ رَسُولِ اللَّهِ وَحْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_514", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَرَوَاهُ أَبُو نُعَيْمٍ. وَرَوَى عَنْهَا أَحْمَدُ أَيْضًا أَنَّ رَسُولَ اللَّهِ كَانَ فِي نَفَرٍ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_515", "reason": "high_symbol_ratio:0.432", "chunk_text": "رَوَاهُ أَحْمَدُ، عَنْ عَفَّانَ، وَابْنُ مَاجَهْ، عَنِ ابْنِ أَبِي شَيْبَةَ، عَنْ عَفَّانَ، قَالَ: ث"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_516", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَقِصَّةُ هَذَا الْجَمَلِ رَوَاهَا جَمَاعَةٌ. وَرَوَى الْإِمَامُ أَحْمَدُ فِي مُسْنَدِهِ، عَنْ أَبِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_517", "reason": "high_symbol_ratio:0.429", "chunk_text": "قَالَ: فَأَقْبَلَ الرَّاعِي يَسُوقُ غَنَمَهُ حَتَّى دَخَلَ الْمَدِينَةَ، فَزَوَاهَا إِلَى زَاوِيَةٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_518", "reason": "high_symbol_ratio:0.442", "chunk_text": "وَرَوَى التِّرْمِذِيُّ آخِرَهُ وَصَحَّحَهُ، قَالَ الْبَيْهَقِيُّ: إِسْنَادُهُ صَحِيحٌ، وَلَهُ شَاهِد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_519", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَرَوَاهُ أَحْمَدُ، عَنْ أَبِي هُرَيْرَةَ قَالَ: وَكَانَ الرَّاعِي يَهُودِيًّا، فَأَسْلَمَ. وَقَالَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_520", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَنَسٍ قَالَ: كَانَ بِالْمَدِينَةِ فَزَعٌ فَاسْتَعَارَ النَّبِيُّ فَرَسًا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_521", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ سَلَمَةَ بْنِ الْأَكْوَعِ، وَسَهْلِ بْنِ سَعْدٍ، عَنِ النَّبِيِّ فِي غَزْو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_522", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَأَخْبِرْهُمْ بِمَا يَجِبُ عَلَيْهِمْ مِنْ حَقِّ اللَّهِ تَعَالَى فِيهِ، فَوَاللَّهِ لَأَنْ يَهْدِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_523", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَعَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ، عَنْ أَبِيهِ قَتَادَةَ بْنِ النُّعْمَانِ أَنَّهُ أُصِيبَت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_524", "reason": "high_symbol_ratio:0.437", "chunk_text": "وَفِي رِوَايَةٍ: فَرَفَعَ حَدَقَتَهُ حَتَّى وَضَعَهَا مَوْضِعَهَا، ثُمَّ غَمَزَهَا بِرَاحَتِهِ، وَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_525", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَمَاتَ وَمَا يَدْرِي مَنْ لَقِيَهُ أَيُّ عَيْنَيْهِ أُصِيبَتْ. رَوَاهُ عَنْهُ أَهْلُ الْمَغَازِي. و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_526", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ قَالَ: بَعَثَ رَسُولُ اللَّهِ إِلَى أَبِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_527", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَالَ: وَأَقْبَلَ حَتَّى دَنَا مِنَ الْبَابِ، وَذَكَرَ قِصَّةَ قَتْلِهِ إِلَى أَنْ قَالَ ثُمَّ وَضَع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_528", "reason": "high_symbol_ratio:0.418", "chunk_text": "عَلَى السُّورِ فَقَالَ: أَنْعِي أَبَا رَافِعٍ. قَالَ: فَانْطَلَقْتُ إِلَى أَصْحَابِي، فَقُلْتُ: النَ"}
