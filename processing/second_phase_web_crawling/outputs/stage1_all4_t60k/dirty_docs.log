{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_823", "reason": "high_symbol_ratio:0.406", "chunk_text": "نَقْلُ دِينِ مُوسَى ، فَإِنَّ أُمَّةَ مُحَمَّدٍ مَا زَالُوا كَثِيرِينَ مُنْتَشِرِينَ فِي مَشَارِقِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_824", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمَسِيحُ لَمْ يَنْقُلْ دِينَهُ عَنْهُ إِلَّا عَدَدٌ قَلِيلٌ لَكِنَّ النَّصَارَى يَزْعُمُونَ أَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_825", "reason": "high_symbol_ratio:0.424", "chunk_text": "الْجَنَابَةِ، وَيُحَرِّمُ الْخَمْرَ وَالْخِنْزِيرَ، وَأَعْظَمُ جَهْلًا وَعِنَادًا مِمَّنْ يُنْكِرُ م"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_827", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَلَيْسُوا أَهْلًا أَنْ يَحْتَجُّوا بِالتَّوْرَاةِ وَالْإِنْجِيلِ وَالزَّبُورِ عَلَى مُرَادِ الْأَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_828", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَإِنَّ النَّاسَ كُلَّهُمْ مُتَّفِقُونَ عَلَى أَنَّ لُغَةَ الْعَرَبِ مِنْ أَفْصَحِ لُغَاتِ الْآدَمِي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_829", "reason": "high_symbol_ratio:0.412", "chunk_text": "كَفَرُوا بِهِ مَا لَا يَخْفَى عَلَى مَنْ لَهُ أَدْنَى خِبْرَةٍ بِسِيرَتِهِ ، وَهَذَا أَمْرٌ قَدِ امْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_830", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَعَقْلِهِمْ، أَوْ عَلَى عِنَادِهِمْ وَمُكَابَرَتِهِمْ، وَكَانَ الْوَاجِبُ إِذْ لَمْ يَكُنْ لَهُ مَع"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_831", "reason": "high_symbol_ratio:0.421", "chunk_text": "فِيهَا نَاسِخٌ وَمَنْسُوخٌ، مَعَ أَنَّ مَا ذَكَرُوهُ مِنَ الْآيَاتِ لَيْسَ مَنْسُوخًا، وَلَكِنَّ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_832", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَصِدْقِهِ مُمْكِنٌ قَبْلَ أَنْ يُعْلَمَ عُمُومُ رِسَالَتِهِ، فَلَيْسَ الْعِلْمُ بِأَحَدِهِمَا مَوْق"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_833", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالْمَقْصُودُ هُنَا: الْكَلَامُ مَعَ هَؤُلَاءِ بِأَنَّ الْعِلْمَ بِعُمُومِ دَعْوَتِهِ لِجَمِيعِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_834", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَإِنْ قِيلَ: بَلْ فِي الْقُرْآنِ مَا يَقْتَضِي أَنَّ رِسَالَتَهُ خَاصَّةٌ، وَفِيهِ مَا يَقْتَضِي أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_835", "reason": "high_symbol_ratio:0.422", "chunk_text": "قِيلَ: هَذَا بَاطِلٌ، وَيُعْلَمُ بُطْلَانُهُ قَبْلَ الْعِلْمِ بِنُبُوَّتِهِ؛ فَإِنَّهُ مِنَ الْمَعْل"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_836", "reason": "high_symbol_ratio:0.423", "chunk_text": "كَمَا قَالَ تَعَالَى: وَإِنْ أَحَدٌ مِنَ الْمُشْرِكِينَ اسْتَجَارَكَ فَأَجِرْهُ حَتَّى يَسْمَعَ كَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_837", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَكَانَ قَدْ أَظْهَرَ أَنَّهُ مَبْعُوثٌ إِلَى أَهْلِ الْكِتَابِ وَسَائِرِ الْخَلْقِ، وَأَنَّهُ رَسُو"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_838", "reason": "high_symbol_ratio:0.416", "chunk_text": "يَسْتَشْكِلُوا مَا هُوَ دُونَ هَذَا، وَهَذَا لَمْ يَسْتَشْكِلْهُ أَحَدٌ، ثُمَّ بَعْدَ هَذَا فَلَوْ ق"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_839", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَإِنَّمَا فِيهِ إِثْبَاتُ رِسَالَتِهِ إِلَيْهِمْ، كَمَا أَنَّ فِيهِ إِثْبَاتُ رِسَالَتِهِ إِلَى قُر"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_841", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَلَيْسَ هَذَا التَّخَصُّصَ لِلْيَهُودِ مُنَافِيًا لِذَلِكَ التَّعْمِيمِ، وَفِي رِسَالَتِهِ خِطَابٌ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_843", "reason": "high_symbol_ratio:0.412", "chunk_text": "ثُمَّ لَمْ يَكُنْ هَذَا مَانِعًا أَنْ يَأْمُرَ بِقِتَالِ غَيْرِهِمْ مِنَ الْيَهُودِ وَالْمَجُوسِ؛ حَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_844", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَإِنْ قِيلَ: إِنَّهُمْ لَيْسُوا مِنْ أَهْلِ الْكِتَابِ، فَهَذَا كُلُّهُ مِمَّا يُعْلَمُ بِالِاضْطِر"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_845", "reason": "high_symbol_ratio:0.412", "chunk_text": "يَتَّبِعُونَ الْمُتَشَابِهَ وَيَدَعُونَ الْمُحْكَمَ، وَبِسَبَبِ مُنَاظَرَةِ النَّصَارَى لِلنَّبِيِّ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_846", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْأَلْبَابِ. فَالتَّأْوِيلُ: يُرَادُ بِهِ تَفْسِيرُ الْقُرْآنِ، وَمَعْرِفَةُ مَعَانِيهِ، وَهَذَا يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_847", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَالضُّلَّالُ يَذْكُرُونَ آيَاتٍ تَشْتَبِهُ عَلَيْهِمْ مَعْرِفَةُ مَعَانِيهَا، فَيَتَّبِعُونَ تَأْوِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_849", "reason": "high_symbol_ratio:0.429", "chunk_text": "الْمُتَقَدِّمَةِ، لَكِنَّ تِلْكَ الْكُتُبَ يُقِرُّونَ بِنُبُوَّةِ أَصْحَابِهَا وَمُحَمَّدٌ هُمْ فِيه"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_851", "reason": "high_symbol_ratio:0.412", "chunk_text": "قِيلَ لَهُمْ عَنْ هَذَا أَجْوِبَةٌ: أَحَدُهَا: أَنَّهُ فِي الْكُتُبِ الْمُتَقَدِّمَةِ مِمَّا يُظَنُّ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_853", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَكُلُّ كِتَابٍ لَيْسَ مِنْ عِنْدِ اللَّهِ لَا بُدَّ أَنْ يَكُونَ فِيهِ تَنَاقُضٌ، وَمَا كَانَ مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_854", "reason": "high_symbol_ratio:0.402", "chunk_text": "الرَّابِعُ: أَنَّا نُبَيِّنُ أَنَّ مَا فِيهِ مِنْ عُمُومِ رِسَالَتِهِ لَا يُنَافِي مَا فِيهِ مِنْ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_855", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالنَّاسُ كُلُّهُمْ مُتَّفِقُونَ عَلَى أَنَّ التَّخْصِيصَ بِالذِّكْرِ مَتَى كَانَ لَهُ سَبَبٌ يُوجِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_856", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَإِنَّهُ نَهَاهُمْ عَنْ ذَلِكَ؛ لِأَنَّهُ هُوَ الَّذِي كَانُوا يَفْعَلُونَهُ، وَقَدْ حَرَّمَ فِي مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_857", "reason": "high_symbol_ratio:0.427", "chunk_text": "الْخَامِسُ: أَنَّهُ فِي ذَلِكَ أُسْوَةٌ بِالْمَسِيحِ فَإِنَّ الْمَسِيحَ خَصَّ أَوَّلًا بِالدَّعْوَةِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_858", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَالَ أَيْضًا فِي الْإِنْجِيلِ: مَا بُعِثْتُ إِلَّا لِهَذَا الشَّعْبِ الْخَبِيثِ. ثُمَّ عَمَّ، فَق"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_859", "reason": "high_symbol_ratio:0.449", "chunk_text": "وَقَالَ: أَرْسَلَنِي أَبِي، وَأَنَا أُرْسِلُكُمْ."}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_861", "reason": "high_symbol_ratio:0.420", "chunk_text": "مُحَمَّدًا ، كَمَا بَعَثَ الْمَسِيحَ وَغَيْرَهُ، وَإِنْ كَانَتْ رِسَالَتُهُ أَكْمَلَ وَأَشْمَلَ كَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_862", "reason": "high_symbol_ratio:0.430", "chunk_text": "أَيْ مَنْ بَلَغَهُ الْقُرْآنُ فَكُلُّ مَنْ بَلَغَهُ الْقُرْآنُ فَقَدْ أَنْذَرَهُ مُحَمَّدٌ . وَنُبَي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_863", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَلَمَّا أَنْزَلَ اللَّهُ عَلَيْهِ هَذِهِ الْآيَةَ انْطَلَقَ إِلَى مَكَانٍ عَالٍ فَعَلَا عَلَيْهِ، ث"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_864", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَهَذِهِ الْقِصَّةُ رَوَاهَا ابْنُ عَبَّاسٍ وَأَبُو هُرَيْرَةَ وَعَائِشَةُ وَغَيْرُهُمْ فِي الصَّحِي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_865", "reason": "high_symbol_ratio:0.430", "chunk_text": "قَالَ ابْنُ عَبَّاسٍ: لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ: وَأَنْذِرْ عَشِيرَتَكَ الْأَقْرَبِينَ."}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_866", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَرَهْطَكَ مِنْهُمُ الْمُخْلَصِينَ، خَرَجَ رَسُولُ اللَّهِ حَتَّى صَعِدَ الصَّفَا، فَجَعَلَ يُنَادِي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_867", "reason": "high_symbol_ratio:0.428", "chunk_text": "قَالَ: فَإِنِّي نَذِيرٌ لَكُمْ بَيْنَ يَدَيْ عَذَابٍ شَدِيدٍ. وَقَالَ أَبُو هُرَيْرَةَ: لَمَّا نَزَل"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_868", "reason": "high_symbol_ratio:0.406", "chunk_text": "دَعَا رَسُولُ اللَّهِ قُرَيْشًا، فَاجْتَمَعُوا، فَعَمَّ وَخَصَّ، فَقَالَ: يَا بَنِي كَعْبِ بْنِ لُؤَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_869", "reason": "high_symbol_ratio:0.426", "chunk_text": "غَيْرَ أَنَّ لَكُمْ رَحِمًا سَأَبُلُّهَا بِبَلَالِهَا. وَقَالَتْ عَائِشَةُ رَضِيَ اللَّهُ عَنْهَا لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_870", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَامَ رَسُولُ اللَّهِ عَلَى الصَّفَا، فَقَالَ: يَا فَاطِمَةُ بِنْتَ مُحَمَّدٍ، يَا صَفِيَّةُ عَمَّةَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_871", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ ابْنُ إِسْحَاقَ: لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ جَعَلَ النَّبِيُّ يُنَادِي: يَا بَنِي عَبْد"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_872", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ فِي جِيدِهَا حَبْلٌ مِنْ مَسَدٍ. وَدَعَا قُرَيْشًا إِلَى اللَّهِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_873", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَقَدْ أَنْزَلَ اللَّهُ عَلَيْهِ فِي غَيْرِ مَوْضِعٍ أَمْرَ جَمِيعِ الْخَلْقِ بِعِبَادَتِهِ، كَقَوْل"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_874", "reason": "high_symbol_ratio:0.443", "chunk_text": "وَقَوْلِهِ: وَمَا خَلَقْتُ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُونِ. وَقُرَيْشٌ هُمْ قَوْمُهُ الَّذ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_875", "reason": "high_symbol_ratio:0.419", "chunk_text": "كَمَا أَنَّ جُمْهُورَ بَنِي إِسْرَائِيلَ وَهُمْ قَوْمُ الْمَسِيحِ كَذَّبُوهُ أَوَّلًا."}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_876", "reason": "high_symbol_ratio:0.408", "chunk_text": "ثُمَّ أَمَرَهُ اللَّهُ تَعَالَى أَنْ يَدْعُوَ سَائِرَ الْعَرَبِ، فَكَانَ يَخْرُجُ بِنَفْسِهِ وَمَعَه"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_877", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْأَنْدَادِ، وَأَنْ تُؤْمِنُوا بِي وَتُصَدِّقُونِي وَتَمْنَعُونِي؛ حَتَّى أُبَيِّنَ عَنِ اللَّهِ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_878", "reason": "high_symbol_ratio:0.430", "chunk_text": "أَمْرَكَ هَذَا لَعَجَبٌ. وَمَا زَالَ رَسُولُ اللَّهِ يُعْلِنُ دَعْوَتَهُ، وَيُظْهِرُ رِسَالَتَهُ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_879", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَلَمَّا اشْتَدَّ عَلَيْهِ أَمْرُ قُرَيْشٍ خَرَجَ إِلَى الطَّائِفِ وَهِيَ مَدِينَةٌ مَعْرُوفَةٌ شَرْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_880", "reason": "high_symbol_ratio:0.423", "chunk_text": "إِلَى ظِلِّ كَرْمَةٍ فِي حَائِطٍ لِعُتْبَةَ وَشَيْبَةَ ابْنَيْ رَبِيعَةَ فَرَجَعَ عَنْهُ مَا كَانَ ت"}
