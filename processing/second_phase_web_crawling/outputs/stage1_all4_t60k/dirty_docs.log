{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_197", "reason": "high_symbol_ratio:0.411", "chunk_text": "النَّوْعُ الْخَامِسُ : مَا يَشْتَمِلُ عَلَى الْحَقَّيْنِ وَيَغْلِبُ عَلَيْهِ حَقُّ الْعِبَادِ كَالزَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_198", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَأَمَّا الْأَمْوَالُ فَحَقُّ اللَّهِ - تَعَالَى - فِيهَا تَابِعٌ لِحُقُوقِ الْعِبَادِ بِدَلِيلِ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_200", "reason": "high_symbol_ratio:0.405", "chunk_text": "النَّوْعُ الثَّانِي : مَا يَكُونُ مَصْلَحَةً عِوَضِيَّةً آجِلَةً كَالِاسْتِئْجَارِ لِلْحَجِّ وَالْعُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_201", "reason": "high_symbol_ratio:0.401", "chunk_text": "النَّوْعُ الثَّالِثُ : مَا تَكُونُ إحْدَى مَصْلَحَتَيْهِ عَاجِلَةً وَالثَّانِيَةُ آجِلَةً كَالْقَرْض"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_202", "reason": "high_symbol_ratio:0.406", "chunk_text": "النَّوْعُ الرَّابِعُ : مَا تَكُونُ إحْدَى مَصْلَحَتَيْهِ عَاجِلَةً وَالْأُخْرَى يَتَخَيَّرُ بَاذِلُه"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_203", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَأَمَّا الْآجِلَةُ ، فَإِنْ ضَمِنَ ذَلِكَ بِعِوَضٍ كَانَ كَالْقَرْضِ ، وَإِنْ ضَمِنَهُ مَجَّانًا أُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_206", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَمِنْ ذَلِكَ الْمُسَامَحَةُ بِبَعْضِ الْأَعْوَاضِ ، مَصْلَحَتُهَا الْعَاجِلَةُ لِلْمُسَامِحِ الْقَا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_207", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَأَمَّا الْوِلَايَاتُ ، فَإِنْ كَانَتْ فِي إحْدَى الصَّلَوَاتِ الْمَكْتُوبَاتِ فَمَصْلَحَتُهَا الْآ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_210", "reason": "high_symbol_ratio:0.408", "chunk_text": "أَحَدُهُمَا : أَنْ يَكُونَ الْحَجْرُ لِمَصْلَحَةِ الْمَحْجُورِ عَلَيْهِ كَالْحَجْرِ عَلَى السُّفَهَا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_211", "reason": "high_symbol_ratio:0.415", "chunk_text": "الضَّرْبُ الثَّانِي : أَنْ يَكُونَ الْحَجْرُ لِمَصْلَحَةِ غَيْرِ الْمَحْجُورِ عَلَيْهِ كَحَجْرِ الرِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_212", "reason": "high_symbol_ratio:0.424", "chunk_text": "أَمَّا حَجْرُ الرِّقِّ فَمَصْلَحَتُهُ الْعَاجِلَةُ لِلسَّادَاتِ ، وَالْعَبْدُ إذَا أَدَّى حَقَّ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_213", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَأَمَّا حَجْرُ الْفَلَسِ فَمَصْلَحَتُهُ الْعَاجِلَةُ لِلْغُرَمَاءِ وَمَصْلَحَتُهُ الْآجِلَةُ لِلْحَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_215", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْحُكْمُ كَالشَّهَادَةِ فِي ذَلِكَ ، وَكَذَلِكَ تَصَرُّفُ الْإِمَامِ إنْ تَصَرَّفَ فِي حُقُوقِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_216", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَأَمَّا الِالْتِقَاطُ ، فَمَصْلَحَتُهُ الْعَاجِلَةُ لِلَّقِيطِ وَمَصْلَحَتُهُ الْآجِلَةُ لِلْمُلْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_218", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْإِنْسَانُ مُكَلَّفٌ بِعِبَادَةِ الدَّيَّانِ بِاكْتِسَابٍ فِي الْقُلُوبِ وَالْحَوَاسِّ وَالْأَرْكَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_219", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَالتَّصَرُّفَاتُ أَنْوَاعٌ : نَقْلٌ ، وَإِسْقَاطٌ وَقَبْضٌ ، وَإِذْنٌ وَرَهْنٌ ، وَخَلْطٌ وَتَمَلُّ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_220", "reason": "high_symbol_ratio:0.421", "chunk_text": "الْبَابُ الْأَوَّلُ فِي نَقْلِ الْحَقِّ مِنْ مُسْتَحِقٍّ إلَى مُسْتَحِقٍّ . وَهُوَ ضَرْبَانِ : الضَّ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_223", "reason": "high_symbol_ratio:0.409", "chunk_text": "النَّوْعُ الثَّانِي : الْإِجَارَةُ وَهِيَ بَيْعُ الْمَنَافِعِ بِعَيْنٍ أَوْ دَيْنٍ أَوْ مَنَافِعَ ، "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_225", "reason": "high_symbol_ratio:0.405", "chunk_text": "النَّوْعُ الرَّابِعُ : الْقَرْضُ وَهُوَ تَعَاقُدٌ عَلَى الْإِجَارَةِ بِجُزْءٍ شَائِعٍ مِنْ الْأَرْبَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_227", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالْحَوَالَةُ مُرَكَّبَةٌ مِنْ بَيْعٍ وَقَبْضٍ ، وَالصُّلْحُ بَيْعٌ أَوْ إجَارَةٌ أَوْ إبْرَاءٌ أَو"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_228", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَأَمَّا الْفُسُوخُ فَهِيَ تَرَادٌّ بَيْنَ الْعِوَضَيْنِ أَوْ رَدٌّ فِي أَحَدِهِمَا فِي مُقَابَلَةِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_229", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَكَذَلِكَ مَا سَرَقَهُ الْمُسْلِمُونَ مِنْ أَمْوَالِ أَهْلِ الْحَرْبِ ، فَإِنَّ الْمِلْكَ يَنْتَقِل"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_230", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَكَذَلِكَ الْأَخْذُ بِالشُّفْعَةِ نَاقِلٌ لِلْمِلْكِ مِنْ الْمُحَابِينَ . وَأَمَّا الْوَقْفُ عَلَى "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_232", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَهِيَ ضَرْبَانِ أَحَدُهُمَا : إسْقَاطٌ بِغَيْرِ عِوَضٍ فَمِنْهُ الْإِبْرَاءُ الَّذِي يُسْقِطُ الدَّ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_233", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقْفُ الْمَسَاجِدِ يُسْقِطُ مِلْكَهَا وَلَا يَنْقُلُهُ ."}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_234", "reason": "high_symbol_ratio:0.405", "chunk_text": "الضَّرْبُ الثَّانِي : الْإِسْقَاطُ بِالْأَعْوَاضِ كَإِسْقَاطِ حَقِّ الزَّوْجِ مِنْ الْبُضْعِ بِالْخُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_236", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهُوَ ثَلَاثَةُ أَضْرُبٍ أَحَدُهَا : قَبْضٌ بِمُجَرَّدِ إذْنِ الشَّرْعِ دُونَ إذْنِ الْمُسْتَحِقِّ "}
