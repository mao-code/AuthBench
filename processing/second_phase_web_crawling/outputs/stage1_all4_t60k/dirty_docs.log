{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_342", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَهَذِهِ الْآيَةُ نَزَلَتْ سَنَةَ سِتٍّ عَامَ الْحُدَيْبِيَةِ، لَمَّا صَدَّ الْمُشْرِكُونَ رَسُولَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_343", "reason": "high_symbol_ratio:0.408", "chunk_text": "تِسْعٍ غَزَا النَّصَارَى إِلَى تَبُوكَ، وَفِيهَا حَجَّ أَبُو بَكْرٍ الصِّدِّيقُ رَضِيَ اللَّهُ عَنْه"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_344", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَأَرْدَفَهُ بِعَلِيِّ بْنِ أَبِي طَالِبٍ رَضِيَ اللَّهُ عَنْهُ لِنَبْذِ الْعُهُودِ، وَأَنْزَلَ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_345", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَهَذِهِ الْأَشْهُرُ عِنْدَ جُمْهُورِ الْعُلَمَاءِ هِيَ الْمَذْكُورَةُ فِي قَوْلِهِ تَعَالَى: فَسِيح"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_346", "reason": "high_symbol_ratio:0.428", "chunk_text": "فَإِنَّ الْمُشْرِكِينَ كَانُوا عَلَى نَوْعَيْنِ: نَوْعًا لَهُمْ عَهْدٌ مُطْلَقٌ غَيْرُ مُؤَقَّتٍ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_347", "reason": "high_symbol_ratio:0.436", "chunk_text": "إِلَّا مُؤَقَّتَةً، وَذَهَبَ بَعْضُهُمْ إِلَى أَنَّهُ يَجُوزُ لِلْإِمَامِ أَنْ يَفْسَخَ الْهُدْنَةَ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_348", "reason": "high_symbol_ratio:0.446", "chunk_text": "فَأَمَّا الْمُطْلَقَةُ فَجَائِزَةٌ غَيْرُ لَازِمَةٍ، يُخَيَّرُ بَيْنَ إِمْضَائِهَا وَبَيْنَ نَقْضِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_349", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ تَعَالَى: بَرَاءَةٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_350", "reason": "high_symbol_ratio:0.410", "chunk_text": "يَنْقُصُوكُمْ شَيْئًا وَلَمْ يُظَاهِرُوا عَلَيْكُمْ أَحَدًا فَأَتِمُّوا إِلَيْهِمْ عَهْدَهُمْ إِلَى "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_351", "reason": "high_symbol_ratio:0.402", "chunk_text": "يَعْلَمُونَكَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِنْدَ اللَّهِ وَعِنْدَ رَسُولِهِ إِلَّا الَّذِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_352", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْمُعْتَدُونَ فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَإِخْوَانُكُمْ فِي الدِّين"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_353", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمَقْصُودُ هُنَا ذِكْرُ قُدُومِ وَفْدِ نَجْرَانَ النَّصَارَى: السَّيِّدِ وَالْعَاقِبِ وَمَنْ مَع"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_354", "reason": "high_symbol_ratio:0.404", "chunk_text": "قَالَ أَبُو الْفَرَجِ بْنُ الْجَوْزِيِّ: ثُمَّ دَخَلَتْ سَنَةُ عَشْرٍ مِنَ الْهِجْرَةِ فَمِنَ الْحَو"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_355", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَدِمَ وَفْدُ عَبْدِ الْقَيْسِ، قَالَ ابْنُ إِسْحَاقَ: قَدِمَ عَلَى رَسُولِ اللَّهِ الْجَارُودُ بْنُ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_356", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَذَكَرَ مُحَمَّدُ بْنُ سَعْدٍ فِي الطَّبَقَاتِ قُدُومَهُمْ فِي الْوُفُودِ فَقَالَ: ذِكْرُ بَعْثِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_357", "reason": "high_symbol_ratio:0.418", "chunk_text": "يَزِيدَ بْنِ رُومَانَ، وَمُحَمَّدِ بْنِ كَعْبٍ قَالَ: وَأَنَا عَلِيُّ بْنُ مُجَاهِدٍ، عَنْ مُحَمَّدِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_358", "reason": "high_symbol_ratio:0.423", "chunk_text": "آمَنَّا بِاللَّهِ وَرَسُولِهِ فَاكْتُبْ لَنَا كِتَابًا. وَذَكَرُوا الْقِصَّةَ، وَقُدُومَ وُفُودٍ مُت"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_359", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالُوا: وَقَدِمَ وَفْدُ نَجْرَانَ وَكَتَبَ رَسُولُ اللَّهِ إِلَى أَهْلِ نَجْرَانَ، فَخَرَجَ إِلَيْه"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_360", "reason": "high_symbol_ratio:0.429", "chunk_text": "الْمَسْجِدِ نَحْوَ الْمَشْرِقِ، فَقَالَ رَسُولُ اللَّهِ : دَعُوهُمْ، ثُمَّ أَتَوُا النَّبِيَّ فَأَعْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_361", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَانْصَرَفُوا عَلَى ذَلِكَ، فَغَدَا عَبْدُ الْمَسِيحِ وَرَجُلَانِ مِنْ ذَوِي رَأْيِهِمْ عَلَى رَسُول"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_362", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَصَالَحَهُمْ عَلَى أَلْفَيْ حُلَّةٍ فِي رَجَبٍ، وَأَلْفٍ فِي صَفَرٍ، أَوْ قِيمَةِ كُلِّ حُلَّةٍ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_363", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَلِنَجْرَانَ وَحَاشِيَتِهِمْ جِوَارُ اللَّهِ وَذِمَّةُ مُحَمَّدٍ رَسُولِ اللَّهِ عَلَى أَنْفُسِهِمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_364", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَأَنْزَلَهُمَا دَارَ أَبِي أَيُّوبَ الْأَنْصَارِيِّ، وَأَقَامَ أَهْلُ نَجْرَانَ عَلَى مَا كَتَبَ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_365", "reason": "high_symbol_ratio:0.415", "chunk_text": "ثُمَّ وُلِّيَ أَبُو بَكْرٍ الصِّدِّيقُ رَضِيَ اللَّهُ عَنْهُ فَكَتَبَ بِالْوَصَاةِ بِهِمْ عِنْدَ وَف"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_366", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَهُوَ لَهُمْ صَدَقَةٌ، وَعَقَبَةٌ لَهُمْ فَكَانَ أَرْضُهُمْ لَا سَبِيلَ عَلَيْهِمْ فِيهِ لِأَحَدٍ و"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_367", "reason": "high_symbol_ratio:0.430", "chunk_text": "أَمَّا بَعْدُ فَمَنْ حَضَرَهُمْ مِنْ رَجُلٍ مُسْلِمٍ فَلْيَنْصُرْهُمْ عَلَى مَنْ ظَلَمَهُمْ؛ فَإِنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_368", "reason": "high_symbol_ratio:0.419", "chunk_text": "شَهِدَ عُثْمَانُ بْنُ عَفَّانَ رَضِيَ اللَّهُ عَنْهُ، وَمُعَيْقِيبُ بْنُ أَبِي فَاطِمَةَ، فَوَقَعَ ن"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_369", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمَا ذَكَرَهُ ابْنُ سَعْدٍ، عَنْ عَلِيِّ بْنِ مُحَمَّدٍ الْمَدَائِنِيِّ، عَنْ أَشْيَاخِهِ فِي حَدِي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_370", "reason": "high_symbol_ratio:0.427", "chunk_text": "عَنْ رَأْيِهِ وَاسْمُهُ عَبْدُ الْمَسِيحِ وَالسَّيِّدُ ثَمَّالُهُمْ، وَصَاحِبُ رَحْلِهِمْ وَنَجْعَتِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_371", "reason": "high_symbol_ratio:0.420", "chunk_text": "فِي دِينِهِمْ، فَلَمَّا وَجَّهُوا إِلَى رَسُولِ اللَّهِ مِنْ نَجْرَانَ جَلَسَ أَبُو حَارِثَةَ عَلَى "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_372", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَأَكْرَمُونَا، وَقَدْ أَبَوْا إِلَّا خِلَافَهُ، فَلَوْ فَعَلْتُ نَزَعُوا مِنَّا كُلَّ مَا تَرَى فَأ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_373", "reason": "high_symbol_ratio:0.409", "chunk_text": "قَالَ ابْنُ هِشَامٍ: وَبَلَغَنِي أَنَّ رُؤَسَاءَ نَجْرَانَ كَانُوا يَتَوَارَثُونَ كِتَابًا عِنْدَهُم"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_374", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَلَمَّا مَاتَ لَمْ تَكُنْ لِابْنِهِ هِمَّةٌ إِلَّا أَنْ شَدَّ فَكَسَرَ الْخَوَاتِمَ، فَوَجَدَ فِيهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_375", "reason": "high_symbol_ratio:0.419", "chunk_text": "يَقُولُ بَعْضُ مَنْ رَآهُمْ مِنْ أَصْحَابِ النَّبِيِّ يَوْمَئِذٍ: مَا رَأَيْنَا بَعْدَهُمْ وَفْدًا م"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_376", "reason": "high_symbol_ratio:0.434", "chunk_text": "قَالَ ابْنُ إِسْحَاقَ: وَكَانَ تَسْمِيَةُ الْأَرْبَعَةَ عَشَرَ الَّذِينَ يَئُولُ إِلَيْهِمْ أَمْرُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_377", "reason": "high_symbol_ratio:0.423", "chunk_text": "اخْتِلَافِهِمْ مِنْ أَمْرِهِمْ يَقُولُونَ هُوَ اللَّهُ، وَيَقُولُونَ هُوَ وَلَدُ اللَّهِ، وَيَقُولُو"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_378", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَهُمْ يَحْتَجُّونَ فِي قَوْلِهِمْ: هُوَ اللَّهُ، بِأَنَّهُ كَانَ يُحْيِي الْمَوْتَى، وَيُبْرِئُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_379", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَيَحْتَجُّونَ فِي قَوْلِهِمْ: إِنَّهُ وَلَدُ اللَّهِ، فَإِنَّهُمْ يَقُولُونَ لَمْ يَكُنْ لَهُ أَبٌ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_380", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَيَحْتَجُّونَ فِي قَوْلِهِمْ: ثَالِثُ ثَلَاثَةٍ، بِقَوْلِ اللَّهِ: فَعَلِمْنَا، وَأَمَرْنَا، وَخَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_381", "reason": "high_symbol_ratio:0.421", "chunk_text": "قَالَ: إِنَّكُمَا لَمْ تُسْلِمَا فَأَسْلِمَا، قَالَا: بَلَى، قَدْ أَسْلَمْنَا قَبْلَكَ. قَالَ: كَذَب"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_382", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَذَكَرَ نُزُولَ الْآيَاتِ بِسَبَبِهِمْ غَيْرُ وَاحِدٍ مِثْلَمَا ذَكَرَهُ مُحَمَّدُ بْنُ جَرِيرٍ الط"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_383", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ: إِنَّ النَّصَارَى أَتَوْا رَسُولَ اللَّهِ ، فَخَاصَمُوهُ فِي عِيسَى ابْنِ مَرْيَمَ، وَقَالُوا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_384", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: أَلَسْتُمْ تَعْلَمُونَ أَنَّ رَبَّنَا حَيٌّ لَا يَمُوتُ وَأَنَّ عِيسَى يَأْتِي عَلَيْهِ الْفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_385", "reason": "high_symbol_ratio:0.457", "chunk_text": "قَالَ: أَلَسْتُمْ تَعْلَمُونَ أَنَّ رَبَّنَا قَيِّمٌّ عَلَى كُلِّ شَيْءٍ يَكْلَؤُهُ وَيَحْفَظُهُ وَي"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_386", "reason": "high_symbol_ratio:0.402", "chunk_text": "قَالَ: فَهَلْ يَمْلِكُ عِيسَى مِنْ ذَلِكَ شَيْئًا؟ قَالُوا: لَا. قَالَ: أَلَسْتُمْ تَعْلَمُونَ أَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_387", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: فَهَلْ يَعْلَمُ عِيسَى مِنْ ذَلِكَ شَيْئًا إِلَّا مَا عُلِّمَ؟، قَالُوا: لَا. قَالَ: فَإِنَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_388", "reason": "high_symbol_ratio:0.435", "chunk_text": "قَالَ: أَلَسْتُمْ تَعْلَمُونَ أَنَّ عِيسَى حَمَلَتْهُ أُمُّهُ كَمَا تَحْمِلُ الْمَرْأَةُ، ثُمَّ وَضَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_389", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَ: فَكَيْفَ يَكُونُ هَذَا كَمَا زَعَمْتُمْ؟. قَالَ: فَعَرَفُوا ثُمَّ أَبَوْا إِلَّا الْجُحُودَ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_390", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَدْ ثَبَتَ فِي الصِّحَاحِ حَدِيثُ وَفْدِ نَجْرَانَ فَفِي الْبُخَارِيِّ وَمُسْلِمٍ عَنْ حُذَيْفَةَ"}
