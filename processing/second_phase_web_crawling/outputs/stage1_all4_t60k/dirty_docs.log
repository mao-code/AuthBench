{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1043", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَفِي ذَلِكَ حِكَمٌ أُخْرَى، وَمِثْلُ ذَلِكَ كَثِيرٌ فِي كَلَامِ اللَّهِ عَزَّ وَجَلَّ وَغَيْرِ كَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1044", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَإِنَّ هَؤُلَاءِ كَانُوا أَوَّلَ الْمُنْذَرِينَ، وَأَحَقَّهُمْ بِالْإِنْذَارِ، فَكَانَ فِي تَخْصِيص"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1045", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَ تَعَالَى: نَزَلَ بِهِ الرُّوحُ الْأَمِينُ عَلَى قَلْبِكَ لِتَكُونَ مِنَ الْمُنْذِرِينَ بِلِس"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1046", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَمَعْلُومٌ أَنَّهُ نَزَلَ بِهِ لِيَكُونَ بَشِيرًا، وَلِيَأْمُرَ بِالْمَعْرُوفِ، وَيَنْهَى عَنِ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1048", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَوْلِهِ تَعَالَى: لَقَدْ مَنَّ اللَّهُ عَلَى الْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِنْ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1049", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَهَذَا كَقَوْلِهِ تَعَالَى: لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1050", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَهَذَا فِي عُمُومِهِ نِزَاعٌ، فَإِنَّهُ إِمَّا أَنْ يَكُونَ خِطَابًا لِجَمِيعِ النَّاسِ، وَيَكُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1051", "reason": "high_symbol_ratio:0.410", "chunk_text": "قَالَ تَعَالَى: وَقَالُوا لَوْلَا أُنْزِلَ عَلَيْهِ مَلَكٌ وَلَوْ أَنْزَلْنَا مَلَكًا لَقُضِيَ الْأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1052", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَإِمَّا أَنْ يَكُونَ الْخِطَابُ لِلْعَرَبِ، وَعَلَى التَّقْدِيرَيْنِ فَإِنَّ مَا تَضَمَّنَ ذِكْرَ إ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1055", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَالَ: قُلْ أُوحِيَ إِلَيَّ أَنَّهُ اسْتَمَعَ نَفَرٌ مِنَ الْجِنِّ فَقَالُوا إِنَّا سَمِعْنَا قُرْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1056", "reason": "high_symbol_ratio:0.404", "chunk_text": "لَمَسْنَا السَّمَاءَ فَوَجَدْنَاهَا مُلِئَتْ حَرَسًا شَدِيدًا وَشُهُبًا وَأَنَّا كُنَّا نَقْعُدُ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1057", "reason": "high_symbol_ratio:0.402", "chunk_text": "الْمُسْلِمُونَ وَمِنَّا الْقَاسِطُونَ فَمَنْ أَسْلَمَ فَأُولَئِكَ تَحَرَّوْا رَشَدًا وَأَمَّا الْقَا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1058", "reason": "high_symbol_ratio:0.401", "chunk_text": "لَنْ يُجِيرَنِي مِنَ اللَّهِ أَحَدٌ وَلَنْ أَجِدَ مِنْ دُونِهِ مُلْتَحَدًا إِلَّا بَلَاغًا مِنَ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1059", "reason": "high_symbol_ratio:0.444", "chunk_text": "رَبِّهِمْ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَى كُلَّ شَيْءٍ عَدَدًا. وَنَظِيرُ هَذَا قَوْلُهُ: وَإِن"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1060", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَوْمُهُ قُرَيْشٌ، وَلَا يَمْنَعُ أَنَّهُ ذِكْرٌ لِسَائِرِ الْعَرَبِ بَلْ لِسَائِرِ النَّاسِ، كَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1061", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَالَ تَعَالَى: تَبَارَكَ الَّذِي نَزَّلَ الْفُرْقَانَ عَلَى عَبْدِهِ لِيَكُونَ لِلْعَالَمِينَ نَذ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1062", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ تَعَالَى: قُلْ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ وَمَا أَنَا مِنَ الْمُتَكَلِّفِينَ إِنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1063", "reason": "high_symbol_ratio:0.428", "chunk_text": "اللَّهُ رَبُّ الْعَالَمِينَ. وَقَالَ تَعَالَى: وَأَرْسَلْنَاكَ لِلنَّاسِ رَسُولًا وَكَفَى بِاللَّهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1064", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَقِيلَ: أَنَّ الْمُرَادَ أَنَّهُ شَرَفٌ لَهُمْ وَلَيْسَ بِشَيْءٍ، فَإِنَّ الْقُرْآنَ هُوَ شَرَفٌ لِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1065", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَقَالَ تَعَالَى: وَكَذَّبَ بِهِ قَوْمُكَ وَهُوَ الْحَقُّ. بِخِلَافِ كَوْنِهِ تَذْكِرَةً وَذِكْرَى؛ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1066", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَعَمَّ الْعَالَمِينَ جَمِيعَهُمْ، فَقَالَ: وَمَا تَسْأَلُهُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ هُوَ إِلَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1067", "reason": "high_symbol_ratio:0.412", "chunk_text": "فصل هَذَا الْكَلَامُ عَلَى الْوَجْهِ الْأَوَّلِ، وَهُوَ قَوْلُ مَنْ يَقُولُ أَنَّهُ لَمْ يَقُلْ أَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1068", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَّا الْوَجْهُ الثَّانِي: وَهُوَ أَنْ نَقُولَ: هُوَ ذَكَرَ أَنَّهُ رَسُولٌ إِلَى النَّاسِ كَافَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1069", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَوْلِهِ: يَا أَيُّهَا النَّاسُ إِنِّي رَسُولُ اللَّهِ إِلَيْكُمْ جَمِيعًا الَّذِي لَهُ مُلْكُ الس"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1070", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَقَدْ صَرَّحَ فِيهِ بِدَعْوَةِ أَهْلِ الْكِتَابِ وَبِدَعْوَةِ الْجِنِّ فِي غَيْرِ مَوْضِعٍ، فَإِذَا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1071", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَإِنْ أَقَرُّوا بِأَنَّهُ رَسُولٌ أَرْسَلَهُ اللَّهُ، لَمْ يُمْكِنْ مَعَ ذَلِكَ تَكْذِيبُهُ كَمَا ت"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1073", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَأَيْضًا فَإِنَّ مَقْصُودَ الرِّسَالَةِ تَبْلِيغُ رِسَالَاتِ اللَّهِ عَلَى وَجْهِهَا، فَإِذَا خُلِط"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1074", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَأَيْضًا فَإِذَا عُلِمَ أَنَّهُ كَذَبَ فِي بَعْضِهَا لَمْ يَتَمَيَّزْ مَا صَدَقَ فِيهِ مِمَّا كَذَب"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1075", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَلِهَذَا أَجْمَعَ أَهْلُ الْمِلَلِ قَاطِبَةً عَلَى أَنَّ الرُّسُلَ مَعْصُومُونَ فِيمَا يُبَلِّغُونَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1076", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَالَ تَعَالَى: أَمْ يَقُولُونَ افْتَرَى عَلَى اللَّهِ كَذِبًا فَإِنْ يَشَأِ اللَّهُ يَخْتِمْ عَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1077", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَقَوْلُهُ تَعَالَى: وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ كَلَامٌ مُسْتَأْنَفٌ، لَيْسَ دَا"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1078", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَلَمَّا قَالَ وَيُحِقُّ الْحَقَّ بِالضَّمِّ دَلَّ عَلَى أَنَّهُ جُمْلَةٌ مُسْتَأْنَفَةٌ أَخْبَرَ فِ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1079", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَالَ تَعَالَى فِي صِيَانَتِهِ وَإِحْكَامِهِ لِمَا تُبَلِّغُهُ رُسُلُهُ: وَمَا أَرْسَلْنَا مِنْ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1080", "reason": "high_symbol_ratio:0.412", "chunk_text": "اللَّهَ لَهَادِ الَّذِينَ آمَنُوا إِلَى صِرَاطٍ مُسْتَقِيمٍ. وَأَيْضًا فَإِذَا لَمْ يَكُنْ أُرْسِلَ "}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1081", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَالْإِقْرَارُ بِرِسَالَتِهِ إِلَى الْعَرَبِ دُونَ غَيْرِهِمْ - مَعَ مَا ظَهَرَ مِنْ عُمُومِ دَعْوَت"}
{"source": "wikisource", "raw_id": "arwikisource:40438:284943#chunk_1082", "reason": "high_symbol_ratio:0.416", "chunk_text": "كَاذِبٌ فِي ذَلِكَ، وَمَعْلُومٌ أَنَّ كُلَّ مَا دَلَّ عَلَى أَنَّ اللَّهَ أَرْسَلَهُ فَإِنَّهُ يَدُل"}
{"source": "wikisource", "raw_id": "arwikisource:4197:281028#chunk_0", "reason": "high_symbol_ratio:0.408", "chunk_text": "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ قَالَ أَخْبَرَنَا مَالِكٌ عَنْ هِشَامِ بْنِ عُرْوَةَ عَنْ أَب"}
{"source": "wikisource", "raw_id": "ruwikisource:35107:5566460", "reason": "low_unique_ratio:0.137", "chunk_text": "* Книга первая (Α) ** Глава первая ** Глава вторая ** Глава третья ** Глава четвертая ** Глава пятая"}
{"source": "wikisource", "raw_id": "arwikisource:35924:495324#chunk_201", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَضَرَبَ لَنا مَثَلًا وَنَسِيَ خَلْقَهُ قالَ مَنْ يُحْيِ الْعِظامَ وَهِيَ رَمِيمٌ، قُلْ يُحْيِيهَا ا"}
{"source": "wikisource", "raw_id": "arwikisource:35924:495324#chunk_617", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَمْ خَلَقْنَا الْمَلائِكَةَ إِناثًا وَهُمْ شاهِدُونَ. أَلا إِنَّهُمْ مِنْ إِفْكِهِمْ لَيَقُولُونَ. "}
{"source": "wikisource", "raw_id": "arwikisource:24430:85073#chunk_71", "reason": "high_symbol_ratio:0.415", "chunk_text": "{ بَلْ عِبَادٌ مُكْرَمُونَ. لا يَسْبِقُونَهُ بِالْقَوْلِ وَهُمْ بِأَمْرِهِ يَعْمَلُونَ } . { يُسَبِّ"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_5", "reason": "high_symbol_ratio:0.409", "chunk_text": "== الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَلَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُنْ لَهُ شَرِيكٌ"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_23", "reason": "high_symbol_ratio:0.401", "chunk_text": "خَرَجَ عَنْ الْحَقّ وَطَرِيق الْهُدَى فَإِنَّهُ ضَالّ حَيْثُمَا تَوَجَّهَ لِأَنَّ الْحَقّ وَاحِد وَم"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_52", "reason": "high_symbol_ratio:0.401", "chunk_text": "غَيّ وَمَنْ مَالَ مَيْله مَثْبُور == فَقَدْ كَذَّبُوكُمْ بِمَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْف"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_54", "reason": "high_symbol_ratio:0.408", "chunk_text": "== وَمَا أَرْسَلْنَا قَبْلَكَ مِنَ الْمُرْسَلِينَ إِلَّا إِنَّهُمْ لَيَأْكُلُونَ الطَّعَامَ وَيَمْشُ"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_106", "reason": "high_symbol_ratio:0.404", "chunk_text": "== وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا مِنَ الْمُجْرِمِينَ وَكَفَى بِرَبِّكَ هَادِيًا وَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_108", "reason": "high_symbol_ratio:0.401", "chunk_text": "== وَقَالَ الَّذِينَ كَفَرُوا لَوْلَا نُزِّلَ عَلَيْهِ الْقُرْآَنُ جُمْلَةً وَاحِدَةً كَذَلِكَ لِنُث"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_126", "reason": "high_symbol_ratio:0.404", "chunk_text": "== وَكُلًّا ضَرَبْنَا لَهُ الْأَمْثَالَ وَكُلًّا تَبَّرْنَا تَتْبِيرًا (39) == وَكُلًّا ضَرَبْنَا لَ"}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_131", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَقَبَّحَهُمْ اللَّه كَمَا قَالَ \" وَلَقَدْ اُسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلك \" الْآيَة ."}
{"source": "wikisource", "raw_id": "arwikisource:35693:251340#chunk_136", "reason": "high_symbol_ratio:0.401", "chunk_text": "== أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ إِنْ هُمْ إِلَّا كَالْأَنْعَامِ بَل"}
