{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_34", "reason": "high_symbol_ratio:0.426", "chunk_text": "====غرف==== الْغُرْفَةُ بِالضَّمِّ الْمَاءُ الْمَغْرُوفُ بِالْيَدِ وَالْجَمْعُ غِرَافٌ مِثْلُ بُرْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_35", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْمِغْرَفَةُ بِكَسْرِ الْمِيمِ مَا يُغْرَفُ بِهِ الطَّعَامُ وَالْجَمْعُ مَغَارِفُ."}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_37", "reason": "high_symbol_ratio:0.410", "chunk_text": "يُتَصَوَّرُ سَلَامَتُهُ وَجَمْعُ الْغَرِيقِ غَرْقَى مِثْلُ قَتِيلٍ وَقَتْلَى وَيُعَدَّى بِالْهَمْزَة"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_38", "reason": "high_symbol_ratio:0.425", "chunk_text": "====غرل==== الْغُرْلَةُ مِثْلُ الْقُلْفَةِ وَزْنًا وَمَعْنًى وَغَرِلَ غَرَلًا مِنْ بَابِ تَعِبَ إذَا"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_39", "reason": "high_symbol_ratio:0.433", "chunk_text": "====غرم==== غَرِمْتُ الدِّيَةَ وَالدَّيْنَ وَغَيْرَ ذَلِكَ أَغْرَمُ مِنْ بَابِ تَعِبَ أَدَّيْتُهُ غُ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_40", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْغَرِيمُ الْمَدِينُ وَصَاحِبُ الدَّيْنِ أَيْضًا وَهُوَ الْخَصْمُ مَأْخُوذٌ مِنْ ذَلِكَ لِأَنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_41", "reason": "high_symbol_ratio:0.411", "chunk_text": "====غري==== غَرِيَ بِالشَّيْءِ غَرًى مِنْ بَابِ تَعِبَ أُولِعَ بِهِ مِنْ حَيْثُ لَا يَحْمِلُهُ عَلَي"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_42", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَغَرَوْتُ الْجِلْدَ أَغْرُوهُ مِنْ بَابِ عَلَا أَلْصَقْتُهُ بِالْغِرَاءِ وَقَوْسٌ مَغْرُوَّةٌ وَأَغ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_43", "reason": "high_symbol_ratio:0.421", "chunk_text": "====غزر==== غَزُرَ الْمَاءُ بِالضَّمِّ غُزْرًا وَغَزَارَةً كَثُرَ فَهُوَ غَزِيرٌ وَقَنَاةٌ غَزِيرَةٌ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_44", "reason": "high_symbol_ratio:0.441", "chunk_text": "====غزز==== الْغُزُّ جِنْسٌ مِنَ التُّرْكِ قَالَهُ الْجَوْهَرِيُّ الْوَاحِدُ غَزِّيٌّ مِثْلُ رُومٍ و"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_45", "reason": "high_symbol_ratio:0.429", "chunk_text": "====غزل==== غَزَلَتِ الْمَرْأَةُ الصُّوفَ وَنَحْوَهُ غَزْلًا مِنْ بَابِ ضَرَبَ فَهُوَ مَغْزُولُ وَغَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_46", "reason": "high_symbol_ratio:0.422", "chunk_text": ". وَالْغَزَلُ بِفَتْحَتَيْنِ حَدِيثُ الْفِتْيَانِ وَالْجَوَارِي."}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_47", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالْغَزَالُ وَلَدُ الظَّبْيَةِ وَاخْتَلَفَ النَّاسُ فِي تَسْمِيَتِهِ بِحَسْبِ أَسْنَانِهِ وَاعْتَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_48", "reason": "high_symbol_ratio:0.471", "chunk_text": "وَالْأُنْثَى ظَبْيَةٌ وَثَنِيَّةٌ."}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_50", "reason": "high_symbol_ratio:0.424", "chunk_text": "====غزو==== غَزَوْتُ الْعَدُوَّ غَزْوًا فَالْفَاعِلُ غَازٍ وَالْجَمْعُ غُزَاةٌ وَغُزًّى مِثْلُ قُضَا"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_51", "reason": "high_symbol_ratio:0.412", "chunk_text": "====غسل==== غَسَلْتُهُ غَسْلًا مِنْ بَابِ ضَرَبَ وَالِاسْمُ الْغُسْلُ بِالضَّمِّ وَجَمْعُهُ أَغْسَال"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_52", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَاعِلٍ. وَالْمُغْتَسَلُ بِالْفَتْحِ مَوْضِعُ الِاغْتِسَالِ. وَالْغِسْلُ بِالْكَسْرِ مَا يُغْسَلُ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_53", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالْغِسْلِينُ مَا يَنْغَسِلُ مِنْ أَبْدَانِ الْكُفَّارِ فِي النَّارِ وَالْيَاءُ وَالنُّونُ زَائِدَت"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_54", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَالْمَغْسِلُ مِثْلُ مَسْجِدٍ مَغْسِلُ الْمَوْتَى وَالْجَمْعُ مَغَاسِلُ. ====غشش==== غَشَّهُ غَشَّا "}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_55", "reason": "high_symbol_ratio:0.421", "chunk_text": "====غشي==== غُشِيَ عَلَيْهِ بِالْبِنَاءِ لِلْمَفْعُولِ غَشْيًا بِفَتْحِ الْغَيْنِ وَضَمِّهَا لُغَةٌ "}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_56", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَغَشِيتُهُ أَغْشَاهُ مِنْ بَابِ تَعِبَ أَتَيْتُهُ وَالِاسْمُ الْغَشَيَانُ بِالْكَسْرِ وَكُنِّيَ بِه"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_57", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْغِشَاوَةُ بِالْكَسْرِ الْغِطَاءُ أَيْضًا وَغَشِيَ اللَّيْلُ مِنْ بَابِ تَعِبَ وَأَغْشَى بِالْأَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_58", "reason": "high_symbol_ratio:0.411", "chunk_text": "====غصب==== غَصَبَهُ غَصْبًا مِنْ بَابِ ضَرَبَ وَاغْتَصَبَهُ أَخَذَهُ قَهْرًا وَظُلْمًا فَهُوَ غَاصِ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_59", "reason": "high_symbol_ratio:0.430", "chunk_text": "نَفْسِهَا يُضَمَّنُ الْفِعْلُ مَعْنَى غُلِبَتْ وَالشَّيْءُ مَغْصُوبٌ وَغَصْبٌ تَسْمِيَةٌ بِالْمَصْدَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_60", "reason": "high_symbol_ratio:0.425", "chunk_text": "====غصن==== غُصْنُ الشَّجَرَةِ جَمْعُهُ أَغْصَانٌ مِثْلُ قُفْلٍ وَأَقْفَالٍ وَغُصُونٌ أَيْضًا. ====غ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_61", "reason": "high_symbol_ratio:0.419", "chunk_text": "====غضر==== غَضِرَ الرَّجُلُ بِالْمَالِ غَضَرًا مِنْ بَابِ تَعِبَ كَثُرَ مَالُهُ وَيَتَعَدَّى بِالْح"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_63", "reason": "high_symbol_ratio:0.440", "chunk_text": "====غضض==== غَضَّ الرَّجُلُ صَوْتَهُ وَطَرْفَهُ وَمِنْ طَرْفِهِ وَمِنْ صَوْتِهِ غَضًّا مِنْ بَابِ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_64", "reason": "high_symbol_ratio:0.435", "chunk_text": "====غضن==== الْغُضُونُ مَكَاسِرُ الْجِلْدِ وَمَكَاسِرُ كُلِّ شَيْءٍ غُضُونٌ أَيْضًا الْوَاحِدُ غَضْن"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_65", "reason": "high_symbol_ratio:0.415", "chunk_text": "====غضي==== أَغْضَى الرَّجُلُ عَيْنَهُ بِالْأَلِفِ قَارَبَ بَيْنَ جَفْنَيْهَا ثُمَّ اُسْتُعْمِلَ فِي"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_66", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَالْغَضَى شَجَرٌ وَخَشَبُهُ مِنْ أَصْلَبِ الْخَشَبِ وَلِهَذَا يَكُونُ فِي فَحْمِهِ صَلَابَةٌ. ====غ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_67", "reason": "high_symbol_ratio:0.428", "chunk_text": "====غطط==== غَطَّهُ فِي الْمَاءِ غَطًّا مِنْ بَابِ قَتَلَ غَمَسَهُ فَانْغَطَّ هُوَ وَغَطَّ الْجَمَلُ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_68", "reason": "high_symbol_ratio:0.423", "chunk_text": "====غطو==== غَطَوْتُ الشَّيْءَ أَغْطُوهُ وَغَطَيْتُهُ أَغْطِيهِ مِنْ بَابَيْ عَلَا وَرَمَى وَالتَّثْ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_69", "reason": "high_symbol_ratio:0.426", "chunk_text": "====غفر==== غَفَرَ اللَّهُ لَهُ غَفْرًا مِنْ بَابِ ضَرَبَ وَغُفْرَانًا صَفَحَ عَنْهُ وَالْمَغْفِرَةُ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_70", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَالْمِغْفَرُ بِالْكَسْرِ مَا يُلْبَسُ تَحْتَ الْبَيْضَةِ. وَغِفَارٌ مِثْلُ كِتَابٍ حَيٌّ مِنَ الْعَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_71", "reason": "high_symbol_ratio:0.408", "chunk_text": "====غفل==== الْغَفْلَةُ غَيْبَةُ الشَّيْءِ عَنْ بَالِ الْإِنْسَانِ وَعَدَمُ تَذَكُّرِهِ لَهُ وَقَدِ "}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_72", "reason": "high_symbol_ratio:0.444", "chunk_text": "وَغَفَّلْتُهُ تَغْفِيلًا صَيَّرْتُهُ كَذَلِكَ فَهُوَ مُغَفَّلٌ أَيْ لَيْسَ لَهُ فِطْنَةٌ وَبِاسْمِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_73", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَأَغْفَلْتُ الشَّيْءَ إغْفَالًا تَرَكْتُهُ إهْمَالًا مِنْ غَيْرِ نِسْيَانٍ. وَتَغَفَّلْتُ الرَّجُلَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_74", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَتَغَافَلَ أَرَى مِنْ نَفْسِهِ ذَلِكَ وَلَيْسَ بِهِ. وَأَرْضٌ غُفْلٌ مِثَالُ قُفْلٍ لَا عَلَمَ بِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_75", "reason": "high_symbol_ratio:0.426", "chunk_text": "====غفو==== أَغْفَيْتُ إغْفَاءً فَأَنَا مُغْفٍ إذَا نِمْتُ نَوْمَةً خَفِيفَةً قَالَ ابْنُ السِّكِّيت"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_76", "reason": "high_symbol_ratio:0.434", "chunk_text": "====غلصم==== الْغَلْصَمَةُ رَأْسُ الْحُلْقُومِ وَهُوَ الْمَوْضِعُ النَّاتِئُ فِي الْحَلْقِ وَالْجَمْ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_77", "reason": "high_symbol_ratio:0.412", "chunk_text": "====غلب==== غَلَبَهُ غَلْبًا مِنْ بَابِ ضَرَبَ وَالِاسْمُ الْغَلَبُ بِفَتْحَتَيْنِ وَالْغَلَبَةُ أَي"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_78", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَغِلَابًا. ====غلت==== غَلِتَ فِي الْحِسَابِ غَلَتًا قِيلَ هُوَ مِثْلُ غَلِطَ غَلَطًا وَزْنًا وَمَع"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_79", "reason": "high_symbol_ratio:0.424", "chunk_text": "====غلث==== غَلَثْتُ الشَّيْءَ بِغَيْرِهِ غَلْثًا مِنْ بَابِ ضَرَبَ خَلَطْتُهُ بِهِ كَالْحِنْطَةِ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_80", "reason": "high_symbol_ratio:0.435", "chunk_text": "====غلس==== الْغَلَسُ بِفَتْحَتَيْنِ ظَلَامُ آخِرِ اللَّيْلِ وَغَلَّسَ الْقَوْمُ تَغْلِيسًا خَرَجُوا"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_81", "reason": "high_symbol_ratio:0.440", "chunk_text": "====غلط==== غَلِطَ فِي مَنْطِقِهِ غَلَطًا أَخْطَأَ وَجْهَ الصَّوَابِ وَغَلَّطْتُهُ أَنَا قُلْتُ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_82", "reason": "high_symbol_ratio:0.415", "chunk_text": "====غلظ==== غَلُظَ الشَّيْءُ بِالضَّمِّ غِلَظًا وِزَانُ عِنَبٍ خِلَافُ دَقَّ وَالِاسْمُ الْغِلْظَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_83", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَأَغْلَظَ لَهُ فِي الْقَوْلِ إغْلَاظًا عَنَّفَهُ وَغَلَّظْتُ عَلَيْهِ فِي الْيَمِينِ تَغْلِيظًا شَد"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_84", "reason": "high_symbol_ratio:0.418", "chunk_text": "====غلف==== غِلَافُ السِّكِّينِ وَنَحْوِهِ جَمْعُهُ غُلُفٌ مِثْلُ كِتَابٍ وَكُتُبٍ وَأَغْلَفْتُ السِ"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_85", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَغَلَفَ لِحْيَتَهُ بِالْغَالِيَةِ مِنْ بَابِ ضَرَبَ أَيْضًا ضَمَخَهَا وَقَالَ ابْنُ دُرَيْدٍ غَلَّف"}
{"source": "wikisource", "raw_id": "arwikisource:41113:108396#chunk_86", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالْغُلْفَةُ بِالضَّمِّ هِيَ الْغُرْلَةُ وَالْقُلْفَةُ. وَغَلِفَ غَلَفًا مِنْ بَابِ تَعِبَ إذَا لَم"}
