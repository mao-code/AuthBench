{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1063", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَعَلَى الْقَوْلَيْنِ فَلَا حُجَّةَ لَهُمْ فِي تَصْدِيقِ مُحَمَّدٍ لِمَا هُمْ عَلَيْهِ مِنَ الدِّينِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1064", "reason": "high_symbol_ratio:0.412", "chunk_text": "شَرَائِعِهِمْ كَالصَّلَاةِ إِلَى الشَّرْقِ وَاسْتِحْلَالِ الْمُحَرَّمَاتِ مِنَ الْخِنْزِيرِ وَالْمَي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1065", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَيُقَالُ لَهُمْ: أَيْنَ مَا مَعَكُمْ عَنْ مُحَمَّدٍ مِمَّا يَدُلُّ عَلَى أَنَّ أَلْفَاظَ الْكُتُبِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1067", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَأَيْنَ فِي الْقُرْآنِ وَالسُّنَّةِ الثَّابِتَةِ عَنْ مُحَمَّدٍ أَنَّ جَمِيعَ مَا بِأَيْدِي أَهْلِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1068", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَهَؤُلَاءِ بَنَوْا كَلَامَهُمْ عَلَى أَنَّ أَلْفَاظَ كُتُبِهِمْ تَدُلُّ عَلَى صِحَّةِ دِينِهِمُ الَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1069", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَدْ تَبَيَّنَ فَسَادُ ذَلِكَ مِنْ وُجُوهٍ مُتَعَدِّدَةٍ. ثُمَّ زَعَمُوا أَنَّ الْمُسْلِمِينَ يَدَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1071", "reason": "high_symbol_ratio:0.402", "chunk_text": "أَرَادُوا وَاشْتَهَوْا هَلْ كَانُوا يُجَوِّزُونَ كَلَامَنَا؟ قَالَ الْحَاكِي عَنْهُمْ: فَقُلْتُ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1073", "reason": "high_symbol_ratio:0.404", "chunk_text": "أَحَدُهُمَا: أَنَّ الرَّسُولَ ثَبَّتَ مَا مَعَهُمْ وَنَفَى عَنْ كُتُبِهِمُ الَّتِي بَيْنَ أَيْدِيهِم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1074", "reason": "high_symbol_ratio:0.443", "chunk_text": "بِأَنَّ كَثِيرًا مِنْ ذَلِكَ مُبَدَّلٌ مُحَرَّفٌ وَكَذَلِكَ وَقَعَ فِي تَغْيِيرِ شَرَائِعِ هَذِهِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1076", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَأَهْلُ الْكِتَابِ يُكَذِّبُونَ بِكَثِيرٍ مِمَّا أَخْبَرَتْ وَلَا يُوجِبُونَ طَاعَتَهَا فِي كَثِيرٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1077", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالنَّصَارَى لَهُمْ سَبْعُ مَجَامِعَ مَشْهُورَةٍ عِنْدَهُمْ وَهُمْ فِي كُلِّ مَجْمَعٍ يَلْعَنُونَ ط"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1078", "reason": "high_symbol_ratio:0.400", "chunk_text": "النُّبُوَّاتِ غَيْرُ مُوجِبَةٍ لِطَاعَةِ بَعْضِ مَا فِيهَا بَلِ اخْتِلَافُهُمْ فِي نَفْسِ التَّوْحِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1080", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَإِذَا عَرَفْتَ أَنَّ جَمِيعَ الطَّوَائِفِ مِنَ الْمُسْلِمِينَ وَالْيَهُودِ وَالنَّصَارَى يَشْهَدُو"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1081", "reason": "high_symbol_ratio:0.414", "chunk_text": "ظَاهِرَةٌ عَلَى الْحَقِّ لَا يَضُرُّهُمْ مَنْ خَالَفَهُمْ وَخَذَلَهُمْ حَتَّى تَقُومَ السَّاعَةُ بِخ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1082", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَالْمُسْلِمُونَ يُثْبِتُونَ بِالدَّلَائِلِ الْكَثِيرَةِ أَنَّهُمْ بَدَّلُوا مَعَانِيَ التَّوْرَاةِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1083", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَإِنَّ هَذَا الْكَلَامَ لَوْ نَقَلَهُ نَاقِلٌ عَنْ بَعْضِ الْأَنْبِيَاءِ لَقَطَعْنَا بِكَذِبِهِ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1084", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِذَا قَطَعْنَا بِكَذِبِ مَنْ يَنْقُلُهُ عَنِ الْأَنْبِيَاءِ فَكَيْفَ إِذَا لَمْ يَنْقُلْهُ عَنْهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1085", "reason": "high_symbol_ratio:0.402", "chunk_text": "قَالَ تَعَالَى: وَعَصَى آدَمُ رَبَّهُ فَغَوَى ثُمَّ اجْتَبَاهُ رَبُّهُ فَتَابَ عَلَيْهِ وَهَدَى وَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1087", "reason": "high_symbol_ratio:0.526", "chunk_text": "تَقْشَعِرُّ مِنْهُ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1088", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَقَالَ تَعَالَى: نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ الْقَصَصِ بِمَا أَوْحَيْنَا إِلَيْكَ هَذَا الْقُر"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1089", "reason": "high_symbol_ratio:0.414", "chunk_text": "ذَنْبِ أَبِيهِ الْأَقْصَى آدَمَ؟ مَعَ أَنَّهُ كَانَ نَبِيًّا وَنُوحٌ قَدْ مَكَثَ فِي قَوْمِهِ أَلْفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1090", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَمُوسَى بْنُ عِمْرَانَ الَّذِي كَلَّمَهُ اللَّهُ تَكْلِيمًا وَأَظْهَرَ عَلَى يَدَيْهِ مِنَ الْبَرَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1091", "reason": "high_symbol_ratio:0.419", "chunk_text": "ثُمَّ أَيُّ مُنَاسَبَةٍ بَيْنَ الصَّلْبِ الَّذِي هُوَ مِنْ أَعْظَمِ الذُّنُوبِ سَوَاءً صَلَبُوا الْم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1092", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَلِمَاذَا أَخَّرَ مَنْعَهُ مِنْ ظُلْمِهِمْ إِلَى زَمَنِ الْمَسِيحِ؟ وَهُوَ سُبْحَانَهُ وَلِيُّ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1093", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَاسْتِحْقَاقِهِمْ كَرَامَتَهُ وَإِحْسَانَهُ وَجَنَّتَهُ بِحُكْمِ وَعْدِهِ وَمُقْتَضَى حِكْمَتِهِ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1094", "reason": "high_symbol_ratio:0.409", "chunk_text": "مَا يَقْتَضِي عَظِيمَ جَهْلِهِمُ الَّذِي جَعَلُوا بِهِ الرَّبَّ جَاهِلًا، فَإِنَّهُمْ يَقُولُونَ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1095", "reason": "high_symbol_ratio:0.432", "chunk_text": "فَلَمَّا أَرَادَ الشَّيْطَانُ أَخْذَ رُوحِهِ لِيَحْبِسَهُ فِي جَهَنَّمَ كَسَائِرِ مَنْ مَضَى وَهُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1096", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَهَذَا تَجْهِيلٌ مِنْهُمْ لِلرَّبِّ - سُبْحَانَهُ وَتَعَالَى - عَمَّا يَقُولُونَ مَعَ تَعْجِيزِهِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1097", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَلَا فَرْقَ بَيْنَ نَاسُوتِ الْمَسِيحِ وَغَيْرِهِ إِذِ الْجَمِيعُ بَنِي آدَمَ، وَأَيْضًا فَإِذَا قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1098", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَيُقَالُ: إِنْ كَانَ تَسَلُّطُ الشَّيْطَانِ عَلَى حَبْسِهِمْ فِي الْجَحِيمِ بِحَقٍّ لِأَجْلِ ذُنُوب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1099", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْأَصْلُ الثَّانِي: الْفَاسِدُ الَّذِي بَنَوْا عَلَيْهِ سُؤَالَهُمُ الَّذِي جَعَلُوهُ مِنْ جِهَةِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1100", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَهَذَا مِمَّا لَا يَقُولُهُ الْمُسْلِمُونَ، وَلَكِنْ قَدْ يَقُولُ بَعْضُهُمْ: أَنَّهُ حُرِّفَ بَعْد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1101", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَمِنْهُمْ مَنْ يَقُولُ كَانَ بَعْدَهُ وَمِنْهُمْ مَنْ يُثْبِتُ الْأَمْرَيْنِ أَوْ يُجَوِّزُهُمَا، و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1102", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَإِنْ كَانَتْ كُلُّ طَائِفَةٍ تَزْعُمُ أَنَّ الْأُخْرَى هِيَ الَّتِي حَرَّفَتِ الْمَعَانِيَ. وَأَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1103", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَذَهَبَ كَثِيرٌ مِنْ عُلَمَاءِ الْمُسْلِمِينَ وَأَهْلِ الْكِتَابِ إِلَى أَنَّهُ بُدِّلَ بَعْضُ أَلْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1104", "reason": "high_symbol_ratio:0.412", "chunk_text": "حَتَّى فِي صَلْبِ الْمَسِيحِ ذَهَبَتْ طَائِفَةٌ مِنَ النَّصَارَى إِلَى أَنَّهُ إِنَّمَا صُلِبَ الَّذ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1105", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَفِيهِمْ مَنْ يَجْعَلُ الْمُبَدَّلَ مِنَ التَّوْرَاةِ وَالْإِنْجِيلِ كَثِيرًا مِنْهُمَا وَرُبَّمَا "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1106", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمِنْ هَؤُلَاءِ مَنْ يُسْرِفُ حَتَّى يَقُولَ: أَنَّهُ لَا حُرْمَةَ لِشَيْءٍ مِنْهُمَا بَلْ يَجُوزُ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1107", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَمِنْهُمْ مَنْ يَقُولُ الَّذِي بُدِّلَتْ أَلْفَاظُهُ قَلِيلٌ مِنْهُمَا وَهَذَا أَظْهَرُ. وَالتَّبْد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1108", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْإِنْجِيلُ الَّذِي هُوَ كَلَامُ اللَّهِ لَيْسَ هُوَ هَذِهِ الْأَنَاجِيلَ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1110", "reason": "high_symbol_ratio:0.423", "chunk_text": "حُكْمُ اللَّهِ فَعُلِمَ أَنَّ التَّوْرَاةَ الَّتِي كَانَتْ مَوْجُودَةً بَعْدَ خَرَابِ بَيْتِ الْمَقْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1111", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالتَّوْرَاةُ الَّتِي كَانَتْ عِنْدَ يَهُودِ الْمَدِينَةِ عَلَى عَهْدِ رَسُولِ اللَّهِ وَإِنْ قِيلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1112", "reason": "high_symbol_ratio:0.404", "chunk_text": "أَلْفَاظِهَا فَتَبْدِيلُ أَلْفَاظِ الْيَسِيرِ مِنَ النُّسَخِ بَعْدَ مَبْعَثِ الرَّسُولِ مُمْكِنٌ لَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1113", "reason": "high_symbol_ratio:0.411", "chunk_text": "حُفِظَتْ أَلْفَاظُهُ فِي الصُّدُورِ بِالنَّقْلِ الْمُتَوَاتِرِ لَا يَحْتَاجُ أَنْ يُحْفَظَ فِي كِتَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1116", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَدْ ذَكَرَ طَائِفَةٌ مِنَ الْعُلَمَاءِ أَنَّ قَوْلَهُ تَعَالَى: فِي الْإِنْجِيلِ وَلْيَحْكُمْ أَه"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1117", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَهَذَا الْقَوْلُ يُنَاسِبُ مُنَاسَبَةً ظَاهِرَةً لِقِرَاءَةِ مَنْ قَرَأَ \" وَلِيَحْكُمْ أَهْلُ الْإ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1119", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَأَمَّا قِرَاءَةُ الْجُمْهُورِ وَلْيَحْكُمْ أَهْلُ الْإِنْجِيلِ فَهُوَ أَمْرٌ بِذَلِكَ، فَمِنَ الْع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1120", "reason": "high_symbol_ratio:0.407", "chunk_text": "بِأَفْوَاهِهِمْ وَلَمْ تُؤْمِنْ قُلُوبُهُمْ وَمِنَ الَّذِينَ هَادُوا سَمَّاعُونَ لِلْكَذِبِ سَمَّاعُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_1121", "reason": "high_symbol_ratio:0.408", "chunk_text": "أَعْرِضْ عَنْهُمْ وَإِنْ تُعْرِضْ عَنْهُمْ فَلَنْ يَضُرُّوكَ شَيْئًا وَإِنْ حَكَمْتَ فَاحْكُمْ بَيْن"}
