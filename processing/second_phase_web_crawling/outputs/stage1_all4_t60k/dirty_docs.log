{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_249", "reason": "high_symbol_ratio:0.405", "chunk_text": "مَعْشَرَ أَصْحَابِ مُحَمَّدٍ إِنَّ كُنْتُمْ ظَنَنْتُمْ أَنِّي أَخَذْتُ خِلَافَتَكُمْ رَغْبَةً فِيهَا"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_251", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَخَرَجَ إِلَيْهِ فَقَالَ: ابْسُطْ يَدَكَ بِأَبِي أَنْتَ وَأُمِّي حَتَّى أُبَايِعَكَ، فَانْزَوَى عَن"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_252", "reason": "high_symbol_ratio:0.412", "chunk_text": "إِلَيَّ أَنَّ أَبَا بَكْرٍ سَيَلِي بَعْدَهُ حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَلِيٍّ الْيَقْ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_253", "reason": "high_symbol_ratio:0.404", "chunk_text": "عَلَيْهِ وَتَسْلِيمِهِمْ لَهُ مَا يُسْتَغْنَى بِهِ عَنْ إِيرَادِ الْأَحَادِيثِ الْمَرْوِيَّةِ فِي ذَ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_254", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَكَانَتْ خِلَافَةُ النُّبُوَّةِ ثَلَاثِينَ سَنَةً لِأَبِي بَكْرِ وَعُمَرَ وَعُثْمَانَ وَعَلِيٍّ رضي"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_255", "reason": "high_symbol_ratio:0.416", "chunk_text": "عَلِيُّ سِتَّ سِنِينَ وَقُتِلَ وَلَيْسَ فِي تَأْخِيرٍ علي نَقْصٌ وَلَا ازْدِرَاءٌ بَلْ هُوَ السَّيِّ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_256", "reason": "high_symbol_ratio:0.409", "chunk_text": "تَكُونَ طَاعَةً أَوْ مَعْصِيَةً فَإِنْ كَانَتْ طَاعَةً فَأَوْلَى النَّاسِ بِالْمُسَابَقَةِ إِلَيْهَا"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_257", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَاحِدًا مِنْهُمَا فَقَدِ افْتَرَى وَخَرَقَ الْإِجْمَاعَ الَّذِي اجْتَمَعَ عَلَيْهِ أَهْلُ الْعِلْمِ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_259", "reason": "high_symbol_ratio:0.403", "chunk_text": "حَدَّثَنَا أَبُو بَكْرِ بْنُ مَالِكٍ، ثنا عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ قَالَ: حَدَّثَن"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_260", "reason": "high_symbol_ratio:0.405", "chunk_text": "أَتْعَبَ مَنْ بَعْدَهُ حَدَّثَنَا أَبُو بَكْرِ بْنُ مَالِكٍ، ثنا عَبْدُ اللَّهِ بْنُ أَحْمَدَ بْنِ ح"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_262", "reason": "high_symbol_ratio:0.404", "chunk_text": "جَعْفَرٍ، ثنا إِسْمَاعِيلُ بْنُ عَبْدِ اللَّهِ، ثنا يزيد بْنُ مُحَمَّدٍ الْأَيْلِيُّ، عَنْ يُونُسَ، "}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_263", "reason": "high_symbol_ratio:0.405", "chunk_text": "أُذَكِّرُكَ بِاللهِ وَالْيَوْمِ الْآخِرِ فَإِنَّكَ قَدِ اسْتَخْلَفْتَ عَلَى النَّاسِ رَجُلًا فَظًّا "}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_264", "reason": "high_symbol_ratio:0.401", "chunk_text": "خَلَا بِهِمْ وَأَنْتَ مُلَاقٍ رَبِّكَ فَسَائِلُكَ عَنْ رَعِيَّتِكَ فَقَالَ أَبُو بَكْرٍ: أَجْلِسُونِ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_265", "reason": "high_symbol_ratio:0.430", "chunk_text": "إِلَيْكُمْ، وَإِنِّي قَدْ أَمَّرْتُ عَلَيْكُمْ عُمَرَ بْنَ الْخَطَّابِ فَاسْمَعُوا لَهُ وَأَطِيعُوا."}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_266", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ: فَتَخَلَّفَ رَجُلٌ مِنَ الْقَوْمِ فَقَالَ: مَا تَقُولُ لِرَبِّكَ عَزَّ وَجَلَّ إِذَا لَقِيتَه"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_267", "reason": "high_symbol_ratio:0.413", "chunk_text": "بَكْرِ مَا تَقُولُ لِرَبِّكَ غَدًا إِذَا لَقِيتَهُ وَقَدِ اسْتَخْلَفْتَ عَلَيْنَا عُمَرَ وَقَدْ عَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_268", "reason": "high_symbol_ratio:0.417", "chunk_text": "الْخَلِيفَةِ مِنْ بَعْدِهِ حَتَّى إِذَا لَمْ يَبْقَ إِلَّا أَنْ يُسَمَّى الرَّجُلَ أَخَذَتْ أَبَا بَ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_269", "reason": "high_symbol_ratio:0.416", "chunk_text": "أَصْلِهِ ثنا أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أُسَيْدٍ، ثنا يَحْيَى بْنُ الرَّبِيعِ، ثنا سُفْيَانُ بْنُ "}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_270", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَقَالَ سُدَيْرٌ: صَحِيفَتُهُ خَيْرٌ مِنْ صَحِيفَتِهِ حَدَّثَنَا مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْحَس"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_271", "reason": "high_symbol_ratio:0.418", "chunk_text": "النَّبِيِّ مِنْ هَذَا الْمُسَجَّى عَلَيْهِ ثَوْبُهُ حَدَّثَنَا مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْحَسَن"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_272", "reason": "high_symbol_ratio:0.404", "chunk_text": "أَبُو مُحَمَّدِ بْنُ حَيَّانَ قَالَ: حَدَّثَنِي مُحَمَّدُ بْنُ أَحْمَدَ بْنِ عَلِيِّ بْنِ بِشْرٍ، ثن"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_273", "reason": "high_symbol_ratio:0.407", "chunk_text": "خَلَّادُ بْنُ يَحْيَى وَحَدَّثَنَا أَبُو مُحَمَّدِ بْنُ حَيَّانَ، ثنا إِبْرَاهِيمُ بْنُ سَعْدَانَ، ث"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_274", "reason": "high_symbol_ratio:0.414", "chunk_text": "بَكَّارٍ، ثنا شُعْبَةُ، عَنْ عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ قَالَ: سَمِعْتُ النَّزَّالَ بْنَ سَبْر"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_275", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَلَمْ يُرَ يَوْمًا كَانَ أَكْثَرَ نَشِيجًا مِنْ ذَلِكَ الْيَوْمِ وَإِنَّا أَصْحَابُ مُحَمَّدٍ اجْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_276", "reason": "high_symbol_ratio:0.409", "chunk_text": "رَسُولِ اللَّهِ فَقَالُوا: لَا نَعْلَمُ أَحَدًا تَزَوَّجَ بِنْتَيْ نَبِيٍّ غَيْرَ عُثْمَانَ حَدَّثَن"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_277", "reason": "high_symbol_ratio:0.413", "chunk_text": "رَسُولَ اللَّهِ قُبِضَ فَنَظَرَ الْمُسْلِمُونَ خَيْرَهُمْ فَاسْتَخْلَفُوهُ وَهُوَ أَبُو بَكْرٍ فَلَم"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_279", "reason": "high_symbol_ratio:0.404", "chunk_text": "مُضَرِّبٍ قَالَ: سَمِعْتُ حَادِيَ عُمَرَ يَقُولُ: إِنَّ الْخَلِيفَةَ بَعْدَهُ عُثْمَانُ حَدَّثَنَا ع"}
{"source": "wikisource", "raw_id": "arwikisource:47792:597883#chunk_280", "reason": "high_symbol_ratio:0.404", "chunk_text": "اسْتَخْلَفْتُمْ؟ فَقَالَ: لَمْ نَأْلُ عَنْ أَعْلَاهَا ذَا فَوْقٍ خَيْرَ خَلَقِ اللَّهِ وَخَيْرَ أَصْ"}
