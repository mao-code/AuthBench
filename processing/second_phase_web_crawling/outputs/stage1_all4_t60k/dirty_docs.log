{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_887", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَالْمُلْحِدُونَ الْمُبَدِّلُونَ لِدِينِ الرُّسُلِ، دِينِ الْمَسِيحِ أَوْ دِينِ مُحَمَّدٍ - صَلَّى ا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_888", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَمَّا أَهْلُ الْحِيَلِ فَيَكْثُرُونَ وَهَؤُلَاءِ لَيْسُوا أَوْلِيَاءَ اللَّهِ بَلْ خَوَارِقُهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_889", "reason": "high_symbol_ratio:0.402", "chunk_text": "الْخَوَارِقِ مَا يَكُونُ مِنَ الشَّيَاطِينِ أَوْ يَكُونُ حِيَلًا وَمَخَارِيقَ وَيَظُنُّ أَنَّهَا مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_892", "reason": "high_symbol_ratio:0.401", "chunk_text": "بِخِلَافِ الْأَنْبِيَاءِ - صَلَوَاتُ اللَّهِ عَلَيْهِمْ - أَجْمَعِينَ، فَإِنَّهُ يَجِبُ تَصْدِيقُهُم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_893", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ تَعَالَى: قُولُوا آمَنَّا بِاللَّهِ وَمَا أُنْزِلَ إِلَيْنَا وَمَا أُنْزِلَ إِلَى إِبْرَاهِيمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_894", "reason": "high_symbol_ratio:0.418", "chunk_text": "النُّبُوَّةِ فَهُوَ كَافِرٌ مُرْتَدٌّ وَمَنْ سَبَّ نَبِيًّا وَجَبَ قَتْلُهُ بَلْ يَجِبُ الْإِيمَانُ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_895", "reason": "high_symbol_ratio:0.413", "chunk_text": "لِأَحَدٍ غَيْرِ الْأَنْبِيَاءِ وَلَوْ كَانَ مِنْ رُسُلِ الْأَنْبِيَاءِ وَكَانُوا مِنْ أَعْظَمِ الصِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_896", "reason": "high_symbol_ratio:0.442", "chunk_text": "فَضَلَالُ الضُّلَّالِ مِنْ هَؤُلَاءِ مَبْنِيٌّ عَلَى مُقَدِّمَتَيْنِ. إِحْدَاهُمَا: أَنَّ هَذَا لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_897", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالثَّانِيَةُ: أَنَّ وَلِيَّ اللَّهِ لَا يَجُوزُ أَنْ يُخْطِئَ بَلْ يَجِبُ تَصْدِيقُهُ فِي كُلِّ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_898", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْمُقَدِّمَتَانِ الْمَذْكُورَتَانِ قَدْ تَكُونُ إِحْدَاهُمَا بَاطِلَةً وَقَدْ يَكُونُ كِلَاهُمَا "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_900", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَيُقَالُ: قَدْ تَقَدَّمَ أَنَّ الرُّسُلَ تَتَنَاوَلُ قَطْعًا الرُّسُلَ الَّذِينَ ذَكَرَهُمُ اللَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_902", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَيَتَنَاوَلُ أَيْضًا اسْمَ الرُّسُلِ مَنْ لَمْ يُسَمِّهِمْ بِأَعْيَانِهِمْ فِي الْقُرْآنِ قَالَ تَع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_903", "reason": "high_symbol_ratio:0.406", "chunk_text": "حُجَّةٌ بَعْدَ الرُّسُلِ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا وَقَالَ تَعَالَى: وَلَقَدْ أَرْسَلْنَا رُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_905", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَلَمْ يَذْكُرِ اللَّهُ تَعَالَى فِي الْقُرْآنِ أَنَّهُ أَرْسَلَهُمُ الْبَتَّةَ بَلْ ذَكَرَ أَنَّهُ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_906", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَدْ ذَكَرَ إِجْمَاعَهُمْ عَلَى ذَلِكَ غَيْرُ وَاحِدٍ مِثْلُ الْقَاضِيَيْنِ أَبِي بَكْرِ بْنِ الطَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_907", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَدْ ثَبَتَ فِي الصَّحِيحَيْنِ عَنِ النَّبِيِّ أَنَّهُ قَالَ: كَمُلَ مِنَ الرِّجَالِ كَثِيرٌ وَلَم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_909", "reason": "high_symbol_ratio:0.401", "chunk_text": "مِنْ عِنْدِ اللَّهِ هُوَ أَهْدَى مِنْهُمَا أَتَّبِعْهُ إِنْ كُنْتُمْ صَادِقِينَ وَهَذَا تَعْجِيزٌ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_911", "reason": "high_symbol_ratio:0.407", "chunk_text": "مُبَارَكٌ مُصَدِّقُ الَّذِي بَيْنَ يَدَيْهِ وَلِتُنْذِرَ أُمَّ الْقُرَى وَمَنْ حَوْلَهَا وَالَّذِينَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_912", "reason": "high_symbol_ratio:0.406", "chunk_text": "تَقُولُوا إِنَّمَا أُنْزِلَ الْكِتَابُ عَلَى طَائِفَتَيْنِ مِنْ قَبْلِنَا وَإِنْ كُنَّا عَنْ دِرَاسَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_913", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْمُنْفَرِدِ، وَمَعْلُومٌ أَنَّهُ أَرَادَ بِالَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِنَا الْيَهُودَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_914", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَقَدْ تَبَيَّنَ بُطْلَانُ قَوْلِ هَؤُلَاءِ الَّذِينَ يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيُفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_915", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَبَيَّنَ أَنَّ اللَّهَ لَمْ يُرِدْ بِالْكِتَابِ الْإِنْجِيلَ وَحْدَهُ؛ كَمَا لَمْ يُرِدْ بِالرُّسُل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_918", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَإِنَّ اللَّهَ سَرِيعُ الْحِسَابِ فَإِنْ حَاجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِيَ لِلَّهِ وَمَنِ اتَّبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_920", "reason": "high_symbol_ratio:0.411", "chunk_text": "مِنَ الْيَهُودِ إِلْقَاءَ الْفِتْنَةِ بَيْنَ الْمُسْلِمِينَ. فَهُمْ دَاخِلُونَ قَطْعًا، وَإِنْ كَانَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_921", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَرَهُ تَعَالَى بِسُؤَالِ الَّذِينَ يَقْرَءُونَ الْكِتَابَ مِنْ قَبْلِهِ عَلَى تَقْدِيرِ الشَّكِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_922", "reason": "high_symbol_ratio:0.409", "chunk_text": "قَالَ تَعَالَى: وَمِنْ ذُرِّيَّتِهِ دَاوُدَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَى وَهَارُونَ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_923", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَالَ تَعَالَى: قُلْ أَفَغَيْرَ اللَّهِ تَأْمُرُونِّي أَعْبُدُ أَيُّهَا الْجَاهِلُونَ وَلَقَدْ أُو"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_924", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَذَكَرَ هُنَا لَفْظَ إِنَّ لِأَنَّهُ خِطَابٌ لِمَوْجُودٍ. وَهُنَاكَ خَبَرٌ عَنْ مَيِّتٍ وَكَذَلِكَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_925", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَلَكِنَّ الْمَقْصُودَ بَيَانُ أَنَّ أَهْلَ الْكِتَابِ عِنْدَهُمْ مَا يُصَدِّقُكَ فِيمَا كَذَّبَكَ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_927", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْحَقُّ مِنْ رَبِّنَا إِنَّا كُنَّا مِنْ قَبْلِهِ مُسْلِمِينَ وَقَالَ: إِنَّ الَّذِينَ أُوتُوا الْع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_929", "reason": "high_symbol_ratio:0.416", "chunk_text": "الْكِتَابِ عِنْدَهُمْ مَا يُصَدِّقُكَ فِيمَا كَذَّبَكَ فِيهِ الْكَافِرُونَ وَذَلِكَ مِنْ وُجُوهٍ. أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_930", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَمِثْلُ هَذَا قَوْلُهُ تَعَالَى: وَاسْأَلْ مَنْ أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رُسُلِنَا أَجَعَلْنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_931", "reason": "high_symbol_ratio:0.400", "chunk_text": "وَقَوْلُهُ تَعَالَى: وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رَسُولٍ إِلَّا نُوحِي إِلَيْهِ أَنَّهُ لَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_932", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْوَجْهُ الثَّانِي: أَنَّ أَهْلَ الْكِتَابِ يَعْلَمُونَ أَنَّ اللَّهَ إِنَّمَا أَرْسَلَ إِلَى النَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_934", "reason": "high_symbol_ratio:0.423", "chunk_text": "لَفِي ضَلَالٍ وَسُعُرٍ وَكَذَلِكَ قَالَ الَّذِينَ مِنْ بَعْدِهِمْ مَا هَذَا إِلَّا بَشَرٌ مِثْلُكُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_935", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَكَذَلِكَ قَالَ قَوْمُ فِرْعَوْنَ لِمُوسَى وَهَارُونَ: أَنُؤْمِنُ لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_936", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ فِرْعَوْنُ: أَمْ أَنَا خَيْرٌ مِنْ هَذَا الَّذِي هُوَ مَهِينٌ وَلَا يَكَادُ يُبِينُ فَلَوْلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_938", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَبَيَّنَ سُبْحَانَهُ أَنَّكُمْ لَا تُطِيقُونَ التَّلَقِّيَ عَنِ الْمَلَكِ فَلَوْ أَنْزَلْنَاهُ مَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_939", "reason": "high_symbol_ratio:0.406", "chunk_text": "يَأْكُلُونَ الطَّعَامَ وَمَا كَانُوا خَالِدِينَ ثُمَّ صَدَقْنَاهُمُ الْوَعْدَ فَأَنْجَيْنَاهُمْ وَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_940", "reason": "high_symbol_ratio:0.427", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنَّهُمْ يَسْأَلُونَ أَهْلَ الْكِتَابِ عَمَّا جَرَى لِلرُّسُلِ مَعَ أُمَمِهِم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_941", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْوَجْهُ الرَّابِعُ: يَسْأَلُونَ أَهْلَ الْكِتَابِ عَنِ الدِّينِ الَّذِي بَعَثَ اللَّهُ بِهِ رُسُلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_942", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْوَجْهُ الْخَامِسُ: يَسْأَلُونَهُمْ عَمَّا وَصَفَتْ بِهِ الرُّسُلُ رَبَّهُمْ هَلْ هُوَ مُوَافِقٌ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_943", "reason": "high_symbol_ratio:0.437", "chunk_text": "وَأَيْضًا، فَإِنَّهُمْ يَسْأَلُونَ أَيْضًا عَمَّا عِنْدَهُمْ مِنَ الشَّهَادَاتِ وَالْبِشَارَاتِ بِنُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_944", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَدْ أَخْبَرَ اللَّهُ بِذَلِكَ فِي الْقُرْآنِ فَقَالَ تَعَالَى: وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_945", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَ تَعَالَى: وَإِذْ قَالَ عِيسَى ابْنُ مَرْيَمَ يَابَنِي إِسْرَائِيلَ إِنِّي رَسُولُ اللَّهِ إِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_946", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ تَعَالَى: فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَاهَا فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَام"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_948", "reason": "high_symbol_ratio:0.420", "chunk_text": "عَلَيْهِمْ يَخِرُّونَ لِلْأَذْقَانِ سُجَّدًا وَيَقُولُونَ سُبْحَانَ رَبِّنَا إِنْ كَانَ وَعْدُ رَبِّ"}
