{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_201", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْإِلَهُ الْمُتَّصِفُ بِهَذِهِ الصِّفَاتِ لَا يَعْبُدُهُ الْيَهُودُ وَالنَّصَارَى، وَهَذَا كَقَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_202", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَهَذَا الْإِلَهُ الَّذِي يَعْبُدُهُ مُحَمَّدٌ وَأُمَّتُهُ، وَلَيْسَ هُوَ إِلَهَ الْمُشْرِكِينَ الَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_206", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَهَذَا تَحْرِيفُ كَلِمِ اللَّهِ عَنْ مَوَاضِعِهِ، وَهُوَ شَبِيهٌ بِتَحْرِيفِهِمْ لِمَا عِنْدَهُمْ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_207", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَأَمَّا تِلْكَ الْكُتُبُ فَلَيْسَ لَهَا مَنْ يَذُبُّ عَنْ لَفْظِهَا وَمَعْنَاهَا، فَلِهَذَا عَظُمَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_208", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَمِمَّا يُبَيِّنُ أَنَّ هَذَا الْخِطَابَ لَيْسَ مُخْتَصًّا بِالنَّصَارَى أَنَّ هَذِهِ السُّورَةَ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_209", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالسُّوَرُ الْمَدَنِيَّةُ خِطَابُهَا تَارَةً لِأَهْلِ الْكِتَابِ، وَتَارَةً تَخْتَصُّ بِالْمُؤْمِنِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_210", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَالَ تَعَالَى: وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_211", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَالْخِطَابُ إِمَّا أَنْ يَعُمَّ الْمُشْرِكِينَ، وَأَهْلَ الْكِتَابِ، أَوْ يَخُصُّ الْمُشْرِكِينَ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_212", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَأَمَّا قَوْلُهُ تَعَالَى: لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ. فَهُوَ نَظِيرُ قَوْلِهِ تَعَالَى: قُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_213", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَقَوْلِهِ: فَإِنْ حَاجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِيَ لِلَّهِ وَمَنِ اتَّبَعَنِ وَقُلْ لِلَّذِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_214", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَالْحُجَّةُ اسْمٌ لِمَا يُحْتَجُّ بِهِ مِنْ حَقٍّ وَبَاطِلٍ كَقَوْلِهِ: لِئَلَّا يَكُونَ لِلنَّاسِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_215", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَإِنَّ الظَّالِمِينَ يَحْتَجُّونَ عَلَيْكُمْ بِحُجَّةٍ بَاطِلَةٍ كَقَوْلِ الْمُشْرِكِينَ لَمَّا حُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_216", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَمِمَّا يُبَيِّنُ ذَلِكَ بَعْدُ قَوْلُهُ بَعْدَ ذَلِكَ: وَالَّذِينَ يُحَاجُّونَ فِي اللَّهِ مِنْ بَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_217", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَسَمَّاهَا حُجَّةً وَجَعَلَهَا دَاحِضَةً، وَهَؤُلَاءِ الَّذِينَ يُحَاجُّونَ فِي اللَّهِ مِنْ بَعْدِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_218", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَهُمْ يُحَاجُّونَ الْمُؤْمِنِينَ لِيَرُدُّوهُمْ عَنْ دِينِهِمْ، وَقَالَ عَنِ النَّصَارَى: فَمَنْ حَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_219", "reason": "high_symbol_ratio:0.441", "chunk_text": "فَكَانَ الْكُفَّارُ يُحَاجُّونَ الْمُؤْمِنِينَ حَتَّى يَرُدُّوهُمْ عَنْ دِينِهِمْ، كَمَا يُؤْذُونَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_220", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَمُحَاجَّتُهُمْ لِلْمُؤْمِنِينَ مِنْ بَابِ الظُّلْمِ لَهُمْ وَالْعُدْوَانِ عَلَيْهِمْ وَقَوْلِ الْب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_221", "reason": "high_symbol_ratio:0.426", "chunk_text": "أَيْ لَيْسَ لَكُمْ أَنْ تَظْلِمُونَا، وَتَعْتَدُوا عَلَيْنَا بِحُجَّتِكُمُ الدَّاحِضَةِ، وَلَيْسَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_222", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَإِنَّهُ تَعَالَى قَالَ: ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_223", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَأَمَرَهُ تَعَالَى أَنْ يُجَادِلَ أَهْلَ دَعْوَتِهِ مُطْلَقًا مِنَ الْمُشْرِكِينَ، وَأَهْلِ الْكِتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_225", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَإِنَّ الظَّالِمَ بَاغٍ مُسْتَحِقٌّ لِلْعُقُوبَةِ، فَيَجُوزُ أَنْ يُقَابَلَ بِمَا يَسْتَحِقُّهُ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_227", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَقَوْلِهِ: لَمْ يَكُنِ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَالْمُشْرِكِينَ مُنْفَكِّينَ. وَأ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_228", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالظَّالِمُ يَكُونُ ظَالِمًا بِتَرْكِ مَا تَبَيَّنَ لَهُ مِنَ الْحَقِّ وَاتِّبَاعِ مَا تَبَيَّنَ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_230", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَالَ: يُجَادِلُونَكَ فِي الْحَقِّ بَعْدَ مَا تَبَيَّنَ. وَقَالَ: هَا أَنْتُمْ هَؤُلَاءِ حَاجَجْتُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_232", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَيُقَالُ لَهُمْ: هَذَا وَنَظَائِرُهُ كَلَامُ مَنْ لَمْ يَفْهَمِ الْقُرْآنَ، بَلْ وَلَا يَفْهَمُ كَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_233", "reason": "high_symbol_ratio:0.410", "chunk_text": "لَكِنْ إِنْ كَانَ حَكِيمًا فِي كَلَامِهِ كَانَ لِلسُّكُوتِ عَنْ دُعَائِهِمْ فِي بَعْضِ الْمَوَاضِعِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_234", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَفَتَرَاهُ لَمَّا أَمَرَ أُمَّتَهُ أَنْ يَقُولُوا وَنَحْنُ لَهُ مُخْلِصُونَ لَمْ يَكُنْ أَهْلُ الْك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_235", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَكَذَلِكَ دَعَاهُمْ إِلَى الْإِسْلَامِ وَتَوَعَّدَهُمْ عَلَى التَّوَلِّي عَنْهُ فِي مِثْلِ: شَهِدَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_236", "reason": "high_symbol_ratio:0.411", "chunk_text": "أَأَسْلَمْتُمْ فَإِنْ أَسْلَمُوا فَقَدِ اهْتَدَوْا وَإِنْ تَوَلَّوْا فَإِنَّمَا عَلَيْكَ الْبَلَاغُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_238", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَقَدْ بَيَّنَ - سُبْحَانَهُ - أَنَّهُ لَا يَرْغَبُ عَنْ مِلَّةِ إِبْرَاهِيمَ إِلَّا مَنْ سَفِهَ نَف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_239", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَذَكَرَ أَنَّ إِبْرَاهِيمَ وَصَّى بِهَا بَنِيهِ، وَيَعْقُوبُ وَصَّى بِهَا بَنِيهِ أَيْضًا، كِلَاهُم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_240", "reason": "high_symbol_ratio:0.408", "chunk_text": "ثُمَّ ذَكَرَ أَنَّ يَعْقُوبَ عِنْدَ مَوْتِهِ: إِذْ قَالَ لِبَنِيهِ مَا تَعْبُدُونَ مِنْ بَعْدِي قَال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_242", "reason": "high_symbol_ratio:0.403", "chunk_text": "ثُمَّ قَالَ: قُولُوا آمَنَّا بِاللَّهِ وَمَا أُنْزِلَ إِلَيْنَا وَمَا أُنْزِلَ إِلَى إِبْرَاهِيمَ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_243", "reason": "high_symbol_ratio:0.406", "chunk_text": "ثُمَّ قَالَ: فَإِنْ آمَنُوا بِمِثْلِ مَا آمَنْتُمْ بِهِ فَقَدِ اهْتَدَوْا وَإِنْ تَوَلَّوْا فَإِنَّم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_244", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَقَدْ أَخْبَرَ أَنَّهُمْ إِنْ تَوَلَّوْا عَنِ الْإِيمَانِ بِمِثْلِ مَا آمَنْتُمْ بِهِ الْمُتَضَمِّن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_245", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَاعْتَبِرُوا يَاأُولِي الْأَبْصَارِ - إِلَى قَوْلِهِ - ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُول"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_246", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَوْلُهُ تَعَالَى: وَنَحْنُ لَهُ مُسْلِمُونَ فِي الْعَنْكَبُوتِ فَهُوَ مِثْلُ قَوْلِهِ: وَنَحْنُ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_247", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَقَدْ دَعَاهُمْ أَوَّلًا إِلَى الْإِسْلَامِ، وَهُوَ عِبَادَةُ اللَّهِ وَحْدَهُ، لَا شَرِيكَ لَهُ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_248", "reason": "high_symbol_ratio:0.401", "chunk_text": "ثُمَّ قَالَ تَعَالَى: فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ. وَهَذِهِ الْآيَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_249", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَقَالَ فِي كِتَابِهِ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_250", "reason": "high_symbol_ratio:0.415", "chunk_text": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ، مِنْ مُحَمَّدٍ رَسُولِ اللَّهِ إِلَى هِرَقْلَ عَظِيمِ الرُّوم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_251", "reason": "high_symbol_ratio:0.408", "chunk_text": "بِأَنَّا مُسْلِمُونَ. فَدَعَاهُ النَّبِيُّ إِلَى الْإِسْلَامِ، فِي كِتَابِهِ الَّذِي أَرْسَلَهُ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_252", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَذَكَرَ التَّوْحِيدَ فِي هَذِهِ الْآيَةِ، وَكَفَّرَ مَنِ اتَّخَذَ الْمَلَائِكَةَ وَالنَّبِيِّينَ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_253", "reason": "high_symbol_ratio:0.403", "chunk_text": "هُمُ الْفَاسِقُونَ * أَفَغَيْرَ دِينِ اللَّهِ يَبْغُونَ وَلَهُ أَسْلَمَ مَنْ فِي السَّمَاوَاتِ وَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_254", "reason": "high_symbol_ratio:0.442", "chunk_text": "فَقَدْ ذَكَرَ أَنَّهُ أَخَذَ الْمِيثَاقَ عَلَى النَّبِيِّينَ وَأُمَمِهِمْ: مَهْمَا آتَيْتُكُمْ مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_255", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَهَذَا يَتَنَاوَلُ الْأَمْرَ لِكُلِّ أَهْلِ الْكِتَابِ إِذَا جَاءَهُمْ رَسُولٌ ثَانٍ أَنْ يُؤْمِنُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_256", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَنَخُصُّ الْإِيمَانَ بِمُحَمَّدٍ ، فَإِنَّهُ خَاتَمُ الرُّسُلِ، وَهُوَ آخِرُ رَسُولٍ جَاءَ مُصَدِّق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_257", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَهَذَا الْمِيثَاقُ أَخَذَهُ اللَّهُ عَلَى الْأَنْبِيَاءِ، وَأَخَذُوهُ عَلَى أُمَمِهِمْ، ثُمَّ قَالَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_259", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَنَحْنُ لَهُ مُسْلِمُونَ. فَهُوَ أَمَرٌ لِلْمُؤْمِنِينَ أَنْ يَقُولُوا الْحَقَّ الَّذِي أَوْجَبَهُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_260", "reason": "high_symbol_ratio:0.404", "chunk_text": "كَمَا قَالَ تَعَالَى فِي الْآيَةِ الْأُخْرَى: قُلْ أَتُحَاجُّونَنَا فِي اللَّهِ وَهُوَ رَبُّنَا وَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_261", "reason": "high_symbol_ratio:0.437", "chunk_text": "فَإِنَّا مُشْتَرِكُونَ فِي أَنَّهُ رَبُّنَا كُلِّنَا وَأَنَّ عَمَلَ كُلِّ عَامِلٍ لَهُ لَا لِغَيْرِه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_262", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَيُشْبِهُ ذَلِكَ قَوْلُهُ تَعَالَى: قُلْ يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_263", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَأَمْرُهُ لَهُمْ أَنْ يَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ يَتَضَمَّنُ إِقَامَةَ الْحُجَّةِ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_265", "reason": "high_symbol_ratio:0.425", "chunk_text": "لِلشَّيَاطِينِ وَأَرَاقُوا دَمًا زَكِيًّا دَمَ بَنِيهِمْ وَبَنَاتِهِمُ الَّذِينَ ذَبَحُوا لِلْمَنْحُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_266", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَالَ أَيْضًا عَلَى لِسَانِ أَشْعِيَا النَّبِيِّ يَقُولُ اللَّهُ فِي بَنِي إِسْرَائِيلَ: لَمْ يَسْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_267", "reason": "high_symbol_ratio:0.419", "chunk_text": "هَكَذَا قَالَ اللَّهُ عَلَى سُكَّانِ بَيْتِ الْمَقْدِسِ مِنْ بَنِي إِسْرَائِيلَ: سَأُبَدِّدُهُمْ بَي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_268", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَقَالَ أَشْعِيَا النَّبِيُّ يَقُولُ اللَّهُ: (يَا بَنِي إِسْرَائِيلَ نَجَّسْتُمْ جَبَلِي الْمُقَدَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_269", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَقَالَ أَشْعِيَا أَيْضًا: (إِنَّ اللَّهَ قَدْ بَغَضَ بَنِي إِسْرَائِيلَ، وَأَخْرَجَهُمْ مِنْ بُيُوت"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_270", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَقَالَ أَرْمِيَا النَّبِيُّ : (كَمَا أَنَّ الْحَبَشِيَّ لَا يَسْتَطِيعُ أَنْ يَكُونَ أَبْيَضًا، فَك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_271", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَقَالَ حِزْقِيلُ النَّبِيُّ : (قَالَ اللَّهُ: إِنَّمَا رَفَعْتُ يَدِي عَنْ بَنِي إِسْرَائِيلَ وَبَد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_272", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَمِثْلُ هَذَا الْقَوْلِ فِي التَّوْرَاةِ، وَكُتُبِ الْأَنْبِيَاءِ، وَزَبُورِ دَاوُدَ شَيْءٌ كَثِيرٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_274", "reason": "high_symbol_ratio:0.425", "chunk_text": "أَتَاهُمْ كَفَرُوا بِهِ وَكَذَّبُوهُ فَلَمَّا بُعِثَ مُحَمَّدٌ كَذَّبُوهُ فَبَاءُوا بِغَضَبٍ عَلَى غ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_275", "reason": "high_symbol_ratio:0.403", "chunk_text": "كَمَا قَالَ تَعَالَى عَنْهُمْ: أَفَتُؤْمِنُونَ بِبَعْضِ الْكِتَابِ وَتَكْفُرُونَ بِبَعْضٍ فَمَا جَزَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_278", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَأُشْرِبُوا فِي قُلُوبِهِمُ الْعِجْلَ بِكُفْرِهِمْ قُلْ بِئْسَمَا يَأْمُرُكُمْ بِهِ إِيمَانُكُمْ إِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_279", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَغَضِبَ عَلَيْهِمْ أَوَّلًا بِتَكْذِيبِ الْمَسِيحِ، وَثَانِيًا بِتَكْذِيبِ مُحَمَّدٍ . وَقَالَ تَعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_281", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَالَ تَعَالَى: قُلْ هَلْ أُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَلِكَ مَثُوبَةً عِنْدَ اللَّهِ مَنْ لَعَنَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_282", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَتَبَيَّنَ أَنَّ الْيَهُودَ لَعَنَهُمُ اللَّهُ وَأَنَّهُمْ عَبَدُوا الطَّاغُوتَ، وَأَنَّهُ جَعَلَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_283", "reason": "high_symbol_ratio:0.408", "chunk_text": "فِي قَوْلِهِ: وَلَا تُجَادِلُوا أَهْلَ الْكِتَابِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ إِلَّا الَّذِينَ ظَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_284", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَإِنَّ قَوْلَهُ تَعَالَى: وَلَا تُجَادِلُوا أَهْلَ الْكِتَابِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ. نَهْي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_285", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَقَوْلَهُ: إِلَّا الَّذِينَ ظَلَمُوا. مِنَ الطَّائِفَتَيْنِ جَمِيعًا."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_286", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَلِهَذَا كَانَ الْوَاجِبُ عَلَى الْمُسْلِمِينَ، إِذَا جَادَلَهُمُ الْيَهُودِيُّ وَالنَّصْرَانِيُّ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_287", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَكَمَا جَاهَدَ النَّصَارَى عَامَ تَبُوكٍ غَزَاهُمْ بِالشَّامِ عَرَبَهُمْ وَرُومَهُمْ، وَأَغْزَاهُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_288", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالنَّبِيُّ لَمَّا قَدِمَ وَفَدُ نَجْرَانَ النَّصَارَى جَادَلَهُمْ فِي مَسْجِدِهِ بِالَّتِي هِيَ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_289", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمِنْ أَعْجَبِ الْأَشْيَاءِ قَوْلُهُمْ: وَأَمَّا الَّذِينَ ظَلَمُوا، فَلَا يَشُكُّ أَحَدٌ أَنَّهُمُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_290", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَهِيَ مِنْ جِنْسِ قَوْلِهِمْ فِي قَوْلِهِ: ذَلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ هُدًى لِلْمُتَّقِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_291", "reason": "high_symbol_ratio:0.427", "chunk_text": "أَنَّهُ عَنَى بِالْكِتَابِ الْإِنْجِيلَ، وَالَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ: النَّصَارَى، وَالَّذِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_292", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَتَفَاسِيرُ النَّصَارَى لِلْكُتُبِ الْإِلَهِيَّةِ فِيهَا مِنَ التَّحْرِيفِ لِكَلِمَاتِ اللَّهِ، وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_293", "reason": "high_symbol_ratio:0.438", "chunk_text": "وَقَوْلَهُ: لَقَدْ أَرْسَلْنَا رُسُلَنَا أَرَادَ بِهِ الْحَوَارِيِّينَ. وَقَوْلَهُ: وَأَنْزَلَ مَعَه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_294", "reason": "high_symbol_ratio:0.422", "chunk_text": "أَرَادَ بِهِ الْإِنْجِيلَ ] فَإِنَّ فِي هَذَا مِنَ الْكَذِبِ الظَّاهِرِ، وَالِافْتِرَاءِ عَلَى مُحَم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_295", "reason": "high_symbol_ratio:0.423", "chunk_text": "الْقُرْآنِ وَالدِّينِ يَعْلَمُ عِلْمًا يَقِينِيًّا ضَرُورِيًّا أَنَّ مُحَمَّدًا لَمْ يَكُنْ يَجْعَلُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_298", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَمَا أَخْبَرُونَا بِهِ عَنِ الْأَنْبِيَاءِ إِنْ عَلِمْنَا صِدْقَهُمْ فِيهِ، صَدَّقْنَاهُمْ فِيهِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_299", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَإِنَّ الْإِيمَانَ بِجَمِيعِ مَا أُوتِيَ النَّبِيُّونَ حَقٌّ وَاجِبٌ، لَكِنَّ وُجُوبَ التَّصْدِيقِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_300", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَهَاتَانِ الْمُقَدِّمَتَانِ، لَابُدَّ مِنْهُمَا فِي جَمِيعِ الْمَنْقُولِ عَنِ الْأَنْبِيَاءِ. وَقَد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_302", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَقَالَ تَعَالَى: وَقَالُوا اتَّخَذَ الرَّحْمَنُ وَلَدًا * لَقَدْ جِئْتُمْ شَيْئًا إِدًّا * تَكَادُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_303", "reason": "high_symbol_ratio:0.404", "chunk_text": "بَأْسًا شَدِيدًا مِنْ لَدُنْهُ وَيُبَشِّرَ الْمُؤْمِنِينَ الَّذِينَ يَعْمَلُونَ الصَّالِحَاتِ أَنَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_308", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَقَالَ تَعَالَى:، لَمَّا قَصَّ قِصَّةَ الْمَسِيحِ : ذَلِكَ عِيسَى ابْنُ مَرْيَمَ قَوْلَ الْحَقِّ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_311", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَذَلِكَ فِي التَّوْحِيدِ، وَالْأَنْبِيَاءِ، وَالشَّرَائِعِ، وَالْحَلَالِ وَالْحَرَامِ وَالْأَخْلَاق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_312", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَالْيَهُودُ يُشَبِّهُونَ الْخَالِقَ بِالْمَخْلُوقِ فِي صِفَاتِ النَّقْصِ الْمُخْتَصَّةِ بِالْمَخْلُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_313", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَكُلٌّ مِنَ الْقَوْلَيْنِ يَسْتَلْزِمُ الْآخَرَ. وَالنَّصَارَى أَيْضًا يَصِفُونَ اللَّاهُوتَ بِصِفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_314", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْيَهُودُ تَزْعُمُ أَنَّ اللَّهَ يَمْتَنِعُ مِنْهُ أَنْ يَنْسَخَ مَا شَرَعَهُ، كَمَا يَمْتَنِعُ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_315", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالنَّصَارَى يُجَوِّزُونَ لِأَكَابِرِهِمْ أَنْ يَنْسَخُوا شَرْعَ اللَّهِ الَّذِي بَعَثَ بِهِ رُسُلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_316", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَيُوجِبُونَ مَا أَسْقَطَ، كَمَا أَوْجَبُوا مِنَ الْقَوَانِينِ مَا لَمْ يُوجِبْهُ اللَّهُ وَأَنْبِيَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_317", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالُوا: أَلَا لَهُ الْخَلْقُ وَالْأَمْرُ، فَكَمَا لَا يَخْلُقُ غَيْرُهُ لَا يَأْمُرُ غَيْرُهُ، بَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_318", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالْيَهُودُ بَالَغُوا فِي اجْتِنَابِ النَّجَاسَاتِ، وَتَحْرِيمِ الطَّيِّبَاتِ، وَالنَّصَارَى اسْتَح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_319", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالْيَهُودُ يُبَالِغُونَ فِي طَهَارَةِ أَبْدَانِهِمْ مَعَ خُبْثِ قُلُوبِهِمْ وَالنَّصَارَى يَدَّعُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_320", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالنَّصَارَى لَهُمْ عِبَادَاتٌ وَأَخْلَاقٌ، بِلَا عِلْمٍ وَمَعْرِفَةٍ وَلَا ذَكَاءٍ، وَالْيَهُودُ ل"}
