{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_666", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَالْإِرَادَةُ تَسْتَلْزِمُ تَصَوُّرَ الْمُرَادِ فَلَابُدَّ أَنْ يَعْلَمَ الْمَخْلُوقَاتِ قَبْلَ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_667", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَكُلُّ مَا وُجِدَ فِي الْخَارِجِ فَهُوَ مَوْجُودٌ وُجُودًا مُعَيَّنًا يَمْتَازُ بِهِ عَنْ غَيْرِهِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_668", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَكُلُّ وَاحِدٍ مِنَ الْأَفْلَاكِ مُعَيَّنٌ، فَلَوْ لَمْ يَعْلَمْ إِلَّا الْكُلِّيَّاتِ لَمْ يَكُنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_669", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَإِنَّ التَّكَثُّرَ فِيمَا يَقُومُ بِهِ مِنَ الْمَعَانِي هُوَ مَدْلُولُ الْأَدِلَّةِ الْعَقْلِيَّةِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_670", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَأَيْضًا فَإِنَّهُ خَالِقُ الْعَالَمِينَ مِنَ الْمَلَائِكَةِ وَالْجِنِّ وَالْإِنْسِ، وَجَاعِلُهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_672", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَأَيْضًا فَإِنَّهُ حَيٌّ، وَالْحَيَاةُ مُسْتَلْزِمَةٌ لِجِنْسِ الْعِلْمِ، وَإِذَا كَانَتْ حَيَاتُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_673", "reason": "high_symbol_ratio:0.415", "chunk_text": "لَا سِيَّمَا وَدَلَائِلُ كَوْنِهِ قَادِرًا أَظْهَرُ مِنْ دَلَائِلِ كَوْنِهِ عَالِمًا، فَإِنَّ نَفْسَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_674", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَقَالَ تَعَالَى: أَوْلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةً."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_675", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ حَدِيثُ الِاسْتِخَارَةِ: اللَّهُمَّ إِنِّي أَسَتُخِيرُكَ بِعِلْمِكَ وَأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_676", "reason": "high_symbol_ratio:0.428", "chunk_text": "الْفَاعِلِ فَيَجِبُ أَنْ يُثْبِتُوا لَهُ صِفَةَ الْقُدْرَةِ مَعَ الْعِلْمِ. وَكَذَلِكَ يَقُولُونَ: إ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_677", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَكَذَلِكَ فِي النُّطْقِ إِذَا أُرِيدَ بِهِ الْبَيَانُ وَالْعِبَارَةُ، وَلَمْ يُرَدْ بِهِ مُجَرَّدُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_678", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمِمَّا يُسْتَدَلُّ بِهِ عَلَى ثُبُوتِ جَمِيعِ صِفَاتِ الْكَمَالِ أَنَّهُ لَوْ لَمْ يُوصَفْ بِكَوْن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_679", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَيَمْتَنِعُ أَنْ يَكُونَ هُوَ شَيْئًا عَاجِزًا جَاهِلًا أَصَمَّ أَبْكَمَ أَخْرَسَ، بَلْ مِنَ الْمَع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_680", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَلِبَعْضِ الْمَلَاحِدَةِ مِنَ الْمُتَفَلْسِفَةِ وَمَنِ اتَّبَعَهُمْ هُنَا سُؤَالٌ مَشْهُورٌ وَهُوَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_681", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَالُوا: هَذِهِ الصِّفَاتُ مُتَقَابِلَةٌ تُقَابِلُ الْعَدَمَ وَالْمَلَكَةَ، وَهُوَ عَدَمُ الشَّيْءِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_682", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْكَلَامُ عَنِ الْحَيَوَانِ الَّذِي هُوَ الْقَابِلُ لَهُ، فَإِذَا لَمْ يَكُنْ قَابِلًا لَهُ كَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_683", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَجَوَابُ ذَلِكَ مِنْ أَوْجُهٍ: أَحَدُهَا: أَنَّهُ إِمَّا أَنْ يَكُونَ قَابِلًا لِلِاتِّصَافِ بِصِفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_684", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَإِنْ لَمْ يَكُنْ قَابِلًا لَزِمَ أَنْ يَكُونَ أَنْقَصَ مِمَّنْ قَبِلَهَا، وَلَمْ يَتَّصِفْ بِهَا، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_686", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْوَجْهُ الثَّانِي: أَنَّ جَعْلَهُمْ سَلْبَ الْمَوْتِ وَالصَّمَمِ وَالْبُكْمِ عَنِ الْجَمَادِ لِزَع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_687", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنَّهُ يَكْفِي عَدَمُ هَذِهِ الصِّفَاتِ، فَإِنَّ مُجَرَّدَ عَدَمِ الْحَيَاةِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_688", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَعُلِمَ أَنَّ نَفْيَ هَذِهِ الصِّفَاتِ عَنْهُ، وَنَفْيَ قَبُولِهَا يُوجِبُ أَنْ يَكُونَ أَنْقَصَ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_689", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْوَجْهُ الرَّابِعُ: أَنَّ الْكَمَالَ فِي الْوُجُودِ، وَالنَّقْصَ فِي الْعَدَمِ، فَنَفْسُ ثُبُوتِ ه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_690", "reason": "high_symbol_ratio:0.441", "chunk_text": "أَنَّ هَؤُلَاءِ الْقَوْمَ مِنْ أَجْهَلِ أَهْلِ الْمِلَلِ بِالرَّبِّ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_691", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالطُّرُقُ الَّتِي يُعْرَفُ بِهَا كَمَالُهُ فِيهَا الْعَقْلِيَّةُ وَالسَّمْعِيَّةُ، وَأَنَّ الْقَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_693", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَالذَّاتُ عِنْدَنَا: الْأَبُ الَّذِي هُوَ ابْتِدَاءُ الِاثْنَيْنِ. وَالنُّطْقُ: الِابْنُ الَّذِي هُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_694", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالْحَيَاةُ: هِيَ الرُّوحُ الْقُدُسُ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_695", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَالْجَوَابُ عَنْ هَذَا مِنْ وُجُوهٍ: الْأَوَّلُ أَنَّ أَسْمَاءَ اللَّهِ تَبَارَكَ وَتَعَالَى مُتَعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_698", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنِ النَّبِيِّ أَنَّهُ قَالَ: إِنَّ لِلَّهِ تِسْعَةً وَتِسْعِينَ اسْمًا مَنْ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_699", "reason": "high_symbol_ratio:0.433", "chunk_text": "عَبْدُكَ ابْنُ عَبْدِكَ ابْنُ أَمَتِكَ، نَاصِيَتِي بِيَدِكَ، مَاضٍ فِيَّ حُكْمُكَ، عَدْلٌ فِي قَضَاؤ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_700", "reason": "high_symbol_ratio:0.408", "chunk_text": "يَتَعَلَّمَهُنَّ. وَإِذَا كَانَتْ أَسْمَاءُ اللَّهِ كَثِيرَةً، كَالْعَزِيزِ وَالْقَدِيرِ وَغَيْرِهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_701", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْوَجْهُ الثَّانِي: قَوْلُهُمُ الْأَبُ الَّذِي هُوَ ابْتِدَاءُ الِاثْنَيْنِ، وَالِابْنُ: النُّطْقُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_702", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَإِذَا قَالُوا: إِنَّ الْأَبَ الَّذِي هُوَ الذَّاتُ، هُوَ ابْتِدَاءُ الْحَيَاةِ وَالنُّطْقِ اقْتَضَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_703", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهَذَا فِي حَقِّ اللَّهِ بَاطِلٌ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_704", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَكَذَلِكَ قَوْلُهُمْ: إِنَّ النُّطْقَ مَوْلُودٌ مِنْهُ كَوِلَادَةِ النُّطْقِ مِنَ الْعَقْلِ، فَإِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_705", "reason": "high_symbol_ratio:0.419", "chunk_text": "نَاطِقًا بِالْقُوَّةِ، ثُمَّ صَارَ نَاطِقًا بِالْفِعْلِ فَيَلْزَمُ أَنَّهُ صَارَ عَالِمًا بَعْدَ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_706", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَذَلِكَ دَوْرٌ مُمْتَنِعٌ فِي صَرِيحِ الْعَقْلِ، إِذْ كَانَ الشَّيْءُ لَا يَجْعَلُ غَيْرَهُ مُتَّصِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_707", "reason": "high_symbol_ratio:0.412", "chunk_text": "مُتَقَدِّمٌ عَلَيْهَا أَوْ فَاعِلٌ لَهَا. الْوَجْهُ الثَّالِثُ: أَنَّ قَوْلَهُمْ فِي الِابْنِ أَنَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_708", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْوَجْهُ الرَّابِعُ: أَنَّ تَسْمِيَةَ حَيَاةِ اللَّهِ رُوحَ الْقُدُسِ أَمْرٌ لَمْ يَنْطِقْ بِهِ شَي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_709", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْوَجْهُ الْخَامِسُ: أَنَّهُمْ يَدَّعُونَ أَنَّ الْمُتَّحِدَ بِالْمَسِيحِ هُوَ الْكَلِمَةُ الَّذِي "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_710", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَإِنْ قَالُوا الْمُتَّحِدُ بِهِ هُوَ الْعِلْمُ، فَالْعِلْمُ صِفَةٌ لَا تُفَارِقُ الْعَالِمَ، وَلَا "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_711", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْوَجْهُ السَّادِسُ: أَنَّ الْعِلْمَ أَيْضًا صِفَةٌ، وَالصِّفَةُ لَا تُخْلَقُ وَلَا تُرْزَقُ، وَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_712", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَلَوْ قَالَ قَائِلٌ: يَا حَيَاةَ اللَّهِ، أَوْ يَا عِلْمَ اللَّهِ، أَوْ يَا كَلَامَ اللَّهِ، اغْفِر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_713", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْمَسِيحُ عِنْدَكُمْ هُوَ الْإِلَهُ الْخَالِقُ الَّذِي يُقَالُ لَهُ اغْفِرْ لَنَا وَارْحَمْنَا، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_714", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَمَعْلُومٌ أَنَّ الْمَسِيحَ لَيْسَ هُوَ كَلِمَاتٍ كَثِيرَةً، بَلْ غَايَتُهُ أَنْ يَكُونَ كَلِمَةً و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_715", "reason": "high_symbol_ratio:0.424", "chunk_text": "الْوَجْهُ السَّابِعُ: أَنَّ أَمَانَتَكُمُ الَّتِي وَضَعَهَا أَكَابِرُكُمْ بِحَضْرَةِ قُسْطَنْطِينَ، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_716", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَهَذَانِ أَمْرَانِ مَعْرُوفَانِ فِي دِينِكُمْ تَنَاقُضُكُمْ وَإِظْهَارُكُمْ فِي الْمُنَاظَرَةِ بِخِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_717", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْجَوْهَرِ الَّذِي بِهِ كَانَ كُلُّ شَيْءٍ، الَّذِي مِنْ أَجْلِنَا نَحْنُ الْبَشَرَ، وَمِنْ أَجْلِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_718", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَمُمَجَّدٍ نَاطِقٍ فِي الْأَنْبِيَاءِ، كَنِيسَةٌ وَاحِدَةٌ جَامِعَةٌ رَسُولِيَّةٌ، وَأَعْتَرِفُ بِم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_720", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَنَّهُ لَا إِلَهَ إِلَّا أَنَا فَاعْبُدُونِ. وَقَالَ تَعَالَى: وَسْئَلْ مَنْ أَرْسَلْنَا مِنْ قَبْل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_721", "reason": "high_symbol_ratio:0.420", "chunk_text": "ثُمَّ قُلْتُمْ: وَبِرَبٍّ وَاحِدٍ يَسُوعَ الْمَسِيحِ ابْنِ اللَّهِ الْوَحِيدِ الْمَوْلُودِ مِنَ الْأ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_722", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَهَذَا تَصْرِيحٌ بِالْإِيمَانِ بِإِلَهَيْنِ، أَحَدُهُمَا مِنَ الْآخَرِ، وَعِلْمُ اللَّهِ الْقَائِمُ"}
