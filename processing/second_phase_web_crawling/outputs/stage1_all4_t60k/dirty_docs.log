{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_772", "reason": "high_symbol_ratio:0.409", "chunk_text": "مَعَهُ فِي الْبَيْتِ قَالَ فَكُنْتُ أَسْمَعُهُ يَتَأَوَّهُ فِي اللَّيْلِ مِنَ الضَّرْبِ يَقُول الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_777", "reason": "high_symbol_ratio:0.406", "chunk_text": "ضَرْبًا مُبْرِحًا وَكَانَ حلف هرون عَلَيْهِ فِي عَمَلٍ أَرَادَ أَنْ يَسْتَعْمِلَهُ عَلَيْهِ فَحَلَفَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_778", "reason": "high_symbol_ratio:0.410", "chunk_text": "مُصْعَبٍ وَابْنِ دِينَارٍ وَمُحَمَّدِ بْنِ عُثْمَانَ بْنِ أَبِي رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْم"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_780", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَضَرَبَهُ مِائَةَ سَوْطٍ قَالَ فَقِيلَ ذَلِكَ لِسَعِيدِ بْنِ الْمُسَيِّبِ قَالَ فَبَكَى قَالَ بَقِي"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_787", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْقَصَبُ تَحْمِلُ مَا مَرَّتْ عَلَيْهِ مِنَ اللَّحْمِ حَتَّى مَا تَرَكَتْ مِنْهُ شَيْئًا إِلا شَرَّ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_788", "reason": "high_symbol_ratio:0.400", "chunk_text": "قَالَ فاتى مَعْدٌ الْحَجَّاجَ فَقَالَ أَيُّهَا الأَمِيرُ قَدْ أَفْسَدَ عَلَيَّ أَهْلَ السِّجْنِ قَال"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_789", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَدْ مَاتَ رَحِمَهُ اللَّهُ ===ذِكْرُ ضَرْبِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ الْجُمَحِيِّ وَث"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_790", "reason": "high_symbol_ratio:0.415", "chunk_text": "يَضْرِبَهُ وَيُخْرِجَهُ مِنَ الْمَدِينَةِ قَالَ فَأَرْسَلَ إِلَيْهِ فَأَحْضَرَهُ قَالَ فَكُنْتُ فِيم"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_791", "reason": "high_symbol_ratio:0.404", "chunk_text": "امْتُحِنَ فِيهِ زَيْدُ بْنُ الْحَسَنِ بْنِ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ=== قَالَ أَبُو الْعَرَبِ حَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_797", "reason": "high_symbol_ratio:0.408", "chunk_text": "طَائِفَةٍ مِنَ الْمُسْلِمِينَ فَاقْتَطَعُوهُمْ وَمِنْهُمْ عَبْدُ اللَّهِ بْنُ حُذَافَةَ السَّهْمِيُّ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_799", "reason": "high_symbol_ratio:0.413", "chunk_text": "هِرَقْلُ فَأَتَاهُ فَقَالَ لَهُ هِرَقْلُ قَدْ بَلَوْتُكَ بِالسَّرَّاءِ وَالضَّرَّاءِ فَصَبَرْتَ فَهَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_802", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَكُلْهُ فَذَبَحَ جَدْيًا فَأَعْطَاهُ إِيَّاهُ فَأَمَرَهُ أَنْ يَطْعَمَهُ فَأَبَى أَنْ يَأْكُلَهُ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_808", "reason": "high_symbol_ratio:0.403", "chunk_text": "عُمَرُ خَوْفًا مِنْهُ عَلَيْهِمُ الزَّلَلَ إِذَا أَكْثَرُوا وَلَمْ يَكُونُوا عِنْدَهُ مُتَّهَمِينَ ب"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_809", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَأَبِي الدَّرْدَاءِ مَا هَذَا الْحَدِيثُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَا"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_810", "reason": "high_symbol_ratio:0.402", "chunk_text": "قَتَلْتُمُونَا وَإِنْ كَذَبْنَاكُمْ خَشِينَا اللَّهَ تَبَارَكَ وَتَعَالَى فَنَظَرَ إِلَيْهِ الْحَجَّ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_811", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَعَبْدَ الرَّحْمَنِ بْنَ عَبْدِ اللَّهِ الْجُمَحِيَّ وَنَفَى عِرَاكَ بْنَ مَالِكٍ ===ذِكْرُ سَبَبَ "}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_819", "reason": "high_symbol_ratio:0.409", "chunk_text": "عَامله أَن يَأْخُذ إِبْرَاهِيمُ بْنُ يَزِيدَ قَالَ فَكَتَبَ إِلَيْهِ أَنْ قَبِلْنَا إِبْرَاهِيمَ بْن"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_823", "reason": "high_symbol_ratio:0.405", "chunk_text": "إِبْرَاهِيمُ بْنُ يَزِيدَ التَّيْمِيُّ يُكَنَّى أَبَا أَسْمَاءَ مَاتَ فِي حَبْسِ الْحَجَّاجِ سَنَةَ "}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_831", "reason": "high_symbol_ratio:0.407", "chunk_text": "النَّخَعِيَّ كَانَ فِي الدِّيوَانِ وَكَانَ مَكْتَبُهُ بِحُلْوَانَ فَضَرَبَهُ حَوْشَبُ بْنُ الْعَوَّا"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_832", "reason": "high_symbol_ratio:0.406", "chunk_text": "حضر الرجل قُلْتُ نَعَمْ فَقَالَ مَا تُرِكَ مِثْلُهُ قَالَ ثُمَّ قَدِمْتُ الْبَصْرَةَ عَلَى ابْنِ سِي"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_842", "reason": "high_symbol_ratio:0.401", "chunk_text": "اللَّهُ الأَمِيرَ أَحْزَنَ بِنَا الْمَنْزِلُ وَأَجْدَبَ الْجَنَابُ وَضَاقَ الْمَسْلَكُ وَاكْتَحَلْنَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_846", "reason": "high_symbol_ratio:0.409", "chunk_text": "الْمُطَبَّقِ بَعْضُ أُولَئِكَ التَّابِعِينَ فَرُبَّمَا ذَكَرُوا الصَّحَابَةَ قَالَ فَلَمَّا طَالَ ذَ"}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_850", "reason": "high_symbol_ratio:0.401", "chunk_text": "مَعَهُ ابْنُ عَجْلانَ وَغَيْرُهُ وَهَرَبَ مَالِكٌ وَلَمْ يَخْرُجْ مَعَهُ وَقَدْ حَدَّثَنِي أَحْمَدُ "}
{"source": "wikisource", "raw_id": "arwikisource:105315:434592#chunk_852", "reason": "high_symbol_ratio:0.410", "chunk_text": "قَالَ قَدِمَ عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ فَصَلَّى وَوَضَعَ رِدَاءَهُ بَيْنَ الصُّفُوفِ فَلَمَّ"}
