{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_967", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ تَعَالَى: سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_968", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَقَدْ قِيلَ: إِنَّ الضَّمِيرَ عَائِدٌ إِلَى اللَّهِ، وَالصَّوَابُ الْأَوَّلُ كَمَا قَالَ: قُلْ أَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_969", "reason": "high_symbol_ratio:0.424", "chunk_text": "ثُمَّ قَالَ بَعْدَ ذَلِكَ: سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_970", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِذَا كَانَ الْقُرْآنُ حَقًّا لَزِمَ كَوْنُ الرَّسُولِ الَّذِي جَاءَ بِهِ صَادِقًا، وَأَنَّ اللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_972", "reason": "high_symbol_ratio:0.400", "chunk_text": "الَّذِي أُوتِيتُهُ وَحْيًا أَوْحَاهُ اللَّهُ إِلَيَّ فَأَرْجُو أَنْ أَكُونَ أَكْثَرَهُمْ تَابِعًا يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_973", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَعَادٍ وَثَمُودَ وَالَّذِينَ مِنْ بَعْدِهِمْ لَا يَعْلَمُهُمْ إِلَّا اللَّهُ جَاءَتْهُمْ رُسُلُهُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_974", "reason": "high_symbol_ratio:0.411", "chunk_text": "رُسُلُهُمْ بِالْبَيِّنَاتِ فَعُلِمَ أَنَّهُمْ جَاءُوا بِالْبَيِّنَاتِ وَقَالَ: فَإِنْ كَذَّبُوكَ فَق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_975", "reason": "high_symbol_ratio:0.448", "chunk_text": "أَرْسَلَ إِلَيْهِمْ وَأَهْلَكَهُمْ فَلَمْ يُعَاقِبْهُمْ إِلَّا بَعْدَ أَنْ أَقَامَ عَلَيْهِمُ الْحُج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_976", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَقَالَ تَعَالَى: وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ إِلَّا رِجَالًا نُوحِي إِلَيْهِمْ فَاسْأَلُوا أَهْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_977", "reason": "high_symbol_ratio:0.409", "chunk_text": "بِتَجْدِيدِ الْكِتَابِ الَّذِي قَبْلَهُ وَقَالَ تَعَالَى: إِنَّا أَرْسَلْنَاكَ بِالْحَقِّ بَشِيرًا و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_978", "reason": "high_symbol_ratio:0.422", "chunk_text": "مَنْ حَقَّتْ عَلَيْهِ الضَّلَالَةُ فَسِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_979", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِنَّ الزُّبُرَ مِنَ الْبَيِّنَاتِ، وَالْكِتَابَ الْمُنِيرَ مِنَ الزُّبُرِ، وَهُوَ كَقَوْلِهِ: وَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_980", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَإِنَّ الْهُدَى مِنَ الْعِلْمِ، وَالْكِتَابَ الْمُنِيرَ مِنَ الْهُدَى. وَبَيَّنَ أَنَّهُ أَخَذَ الَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_981", "reason": "high_symbol_ratio:0.484", "chunk_text": "وَهَذِهِ السُّورَةُ مَكِّيَّةٌ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_982", "reason": "high_symbol_ratio:0.401", "chunk_text": "ثُمَّ أَنْزَلَ فِي آلِ عِمْرَانَ وَهِيَ مَدَنِيَّةٌ فِي سِيَاقِ الْآيَاتِ الَّتِي فِيهَا تَسْلِيَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_983", "reason": "high_symbol_ratio:0.408", "chunk_text": "يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ * إِنَّمَا ذَلِكُمُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_984", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَإِمْلَاءٌ إِلَى أَنْ قَالَ: لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_985", "reason": "high_symbol_ratio:0.412", "chunk_text": "هَذَا الْقَوْلَ مِنْهُمْ مَعَ أَنَّهُ كَذِبٌ فَلَمْ يَقُولُوهُ إِلَّا دَفْعًا لِلْحَقِّ لَا لِيُؤْمِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_986", "reason": "high_symbol_ratio:0.402", "chunk_text": "فِرْعَوْنَ وَأَنْتُمْ تَنْظُرُونَ - إِلَى قَوْلِهِ - وَإِذْ قُلْتُمْ يَا مُوسَى لَنْ نُؤْمِنَ لَكَ ح"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_987", "reason": "high_symbol_ratio:0.416", "chunk_text": "ثُمَّ قَالَ: فَإِنْ كَذَّبُوكَ فَقَدْ كُذِّبَ رُسُلٌ مِنْ قَبْلِكَ جَاءُوا بِالْبَيِّنَاتِ وَالزُّبُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_988", "reason": "high_symbol_ratio:0.428", "chunk_text": "فصل وَمِنْ آيَاتِ الْأَنْبِيَاءِ إِهْلَاكُ اللَّهِ لِمُكَذِّبِيهِمْ، وَنَصْرُهُ لِلْمُؤْمِنِينَ بِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_989", "reason": "high_symbol_ratio:0.416", "chunk_text": "أَنَّهَا مِنْ آيَاتِ الْأَنْبِيَاءِ الدَّالَّةِ عَلَى صِدْقِهِمْ كَمَا يَذْكُرُهُ فِي سُورَةِ الشُّع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_991", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَكَذَلِكَ فِي قِصَّةِ مُوسَى، وَهَارُونَ: وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ سَلَامٌ عَلَى مُوسَى"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_992", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَنَبَذْنَاهُمْ فِي الْيَمِّ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ * وَجَعَلْنَاهُمْ أَئِمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_994", "reason": "high_symbol_ratio:0.419", "chunk_text": "كَمَا ذَكَرَ اللَّهُ الطَّرِيقَيْنِ فِي قَوْلِهِ: وَلَيَنْصُرَنَّ اللَّهُ مَنْ يَنْصُرُهُ إِنَّ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_997", "reason": "high_symbol_ratio:0.403", "chunk_text": "فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ * ذَلِكَ بِأَنَّهُمْ ك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_998", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَلَمَّا رَأَوْا بَأْسَنَا قَالُوا آمَنَّا بِاللَّهِ وَحْدَهُ وَكَفَرْنَا بِمَا كُنَّا بِهِ مُشْرِكِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_999", "reason": "high_symbol_ratio:0.418", "chunk_text": "مِنْ شَيْءٍ لَمَّا جَاءَ أَمْرُ رَبِّكَ وَمَا زَادُوهُمْ غَيْرَ تَتْبِيبٍ * وَكَذَلِكَ أَخْذُ رَبِّك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1001", "reason": "high_symbol_ratio:0.414", "chunk_text": "بَيَّنَ سُبْحَانَهُ أَنَّ هَذِهِ وَهَذِهِ كِلَاهُمَا بِسَبِيلٍ لِلنَّاسِ يَرَوْنَهَا بِأَبْصَارِهِمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1002", "reason": "high_symbol_ratio:0.435", "chunk_text": "الْقَمَرِ عِنْدَ سُؤَالِ مُشْرِكِي مَكَّةَ آيَةً، وَأَمْثَالِ ذَلِكَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1004", "reason": "high_symbol_ratio:0.420", "chunk_text": "إِذَا جَوَّزْتُمْ عَلَى الرَّبِّ كُلَّ فِعْلٍ جَازَ أَنْ يُظْهِرَ الْخَوَارِقَ عَلَى يَدِ الْكَاذِبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1005", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَيُقَالُ: هَذَا السُّؤَالُ إِنْ كَانَ مُتَوَجِّهًا فَإِنَّمَا يَقْدَحُ فِي قَوْلِ هَؤُلَاءِ الَّذِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1006", "reason": "high_symbol_ratio:0.448", "chunk_text": "الْعِلْمِ بِصِدْقِ الرُّسُلِ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1007", "reason": "high_symbol_ratio:0.407", "chunk_text": "قَالُوا: إِذَا جَوَّزْتُمْ أَنْ يَفْعَلَ كُلَّ شَيْءٍ فَجَوِّزُوا أَنْ يَكُونَ الْجِبَالُ انْقَلَبَت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1008", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَنَّ اللَّهَ سُبْحَانَهُ وَتَعَالَى نَجَّى مُوسَى وَنَصَرَهُ لِصِدْقِهِ وَنُبُوَّتِهِ وَإِيمَانِه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1009", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْمَنْصُورُونَ * وَإِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ كَمَا لَا يَقْدَحُ مَا عُلِمَ بِالِاضْطِرَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1011", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَنُفَاةُ التَّعْلِيلِ يَقُولُونَ: نَحْنُ نَعْلَمُ أَنَّ هَذَا مُقَارِنٌ لِهَذَا بِحُكْمِ الْعَادَةِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1012", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَلَا جَرَمَ رَجَعُوا إِلَى فِطْرَتِهِ مِنْ أَنَّ هَذَا أَمْرٌ مَعْلُومٌ بِالِاضْطِرَارِ، وَإِنْ كَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1013", "reason": "high_symbol_ratio:0.412", "chunk_text": "لَكِنْ يُقَالُ لَهُمُ: الْمَلِكُ يَفْعَلُ فِعْلًا لِمَقْصُودٍ، فَأَمْكَنَ أَنْ يُقَالَ: إِنَّهُ قَام"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1014", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْأَشْعَرِيِّ فِي أَكْثَرِ كُتُبِهِ، وَأَحَدُ قَوْلَيْهِ، وَسَلَكَهَا الْقَاضِي أَبُو بَكْرٍ، وَأَب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1015", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَتَنَازَعُوا: هَلْ يُمْكِنُ خَلْقُ ذَلِكَ عَلَى يَدِ كَذَّابٍ؟ فَقِيلَ: لَا يُمْكِنُ لِأَنَّهُ لَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1016", "reason": "high_symbol_ratio:0.409", "chunk_text": "قَالُوا: فَنَحْنُ نَعْلَمُ بِالضَّرُورَةِ أَنَّهُ لَا يَفْعَلُهَا فَلَا يَلْزَمُ مِنْ كَوْنِهَا مَقْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1017", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَقَالُوا: الْمُعْجِزُ عَلَمٌ عَلَى صِدْقِ الْأَنْبِيَاءِ فَيَمْتَنِعُ أَنْ يَكُونَ الدَّلِيلُ غَيْر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1018", "reason": "high_symbol_ratio:0.414", "chunk_text": "مُنَزَّهٌ عَنْ أَنْ يَفْعَلَ أَشْيَاءَ لَا يَجُوزُ مِنْهُ فِعْلُ كُلِّ شَيْءٍ، وَهُمْ يَقُولُونَ هُن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1019", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَعَلَى هَذَا الْجَوَابِ يَعْتَمِدُونَ كَثِيرًا، كَمَا يَذْكُرُهُ الْقَاضِي أَبُو بَكْرٍ، وَالْقَاضِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1020", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَيَقُولُونَ: نَعْلَمُ أَنَّ هَذَا جَائِزٌ مُمْكِنٌ لَا يَتَوَقَّفُ عَلَى سَبَبٍ، وَلَا لَهُ مَانِعٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1021", "reason": "high_symbol_ratio:0.441", "chunk_text": "وَالْقُوَى النَّفْسَانِيَّةُ وَالطَّبِيعِيَّةُ، وَهَذِهِ كُلُّهَا مُشْتَرَكَةٌ عِنْدَهُمْ بَيْنَ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1022", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَكَذَلِكَ أُولَئِكَ الَّذِينَ وَافَقُوا جَهْمًا عَلَى أَصْلِهِ فِي الْقَدْرِ، لَا فَرْقَ عِنْدَهُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1023", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَجُمْهُورُ النَّاسِ يُخَالِفُونَهُمْ، وَيَقُولُونَ: هَذَا الْقَوْلُ فَاسِدٌ بَلْ نَفْسُ تَصَوُّرِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1024", "reason": "high_symbol_ratio:0.429", "chunk_text": "قِيلَ لَهُ: مُنَازِعُوكَ يَقُولُونَ: هَذَا بَاطِلٌ مِنْ وَجْهَيْنِ: أَحَدُهُمَا: أَنَّكَ أَنْتَ تُجَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1025", "reason": "high_symbol_ratio:0.412", "chunk_text": "التَّحَدِّي بِالْمُعَارَضَةِ قَدْ يَقَعُ مِنَ الْمُشْرِكِ بَلْ وَمِنَ السَّاحِرِ، فَلَمْ يُثْبِتُوا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1026", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالثَّانِي: أَنَّ الْعَادَةَ لَا بُدَّ لَهَا مِنْ أَسْبَابٍ وَمَوَانِعَ يُعْلَمُ بِهَا اطِّرَادُهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1027", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَبْلَهُ؟ وَمَوَانِعَ تَرْتَفِعُ كَسَائِرِ مَا يُحْدِثُهُ اللَّهُ مِنَ الْأُمُورِ الْخَارِقَةِ لِلْع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1028", "reason": "high_symbol_ratio:0.400", "chunk_text": "فَالْتَقَى الْمَاءُ عَلَى أَمْرٍ قَدْ قُدِرَ * وَحَمَلْنَاهُ عَلَى ذَاتِ أَلْوَاحٍ وَدُسُرٍ وَكَذَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1029", "reason": "high_symbol_ratio:0.406", "chunk_text": "ثَلَاثَةَ أَيَّامٍ ذَلِكَ وَعْدٌ غَيْرُ مَكْذُوبٍ * فَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا صَالِحًا وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1030", "reason": "high_symbol_ratio:0.423", "chunk_text": "الْعَصَا حَيَّةً، كَانَتْ بَعْدَ أَنْ أَلْقَاهَا إِمَّا عِنْدَ أَمْرِ اللَّهِ بِذَلِكَ لَمَّا نَادَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1031", "reason": "high_symbol_ratio:0.411", "chunk_text": "عِنْدَهُمْ. وَكَذَلِكَ آيَاتُ نَبِيِّنَا ، مِثْلَ تَكْثِيرِ الْمَاءِ، كَانَ بِوَضْعِ يَدِهِ فِيهِ حَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1032", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَأَمَّا جَبَلٌ يَنْقَلِبُ يَاقُوتًا بِلَا أَسْبَابٍ تَقَدَّمَتْ ذَلِكَ فَهَذَا لَا كَانَ، وَلَا يَك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1033", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَالْإِمْكَانُ الذِّهْنِيُّ هُوَ عَدَمُ الْعِلْمِ بِالِامْتِنَاعِ، وَهَذَا لَيْسَ فِيهِ إِلَّا عَدَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1034", "reason": "high_symbol_ratio:0.407", "chunk_text": "إِلَّا مُجَرَّدُ الدَّعْوَى وَأَمَّا الثَّانِي: وَهُوَ الْعِلْمُ بِإِمْكَانِ الشَّيْءِ فِي الْخَارِج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1035", "reason": "high_symbol_ratio:0.449", "chunk_text": "لَكَ حَتَّى نَرَى اللَّهَ جَهْرَةً... فَأَخَذَتْهُمُ الصَّاعِقَةُ وَهُمْ يَنْظُرُونَ، ثُمَّ بَعَثَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1036", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَكَمَا أَخْبَرَ عَنِ الْمَقْتُولِ الَّذِي ضَرَبُوهُ بِالْبَقَرَةِ فَأَحْيَاهُ اللَّهُ كَمَا قَالَ: "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1037", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَكَمَا أَخْبَرَ عَنِ الَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ وَهُمْ أُلُوفٌ حَذَرَ الْمَوْتِ فَقَالَ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1038", "reason": "high_symbol_ratio:0.422", "chunk_text": "نَكْسُوهَا لَحْمًا فَلَمَّا تَبَيَّنَ لَهُ قَالَ أَعْلَمُ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1039", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَاسْتَدَلَّ سُبْحَانَهُ بِمَا هُوَ أَعْظَمُ مِنْ ذَلِكَ وَهُوَ النَّشْأَةُ الْأُولَى، وَخَلْقُ السَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1040", "reason": "high_symbol_ratio:0.415", "chunk_text": "الْأَرْضَ هَامِدَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ وَأَنْبَتَتْ مِنْ كُل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1041", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالْمَقْصُودُ أَنَّ قَوْلَ الْقَائِلِ: هَذَا مُمْكِنٌ لَا يَحْتَاجُ إِلَى دَلِيلٍ لَا يَكْفِي فِي ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1042", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَالْجَزْمُ بِإِمْكَانِ وَجُودِهِ بِدُونِ الْعِلْمِ بِلَوَازِمِهِ وَإِمْكَانِهَا وَأَضْدَادِهَا وَان"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1044", "reason": "high_symbol_ratio:0.411", "chunk_text": "رُسُلَنَا وَالَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ يَقُومُ الْأَشْهَادُ وَقَالَ تَعَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1045", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَالَ: يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا أَنْصَارَ اللَّهِ كَمَا قَالَ عِيسَى ابْنُ مَرْيَمَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1046", "reason": "high_symbol_ratio:0.433", "chunk_text": "الْكُتُبِ الْمُتَقَدِّمَةِ كَمَا قَدْ بُسِطَ فِي مَوْضِعِهِ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1047", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْخَلِيلُ دَعَا بِهِ فَقَالَ فِي دُعَائِهِ لِذُرِّيَّتِهِ: رَبَّنَا وَابْعَثْ فِيهِمْ رَسُولًا مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1048", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَمِثْلَ مَا شُوهِدَ مِنْ أَحْوَالِهِ فِي صِغَرِهِ، وَأَمَّا انْتِصَارُ اللَّهِ لَهُ وَلِأَتْبَاعِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1049", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ تَعَالَى: قَدْ كَانَ لَكُمْ آيَةٌ فِي فِئَتَيْنِ الْتَقَتَا فِئَةٌ تُقَاتِلُ فِي سَبِيلِ اللَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1050", "reason": "high_symbol_ratio:0.405", "chunk_text": "بِأَيْدِيهِمْ وَأَيْدِي الْمُؤْمِنِينَ فَاعْتَبِرُوا يَاأُولِي الْأَبْصَارِ وَالْأَنْبِيَاءُ صَلَوَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1051", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَفِي الْحَدِيثِ الْمُتَّفَقِ عَلَى صِحَّتِهِ لَمَّا أَرْسَلَ النَّبِيُّ رَسُولًا إِلَى مَلِكِ الرُّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1052", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَقَالَ: كَذَلِكَ الرُّسُلُ تُبْتَلَى، وَتَكُونُ لَهَا الْعَاقِبَةُ. فَإِنَّهُ كَانَ يَوْمَ بَدْرٍ ن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1053", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَإِنْ قِيلَ: فَفِي الْأَنْبِيَاءِ مَنْ قَدْ قُتِلَ كَمَا أَخْبَرَ اللَّهُ أَنَّ بَنِي إِسْرَائِيلَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1054", "reason": "high_symbol_ratio:0.407", "chunk_text": "قِيلَ: أَمَّا مَنْ قُتِلَ مِنَ الْأَنْبِيَاءِ فَهُمْ كَمَنْ يُقْتَلُ مِنَ الْمُؤْمِنِينَ فِي الْجِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1056", "reason": "high_symbol_ratio:0.408", "chunk_text": "حَتْفَ أَنْفِهِ قَالَ تَعَالَى: وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1059", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَلَمْ يَحْصُلْ لَهُمْ وَلَا لِطَائِفَتِهِمْ شَيْءٌ مِنْ سَعَادَةِ الدُّنْيَا بَلِ أُتْبِعُوا فِي هَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1060", "reason": "high_symbol_ratio:0.402", "chunk_text": "اسْتَكَانُوا لِذَلِكَ، بَلِ اسْتَغْفَرُوا مِنْ ذُنُوبِهِمُ الَّتِي كَانَتْ سَبَبَ ظُهُورِ الْعَدُوِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1061", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَظُهُورُ الْكُفَّارِ عَلَى الْمُؤْمِنِينَ أَحْيَانًا هُوَ بِسَبَبِ ذُنُوبِ الْمُسْلِمِينَ كَيَوْمِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1062", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَعَدَمًا مِنْ غَيْرِ سَبَبٍ يُزَاحِمُ ذَلِكَ، وَدَوْرَانُ الْحُكْمِ مَعَ الْوَصْفِ وُجُودًا وَعَدَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1063", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَقَوْلُنَا: (مِنْ غَيْرِ مُزَاحَمَةِ وَصْفٍ آخَرَ): يُزِيلُ النُّقُوضَ الْوَارِدَةَ، فَهَذَا الِاسْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1065", "reason": "high_symbol_ratio:0.402", "chunk_text": "قَالَ تَعَالَى: وَقَضَيْنَا إِلَى بَنِي إسْرائِيلَ فِي الْكِتَابِ لَتُفْسِدُنَّ فِي الْأَرْضِ مَرَّت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1066", "reason": "high_symbol_ratio:0.425", "chunk_text": "دَخَلُوهُ أَوَّلَ مَرَّةٍ وَلِيُتَبِّرُوا مَا عَلَوْا تَتْبِيرًا * عَسَى رَبُّكُمْ أَنْ يَرْحَمَكُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1067", "reason": "high_symbol_ratio:0.420", "chunk_text": "نُبُوَّةِ مُوسَى، وَكَذَلِكَ انْتِصَارُ الْمُؤْمِنِينَ مَعَ مُحَمَّدٍ فِي حَيَاتِهِ وَبَعْدَ مَمَاتِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1068", "reason": "high_symbol_ratio:0.414", "chunk_text": "عَلَيْكُمْ، وَأَيْضًا فَلَا عَاقِبَةَ لَهُمْ، بَلِ اللَّهُ يُهْلِكُ الظَّالِمَ بِالظَّالِمِ ثُمَّ يُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1069", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَبَيِّنٌ أَنَّ ظُهُورَ مُحَمَّدٍ وَأُمَّتِهِ عَلَى أَهْلِ الْكِتَابِ الْيَهُودِ وَالنَّصَارَى هُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1070", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَبَيِّنٌ أَنَّ الْكَذَّابَ الْمُدَّعِيَ لِلنُّبُوَّةِ لَا يَتِمُّ أَمْرُهُ، وَإِنَّمَا يَتِمُّ أَمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1071", "reason": "high_symbol_ratio:0.425", "chunk_text": "النُّبُوَّةِ وَدَعَا إِلَيْهِ مِنَ الدِّينِ، بَلْ كَانَ بِمَنْزِلَةِ الْمُحَارِبِينَ قُطَّاعِ الطَّر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1072", "reason": "high_symbol_ratio:0.427", "chunk_text": "خَرْقِ الْعَادَاتِ الَّتِي لَمْ تَقْتَرِنْ بِدَعْوَى النُّبُوَّةِ، فَإِنَّهُ لَيْسَ دَلِيلًا عَلَيْه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1073", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَدْ يَغْرَقُ فِي الْبَحْرِ أُمَمٌ كَثِيرَةٌ فَلَا يَكُونُ ذَلِكَ دَلِيلًا عَلَى نُبُوَّةِ نَبِيٍّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1074", "reason": "high_symbol_ratio:0.424", "chunk_text": "عَلَى كَذِبِهِ مِنْ وَجُوهٍ: مِنْهَا: دَعْوَاهُ الْإِلَهِيَّةَ وَهُوَ أَعْوَرُ، وَاللَّهُ لَيْسَ بِأ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1075", "reason": "high_symbol_ratio:0.407", "chunk_text": "عَلَى ذَلِكَ بِالْحِكْمَةِ فَحِكْمَتُهُ تُنَاقِضُ أَنْ يَفْعَلَ ذَلِكَ إِذِ الْحَكِيمُ لَا يَفْعَلُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1076", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالْإِيمَانُ الْمُسْتَلْزِمُ لِذَلِكَ يَتَضَمَّنُ طَاعَةَ اللَّهِ وَرَسُولِهِ فَإِذَا نُقِضَ الْإِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1077", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَقَالَ تَعَالَى: وَأَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ لَئِنْ جَاءَهُمْ نَذِيرٌ لَيَكُونُنَّ "}
