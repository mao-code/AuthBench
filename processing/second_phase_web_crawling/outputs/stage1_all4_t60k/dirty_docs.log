{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_152", "reason": "high_symbol_ratio:0.416", "chunk_text": "بِكِتَابٍ لَمْ نَفْهَمْهُ؟. الْوَجْهُ الرَّابِعُ: أَنَّ حُكْمَ أَهْلِ الْكِتَابِ فِي ذَلِكَ حُكْمُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_153", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْوَجْهُ الْخَامِسُ: أَنَّهُ لَيْسَ فَهْمُ كُلِّ آيَةٍ مِنَ الْقُرْآنِ فَرْضًا عَلَى كُلِّ مُسْلِمٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_154", "reason": "high_symbol_ratio:0.412", "chunk_text": "الصَّلَاةِ وَالتَّعْبِيرُ كَمَا يَجُوزُ تَفْسِيرُهُ بِاتِّفَاقِ الْمُسْلِمِينَ وَإِنَّمَا تَنَازَعُو"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_155", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَّا جُمَلُ مَا أَمَرَ بِهِ الرَّسُولُ مِنَ الصَّلَاةِ وَالزَّكَاةِ وَالصَّوْمِ وَالْحَجِّ وَصِد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_157", "reason": "high_symbol_ratio:0.431", "chunk_text": "بِهِ أَوَّلًا الْعَرَبُ لِيَفْهَمُوهُ ثُمَّ مَنْ يَعْلَمُ لُغَتَهُمْ يَفْهَمُهُ كَمَا فَهِمُوهُ ثُمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_158", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ تَعَالَى: فَإِنَّمَا يَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ وَقَالَ: فَإِنَّمَا ي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_159", "reason": "high_symbol_ratio:0.426", "chunk_text": "يَقُلْ: وَمَا أَرْسَلْنَا مِنْ رَسُولٍ إِلَّا إِلَى قَوْمِهِ بَلِ الرَّسُولُ يَبْعَثُهُ اللَّهُ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_160", "reason": "high_symbol_ratio:0.429", "chunk_text": "يَحْصُلْ مَقْصُودُ الرِّسَالَةِ لَا لَهُمْ وَلَا لِغَيْرِهِمْ وَإِذَا تَبَيَّنَ لِقَوْمِهِ أَوَّلًا "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_161", "reason": "high_symbol_ratio:0.404", "chunk_text": "بِلِسَانِ قَوْمِهِ ثُمَّ يُتَرْجَمُ ذَلِكَ الْكِتَابُ وَيُنْقَلُ إِلَى لُغَاتٍ أُخَرَ وَيَنْتَفِعُ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_163", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَأَبْنَاءُ فَارِسَ الْمُسْلِمُونَ لَمَّا كَانَ لَهُمْ مِنْ عِنَايَةٍ بِهَذَا تَرْجَمُوا مَصَاحِفَ ك"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_164", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالْإِنْجِيلِ وَالزَّبُورِ وَغَيْرُ ذَلِكَ مِنَ النُّبُوَّاتِ بَلْ كُلُّ مَنْ تَدَبَّرَ نُبُوَّاتِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_165", "reason": "high_symbol_ratio:0.403", "chunk_text": "التَّوْرَاةَ وَالْإِنْجِيلَ وَلَا الزَّبُورَ وَمُحَمَّدٌ لَمْ يَخْرُجْ مِنْ بَيْنِ ظَهْرَانِيهِمْ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_166", "reason": "high_symbol_ratio:0.417", "chunk_text": "رَآهُ عَرَفَهُ لِمَا كَانَ عِنْدَهُ مِنْ ذِكْرِهِ وَنَعْتِهِ فَأَخْبَرَ أَهْلَهُ بِذَلِكَ وَأَمَرَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_168", "reason": "high_symbol_ratio:0.422", "chunk_text": "يَلْتَفِتُ قَالَ: فَهُمْ يَحُلُّونَ رِحَالَهُمْ فَجَعَلَ يَتَخَلَّلُهُمُ الرَّاهِبُ حَتَّى جَاءَ فَأ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_169", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَلَمَّا أَتَاهُمْ بِهِ - وَكَانَ هُوَ فِي رِعْيَةِ الْإِبِلِ - فَقَالَ: أَرْسِلُوا إِلَيْهِ فَأَقْب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_170", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَقَالَ: مَا جَاءَ بِكُمْ قَالُوا: جِئْنَا؛ لِأَنَّ هَذَا النَّبِيَّ خَارِجٌ فِي هَذَا الشَّهْرِ فَل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_171", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَقَالَ أَفَرَأَيْتُمْ أَمْرًا أَرَادَ اللَّهُ أَنْ يَقْضِيَهُ هَلْ يَسْتَطِيعُ أَحَدٌ مِنَ النَّاسِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_172", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ: فَتَابَعُوهُ وَأَقَامُوا مَعَهُ. قَالَ: أُنْشِدُكُمُ اللَّهَ يَا مَعْشَرَ الْعَرَبِ أَيُّكُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_173", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ التِّرْمِذِيُّ هَذَا حَدِيثٌ حَسَنٌ غَرِيبٌ لَا نَعْرِفُهُ إِلَّا مِنْ هَذَا الْوَجْهِ وَرَوَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_174", "reason": "high_symbol_ratio:0.422", "chunk_text": "قَالَ الْبَيْهَقِيُّ أَرَادَ أَنَّهُ لَمْ يُحَدِّثْ بِهَذَا الْإِسْنَادِ سِوَى هَؤُلَاءِ فَأَمَّا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_175", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَالَ ابْنُ سَعْدٍ فِي الطَّبَقَاتِ: حَدَّثَنَا مُحَمَّدُ بْنُ عُمَرَ قَالَ: حَدَّثَنِي مُحَمَّدُ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_176", "reason": "high_symbol_ratio:0.411", "chunk_text": "يَكْلَؤُهُ اللَّهُ وَيَحْفَظُهُ وَيَحُوطُهُ مِنْ أُمُورِ الْجَاهِلِيَّةِ وَمَعَايِبِهَا لِمَا يُرِيد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_177", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَالَ: ابْنُ الْجَوْزِيِّ خَرَجَ أَبُو طَالِبٍ إِلَى الشَّامِ وَمَعَهُ رَسُولُ اللَّهِ وَهُوَ ابْن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_178", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَصَنَعَ لَهُمُ الرَّاهِبُ طَعَامًا وَدَعَاهُمْ وَإِنَّمَا حَمَلَهُ عَلَى ذَلِكَ لِشَيْءٍ رَآهُ فَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_179", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَإِنَّهُ كَائِنٌ لَهُ شَأْنٌ عَظِيمٌ، فَإِنَّا نَجِدُ صِفَتَهُ فِي كُتُبِنَا وَيَرْوُونَهُ عَنْ آبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_180", "reason": "high_symbol_ratio:0.425", "chunk_text": "هَذَا مَعَ أَنَّ فِي الْقُرْآنِ مِنَ الرَّدِّ عَلَى أَهْلِ الْكِتَابِ فِي بَعْضِ مَا حَرَّفُوهُ مِثْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_181", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَطَعْنُهُمْ عَلَى سُلَيْمَانَ وَقَوْلُهُمْ أَنَّهُ كَانَ سَاحِرًا. وَأَمْثَالُ ذَلِكَ مَا يُبَيِّنُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_182", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَفِي الْقُرْآنِ مِنْ قِصَصِ الْأَنْبِيَاءِ عَلَيْهِمُ السَّلَامُ مَا لَا يُوجَدُ فِي التَّوْرَاةِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_186", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَحَدُهَا: أَنَّ هَذَا كَذِبٌ بَيِّنٌ، فَإِنَّ مِنَ الْعَرَبِ مِنَ النَّصَارَى مَنْ لَا يُحْصِي عَدَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_187", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَمَعَ هَذَا فَلَيْسَ عَلَى وَجْهِ الْأَرْضِ تَوْرَاةٌ وَلَا إِنْجِيلُ مُعَرَّبٌ مِنْ عَهْدِ الْحَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_188", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْمُقَدَّسِ وَهُمْ بَنُو إِسْمَاعِيلَ وَالْأَنَاجِيلُ عِنْدَهُمْ أَرْبَعَةٌ وَهُمْ يَدَّعُونَ أَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_189", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْأَنَاجِيلُ كُلُّهَا ثُمَّ هُمْ مَعَ هَذَا يَدَّعُونَ أَنَّهَا تُرْجِمَتْ بِاثْنَيْنِ وَسَبْعِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_190", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَنْوَاعٌ مُخْتَلِفَةٌ لَا يَفْهَمُ بَعْضُهُمْ لِسَانَ بَعْضٍ إِلَّا أَنْ يَتَعَلَّمَهُ مِنْهُمْ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_191", "reason": "high_symbol_ratio:0.410", "chunk_text": "مِنْ نَذِيرٍ مِنْ قَبْلِكَ فَكَيْفَ يُدَّعَى أَنَّ التَّوْرَاةَ وَالْإِنْجِيلَ تَرْجَمَهَا الْحَوَار"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_192", "reason": "high_symbol_ratio:0.405", "chunk_text": "الْوَجْهُ الثَّانِي: أَنْ يُقَالَ تَرْجَمَةُ الْكَلَامِ مِنْ لُغَةٍ إِلَى لُغَةٍ لَا تَحْتَاجُ إِلَى"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_193", "reason": "high_symbol_ratio:0.406", "chunk_text": "يَذْكُرُونَ أَنَّ التَّوْرَاةَ تَرْجَمَهَا اثْنَانِ وَسَبْعُونَ حَبْرًا مِنَ الْيَهُودِ وَلَمْ يَكُو"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_194", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَهَذِهِ التَّوْرَاةُ فِي زَمَانِنَا وَالْإِنْجِيلُ وَالزَّبُورُ يُتَرْجَمُ بِاللُّغَةِ الْعَرَبِيَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_195", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنَّ دَعْوَى الْعِصْمَةِ فِي كُلِّ وَاحِدٍ مِنَ الْحَوَارِيِّينَ وَأَنَّهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_196", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْمُسْلِمِينَ وَغَيْرِهِمْ، فَإِنَّهُ وَإِنْ كَانَتْ لَهُمْ كَرَامَاتٌ مِنَ الْخَوَارِقِ فَلَيْسُوا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_197", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْجَنَّةِ فَلَا يَجِبُ الْإِيمَانُ بِكُلِّ مَا يَقُولُهُ: إِنْ لَمْ يُوَافِقْ مَا قَالَتْهُ الْأَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_198", "reason": "high_symbol_ratio:0.409", "chunk_text": "مُوسَى وَعِيسَى وَمَا أُوتِيَ النَّبِيُّونَ مِنْ رَبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْهُمْ وَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_199", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَهَذَا مَبْسُوطٌ فِي مَوْضِعٍ آخَرَ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_201", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَالْجَوَابُ عَنْهُ مِنْ وُجُوهٍ: أَحَدُهَا: أَنَّ إِثْبَاتَ رَسُولٍ مِنْ قَبْلِهِ إِلَيْكُمْ لَا يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_203", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَبَنُو إِسْرَائِيلَ أَكْثَرُ اخْتِصَاصًا بِمُوسَى وَالتَّوْرَاةِ مِنَ الرُّومِ وَغَيْرِهِمْ فَالْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_204", "reason": "high_symbol_ratio:0.403", "chunk_text": "الْوَجْهُ الثَّانِي: دَعْوَاهُمْ أَنَّهُمْ مُتَمَسِّكُونَ فِي هَذَا الْوَقْتِ بِالدِّينِ الَّذِي نَق"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_205", "reason": "high_symbol_ratio:0.402", "chunk_text": "خَمْسِينَ يَوْمًا وَالصَّلَوَاتِ وَالْقَرَابِينَ وَالنَّامُوسِ لَمْ يَنْقُلْهُ الْحَوَارِيُّونَ عَنِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_206", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْعَذْرَاءَ افْتَحِي لَنَا أَبْوَابَ الرَّحْمَةِ \"."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_207", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْوَجْهُ الثَّالِثُ: قَوْلُهُمْ أَنَّهُمْ سَلَّمُوا إِلَيْهِمُ التَّوْرَاةَ وَالْإِنْجِيلَ بِلُغَات"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_208", "reason": "high_symbol_ratio:0.433", "chunk_text": "بِكِتَابٍ نَزَلَ بِغَيْرِ لِسَانِهِمْ ثُمَّ عُرِّبَ لَهُمْ فَكَيْفَ لَا تَقُومُ عَلَى الرُّومِ وَغَي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_209", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْوَجْهُ الرَّابِعُ: أَنْ يُقَالَ الْأُمَّةُ إِذَا غَيَّرَتْ دِينَ رَسُولِهَا الَّذِي أُرْسِلَ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_210", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَقَدْ ثَبَتَ فِي الصَّحِيحِ عَنِ النَّبِيِّ أَنَّهُ قَالَ: إِنَّ اللَّهَ نَظَرَ إِلَى أَهْلِ الْأَر"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_211", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَأُولَئِكَ الْبَقَايَا الَّذِينَ كَانُوا مُتَمَسِّكِينَ بِدِينِ الْمَسِيحِ قَبْلَ مَبْعَثِ مُحَمَّد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_212", "reason": "high_symbol_ratio:0.415", "chunk_text": "الْوَجْهُ الْخَامِسُ: أَنْ يُقَالَ دَعْوَاهُمْ أَنَّ الرُّسُلَ سَلَّمُوا إِلَيْهِمُ التَّوْرَاةَ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_213", "reason": "high_symbol_ratio:0.432", "chunk_text": "بِاثْنَيْنِ وَسَبْعِينَ لِسَانًا وَأَنَّهَا مُتَّفِقَةٌ وَأَنَّهَا كُلَّهَا مَنْقُولَةٌ عَنِ الْحَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_214", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَيُقَالُ: مَنِ الَّذِي مِنْكُمْ لَوْ قُدِّرَ أَنَّ هَذِهِ الْكُتُبَ الَّتِي بِاثْنَيْنِ وَسَبْعِينَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_215", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَسَبْعِينَ لِسَانًا لَمْ يَعْلَمْ أَنَّ كُلَّ نُسْخَةٍ مِنْ هَذِهِ هِيَ الْمَأْخُوذَةُ عَنِ الْحَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_216", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَحِينَئِذٍ فَإِذَا وُجِدَتْ نُسْخَةٌ بِالْعَرَبِيَّةِ لَمْ يُعْلَمْ أَنَّهَا مِمَّا عُرِّبَتْ بَعْد"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_217", "reason": "high_symbol_ratio:0.412", "chunk_text": "يَكَادُ يَنْضَبِطُ وَمَا يَشْهَدُ بِأَنَّهَا مُبَدَّلَةٌ مُغَيَّرَةٌ لَا يُوثَقُ بِهَا وَرَأَيْتُ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_218", "reason": "high_symbol_ratio:0.415", "chunk_text": "لِسَانًا مَعْرِفَةً تَامَّةً وَلَيْسَ فِي بَنِي آدَمَ مَنْ يَقْدِرُ عَلَى ذَلِكَ وَلَوْ قُدِّرَ وُجُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_219", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَلَوْ وُجِدَ ذَلِكَ لَكَانَ هَذَا خَبَرٌ وَاحِدٌ أَوْ أَنْ يُتَرْجِمَ كُلُّ لِسَانٍ مَنْ يَعْلَمُ ص"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_220", "reason": "high_symbol_ratio:0.415", "chunk_text": "يَعْرِفُهُ. وَمَعْلُومٌ أَنَّ أَحَدًا لَمْ يُتَرْجَمْ لَهُ الِاثْنَانِ وَسَبْعُونَ لِسَانًا بِلِسَان"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_221", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَحِينَئِذٍ فَالْجَزْمُ بِاتِّفَاقِ جَمِيعِ الْكُتُبِ الْمَكْتُوبَةِ بِاثْنَيْنِ وَسَبْعِينَ لِسَانً"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_222", "reason": "high_symbol_ratio:0.415", "chunk_text": "هَذَا إِذَا ثَبَتَ أَنَّ الْحَوَارِيِّينَ سَلَّمُوهَا بِاثْنَيْنِ وَسَبْعِينَ لِسَانًا وَأَنَّهَا بَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_224", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْوَجْهُ السَّادِسُ: قَوْلُهُمْ وَسَلَّمُوا إِلَيْنَا التَّوْرَاةَ وَالْإِنْجِيلَ بِلِسَانِنَا عَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_225", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَمِنْ جِنْسِ اسْتِشْهَادِكُمْ بِالنُّبُوَّاتِ عَلَى مَا أَحْدَثْتُمُوهُ وَغَيَّرْتُمْ بِهِ دِينَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_226", "reason": "high_symbol_ratio:0.441", "chunk_text": "الْعِبْرَانِيِّ، لَمْ يَتَكَلَّمْ أَحَدٌ مِنْهُمَا لَا بِرُومِيَّةٍ وَلَا سُرْيَانِيَّةٍ وَلَا يُونَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_227", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَقَوْلُهُ تَعَالَى: وَلَقَدْ بَعَثْنَا فِي كُلِّ أُمَّةٍ رَسُولًا كَلَامٌ مُطْلَقٌ عَامٌّ كَقَوْلِه"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_229", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَيُقَالُ: لَهُمْ هَبْ أَنَّكُمْ تَدَّعُونَ هَذَا وَتَعْتَقِدُونَهُ وَنَحْنُ سَنُبَيِّنُ - إِنْ شَاء"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_230", "reason": "high_symbol_ratio:0.421", "chunk_text": "يَقِينًا عَنْهُ أَنَّهُ لَمْ يَشْهَدْ لِلْمَسِيحِ بِأَنَّهُ اللَّهُ بَلْ كَفَّرَ مَنْ قَالَ ذَلِكَ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_233", "reason": "high_symbol_ratio:0.403", "chunk_text": "بِهِمْ وَهَذِهِ وَإِنْ كَانَتْ أَنْطَاكِيَّةُ فَكَانَ هَذَا الْإِرْسَالُ قَبْلَ الْمَسِيحِ وَالْمَسِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_234", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمَقْصُودُ هُنَا أَنَّ مُحَمَّدًا لَمْ يَشْهَدْ لِلْمَسِيحِ بِالْإِلَهِيَّةِ وَلَا لِلْحَوَارِيِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_235", "reason": "high_symbol_ratio:0.410", "chunk_text": "يُتَرْجِمُ ذَلِكَ اللِّسَانَ كَانَتْ رُسُلُ الرُّسُلِ تُخَاطِبُهُمْ بِلِسَانِهِمْ لَكِنْ لَا يَلْزَم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_238", "reason": "high_symbol_ratio:0.422", "chunk_text": "مُوسَى وَبُعِثَ إِلَيْهِمْ بَعْدَهُ أَنْبِيَاءُ كَثِيرُونَ حَتَّى قِيلَ أَنَّهُمْ أَلْفُ نَبِيٍّ وَك"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_240", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَهَذِهِ الْفَتْرَةُ الَّتِي كَانَتْ بَيْنَ الْمَسِيحِ وَمُحَمَّدٍ - صَلَوَاتُ اللَّهِ عَلَيْهِمَا و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_241", "reason": "high_symbol_ratio:0.405", "chunk_text": "الْعَاشِرَةِ وَالتَّارِيخُ قَدْ تُحْسَبُ فِيهِ التَّامَّةُ وَتُحْسَبُ فِيهِ النَّاقِصَةُ فَمَنْ قَال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_243", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَحَدُهَا: أَنَّ هَذَا الْكَلَامَ لَا يَجُوزُ أَنْ يَقُولَهُ مَنْ كَتَبَ هَذَا الْكِتَابَ وَلَا أَحَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_244", "reason": "high_symbol_ratio:0.410", "chunk_text": "الثَّانِي: كَمَا أَنَّهُمْ يَفْهَمُونَ مَا فِي كُتُبِهِمُ الرُّومِيَّةِ وَالسُّرْيَانِيَّةِ وَالْقِب"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_245", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَحِينَئِذٍ فَيَكُونُ وَصُولُ الْمَعَانِي بِهِ إِلَى غَيْرِ أَهْلِ لِسَانِهِ أَيْسَرَ لِكَمَالِ مَعْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_246", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنْ يُقَالَ النَّاسُ لَهُمْ فِي عَدْلِ اللَّهِ ثَلَاثَةُ أَقْوَالٍ قِيلَ كُلُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_247", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَمَعْلُومٌ أَنَّهُ إِذَا أُمِرَ الْعَبْدُ بِمَا يَقْدِرُ عَلَيْهِ كَانَ جَائِزًا بِاتِّفَاقِ طَوَائ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_248", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْأَرْضَ وَمِنْهُمْ نَصَارَى لَا يُحْصَوْنَ فَكُلُّ مَنْ عُرِفَ بِالْعَرَبِيَّةِ مِنَ النَّصَارَى أ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_249", "reason": "high_symbol_ratio:0.409", "chunk_text": "بِهِ إِذَا كَانَ مَقْدُورًا لِلْعَبْدِ فَعَلَيْهِ أَنْ يَفْعَلَهُ بِاتِّفَاقِ أَهْلِ الْمِلَلِ الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_251", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ هَؤُلَاءِ: وَلِأَنَّ الْوَاجِبَ مَا يُذَمُّ تَارِكُهُ شَرْعًا أَوْ يُعَاقَبُ تَارِكُهُ شَرْعًا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_252", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَكَذَلِكَ مَنْ وَجَبَ عَلَيْهِ قَضَاءُ دَيْنِهِ مِنْ غَيْرِ احْتِيَاجٍ إِلَى بَيْعِ شَيْءٍ مِنْ مَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_253", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَفَصْلُ الْخِطَابِ أَنَّ مَا لَا يَتِمُّ الْوَاجِبُ إِلَّا بِهِ هُوَ مِنْ لَوَازِمِ وُجُودِ الْوَاج"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_254", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَتَنَازَعَ النَّاسُ هَلْ يُقَالُ مَا لَا يَتِمُّ الْوَاجِبُ إِلَّا بِهِ فَهُوَ وَاجِبٌ سَوَاءً كَان"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_256", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَالْمَقْصُودُ هُنَا أَنَّ اللَّهَ إِذَا أَوْجَبَ عَلَى الْعِبَادِ شَيْئًا وَاحْتَاجَ أَدَاءُ الْوَا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_257", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَلَوْ جَاءَتْ رِسَالَةٌ مِنْ مَلِكٍ إِلَى مَلِكٍ بِغَيْرِ لِسَانِهِ لَطَلَبَ مَنْ يُتَرْجِمُ مَقْصُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_258", "reason": "high_symbol_ratio:0.424", "chunk_text": "يَكُونُ ظُلْمًا مِنْ رَبِّ الْعَالَمِينَ مَعَ أَنَّهُ لَيْسَ بِظُلْمٍ مِنَ الْمَخْلُوقِينَ؟."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_259", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَلَوْ وَجَبَ لِبَعْضِ الرَّعِيَّةِ حَقٌّ عَلَى بَعْضٍ أَوْ ظُلْمُ بَعْضِهِمْ بَعْضًا لَوَجَبَ عَلَى"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_260", "reason": "high_symbol_ratio:0.420", "chunk_text": "رُسُلَنَا بِالْبَيِّنَاتِ وَأَنْزَلْنَا مَعَهُمُ الْكِتَابَ وَالْمِيزَانَ لِيَقُومَ النَّاسُ بِالْقِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_261", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالنَّاسُ فِي مَصَالِحِ دُنْيَاهُمْ يَتَوَسَّلُ أَحَدُهُمْ إِلَى مَعْرِفَةِ مُرَادِ الْآخَرِ بِالتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_262", "reason": "high_symbol_ratio:0.427", "chunk_text": "هَوَاهُ وَأَعْرَضَ عَنْ ذِكْرِ رَبِّهِ وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا ذَلِكَ مَبْلَغُهُم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_263", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَ تَعَالَى: فَأَعْرِضْ عَنْ مَنْ تَوَلَّى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_264", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْوَجْهُ الرَّابِعُ: أَنَّهُ مِنَ الْعَجَبِ أَنْ تَعُدَّ النَّصَارَى مِثْلَ هَذَا ظُلْمًا خَارِجًا "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_265", "reason": "high_symbol_ratio:0.413", "chunk_text": "ذُرِّيَّتِهِ إِلَى أَنْ جَاءَ الْمَسِيحُ وَصُلِبَ وَأَنَّهُ كَانَتِ الذُّرِّيَّةُ فِي حَبْسِ إِبْلِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_266", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَمَعْلُومٌ أَنَّ إِبْرَاهِيمَ كَانَ أَبُوهُ كَافِرًا وَلَمْ يُؤَاخِذْهُ اللَّهُ بِذَنْبِ أَبِيهِ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_267", "reason": "high_symbol_ratio:0.406", "chunk_text": "إِلَى حِينِ مَبْعَثِ الْمَسِيحِ وَالرَّبُّ قَادِرٌ عَلَى عُقُوبَتِهِ وَبَنُو آدَمَ لَا عُقُوبَةَ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_268", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْإِصْرَارِ عَلَى تَبْدِيلِ الْكِتَابِ الْأَوَّلِ وَتَكْذِيبِ الْكِتَابِ الْآخِرِ وَعَلَى أَنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_269", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالنَّصَارَى يَقُولُونَ: إِنَّ الْمَسِيحَ الَّذِي هُوَ عِنْدَهُمُ اللَّاهُوتُ وَالنَّاسُوتُ جَمِيعً"}
