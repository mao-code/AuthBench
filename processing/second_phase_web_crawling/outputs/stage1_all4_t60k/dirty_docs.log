{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_194", "reason": "high_symbol_ratio:0.409", "chunk_text": "يُقَاتِلُوهُمْ بَعْدَ نُزُولِ الْآيَةِ إِلَّا انْتَصَرَ عَلَيْهِمُ الْمُسْلِمُونَ، وَمَا زَالَ الْإِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_195", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ تَعَالَى خِطَابًا لِلْيَهُودِ: قُلْ إِنْ كَانَتْ لَكُمُ الدَّارُ الْآخِرَةُ عِنْدَ اللَّهِ خ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_196", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَقَالَ: قُلْ يَا أَيُّهَا الَّذِينَ هَادُوا إِنْ زَعَمْتُمْ أَنَّكُمْ أَوْلِيَاءُ لِلَّهِ مِنْ دُون"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_197", "reason": "high_symbol_ratio:0.406", "chunk_text": "عَلَى تَكْذِيبِهِ - لَمْ تَنْبَعِثْ دَوَاعِيهِمْ لِإِظْهَارِ تَكْذِيبِهِ، بِإِظْهَارِ تَمَنِّي الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_198", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَالَ عَنْ أَبِي لَهَبٍ - عَمِّهِ -: تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ مَا أَغْنَى عَنْهُ مَالُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_199", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ فِي سُورَةِ الْفَتْحِ: وَعَدَكُمُ اللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_200", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَالَ: لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_201", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَالَ: قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَى قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_202", "reason": "high_symbol_ratio:0.406", "chunk_text": "قِتَالٍ، كَمَا كَانَ يَكُونُ قَبْلَ نُزُولِ الْآيَةِ. وَقَالَ تَعَالَى: إِذَا جَاءَ نَصْرُ اللَّهِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_204", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَالَ تَعَالَى عَنِ الْمُنَافِقِينَ: أَلَمْ تَرَ إِلَى الَّذِينَ نَافَقُوا يَقُولُونَ لِإِخْوَانِه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_205", "reason": "high_symbol_ratio:0.429", "chunk_text": "الْمُنَافِقِينَ، كَعَبْدِ اللَّهِ بْنِ أُبَيٍّ، وَعَبْدِ اللَّهِ بْنِ نَبْتَلٍ، وَرِفَاعَةَ بْنِ تَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_206", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَأَخْبَرَ اللَّهُ عَنْهُمْ أَنَّهُمْ لَنْ يَفْعَلُوا ذَلِكَ؛ وَكَذَلِكَ كَانَ، وَضَرَبَ اللَّهُ لَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_208", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِخْبَارُهُ عَنِ الْغَيْبِ الْمَاضِي وَالْحَاضِرِ وَالْمُسْتَقْبَلِ بِأُمُورٍ بَاهِرَةٍ، لَا يُوجَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_209", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَفِي الْقُرْآنِ مِنْ إِخْبَارِهِ عَنِ الْغُيُوبِ شَيْءٌ كَثِيرٌ - كَمَا تَقَدَّمَ بَعْضُ ذَلِكَ - و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_210", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَفِي الصَّحِيحَيْنِ عَنْ حُذَيْفَةَ قَالَ: قَامَ فِينَا رَسُولُ اللَّهِ مَقَامًا مَا تَرَكَ شَيْئًا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_211", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ أَبِي زَيْدٍ عَمْرِو بْنِ أَخْطَبَ قَالَ: صَلَّى بِنَا رَسُولُ اللَّهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_212", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ عَدِيِّ بْنِ حَاتِمٍ قَالَ: بَيْنَا أَنَا عِنْدَ النَّبِيِّ إِذْ ج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_213", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَقَالَ: يَا عَدِيُّ، هَلْ رَأَيْتَ الْحِيرَةَ؟ قُلْتُ: لَمْ أَرَهَا وَقَدْ أُنْبِئْتُ عَنْهَا. قَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_214", "reason": "high_symbol_ratio:0.424", "chunk_text": "قَالَ: قُلْتُ فِيمَا بَيْنِي وَبَيْنَ نَفْسِي: فَأَيْنَ دُعَّارُ طَيِّئٍ الَّذِينَ قَدْ سَعَّرُوا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_215", "reason": "high_symbol_ratio:0.444", "chunk_text": "قُلْتُ: كِسْرَى بْنِ هُرْمُزَ! قَالَ: كِسْرَى بْنِ هُرْمُزَ، وَلَئِنْ طَالَتْ بِكَ حَيَاةٌ لَتَرَيَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_216", "reason": "high_symbol_ratio:0.432", "chunk_text": "فَيَقُولُ: أَلَمْ أُعْطِكَ مَالًا وَأُفْضِلْ عَلَيْكَ؟ فَيَقُولُ بَلَى. فَيَنْظُرُ عَنْ يَمِينِهِ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_217", "reason": "high_symbol_ratio:0.450", "chunk_text": "قَالَ عَدِيٌّ: سَمِعْتُ النَّبِيَّ يَقُولُ: اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ، فَمَنْ لَمْ ي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_218", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ عَدِيٌّ فَرَأَيْتُ الظَّعِينَةَ تَرْتَحِلُ مِنَ الْحِيرَةِ حَتَّى تَطُوفَ بِالْكَعْبَةِ لَا تَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_219", "reason": "high_symbol_ratio:0.423", "chunk_text": "قُلْتُ: وَهَذَا الَّذِي أَخْبَرَ بِهِ مِنْ خُرُوجِ الرَّجُلِ بِمِلْءِ كَفِّهِ مِنْ ذَهَبٍ أَوْ فِضَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_220", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ جَابِرِ بْنِ سَمُرَةَ، عَنْ نَافِعِ بْنِ عُتْبَةَ قَالَ: كُنَّا مَعَ رَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_221", "reason": "high_symbol_ratio:0.456", "chunk_text": "فَأَتَيْتُهُمْ فَقُمْتُ بَيْنَهُمْ وَبَيْنَهُ، قَالَ: فَحَفِظْتُ مِنْهُ أَرْبَعَ كَلِمَاتٍ أَعُدُّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_222", "reason": "high_symbol_ratio:0.428", "chunk_text": "قَالَ: تَغْزُونَ جَزِيرَةَ الْعَرَبِ فَيَفْتَحُهَا اللَّهُ، ثُمَّ فَارِسَ فَيَفْتَحُهَا اللَّهُ، ثُم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_223", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَرَوَى الْبُخَارِيُّ، عَنْ عَوْفِ بْنِ مَالِكٍ قَالَ: أَتَيْتُ النَّبِيَّ فِي غَزْوَةِ تَبُوكَ، وَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_224", "reason": "high_symbol_ratio:0.409", "chunk_text": "اثْنَا عَشَرَ أَلْفًا."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_225", "reason": "high_symbol_ratio:0.407", "chunk_text": "قُلْتُ: فَفُتِحَ بَيْتُ الْمَقْدِسِ بَعْدَ مَوْتِهِ فِي خِلَافَةِ عُمَرَ بْنِ الْخَطَّابِ، ثُمَّ بَع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_226", "reason": "high_symbol_ratio:0.428", "chunk_text": "تُشْتَرَى بِوَزْنِهَا، ثُمَّ وَقَعَتِ الْفِتْنَةُ الْعَامَّةُ الَّتِي لَمْ يَبْقَ بَيْتٌ مِنَ الْعَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_227", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ خَبَّابِ بْنِ الْأَرَتِّ قَالَ: شَكَوْنَا إِلَى رَسُولِ اللَّهِ ، وَهْوَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_228", "reason": "high_symbol_ratio:0.428", "chunk_text": "يَصْرِفُهُ عَنْ دِينِهِ، وَلَيُتِمَّنَّ اللَّهُ هَذَا الْأَمْرَ حَتَّى يَسِيرَ الرَّاكِبُ مِنْ صَنْع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_229", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ قَالَ: لَا تَقُومُ السَّاعَةُ حَ"}
