{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_295", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْهُ أَنَّهُ سَارَّ فَاطِمَةَ فَقَالَ لَهَا وَهُوَ فِي مَرَضِهِ الَّذِي تُوُف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_296", "reason": "high_symbol_ratio:0.439", "chunk_text": "ثُمَّ أَخْبَرَهَا أَنَّهَا أَوَّلُ أَهْلِهِ لُحُوقًا بِهِ. وَفِي رِوَايَةٍ: وَأَخْبَرَهَا أَنَّهَا س"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_297", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ عَائِشَةَ قَالَتْ: قَالَ رَسُولُ اللَّهِ : أَسْرَعُكُنَّ بِي لَحَاقًا أَطْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_298", "reason": "high_symbol_ratio:0.448", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، وَغَيْرِهِ، عَنْ أُمِّ حَرَامٍ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: أَوَّلُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_299", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ أُمِّ حَرَامٍ أَيْضًا قَالَتْ: سَمِعْتُ رَسُولَ اللَّهِ يَقُولُ: أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_300", "reason": "high_symbol_ratio:0.429", "chunk_text": "قَالَتْ: يَا رَسُولَ اللَّهِ، أَنَا فِيهِمْ؟ قَالَ: أَنْتِ فِيهِمْ. قَالَتْ: ثُمَّ قَالَ النَّبِيُّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_301", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَقُلْتُ: يَا رَسُولَ اللَّهِ، أَنَا فِيهِمْ؟ قَالَ: لَا؛ وَغَزَاهَا الْمُسْلِمُونَ فِي خِلَافَةِ مُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_302", "reason": "high_symbol_ratio:0.416", "chunk_text": "ثُمَّ غَزَاهَا الْمُسْلِمُونَ مَرَّةً ثَانِيَةً فِي خِلَافَةِ عَبْدِ الْمَلِكِ، غَزَاهَا ابْنُهُ مَس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_303", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَنَسٍ قَالَ: كَانَ النَّبِيُّ يَدْخُلُ عَلَى أُمِّ حَرَامٍ بِنْتِ مِلْحَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_304", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَقَالَتْ أُمُّ حَرَامٍ: ادْعُ اللَّهَ أَنْ يَجْعَلَنِي مِنْهُمْ، فَدَعَا لَهَا، ثُمَّ وَضَعَ رَأْسَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_306", "reason": "high_symbol_ratio:0.430", "chunk_text": "أَمْرَهُ. وَفِي الصَّحِيحَيْنِ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: سَأَلْتُ رَبِّي ثَلَاثًا فَأَعْطَانِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_307", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَثَبَتَ عَنْهُ فِي الصَّحِيحَيْنِ أَنَّهُ قَالَ: لَا تَزَالُ طَائِفَةٌ مِنْ أُمَّتِي ظَاهِرِينَ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_308", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَهَذَا أَخْبَرَ بِهِ حِينَ كَانَتْ أُمَّتُهُ أَقَلَّ الْأُمَمِ فَانْتَشَرَتِ الْأُمَّةُ فِي مَشَارِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_309", "reason": "high_symbol_ratio:0.412", "chunk_text": "عَدُوًّا مِنْ غَيْرِهِمْ، وَلَكِنْ وَقَعَ بَيْنَهُمُ اخْتِلَافٌ وَفِتَنٌ. وَفِي صَحِيحِ مُسْلِمٍ، عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_310", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَهَؤُلَاءِ ظَهَرُوا بَعْدَهُ بِمُدَّةٍ طَوِيلَةٍ، وَظَهَرَ النِّسْوَةُ بَعْدَ ذَلِكَ بِسِنِينَ كَثِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_311", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَفِي حَدِيثِ مُسْلِمٍ، عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ، عَنِ النَّبِيِّ أَنَّهُ قَالَ سَيَكُونُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_312", "reason": "high_symbol_ratio:0.440", "chunk_text": "وَظَهَرَ الْكَذَّابُ مِنْ ثَقِيفٍ، وَهُوَ الْمُخْتَارُ بْنُ أَبِي عُبَيْدِ الثَّقَفِيُّ الَّذِي أَظْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_313", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَقَالَ أَحَدُهُمَا: وَإِنَّ الشَّيَاطِينَ لَيُوحُونَ إِلَى أَوْلِيَائِهِمْ، وَقَالَ الْآخَرُ: هَلْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_314", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَّا الْمُبِيرُ فَكَانَ هُوَ الْحَجَّاجَ بْنَ يُوسُفَ الثَّقَفِيَّ، وَكَانَ مُبِيرًا سَفَّاكًا ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_315", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي الصَّحِيحَيْنِ، عَنْ أَبِي هُرَيْرَةَ أَنَّهُ قَالَ: لَقَدْ قَالَ رَسُولُ اللَّهِ : أَيُّكُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_316", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرِ بْنِ سَمُرَةَ قَالَ: قَالَ رَسُولُ اللَّهِ : لَا يَزَالُ الْإِسْلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_317", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَفِي لَفْظٍ: إِلَى اثْنَيْ عَشَرَ أَمِيرًا، وَفِي رِوَايَةٍ لِأَبِي دَاوُدَ الطَّيَالِسِيِّ: كُلُّه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_318", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ أَبُو بَكْرٍ الْبَيْهَقِيُّ: وَفِي الرِّوَايَةِ الْأُولَى بَيَانُ الْعَدَدِ، وَفِي الْأُخْرَى "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_319", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَدْ وُجِدَ هَذَا الْعَدَدُ بِالصِّفَةِ الْمَذْكُورَةِ إِلَى وَقْتِ الْوَلِيدِ بْنِ يَزِيدَ بْنِ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_320", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرٍ قَالَ: قَالَ لِي رَسُولُ اللَّهِ : هَلْ لَكَ مِنْ أَنْمَاطٍ؟ قُلْت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_321", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنِ ابْنِ عَبَّاسٍ أَنَّ رَسُولَ اللَّهِ قَالَ: بَيْنَا أَنَا نَائِمٌ أُرِيتُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_322", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَفِي الصَّحِيحَيْنِ مِنْ حَدِيثِ ابْنِ عُمَرَ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ قَالَ وَهُوَ مُسْتَقْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_323", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَفِي بَعْضِ طُرُقِ الْبُخَارِيِّ: قَامَ خَطِيبًا فَأَشَارَ بِيَدِهِ نَحْوَ مَسْكَنِ عَائِشَةَ فَقَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_324", "reason": "high_symbol_ratio:0.438", "chunk_text": "فَالْمَشْرِقُ عَنْ مَدِينَتِهِ فِيهِ الْبَحْرَيْنُ، وَمِنْهَا خَرَجَ مُسَيْلِمَةُ الْكَذَّابُ الَّذِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_325", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَرَوَى أَبُو حَاتِمٍ فِي صَحِيحِيهِ عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ قَالَ: سَمِعْتُ النَّبِيَّ يَق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_326", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَصَاحِبُ الْيَمَامَةِ هُوَ مُسَيْلِمَةُ. قَالَ: وَقَالَ أَصْحَابِي: قَالَ: هُمْ قَرِيبٌ مِنْ ثَلَاث"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_327", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالُوا: وَمَا الْهَرْجُ يَا رَسُولَ اللَّهِ؟ قَالَ: الْقَتْلُ الْقَتْلُ. وَفِي صَحِيحِ ابْنِ حِبَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_328", "reason": "high_symbol_ratio:0.421", "chunk_text": "قَالَ: يَا أَبَا ذَرٍّ، أَرَأَيْتَ إِنْ أَصَابَ النَّاسَ مَوْتٌ شَدِيدٌ حَتَّى يَكُونَ الْبَيْتُ بِا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_329", "reason": "high_symbol_ratio:0.422", "chunk_text": "يَا أَبَا ذَرٍّ، أَرَأَيْتَ إِنْ قَتْلَ النَّاسُ بَعْضُهُمْ بَعْضًا حَتَّى تَغْرَقَ حِجَارَةُ الزَّي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_330", "reason": "high_symbol_ratio:0.442", "chunk_text": "قَالَ: اقْعُدْ فِي بَيْتِكَ، وَأَغْلِقْ عَلَيْكَ بَابَكَ. فَقَالَ: أَرَأَيْتَ إِنْ لَمْ أُتْرَكْ؟ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_331", "reason": "high_symbol_ratio:0.417", "chunk_text": "قَالَ: فَآخُذُ سِلَاحِي؟ قَالَ: إِذَا تُشَارِكُهُمْ فِيهِ، وَلَكِنْ إِنْ خَشِيتَ أَنْ يَرُوعَكَ شُعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_332", "reason": "high_symbol_ratio:0.437", "chunk_text": "وَفِيهِ عَنِ ابْنِ مَسْعُودٍ قَالَ: أَتَيْتُ النَّبِيَّ ، وَهُوَ فِي قُبَّةٍ مِنْ أَدَمٍ، فِيهَا أَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_333", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَأَمَّا الْفُتُوحُ الَّتِي فُتِحَتْ عَلَيْهِمْ، وَالنُّصْرَةُ الَّتِي نُصِرُوا فَقَدْ أَخْبَرَ بِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_334", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَرَوَى أَبُو حَاتِمٍ فِي صَحِيحِهِ، عَنِ ابْنِ عَبَّاسٍ قَالَ: مَرِضَ أَبُو طَالِبٍ فَأَتَتْهُ قُرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_335", "reason": "high_symbol_ratio:0.419", "chunk_text": "قَالَ: مَا شَأْنُ قَوْمِكَ يَشْكُونَكَ يَا ابْنَ أَخِي؟ قَالَ: يَا عَمِّ، إِنَّمَا أَرَدْتُهُمْ عَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_336", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَقَالَ: وَمَا هِيَ؟ قَالَ: لَا إِلَهَ إِلَّا اللَّهُ. فَقَامُوا، فَقَالُوا: أَجَعَلَ الْآلِهَةَ إِل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_337", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَفِي صَحِيحِ ابْنِ حِبَّانَ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_338", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالُوا: مَهْلًا - يَرْحَمُكِ اللَّهُ - تَقْدَمِينَ فَيَرَاكِ الْمُسْلِمُونَ، فَيُصْلِحُ اللَّهُ بِك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_339", "reason": "high_symbol_ratio:0.405", "chunk_text": "قَالَ عَلِيٌّ: وَايْمُ اللَّهِ لَقَدْ قَالَهَا رَسُولُ اللَّهِ . قَالَ أَبُو الْأَسْوَدِ: فَقُلْتُ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_340", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَهَذَا وَأَمْثَالُهُ مِمَّا أَخْبَرَ بِهِ مِنَ الْمُسْتَقْبَلَاتِ فَوَقَعَ بَعْدَهُ كَمَا أَخْبَرَ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_341", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَمَّا مَا أَخْبَرَ بِهِ مِمَّا لَمْ يَقَعْ إِلَى الْآنَ فَكَثِيرٌ، وَقَدْ أَخْبَرَ بِأَشْيَاءَ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_342", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَفِي الصَّحِيحَيْنِ، عَنْ أَبِي هُرَيْرَةَ قَالَ: شَهِدْنَا مَعَ رَسُولِ اللَّهِ حُنَيْنًا، فَقَالَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_343", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَلَمَّا حَضَرْنَا الْقِتَالَ، قَاتَلَ الرَّجُلُ قِتَالًا شَدِيدًا فَأَصَابَتْهُ جِرَاحَةٌ، فَقِيلَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_344", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَكَادَ بَعْضُ الْمُسْلِمِينَ أَنْ يَرْتَابَ، فَبَيْنَا هُمْ عَلَى ذَلِكَ إِذْ قِيلَ: فَإِنَّهُ لَمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_345", "reason": "high_symbol_ratio:0.419", "chunk_text": "ثُمَّ أَمَرَ بِلَالًا فَنَادَى فِي النَّاسِ: إِنَّهُ لَا يَدْخُلُ الْجَنَّةَ إِلَّا نَفْسٌ مَسْلِمَة"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_346", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَرَوَاهُ سَهْلُ بْنُ سَعْدٍ. وَفِي الصَّحِيحَيْنِ، عَنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ قَالَ: بَعَثَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_347", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَأَدْرَكْنَاهَا تَسِيرُ عَلَى بَعِيرٍ لَهَا خَبَبٌ فَقُلْنَا لَهَا: أَيْنَ الْكِتَابُ؟ فَقَالَتْ: م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_348", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: فَأَنَخْنَا بِهَا، فَالْتَمَسْنَا الْكِتَابَ فِي رَحْلِهَا، فَلَمْ نَرَ كِتَابًا، قَالَ: قُلْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_349", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: فَلَمَّا رَأَتْ أَنِّي أَهْوَيْتُ إِلَى حُجْزَتِهَا، وَهِيَ مُحْتَجِزَةٌ بِكِسَاءٍ، أَخْرَجَت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_350", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَأَحْبَبْتُ إِذْ فَاتَنِي ذَلِكَ مِنَ النَّسَبِ فِيهِمْ أَنْ أَتَّخِذَ يَدًا يَحْمُونَ بِهَا قَرَاب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_351", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : إِنَّهُ قَدْ صَدَقَكُمْ. فَقَالَ عُمَرُ: دَعْنِي أَضْرِبْ عُنُقَ هَذَا الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_352", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَكَانَ فِي هَذَا الْكِتَابِ إِخْبَارُ الْمُشْرِكِينَ بِأَنَّ النَّبِيَّ يُرِيدُ أَنْ يَغْزُوَهُمْ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_353", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَبِي هُرَيْرَةَ قَالَ: نَعَى رَسُولُ اللَّهِ لِلنَّاسِ النَّجَاشِيَّ فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_354", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَأَمَّنَا، وَصَلَّى عَلَيْهِ. وَفِي رِوَايَةِ عِمْرَانَ بْنِ حُصَيْنٍ قَالَ: إِنَّ أَخَاكُمْ قَدْ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_355", "reason": "high_symbol_ratio:0.455", "chunk_text": "يَعْنِي النَّجَاشِيَّ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_356", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَرَوَى مُوسَى بْنُ عُقْبَةَ، عَنِ ابْنِ شِهَابٍ، وَرَوَاهَا عُرْوَةُ بْنُ الزُّبَيْرِ، وَمُحَمَّدُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_357", "reason": "high_symbol_ratio:0.445", "chunk_text": "مُسَلِمُهُمْ وَكَافِرُهُمْ، فَمِنْهُمْ مَنْ فَعَلَهُ حَمِيَّةً، وَمِنْهُمْ مَنْ فَعَلَهُ إِيمَانًا و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_358", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَلَمَّا عَرَفَتْ قُرَيْشٌ أَنَّ الْقَوْمَ قَدْ مَنَعُوا الرَّسُولَ ، وَاجْتَمَعُوا عَلَى ذَلِكَ، اج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_359", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَلَبِثَ بَنُو هَاشِمٍ فِي شِعْبِهِمْ ثَلَاثَ سِنِينَ، وَاشْتَدَّ عَلَيْهِمُ الْبَلَاءُ وَالْجَهْدُ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_360", "reason": "high_symbol_ratio:0.418", "chunk_text": "زَادَ ابْنُ إِسْحَاقَ فِي رِوَايَتِهِ قَالَ: حَتَّى كَانَ يُسْمَعُ صَوْتُ صِبْيَانِهِمْ يَتَضَاغَوْن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_361", "reason": "high_symbol_ratio:0.403", "chunk_text": "قَالَ مُوسَى بْنُ عُقْبَةَ فِي تَمَامِ حَدِيثِهِ: وَكَانَ أَبُو طَالِبٍ إِذَا أَخَذَ النَّاسُ مَضَاج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_362", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَلَمَّا كَانَ رَأْسُ ثَلَاثِ سِنِينَ تَلَاوَمَ رِجَالٌ مِنْ بَنِي عَبْدِ مَنَافٍ وَمِنْ بَنِي قُصَي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_363", "reason": "high_symbol_ratio:0.414", "chunk_text": "الْبَيْتِ فَلَمْ تَتْرُكِ اسْمًا لِلَّهِ عَزَّ وَجَلَّ فِيهَا إِلَّا لَحَسَتْهُ، وَبَقِيَ مَا فِيهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_364", "reason": "high_symbol_ratio:0.421", "chunk_text": "لِيُعْطُوهُمْ رَسُولَ اللَّهِ ، فَتَكَلَّمَ أَبُو طَالِبٍ،= فَقَالَ: قَدْ حَدَثَتْ أُمُورٌ بَيْنَكُم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_365", "reason": "high_symbol_ratio:0.437", "chunk_text": "قَطَعَ بَيْنَنَا وَبَيْنَكُمْ رَجُلٌ وَاحِدٌ جَعَلْتُمُوهُ خَطَرًا لِهَلَكَةِ قَوْمِكُمْ وَعَشِيرَتِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_366", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَقَالَ أَبُو طَالِبٍ: إِنَّمَا أَتَيْتُكُمْ لِأُعْطِيَكُمْ أَمْرًا فِيهِ نَصَفٌ، فَإِنَّ ابْنَ أَخِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_368", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَقَالَ أُولَئِكَ النَّفَرُ مِنْ بَنِي عَبْدِ الْمُطَّلِبِ: إِنَّ أَوْلَى بِالسِّحْرِ وَالْكَذِبِ غَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_369", "reason": "high_symbol_ratio:0.424", "chunk_text": "أَفَنَحْنُ السَّحَرَةُ أَمْ أَنْتُمْ؟ فَقَالَ عِنْدَ ذَلِكَ النَّفَرُ مِنْ بَنِي عَبْدِ مَنَافٍ وَبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_370", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَأَنْشَأَ أَبُو طَالِبٍ يَقُولُ فِي ذَلِكَ الشِّعْرَ فِي شَأْنِ صَحِيفَتِهِمْ، وَيَمْتَدِحُ النَّفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_371", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَ مُوسَى بْنُ عُقْبَةَ: فَلَمَّا أَفْسَدَ اللَّهُ صَحِيفَةَ مَكْرِهِمْ، خَرَجَ النَّبِيُّ فَعَاش"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_372", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ، قَالَ: انْطَلَقَ سَعْدُ بْنُ مُعَاذ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_373", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ: انْتَظِرْ حَتَّى إِذَا انْتَصَفَ النَّهَارُ وَغَفَلَ النَّاسُ انْطَلَقْتُ، فَطُفْتُ، قَالَ: ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_374", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَقَالَ أَبُو جَهْلٍ: أَلَا أَرَاكَ تَطُوفُ بِالْبَيْتِ آمِنًا، وَقَدْ أَوَيْتُمُ الصُّبَاةَ، وَزَعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_375", "reason": "high_symbol_ratio:0.424", "chunk_text": "قَالَ: فَقَالَ لَهُ أُمَيَّةُ: لَا تَرْفَعْ صَوْتَكَ عَلَى أَبِي الْحَكَمِ سَيِّدِ أَهْلِ الْوَادِي،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_376", "reason": "high_symbol_ratio:0.434", "chunk_text": "قَالَ: بِمَكَّةَ؟ قَالَ: لَا أَدْرِي. فَفَزِعَ لِذَلِكَ أُمَيَّةُ فَزَعًا شَدِيدًا، وَقَالَ: وَاللَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_377", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَلَمَّا كَانَ يَوْمُ بَدْرٍ اسْتَنْصَرَ أَبُو جَهْلٍ النَّاسَ، فَقَالَ: أَدْرِكُوا عِيرَكُمْ. قَالَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_378", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَقَالَتْ لَهُ: يَا أَبَا صَفْوَانَ قَدْ نَسِيتَ مَا قَالَ لَكَ أَخُوكَ الْيَثْرِبِيُّ. قَالَ: لَا، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_379", "reason": "high_symbol_ratio:0.434", "chunk_text": "قَالَ: فَلَمَّا خَرَجَ أُمَيَّةُ جَعَلَ لَا يَنْزِلُ مَنْزِلًا إِلَّا عَقَلَ بِعِيرَهُ فَلَمْ يَزَلْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_380", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَعَنْ كَعْبِ بْنِ مَالِكٍ قَالَ: كَانَ أُبَيُّ بْنُ خَلَفٍ أَخُو بَنِي جُمَحَ قَدْ حَلَفَ وَهُوَ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_381", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَلَمَّا بَلَغَتْ رَسُولَ اللَّهِ حَلْفَتُهُ، قَالَ رَسُولُ اللَّهِ : بَلْ أَنَا أَقْتُلُهُ - إِنْ ش"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_382", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَأَقْبَلَ أُبَيٌّ مُقَنَّعًا فِي الْحَدِيدِ، وَهُوَ يَقُولُ: لَا نَجَوْتُ إِنْ نَجَا مُحَمَّدٌ، فَح"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_383", "reason": "high_symbol_ratio:0.407", "chunk_text": "مَا أَجْزَعَكَ! إِنَّمَا هُوَ خَدْشٌ، فَذَكَرَ لَهُمْ قَوْلَ رَسُولِ اللَّهِ : أَنَا أَقْتُلُ أُبَيً"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_384", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَرَوَاهُ مُوسَى بْنُ عُقْبَةَ، عَنِ ابْنِ شِهَابٍ الزُّهْرِيِّ عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ، وَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_385", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَذَكَرَ مُوسَى بْنُ عُقْبَةَ فِي مَغَازِيهِ أَنَّ عُمَيْرَ بْنَ وَهْبٍ الْجُمَحِيَّ لَمَّا رَجَعَ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_386", "reason": "high_symbol_ratio:0.430", "chunk_text": "قَالَ: أَجَلْ، وَاللَّهِ مَا فِي الْعَيْشِ خَيْرٌ بَعْدَهُمْ، وَلَوْلَا دَيْنٌ عَلَيَّ لَا أَجِدُ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_387", "reason": "high_symbol_ratio:0.437", "chunk_text": "الْمَسْجِدِ، وَعَقَلَ رَاحِلَتَهُ، وَأَخَذَ السَّيْفَ فَعَمَدَ لِرَسُولِ اللَّهِ ، فَنَظَرَ عُمَرُ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_388", "reason": "high_symbol_ratio:0.405", "chunk_text": "ثُمَّ قَامَ عُمَرُ حَتَّى دَخَلَ عَلَى رَسُولِ اللَّهِ إِلَى أَنْ قَالَ: قَالَ رَسُولُ اللَّهِ : مَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_389", "reason": "high_symbol_ratio:0.433", "chunk_text": "قَالَ: فَمَاذَا شَرَطْتَ لِصَفْوَانَ بْنِ أُمَيَّةَ فِي الْحِجْرِ؟ فَفَزِعَ عُمَيْرٌ وَقَالَ: مَاذَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_390", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَقَالَ عُمَيْرٌ: أَشْهَدُ أَنَّكَ رَسُولُ اللَّهِ، وَأَنْ لَا إِلَهَ إِلَّا اللَّهُ، كُنَّا نُكَذِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_391", "reason": "high_symbol_ratio:0.467", "chunk_text": "وَذَكَرَ بَقِيَّةَ الْحَدِيثِ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_392", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ عَنْ أَنَسٍ قَالَ: بَعَثَ رَسُولُ اللَّهِ أَقْوَامًا مِنْ بَنِي سُلَيْمٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_393", "reason": "high_symbol_ratio:0.421", "chunk_text": "جِبْرِيلُ النَّبِيَّ أَنَّهُمْ قَدْ لَقُوا رَبَّهُمْ فَرَضِيَ اللَّهُ عَنْهُمْ وَأَرْضَاهُمْ. فَكُنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_394", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَفِي الصَّحِيحَيْنِ مِنْ حَدِيثِ أَبِي حُمَيْدٍ السَّاعِدِيِّ قَالَ: خَرَجْنَا مَعَ رَسُولِ اللَّهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_395", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَحَمَلَتْهُ الرِّيحُ حَتَّى أَلْقَتْهُ بِجَبَلِ طَيِّئٍ. وَرَوَى الْإِمَامُ أَحْمَدُ، عَنِ ابْنِ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_396", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَقَالَ لَهُ رَسُولُ اللَّهِ : كَيْفَ أَسَرْتَهُ يَا أَبَا الْيَسَرِ؟ فَقَالَ: لَقَدْ أَعَانَنِي عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_397", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : لَقَدْ أَعَانَكَ عَلَيْهِ مَلَكٌ كَرِيمٌ. وَقَالَ لِلْعَبَّاسِ: يَا عَبَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_398", "reason": "high_symbol_ratio:0.428", "chunk_text": "قَالَ: فَإِنِّي قَدْ كُنْتُ مُسْلِمًا قَبْلَ ذَلِكَ وَإِنَّمَا اسْتَكْرَهُونِي. قَالَ: اللَّهُ أَعْل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_399", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَدْ كَانَ رَسُولُ اللَّهِ قَدْ أَخَذَ مِنْهُ عِشْرِينَ أُوقِيَّةً ذَهَبًا. فَقَالَ: يَا رَسُولَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_400", "reason": "high_symbol_ratio:0.427", "chunk_text": "قَالَ: لَا، ذَلِكَ شَيْءٌ أَعْطَانَا اللَّهُ مِنْكَ. قَالَ: فَإِنَّهُ لَيْسَ لِي مَالٌ. قَالَ: فَأَي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_401", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ فَوَالَّذِي بَعَثَكَ بِالْحَقِّ مَا عَلِمَ بِهَذَا أَحَدٌ مِنَ النَّاسِ غَيْرِي وَغَيْرُهَا وَ"}
