{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_564", "reason": "high_symbol_ratio:0.415", "chunk_text": "مِنْ بَنِي عَبْدِ اللَّهِ بْنِ مَيْمُونٍ الْقَدَّاحِ الْمُنْتَسِبِينَ إِلَى مُحَمَّدِ بْنِ إِسْمَاعِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_565", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَدَعْوَى كَثِيرٍ مِنَ النَّاسِ نَحْوَ ذَلِكَ فِي بَعْضِ الشُّيُوخِ، إِمَّا الْمَعْرُوفِينَ بِالصَّل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_566", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَعَامَّةُ هَؤُلَاءِ إِذَا خُوطِبُوا بِبَيَانِ فَسَادِ قَوْلِهِمْ قَالُوا مِنْ جِنْسِ قَوْلِ النَّصَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_567", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَيُنْشِدُونَ فِيهِمْ: مَجَانِينُ إِلَّا أَنَّ سِرَّ جُنُونِهِمُ عَزِيزٌ عَلَى أَقْدَامِهِ يَسْجُدُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_568", "reason": "high_symbol_ratio:0.424", "chunk_text": "يُعْتَرَضُ عَلَيْهِ كَمَا يَقُولُ النَّصَارَى لِشُيُوخِهِمْ وَمِنْ هَؤُلَاءِ مَنْ يَقُولُ نَحْنُ أَو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_569", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَغَايَةُ مَا عِنْدَهُمْ أَنَّهُمْ يَحْكُونَ عَنْ شُيُوخِهِمْ نَوْعًا مِنْ خَرْقِ الْعَادَاتِ، قَدْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_570", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَإِنَّمَا هَذَا مِنْ خَصَائِصِ الْأَنْبِيَاءِ الَّذِينَ يَجِبُ الْإِيمَانُ بِكُلِّ مَا يَقُولُونَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_571", "reason": "high_symbol_ratio:0.403", "chunk_text": "فَهَؤُلَاءِ الْمُبْتَدِعَةُ الْغُلَاةُ الْمُشْرِكُونَ الْقَائِلُونَ بِنَوْعٍ مِنَ الْحُلُولِ هُمْ مُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_572", "reason": "high_symbol_ratio:0.406", "chunk_text": "يَقْتَضِي امْتِنَاعَ ذَلِكَ قَالُوا هَكَذَا فِي الْكِتَابِ، وَبِهَذَا نَطَقَ الْكِتَابُ وَهَذِهِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_573", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَلِهَذَا يَنْهَوْنَ جُمْهُورَهُمْ عَنِ الْبَحْثِ وَالْمُنَاظَرَةِ فِي ذَلِكَ، لِعِلْمِهِمْ بِأَنَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_574", "reason": "high_symbol_ratio:0.412", "chunk_text": "بِالْعِبَارَاتِ الْبَيِّنَةِ كَمَا يَقُولُهُ الْمُسْلِمُونَ وَغَيْرُهُمْ بِدُونِ قَوْلِنَا أَبٌ وَاب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_575", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَمِمَّا يُبَيِّنُ ذَلِكَ الْوَجْهُ الثَّانِي: وَهُوَ أَنَّ النَّصَارَى - الْمُقِرُّونَ بِأَنَّ هَذِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_576", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَمِنْهُمْ مَنْ يَقُولُ: بَلِ الْأَبُ هُوَ الْوُجُودُ، وَالِابْنُ هُوَ الْكَلِمَةُ، وَرُوحُ الْقُدُس"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_577", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَدْ رَأَيْتُ فِي كُتُبِ النَّصَارَى هَذَا وَهَذَا وَهَذَا، وَمِنْهُمْ مَنْ يُعَبِّرُ عَنِ الْكَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_578", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْمَسِيحَ عَبْدٌ مُرْسَلٌ، كَسَائِرِ الرُّسُلِ - صَلَوَاتُ اللَّهِ عَلَيْهِمْ وَسَلَامُهُ -، فَوَاف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_579", "reason": "high_symbol_ratio:0.410", "chunk_text": "كَمَا أَنَّ النَّسْطُورِيَّةَ يُوَافِقُونَهُمْ أَيْضًا عَلَى هَذَا اللَّفْظِ، وَيُنَازِعُونَهُمْ فِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_580", "reason": "high_symbol_ratio:0.432", "chunk_text": "أَنَّ أَصْلَ قَوْلِهِمُ: الْأَبُ، وَالِابْنُ، وَرُوحُ الْقُدُسِ، لَمْ يَكُنْ لِأَجْلِ تَصْحِيحِ الْق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_581", "reason": "high_symbol_ratio:0.407", "chunk_text": "يُوَضِّحُ هَذَا الْوَجْهُ الثَّالِثُ: وَهُوَ قَوْلُهُمْ إِنَّمَا لَمَّا رَأَيْنَا حُدُوثَ الْأَشْيَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_582", "reason": "high_symbol_ratio:0.415", "chunk_text": "حَتَّى قَالُوا ذَلِكَ فَهَذَا كَذِبٌ بَيِّنٌ، فَإِنَّ هَذَا الْكَلَامَ يَقُولُ النَّصَارَى إِنَّهُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_583", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْمَسِيحُ وَالْحَوَارِيُّونَ لَمْ يَأْمُرُوهُمْ بِهَذَا النَّظَرِ الْمُوجِبِ لِهَذَا الْقَوْلِ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_584", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْوَجْهُ الرَّابِعُ: إِنَّ هَذَا الْقَوْلَ: إِنْ كَانَ الْمَسِيحُ لَمْ يَقُلْهُ فَلَا يَجُوزُ أَنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_585", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَلِهَذَا قَالَ تَعَالَى: أَنَّى يَكُونُ لَهُ وَلَدٌ وَلَمْ تَكُنْ لَهُ صَاحِبَةٌ وَخَلَقَ كُلَّ شَي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_586", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَجَعْلُ الرَّبِّ وَالِدَ الْمَوْلُودِ أَنْكَرُ فِي الْعُقُولِ مِنْ إِثْبَاتِ صَاحِبَةٍ لَهُ سَوَاءً"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_587", "reason": "high_symbol_ratio:0.414", "chunk_text": "صَاحِبَةٌ لِلْأَبِ بِالنَّاسُوتِ، وَاللَّاهُوتُ زَوْجُ مَرْيَمَ، بِلَاهُوتِهِ، كَمَا أَنَّهُ أَبٌ لِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_588", "reason": "high_symbol_ratio:0.412", "chunk_text": "اللَّهِ، وَنَاسُوتُهُ مِنْ مَرْيَمَ، فَهُوَ مِنْ أَصْلَيْنِ: لَاهُوتٌ وَنَاسُوتٌ، فَإِذَا كَانَ أَحَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_589", "reason": "high_symbol_ratio:0.402", "chunk_text": "الْأَنْبِيَاءِ مَعْصُومُونَ لَا يَقُولُونَ: إِلَّا الْحَقَّ، وَإِذَا قَالُوا قَوْلًا فَلَابُدَّ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_590", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَيَمْتَنِعُ أَنْ يُرِيدُوا بِقَوْلِهِمْ مَا يَمْتَنِعُ بُطْلَانُهُ بِسَمْعٍ أَوْ عَقْلٍ فَإِذَا كَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_591", "reason": "high_symbol_ratio:0.405", "chunk_text": "بَلْ نَقُولُ فِي الْوَجْهِ الْخَامِسِ: إِنْ صَحَّتْ هَذِهِ الْعِبَارَةُ عَنِ الْمَسِيحِ الْمَعْصُومِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_592", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَإِلَهِكُمْ فَيُسَمِّيهِ أَبًا لَهُمْ كَمَا يُسَمِّيهِمْ أَبْنَاءً لَهُ، فَإِنْ كَانَ هَذَا صَحِيحً"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_593", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَأَمَّا رُوحُ الْقُدُسِ: فَهِيَ لَفْظَةٌ مَوْجُودَةٌ فِي غَيْرِ مَوْضِعٍ مِنَ الْكُتُبِ الَّتِي عِن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_594", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْقُرْآنُ قَدْ شَهِدَ أَنَّ اللَّهَ أَيَّدَ الْمَسِيحَ بِرُوحِ الْقُدُسِ، كَمَا قَالَ تَعَالَى: و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_595", "reason": "high_symbol_ratio:0.406", "chunk_text": "فِي مَوْضِعَيْنِ مِنَ الْبَقَرَةِ. وَقَالَ تَعَالَى: يَا عِيسَى ابْنَ مَرْيَمَ اذْكُرْ نِعْمَتِي عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_596", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَقَدْ قَالَ النَّبِيُّ لِحَسَّانِ بْنِ ثَابِتٍ: إِنَّ رُوحَ الْقُدُسِ مَعَكَ مَا دُمْتَ تُنَافِحُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_597", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَرُوحُ الْقُدُسِ: قَدْ يُرَادُ بِهَا الْمَلَكُ الْمُقَدَّسُ كَجِبْرِيلَ، وَيُرَادُ بِهَا الْوَحْيُ،"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_598", "reason": "high_symbol_ratio:0.411", "chunk_text": "فِي مَوْضِعَيْنِ مِنْ سُورَةِ \" بَرَاءَةٌ \". وَقَالَ اللَّهُ تَعَالَى: فَأَرْسَلْنَا عَلَيْهِمْ رِيح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_599", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَالَ تَعَالَى: إِذْ يُوحِي رَبُّكَ إِلَى الْمَلَائِكَةِ أَنِّي مَعَكُمْ فَثَبِّتُوا الَّذِينَ آمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_600", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَالَ اللَّهُ تَعَالَى: يُنَزِّلُ الْمَلَائِكَةَ بِالرُّوحِ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_602", "reason": "high_symbol_ratio:0.406", "chunk_text": "إِنْ كَانَ قَالَ: عَمِّدُوا النَّاسَ بِاسْمِ الْأَبِ وَالِابْنِ وَرُوحِ الْقُدُسِ مُرَادُهُ مُرُوا ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_603", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَتَفْسِيرُ كَلَامِ الْمَعْصُومِ بِهَذَا التَّفْسِيرِ الَّذِي يُوَافِقُ سَائِرَ أَلْفَاظِ الْكُتُبِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_604", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَهَذَا تَفْسِيرٌ ظَاهِرٌ لَيْسَ فِيهِ تَكَلُّفٌ، وَلَا هُوَ مِنَ التَّأْوِيلِ الَّذِي هُوَ صَرْفُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_605", "reason": "high_symbol_ratio:0.406", "chunk_text": "أَمَّا تَفْسِيرُ النَّصَارَى بِأَنَّ الِابْنَ مَوْلُودٌ قَدِيمٌ أَزَلِيٌّ هُوَ الْعِلْمُ أَوْ كَلِمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_606", "reason": "high_symbol_ratio:0.426", "chunk_text": "تَفْسِيرُهُ بِمَا فَسَّرْنَاهُ، وَبِذَلِكَ فَسَّرَهُ أَكَابِرُ عُلَمَاءِ النَّصَارَى. وَأَمَّا ضُلَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_607", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَتَمَامُ هَذَا بِالْوَجْهِ السَّادِسِ: وَهُوَ أَنَّ النَّصَارَى لَمَّا كَانَ عِنْدَهُمْ فِي الْكُتُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_608", "reason": "high_symbol_ratio:0.451", "chunk_text": "الْمَخْلُوقِينَ، وَأَنَّ مَرْيَمَ زَوْجَةُ اللَّهِ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_609", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَكَذَلِكَ جَعَلُوا رُوحَ الْقُدُسِ مُشْتَرَكَةٌ بَيْنَ حَيَاةِ اللَّهِ وَبَيْنَ رُوحِ الْقُدُسِ الَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_611", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْقُدُسِ بِمَا يَنْزِلُ عَلَى الْأَنْبِيَاءِ كُنَّا قَدْ جَعَلْنَا اللَّفْظَ مُفْرَدًا مُتَوَاطِئًا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_612", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَيُؤَيِّدُ هَذَا الْوَجْهُ السَّابِعُ: وَهُوَ أَنَّهُمْ فِي أَمَانَتِهِمْ أَثْبَتُوا مِنَ الْمَعَان"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_613", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْوَجْهُ الثَّامِنُ: أَنَّ قَوْلَهُمْ بِالْأَقَانِيمِ مَعَ بُطْلَانِهِ فِي الْعَقْلِ وَالشَّرْعِ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_614", "reason": "high_symbol_ratio:0.421", "chunk_text": "لِلذَّاتِ وَالصِّفَةِ مَعًا، وَهَذَا تَفْسِيرُ حُذَّاقِهِمْ. الْوَجْهُ التَّاسِعُ: قَوْلُهُمْ فِي ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_615", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْوَجْهُ الْعَاشِرُ: قَوْلُهُمْ فِي تَجَسُّدِ اللَّاهُوتِ - أَيْضًا - هُوَ قَوْلٌ مَعَ بُطْلَانِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_616", "reason": "high_symbol_ratio:0.429", "chunk_text": "أَنَّكُمْ تُثْبِتُونَ ذَلِكَ بِالْعَقْلِ، لَمْ تَذْكُرُوا عَلَى ذَلِكَ دَلِيلًا عَقْلِيًّا."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_617", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَقَوْلُكُمْ لَمَّا رَأَيْنَا حُدُوثَ الْأَشْيَاءِ عَلِمْنَا أَنَّ شَيْئًا غَيْرَهَا أَحْدَثَهَا إِذ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_618", "reason": "high_symbol_ratio:0.415", "chunk_text": "أَوْ حُدُوثُ مَا سِوَى اللَّهِ وَنَحْوُ ذَلِكَ مِمَّا يُبَيِّنَ أَنَّ الْمُحْدَثَ مَا سِوَى اللَّهِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_619", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَإِنَّ هَذَا التَّرْكِيبَ يُبَيِّنُ أَنَّ الْخَالِقَ غَيْرُ الْمَخْلُوقِ خِلَافَ قَوْلِ الْقَائِلِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_620", "reason": "high_symbol_ratio:0.420", "chunk_text": "الثَّالِثُ: أَنَّ الْعِلْمَ بِأَنَّ الْمُحْدَثَ لَابُدَّ لَهُ مِنْ مُحْدِثٍ، عِلْمٌ فِطْرِيٌّ ضَرُور"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_621", "reason": "high_symbol_ratio:0.416", "chunk_text": "قَالَ جُبَيْرُ بْنُ مُطْعِمٍ: لَمَّا سَمِعْتُ النَّبِيَّ يَقْرَأُ بِهَا فِي صَلَاةِ الْمَغْرِبِ أَحْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_622", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمَعْلُومٌ بِالْفِطْرَةِ الَّتِي فَطَرَ اللَّهُ عَلَيْهَا عِبَادَهُ بِصَرِيحِ الْعَقْلِ أَنَّ الْحَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_623", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَإِنَّ حُدُوثَ الْحَادِثِ بِلَا مُحْدِثٍ أَحْدَثَهُ مَعْلُومُ الْبُطْلَانِ بِضَرُورَةِ الْعَقْلِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_624", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَلِهَذَا لَوْ جَوَّزَ مُجَوِّزٌ أَنْ يَحْدُثَ كِتَابَةٌ أَوْ بِنَاءٌ أَوْ غِرَاسٌ وَنَحْوُ ذَلِكَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_625", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَقَوْلُكُمْ لَمْ يَكُنْ حُدُوثُهَا مِنْ ذَوَاتِهَا لِمَا فِيهَا مِنَ التَّضَادِّ وَالتَّقَلُّبِ، تَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_626", "reason": "high_symbol_ratio:0.455", "chunk_text": "مَعْدُومًا."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_627", "reason": "high_symbol_ratio:0.416", "chunk_text": "الْوَجْهُ الرَّابِعُ: أَنَّكُمْ ذَكَرْتُمْ حُجَّةً عَلَى أَنَّهَا لَمْ تُحْدِثْ نَفْسَهَا، وَهِيَ حُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_628", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَكَيْفَ إِذَا كَانَ الدَّلِيلُ بَاطِلًا؟ وَمَنْ يَكُونُ مُبَلِّغَهُمْ مِنَ الْعِلْمِ بِالْأَدِلَّةِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_629", "reason": "high_symbol_ratio:0.407", "chunk_text": "سَرِيعُ الْحِسَابِ * أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_630", "reason": "high_symbol_ratio:0.430", "chunk_text": "الْوَجْهُ الثَّانِي عَشَرَ: قَوْلُكُمْ: فَقُلْنَا إِنَّهُ شَيْءٌ لَا كَالْأَشْيَاءِ الْمَخْلُوقَةِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_631", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَيُقَالُ لَهُمْ: لَا رَيْبَ أَنَّ اللَّهَ كَمَا وَصَفَ نَفْسَهُ بِقَوْلِهِ تَعَالَى: لَيْسَ كَمِثْل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_632", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَقَوْلِهِ: فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهِ هَلْ تَعْلَمُ لَهُ سَمِيًّا. أَيْ مَثَلًا يَسْتَحِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_633", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَقَدْ دَلَّ عَلَى ذَلِكَ الْعَقْلُ، فَإِنَّ الْمِثْلَيْنِ اللَّذَيْنِ يَسُدُّ أَحَدُهُمَا مَسَدَّ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_634", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَالْخَالِقُ يَجِبُ لَهُ الْوُجُودُ وَالْقِدَمُ، وَيَمْتَنِعُ عَلَيْهِ الْعَدَمُ، فَيَلْزَمُ أَنْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_635", "reason": "high_symbol_ratio:0.421", "chunk_text": "لِلْقِدَمِ وَاجِبَ الْحُدُوثِ بَعْدَ الْعَدَمِ وَهَذَا جَمْعٌ بَيْنَ النَّقِيضَيْنِ، فَالْعَقْلُ الص"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_636", "reason": "high_symbol_ratio:0.418", "chunk_text": "كُلِّ شَيْءٍ عَلَى أَنَّهُ لَيْسَ كَمِثْلِهِ شَيْءٌ، بَلْ قُلْتُمْ لِأَنَّنَا مَعْشَرَ النَّصَارَى ل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_637", "reason": "high_symbol_ratio:0.426", "chunk_text": "مَعْدُومًا، وَهَذَا مَعْلُومٌ بِالضَّرُورَةِ لَا يَحْتَاجُ إِلَى دَلِيلٍ عِنْدَ جُمْهُورِ الْعُقَلَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_639", "reason": "high_symbol_ratio:0.433", "chunk_text": "===فصل: دلائل حياة الله=== وَأَمَّا قَوْلُكُمْ: وَرَأَيْنَا الْأَشْيَاءَ الْمَخْلُوقَةَ تَنْقَسِمُ ق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_640", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَيُقَالُ: لَا رَيْبَ أَنَّ اللَّهَ حَيٌّ كَمَا نَطَقَتْ بِذَلِكَ كُتُبُهُ الْمُنَزَّلَةُ الَّتِي هِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_641", "reason": "high_symbol_ratio:0.429", "chunk_text": "أَيِ الْقُرْآنُ حَقٌّ، وَقَدْ تَقَدَّمَ ذِكْرُ الْقُرْآنِ فِي قَوْلِهِ: قُلْ أَرَأَيْتُمْ إِنْ كَانَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_642", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَاللَّهُ تَعَالَى يُرِي عِبَادَهُ مِنْ آيَاتِهِ الْمُشَاهَدَةِ الْمُعَايَنَةِ الْفِعْلِيَّةِ، مَا ي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_643", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ تَعَالَى: اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ وَقَالَ تَعَالَى: وَتَوَكَّلْ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_644", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَالدَّلَائِلُ عَلَى حَيَاتِهِ كَثِيرَةٌ: مِنْهَا: أَنَّهُ قَدْ ثَبَتَ أَنَّهُ عَالِمٌ، وَالْعِلْمُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_645", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَمِنْهَا: أَنَّهُ خَالِقُ الْأَحْيَاءِ وَغَيْرِهِمْ، وَالْخَالِقُ أَكْمَلُ مِنَ الْمَخْلُوقِ، فَكُل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_646", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَالْمُتَفَلْسِفَةُ الْقَائِلُونَ بِالْمُوجِبِ بِالذَّاتِ يُسَلِّمُونَ هَذَا، وَيَقُولُونَ: كَمَالُ "}
