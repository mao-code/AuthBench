{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1044", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِذَا امْتَنَعَ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِنْ وَرَاءِ حِجَابٍ فَامْتِنَاعُ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1045", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِنَّ مَا اتَّحَدَ بِهِ وَحَلَّ فِيهِ كَلِمَةُ اللَّهِ مِنْ غَيْرِ حِجَابٍ بَيْنَ اللَّاهُوتِ وَال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1046", "reason": "high_symbol_ratio:0.424", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنَّ قَوْلَهُ: وَمَا كَانَ لِبَشَرٍ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1047", "reason": "high_symbol_ratio:0.413", "chunk_text": "يَقْتَضِي أَنْ يَكُونَ الْحِجَابُ حِجَابًا يَحْجُبُ الْبَشَرَ كَمَا حَجَبَ مُوسَى، فَيَقْتَضِي ذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1048", "reason": "high_symbol_ratio:0.409", "chunk_text": "قِيلَ: أَنَا أَوَّلُ مَنْ آمَنَ أَنَّهُ لَا يَرَاكَ أَحَدٌ فِي الدُّنْيَا. وَعِنْدَهُمْ فِي التَّوْر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1049", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَهَذَا مَعْرُوفٌ عِنْدَهُم، وَإِذَا كَانَ كَذَلِكَ فَلَا بُدَّ أَنْ يَكُونَ الْحِجَابُ الْحَاجِبُ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1050", "reason": "high_symbol_ratio:0.415", "chunk_text": "يُبَيِّنُ هَذَا الْوَجْهُ الرَّابِعُ: وَهُوَ أَنَّ ذَلِكَ الْجَسَدَ الَّذِي وَلَدَتْهُ مَرْيَمُ هُوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1051", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَتَبَيَّنَ أَنَّ نَفْيَ الْأَنْبِيَاءِ لِأَنْ يَرَاهُ الْمَرْءُ فِي الدُّنْيَا هُوَ نَفْيٌ لِمُمَاس"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1052", "reason": "high_symbol_ratio:0.417", "chunk_text": "الدُّنْيَا قَدْ نَفَاهَا اللَّهُ، وَمَنَعَهَا عَلَى أَلْسُنِ رُسُلِهِ: مُوسَى وَعِيسَى وَمُحَمَّدٍ ص"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1053", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَاحِدٍ، وَلَمَّا كَانَ سَمَاعُ كَلَامِهِ لِلْبَشَرِ مُمْكِنًا سَمِعَ كَلَامَهُ غَيْرُ وَاحِدٍ، وَرُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1054", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالْخُلَّةُ لَمَّا كَانَتْ مُمْكِنَةً اتَّخَذَ إِبْرَاهِيمَ خَلِيلًا، وَاتَّخَذَ مُحَمَّدًا أَيْضًا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1055", "reason": "high_symbol_ratio:0.402", "chunk_text": "الْوَجْهُ السَّابِعُ: قَوْلُهُم: وَإِذَا كَانَتِ اللَّطَائِفُ لَا تَظْهَرُ إِلَّا فِي الْكَثَائِفِ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1056", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَيُقَالُ لَهُم: ظُهُورُ اللَّطَائِفِ فِي الْكَثَائِفِ كَلَامٌ مُجْمَلٌ، فَإِنْ أَرَدْتُمْ أَنَّ رُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1057", "reason": "high_symbol_ratio:0.415", "chunk_text": "اللَّهَ يَحُلُّ فِي بَشَرٍ، وَلَا ادَّعَى صَادِقٌ قَطُّ حُلُولَ الرَّبِّ فِيهِ، وَإِنَّمَا يَدَّعِي "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1058", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَلِهَذَا لَمَّا أَنْذَرَ النَّبِيُّ بِالْمَسِيحِ الدَّجَّالِ، وَقَالَ: مَا مِنْ نَبِيٍّ إِلَّا وَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1059", "reason": "high_symbol_ratio:0.449", "chunk_text": "بَشَرٍ فَإِنَّهُ يُرَى فِي الدُّنْيَا بِالْعَيْنِ، فَعُلِمَ أَنَّ اللَّهَ لَا يَتَّحِدُ بِبَشَرٍ. ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1061", "reason": "high_symbol_ratio:0.406", "chunk_text": "فِي إِمْكَانِ دَعْوَاهُ، وَإِذَا صَدَّقُوهُ صَدَّقُوا النَّصَارَى فِي دَعْوَى إِلَهِيَّةِ الْمَسِيحِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1062", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَبِهَذَا يَظْهَرُ الْجَوَابُ عَمَّا يُورِدُهُ بَعْضُ أَهْلِ الْكَلَامِ كَالرَّازِيِّ عَلَى هَذَا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1063", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَقَالُوا: هَذَا إِلَهُكُمْ وَإِلَهُ مُوسَى، وَظَنُّوا أَنَّ مُوسَى نَسِيَهُ. وَالنَّصَارَى مَعَ كَث"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1064", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي الْمُنْتَسِبِينَ إِلَى الْقِبْلَةِ خَلْقٌ كَثِيرٌ يَقُولُونَ ذَلِكَ فِي كَثِيرٍ مِنَ الْمَشَاي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1065", "reason": "high_symbol_ratio:0.413", "chunk_text": "هَذِهِ الْخَوَارِقَ الْعَظِيمَةَ أَنْ يُعْتَقَدَ فِيهِ أَنَّهُ اللَّهُ، وَهُوَ يَقُولُ: أَنَا اللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1066", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْوَجْهُ التَّاسِعُ: قَوْلُهُم: فَكَلِمَةُ اللَّهِ الَّتِي بِهَا خُلِقَتِ اللَّطَائِفُ تَظْهَرُ فِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1067", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَإِنْ أُرِيدَ بِهِ أَنَّ كَلَامَ اللَّهِ فَارَقَ ذَاتَهُ وَحَلَّ فِي الْمَسِيحِ أَوْ غَيْرِهِ، فَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1069", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَكَمَا ظَهَرَ اللَّهُ مِن طُورِ سَيْنَاءَ وَأَشْرَقَ مِنْ سَاعِيرَ وَاسْتَعْلَنَ مِن جِبَالِ فَارَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1070", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَقَالَ: يَمْلِكُ الْمُلْكَ، وَرَبُّ الْعَالَمِينَ مَا زَالَ وَلَا يَزَالُ مَالِكًا لِلْمُلْكِ سُبْح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1071", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَأَيْضًا فَإِنَّهُ قَالَ: وَهُوَ ضَوْءُ النُّورِ لَمْ يَجْعَلْهُ النُّورَ نَفْسَهُ، بَلْ جَعَلَهُ ض"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1072", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَغَيْرُهُ مِنَ الْأَنْبِيَاءِ ذَلِكَ بَيَانًا قَاطِعًا لِلْعُذْرِ، وَلَمْ يَكْتَفُوا بِمِثْلِ هَذِه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1073", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَمَّا الْإِخْبَارُ بِمَجِيءِ الرَّبِّ نَفْسِهِ وَحُلُولِهِ أَوِ اتِّحَادِهِ بِنَاسُوتٍ بَشَرِيٍّ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1074", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَإِمَّا مُمْكِنٌ كَمَا يَقُولُهُ بَعْضُ النَّاسِ، وَحِينَئِذٍ فَإِمْكَانُهُ خَفِيَ عَلَى أَكْثَرِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1075", "reason": "high_symbol_ratio:0.402", "chunk_text": "يَتَّحِدُ لَا بِمُوسَى وَلَا بِغَيْرِهِ، وَمَعَ هَذَا فَقَدْ أَظْهَرَ مِنَ الْآيَاتِ عَلَى ذَلِكَ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1076", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَلَوْ كَانَ هُوَ بِذَاتِهِ مُتَّحِدًا بِنَاسُوتٍ بَشَرِيٍّ لَكَانَ الْأَنْبِيَاءُ يُخْبِرُونَ بِذَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1077", "reason": "high_symbol_ratio:0.429", "chunk_text": "فصل قَالُوا: وَقَالَ أَشْعِيَا النَّبِيُّ: قُلْ لِصِهْيُونَ هُنَا تَفْرَحُ وَتَتَهَلَّلُ، فَإِنَّ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1078", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَيُقَالُ: هَذَا مُحْتَاجٌ أَوَّلًا أَنْ يُعْلَمَ مِنْ هَذِهِ النُّبُوَّةِ أَنَّ هَذَا الْكَلَامَ نُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1079", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَمَعْلُومٌ أَنَّهُ لَيْسَ فِي هَذَا مَا يَدُلُّ عَلَى أَنَّ اللَّهَ حَالٌّ فِي مُوسَى بْنِ عِمْرَان"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1080", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَكَذَلِكَ هَذَا اللَّفْظُ لَا يَدُلُّ عَلَى أَنَّهُ حَالٌّ فِي الْمَسِيحِ وَمُتَّحِدٌ بِهِ، إِذْ كِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1081", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَوْلُهُ: وَيُظْهِرُ اللَّهُ ذِرَاعَهُ الطَّاهِرَ لِجَمِيعِ الْأُمَمِ الْمُبَدَّدِينَ، قَدْ قَالَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1082", "reason": "high_symbol_ratio:0.443", "chunk_text": "وَأَمَّا قَوْلُهُ عَنِ الْأُمَمِ الْمُبَدَّدِينَ: فَيَجْعَلُهُمْ أُمَّةً وَاحِدَةً، فَهُمُ الَّذِينَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1083", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَأَمَّا قَوْلُهُ: وَيُبَصِّرُونَ جَمِيعَ أَهْلِ الْأَرْضِ خَلَاصَ اللَّهِ، لِأَنَّهُ يَمْشِي مَعَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1084", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَفِي مَوْضِعٍ قَالَ مُوسَى: إِنَّ الشَّعْبَ هُوَ شَعْبُكَ، فَقَالَ: أَنَا أَمْضِي أَمَامَكَ فَارْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1085", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَفِي السِّفْرِ الرَّابِعِ مِنَ الْفَصْلِ الثَّالِثَ عَشَرَ: إِنْ أَصْعَدْتَ هَؤُلَاءِ مِنْ بَيْنِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1086", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَفِي التَّوْرَاةِ أَيْضًا: يَقُولُ اللَّهُ لِمُوسَى: (إِنِّي آتٍ إِلَيْكَ فِي غِلَظِ الْغَمَامِ لِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1087", "reason": "high_symbol_ratio:0.411", "chunk_text": "ثُمَّ قَوْلُهُ: اجْمَعْ سَبْعِينَ رَجُلًا مِنْ شُيُوخِ بَنِي إِسْرَائِيلَ وَخُذْهُمْ إِلَى خِبَاءِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1088", "reason": "high_symbol_ratio:0.411", "chunk_text": "فصل قَالُوا: وَقَالَ زَكَرِيَّا النَّبِيُّ: (افْرَحِي يَا بَيْتَ صِهْيُونَ، لِأَنِّي آتِيكِ وَأَحُلُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1089", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَيُقَالُ: مِثْلُ هَذَا قَدْ ذُكِرَ عِنْدَهُمْ عَن إِبْرَاهِيمَ وَغَيْرِهِ مِنَ الْأَنْبِيَاءِ أَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1090", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَكَذَلِكَ إِتْيَانُهُ، وَهُوَ لَمْ يَقُل: إِنِّي أَحُلُّ فِي الْمَسِيحِ وَأَتَّحِدُ بِهِ، وَإِنَّمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1091", "reason": "high_symbol_ratio:0.408", "chunk_text": "حَصَلَتْ مَعْرِفَتُهُ وَالْإِيمَانُ بِهِ فِي الْقُلُوبِ اطْمَأَنَّتْ وَسَكَنَت. وَكَانَ بَيْتُ الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1092", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَجِمَاعُ هَذَا أَنَّ النُّبُوَّاتِ الْمُتَقَدِّمَةَ وَالْكُتُبَ الْإِلَهِيَّةَ كَالتَّوْرَاةِ وَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1093", "reason": "high_symbol_ratio:0.416", "chunk_text": "فَكُتُبُ الْأَنْبِيَاءِ الْمُتَقَدِّمَةُ، وَسَائِرُ النُّبُوَّاتِ مُوَافِقَةٌ لِمَا أَخْبَرَ بِهِ مُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1094", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَهَذِهِ الْكَلِمَاتُ وَمَا أَشْبَهَهَا مَوْجُودَةٌ فِي حَقِّ غَيْرِ الْمَسِيحِ عِنْدَهُم، وَلَمْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1095", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَلَكِنِ الْقَائِلُونَ بِالْحُلُولِ وَالِاتِّحَادِ فِي حَقِّ جَمِيعِ الْأَنْبِيَاءِ وَالصَّالِحِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1096", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهَذَا الْمَذْهَبُ بَاطِلٌ بِاتِّفَاقِ الْمُسْلِمِينَ وَالْيَهُودِ وَالنَّصَارَى، وَهُوَ بَاطِلٌ فِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1097", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَظَنُّوا أَنَّ ذَلِكَ ذَاتُ الرَّبِّ، كَمَنْ يَظُنُّ أَنَّ نَفْسَ اللَّفْظِ بِالِاسْمِ هُوَ الْمَعْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1100", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَالْمُؤْمِنُونَ يَعْرِفُونَ اللَّهَ وَيُحِبُّونَهُ وَيَعْبُدُونَهُ وَيَذْكُرُونَهُ وَيُقَالُ هُوَ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1102", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ أُبَيُّ بْنُ كَعْبٍ: مَثَلُ نُورِهِ فِي قُلُوبِ الْمُؤْمِنِينَ. ثُمَّ قَالَ: نُورٌ عَلَى نُورٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1103", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَذَكَرَ سُبْحَانَهُ نُورَهُ فِي قُلُوبِ الْمُؤْمِنِينَ، ثُمَّ ذَكَرَ ذَلِكَ فِي بُيُوتِهِ، كَذَلِكَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1104", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَأَمَّا الْإِتْيَانُ وَالْمَجِيءُ وَالتَّجَلِّي فَعِنْدَهُمْ فِي التَّوْرَاةِ يَقُولُ اللَّهُ لِمُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1105", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَفِي الْفَصْلِ الثَّالِثَ عَشَرَ: (إِنْ أَصْعَدْتَ هَؤُلَاءِ مِنْ بَيْنِهِمْ بِقُدْرَتِكَ، فَيَقُول"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1106", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَفِي السِّفْرِ الْخَامِسِ قَوْلُ مُوسَى لِبَنِي إِسْرَائِيلَ: (لَا تَهَابُوهُمْ وَلَا تَخَافُوهُم، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1107", "reason": "high_symbol_ratio:0.437", "chunk_text": "فَأَخْبَرَ أَنَّهُ يَحُلُّ فِي جَمِيعِ الصِّدِّيقِينَ، أَيْ مَعْرِفَتُهُ وَمَحَبَّتُهُ، فَإِنَّهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1108", "reason": "high_symbol_ratio:0.404", "chunk_text": "فصل قَالُوا: وَقَالَ عَامُوصَ النَّبِيُّ: سَتُشْرِقُ الشَّمْسُ عَلَى الْأَرْضِ، وَيَهْتَدِي بِهَا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1109", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَيُقَالُ: هَذَا مِمَّا لَا يُنَازِعُ فِيهِ الْمُسْلِمُونَ، وَإِنَّمَا يُنَازِعُ فِي مِثْلِ هَذَا وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1110", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَأَمَّا الْمُسْلِمُونَ فَيُؤْمِنُونَ بِجَمِيعِ كُتُبِ اللَّهِ وَرُسُلِهِ، وَأَنَّ الْمَسِيحَ عَلَيْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1111", "reason": "high_symbol_ratio:0.408", "chunk_text": "كَمَا أَشْرَقَ قَبْلَهُ نُورُ مُوسَى عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ، وَأَشْرَقَ بَعْدَهُ نُورُ مُح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1112", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَسَمَّاهُ اللَّهُ سِرَاجًا مُنِيرًا، وَسَمَّى الشَّمْسَ سِرَاجًا وَهَّاجًا، وَالسِّرَاجُ الْمُنِيرُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1113", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَالَ تَعَالَى لِمُحَمَّدٍ : فَالَّذِينَ آمَنُوا بِهِ وَعَزَّرُوهُ وَنَصَرُوهُ وَاتَّبَعُوا النُّو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1115", "reason": "high_symbol_ratio:0.401", "chunk_text": "كَافِرٌ، كَمَا قَالَ تَعَالَى: إِذْ قَالَ اللَّهُ يَا عِيسَى إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1117", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَوْلُهُ: سَتُشْرِقُ الشَّمْسُ عَلَى الْأَرْضِ وَيَهْتَدِي بِهَا الضَّالُّونَ وَيَضِلُّ عَنْهَا بَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1118", "reason": "high_symbol_ratio:0.413", "chunk_text": "النَّصَارَى، وَالْيَهُودُ مِنْ قَبْلِ النَّصَارَى. وَهَذَا مَوْجُودٌ فِي عَصْرِنَا هَذَا، فِي أَهْلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1119", "reason": "high_symbol_ratio:0.417", "chunk_text": "قُلْتُ: وَمَعْلُومٌ أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ وَالْمُحْسِنِينَ وَالْمُقْسِطِينَ بِالْهِدَايَة"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1121", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَيُقَالُ: لَيْسَ فِي هَذِهِ الْبِشَارَةِ دَلَالَةٌ بَيِّنَةٌ أَنَّ الْمُرَادَ بِهِ الْمَسِيحُ ، وَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1122", "reason": "high_symbol_ratio:0.444", "chunk_text": "وَمِنْ جِهَةِ أَنَّهُ بُعِثَ بِالسَّيْفِ الَّذِي يَتَقَلَّدُ بِهِ عَلَى عَاتِقِهِ وَيَرْفَعُهُ، إِذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1123", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَهَذِهِ صِفَةُ مُحَمَّدٍ الْمُؤَيَّدِ الْمَنْصُورِ الْمُسَلَّطِ رَئِيسِ السَّلَامَةِ، فَإِنَّ دِينَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1124", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَالْمَسِيحُ لَمْ يُسَلَّطْ عَلَى أَعْدَائِهِ، كَمَا سُلِّطَ مُحَمَّدٌ ، بَلْ كَانَ أَعْدَاؤُهُ بِحَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1125", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَقَالَ: (فِي كُلِّ الدُّهُورِ سُلْطَانُهُ كَامِلٌ لَيْسَ لَهُ فَنَاءٌ)، وَهَذَا صِفَةُ خَاتَمِ الرُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1126", "reason": "high_symbol_ratio:0.409", "chunk_text": "فصل قَالُوا: وَقَالَ أَشْعِيَا أَيْضًا: يَخْرُجُ عَصَاهُ مِنْ بَيْتِ يَسِّي يَنْبُتُ نُورٌ مِنْهَا، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1127", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي تِلْكَ الْأَيَّامِ يَكُونُ أَصْلُ يَسِّي آيَةً لِلْأُمَمِ، وَبِهِ يُؤْمِنُونَ وَعَلَيْهِ يَتَو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1128", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَالْجَوَابُ: أَنَّ هَذَا الْكَلَامَ بَعْدَ الْمُطَالَبَةِ بِصِحَّةِ نَقْلِهِ عَنِ النَّبِيِّ، وَصِح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1129", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَضْلًا عَنْ أَنْ يَقُولَ حَلَّ فِيهِ اللَّهُ أَوِ اتَّحَدَ بِهِ، وَلَكِنْ جَعَلَ رُوحَ الْقُدُسِ هِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1130", "reason": "high_symbol_ratio:0.411", "chunk_text": "كَمَا أَنَّ عِنْدَهُمْ فِي التَّوْرَاةِ (أَنَّ الَّذِينَ كَانُوا يَعْمَلُونَ فِي قُبَّةِ الزَّمَانِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1132", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَقَالَ: هِيَ رُوحُ اللَّهِ، وَهَذَا كَقَوْلِهِ تَعَالَى: أُولَئِكَ كَتَبَ فِي قُلُوبِهِمُ الْإِيمَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1134", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَقَالَ تَعَالَى: يُنَزِّلُ الْمَلَائِكَةَ بِالرُّوحِ مِنْ أَمْرِهِ. فَمَا أَنْزَلَهُ يُسَمَّى هُدَى"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1135", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَالَ تَعَالَى لَمَّا ذَكَرَ أَنْبِيَاءَهُ مِنْ ذُرِّيَّةِ إِبْرَاهِيمَ فَقَالَ: وَمِنْ ذُرِّيَّتِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1136", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَقَالَ تَعَالَى: فَإِمَّا يَأْتِيَنَّكُمْ مِنِّي هُدًى فَمَنِ اتَّبَعَ هُدَايَ فَلَا يَضِلُّ وَلَا "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1137", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَسَمَّاهُ نُورَ اللَّهِ كَقَوْلِهِ تَعَالَى: اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1139", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَالَ تَعَالَى: أُولَئِكَ كَتَبَ فِي قُلُوبِهِمُ الْإِيمَانَ وَأَيَّدَهُمْ بِرُوحٍ مِنْهُ. فصل قَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1140", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَيُقَالُ: مِثْلُ هَذَا الْكَلَامِ لَا بُدَّ أَنْ يَكُونَ قَبْلَهُ كَلَامٌ وَبَعْدَهُ كَلَامٌ، وَهُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1141", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالنَّصَارَى يُسَلِّمُونَ أَنَّ اللَّاهُوتَ مَا هُوَ مُتَوَلِّدٌ مِنَ الْبَشَرِ، وَإِنَّمَا الْمُتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1142", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَنَظِيرُ هَذَا مَا عِنْدَهُمْ فِي إِنْجِيلِ مَتَّى: (أَنَّ ابْنَ الْإِنْسَانِ يُرْسِلُ مَلَائِكَتَه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1143", "reason": "high_symbol_ratio:0.423", "chunk_text": "ثُمَّ شَهَادَةِ (لُوقَا) أَنَّ اللَّهَ أَرْسَلَ لَهُ مَلَكًا مِنَ السَّمَاءِ لِيُقَوِّيَهُ. قَالَ: \""}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1144", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَقَالَ الْمَسِيحُ لِتَلَامِيذِهِ: \" مَنْ قَبِلَكُمْ فَقَدْ قَبِلَنِي، وَمَنْ قَبِلَنِي فَقَدْ قَبِل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1145", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَقَالَ الْمَسِيحُ: \" مَنْ أَنْكَرَنِي قُدَّامَ النَّاسِ أَنْكَرْتُهُ قُدَّامَ مَلَائِكَةِ اللَّهِ \""}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1146", "reason": "high_symbol_ratio:0.409", "chunk_text": "فصل قَالُوا: وَمِثْلُ هَذَا الْقَوْلِ فِي كُتُبِ اللَّهِ الْمُنَزَّلَةِ عَلَى أَفْوَاهِ الْأَنْبِيَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1147", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالْجَوَابُ عَلَى هَذَا مِنْ وُجُوهٍ: أَحَدُهَا: أَنَّ الْقَوْلَ فِي سَائِرِ مَا يَذْكُرُونَهُ مِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1148", "reason": "high_symbol_ratio:0.405", "chunk_text": "اللَّهُ فِيهِم: فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_1149", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَهَذَا كَقَوْلِ الْمَسِيحِ لَمَّا سُئِلَ عَنْ عِلْمِ السَّاعَةِ فَقَالَ: (لَا يَعْلَمُهَا إِنْسَانٌ"}
