{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_242", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَأَخْبِرْنِي يَا رَسُولَ اللَّهِ: أَصَبْتُ أَمْ أَخْطَأْتُ؟ فَقَالَ: أَصَبْتَ بَعْضًا وَأَخْطَأْتَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_243", "reason": "high_symbol_ratio:0.450", "chunk_text": "قَالَ: لَا تُقْسِمْ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_244", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَبِي هُرَيْرَةَ رَضِيَ اللَّهُ عَنْهُ قَالَ: سَمِعْتُ رَسُولَ اللَّهِ يَق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_245", "reason": "high_symbol_ratio:0.440", "chunk_text": "قَالَ الشَّافِعِيُّ: رُؤْيَا الْأَنْبِيَاءِ وَحْيٌ. وَقَوْلُهُ: فِي نَزْعِهِ ضَعْفٌ، قِصَرُ مُدَّتِه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_246", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ، عَنْ أَبِيهِ أَنَّ امْرَأَةً سَأَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_247", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَرَوَى أَبُو دَاوُدَ الطَّيَالِسِيُّ، عَنْ أَبِي ثَعْلَبَةَ الْخُشَنِيِّ، وَعَنْ أَبِي عُبَيْدَةَ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_248", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَرَوَى أَبُو دَاوُدَ، عَنْ سَمُرَةَ بْنِ جُنْدُبٍ أَنَّ رَجُلًا قَالَ: يَا رَسُولَ اللَّهِ، إِنِّي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_249", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَفِي السُّنَنِ عَنْ سَفِينَةَ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: تَكُونُ خِلَافَةُ النُّبُوَّةِ ثَلَاث"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_250", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَكَانَ هَذَا الْعَامُ تَمَامَ الثَلَاثِينَ سَنَةً مِنْ مَوْتِهِ، وَدَخَلَ فِي ذَلِكَ خِلَافَةُ أَبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_251", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْهُ أَنَّهُ قَالَ: زُوِيَتْ لِيَ الْأَرْضُ مَشَارِقُهَا، وَمَغَارِبُهَا، وَس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_252", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ: إِنَّ اللَّهَ زَوَى لِيَ الْأَرْضَ فَرَأَيْتُ مَشَارِقَهَا وَمَغَارِبَهَا، و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_253", "reason": "high_symbol_ratio:0.434", "chunk_text": "عَلَيْهِمْ عَدُوًّا مِنْ سِوَى أَنْفُسِهِمْ يَسْتَبِيحُ بَيْضَتَهُمْ، وَلَوِ اجْتَمَعَ عَلَيْهِمْ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_254", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَهَذَا أَخْبَرَ بِهِ فِي أَوَّلِ الْأَمْرِ وَأَصْحَابُهُ فِي غَايَةِ الْقِلَّةِ قَبْلَ فَتْحِ مَكَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_255", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَذَاكَ كِسْرَى بْنُ هُرْمُزَ آخِرُ الْأَكَاسِرَةِ الْمُمَلَّكِينَ، ثُمَّ وَلِيَ بَعْدَهُ وُلَاةٌ مُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_256", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَهَذَا أَخْبَرَ بِهِ، وَمُلْكُ كِسْرَى وَقَيْصَرَ أَعَزُّ مُلْكٍ فِي الْأَرْضِ، فَصَدَقَ اللَّهُ خَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_258", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَلَمْ يَبْقَ بِأَرْضِ الْعِرَاقِ كِسْرَى يَثْبُتُ لَهُ أَمْرٌ بَعْدَهُ. وَقَالَ: إِذَا هَلَكَ قَيْص"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_259", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَلَمْ يَكُنْ بِأَرْضِ الشَّامِ قَيْصَرُ، فَأَجَابَهُمْ عَلَى مَا قَالُوا، وَكَانَ كَمَا قَالَ قَطَع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_260", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَقَالَ فِي كِسْرَى: مَزَّقَ اللَّهُ مُلْكَهُ. فَلَمْ يَبْقَ لِلْأَكَاسِرَةِ مُلْكٌ، وَقَالَ فِي قَي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_261", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَثَبَتَ مُلْكُهُمْ بِبِلَادِ الرُّومِ، وَتَنَحَّى عَنِ الشَّامِ، وَكُلُّ هَذَا يُصَدِّقُ بَعْضُهُ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_262", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَأَخْبَرَ بِفَتْحِ الْيَمَنِ، وَالشَّامِ، وَالْعِرَاقِ قَبْلَ أَنْ يَكُونَ، وَأَخْبَرَ أَنَّهُ يَخْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_263", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ عَنْ أَبِي ذَرٍّ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: سَتُفْتَحُ مِصْرُ، وَهِيَ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_264", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَفِي رِوَايَةٍ: فَأَحْسِنُوا إِلَى أَهْلِهَا، فَإِنَّ لَهُمْ ذِمَّةً وَرَحِمًا، فَإِذَا رَأَيْتُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_265", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَمَرَّ أَبُو ذَرٍّ بَعْدَ فَتْحِ مِصْرَ بِمُدَّةٍ بِابْنَيْ شُرَحْبِيلَ بْنِ حَسَنَةَ، وَهُمَا يَتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_266", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ سُلَيْمَانَ بْنِ صُرَدٍ قَالَ: سَمِعْتُ النَّبِيَّ يَقُولُ: حِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_267", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو أَنَّ رَسُولَ اللَّهِ قَالَ: إِذَا فُتِحَتْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_268", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ: نَقُولُ كَمَا أَمَرَنَا اللَّهُ. قَالَ رَسُولُ اللَّهِ : أَوَغ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_269", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ أَبِي هُرَيْرَةَ أَنَّهُ لَمَّا أَنْزَلَ اللَّهُ: هُوَ الَّذِي بَع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_270", "reason": "high_symbol_ratio:0.411", "chunk_text": "سُئِلَ النَّبِيُّ عَنْ هَؤُلَاءِ الْآخَرِينَ، فَقَالَ: لَوْ كَانَ الدِّينُ مُعَلَّقًا بِالثُّرَيَّا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_271", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَفِي لَفْظٍ: لَوْ كَانَ الْإِيمَانُ، وَفِي لَفْظٍ: الْعِلْمُ. وَكَانَ كَمَا أَخْبَرَ، فَإِنَّهُ حَص"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_272", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَلَمَّا نَزَلَ قَوْلُهُ تَعَالَى: فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_273", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْهُ أَنَّهُ قَالَ: أَتَاكُمْ أَهْلُ الْيَمَنِ، هُمْ أَرَقُّ قُلُوبًا وَأَلْي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_274", "reason": "high_symbol_ratio:0.434", "chunk_text": "فَلَمَّا ارْتَدَّ مَنِ ارْتَدَّ عَنِ الْإِسْلَامِ أَتَى اللَّهُ بِهَؤُلَاءِ الَّذِينَ يُحِبُّهُمْ وَ"}
