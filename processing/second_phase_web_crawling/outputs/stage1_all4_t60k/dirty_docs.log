{"source": "wikisource", "raw_id": "arwikisource:35931:101074#chunk_356", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَهُوَ لَهُ قَرِينٌ (36) وَإِنَّهُمْ لَيَصُدُّونَهُمْ عَنِ السَّبِيلِ وَيَحْسَبُونَ أَنَّهُمْ مُهْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:35931:101074#chunk_400", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَلَمَّا وَقَعَ عَلَيْهِمُ الرِّجْزُ قالُوا يا مُوسَى ادْعُ لَنا رَبَّكَ بِما عَهِدَ عِنْدَكَ لَئِنْ"}
{"source": "wikisource", "raw_id": "arwikisource:35931:101074#chunk_546", "reason": "high_symbol_ratio:0.439", "chunk_text": "مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا »."}
{"source": "wikisource", "raw_id": "arwikisource:35778:142508#chunk_16", "reason": "high_symbol_ratio:0.413", "chunk_text": "لَهُ وَنَسْتَغْفِرهُ مَعْنًى مَلِيحٌ صَحِيحٌ ."}
{"source": "wikisource", "raw_id": "arwikisource:24653:240176#chunk_822", "reason": "high_symbol_ratio:0.450", "chunk_text": "لِيُجَادِلُوكُمْ } ."}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_24", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَدْ سَرَدَهَا مُفَصَّلَة ثُمَّ قَالَ : فَسُبْحَان الَّذِي دَقَّتْ فِي كُلّ شَيْء حِكْمَته ."}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_30", "reason": "high_symbol_ratio:0.402", "chunk_text": "تَيْمِيَّةَ وَشَيْخنَا الْحَافِظ الْمُجْتَهِد أَبُو الْحَجَّاج الْمِزِّيّ وَحَكَاهُ لِي عَنْ اِبْن ت"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_43", "reason": "high_symbol_ratio:0.409", "chunk_text": "== أَمْ يَقُولُونَ افْتَرَاهُ بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_54", "reason": "high_symbol_ratio:0.403", "chunk_text": "== ثُمَّ سَوَّاهُ وَنَفَخَ فِيهِ مِنْ رُوحِهِ وَجَعَلَ لَكُمُ السَّمْعَ وَالْأَبْصَارَ وَالْأَفْئِدَ"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_55", "reason": "high_symbol_ratio:0.429", "chunk_text": "طَاعَة رَبّه عَزَّ وَجَلَّ ."}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_60", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَرَوَاهُ زُهَيْر بْن مُحَمَّد عَنْ النَّبِيّ صَلَّى اللَّه عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ مُرْسَلًا "}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_69", "reason": "high_symbol_ratio:0.406", "chunk_text": "== وَلَوْ شِئْنَا لَآَتَيْنَا كُلَّ نَفْسٍ هُدَاهَا وَلَكِنْ حَقَّ الْقَوْلُ مِنِّي لَأَمْلَأَنَّ جَ"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_73", "reason": "high_symbol_ratio:0.404", "chunk_text": "== إِنَّمَا يُؤْمِنُ بِآَيَاتِنَا الَّذِينَ إِذَا ذُكِّرُوا بِهَا خَرُّوا سُجَّدًا وَسَبَّحُوا بِحَم"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_115", "reason": "high_symbol_ratio:0.425", "chunk_text": "== وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآَيَاتِ رَبِّهِ ثُمَّ أَعْرَضَ عَنْهَا إِنَّا مِنَ الْمُجْرِمِي"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_116", "reason": "high_symbol_ratio:0.401", "chunk_text": "قَالَ قَتَادَة إِيَّاكُمْ وَالْإِعْرَاض عَنْ ذِكْر اللَّه فَإِنَّ مَنْ أَعْرَضَ عَنْ ذِكْره فَقَدْ ا"}
{"source": "wikisource", "raw_id": "arwikisource:35700:397153#chunk_142", "reason": "high_symbol_ratio:0.413", "chunk_text": "== فَأَعْرِضْ عَنْهُمْ وَانْتَظِرْ إِنَّهُمْ مُنْتَظِرُونَ (30) == فَأَعْرِضْ عَنْهُمْ وَانْتَظِرْ إ"}
{"source": "wikisource", "raw_id": "arwikisource:1804:601152#chunk_0", "reason": "high_symbol_ratio:0.402", "chunk_text": "حَدَثَنَا عِيسَى بْنُ هِشَامٍ قَالَ: حَدا بِي إِلى سِجِسْتَانَ أَرَبٌ، فَاقْتَعَدْتُ طِيَتَّهُ، وَام"}
{"source": "wikisource", "raw_id": "arwikisource:1804:601152#chunk_4", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهَوْناً أَضَعْتُهَا، وَغَالِياً اشْتَرَيْتُهَا، وَرَخِيصاً ابْتَعْتُهَا، فَقَدْ واللهِ صَحِبْت لهَ"}
{"source": "wikisource", "raw_id": "arwikisource:1804:601152#chunk_5", "reason": "high_symbol_ratio:0.418", "chunk_text": "بِالْمَاءِ الطَّاهِرِ عُوُدُهُ. قَالَ عِيسَى بْنُ هِشَامٍ: فَدُرْتُ إِلَى وَجْهِهِ لأَعْلَمَ عِلْمَه"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_0", "reason": "high_symbol_ratio:0.424", "chunk_text": "اعْلَمْ أَنَّ لِكُلِّ فَضِيلَةٍ أُسًّا وَلِكُلِّ أَدَبٍ يَنْبُوعًا، وَأُسُّ الْفَضَائِلِ وَيَنْبُوعُ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_1", "reason": "high_symbol_ratio:0.419", "chunk_text": "لَهُمَا عِمَادًا. وَرُوِيَ عَنْ النَّبِيِّ أَنَّهُ قَالَ: «مَا اكْتَسَبَ الْمَرْءُ مِثْلَ عَقْلٍ يَه"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_2", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَرُوِيَ عَنْ النَّبِيِّ أَنَّهُ قَالَ: «لِكُلِّ شَيْءٍ عُمِلَ دِعَامَةٌ وَدِعَامَةُ عَمَلِ الْمَرْء"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_3", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ الْحَسَنُ الْبَصْرِيُّ: مَا اسْتَوْدَعَ اللَّهُ أَحَدًا عَقْلًا إلَّا اسْتَنْقَذَهُ بِهِ يَو"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_4", "reason": "high_symbol_ratio:0.434", "chunk_text": "وَقَالَ بَعْضُ الْأُدَبَاءِ: صَدِيقُ كُلِّ امْرِئٍ عَقْلُهُ وَعَدُوُّهُ جَهْلُهُ. وَقَالَ بَعْضُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_5", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَالَ بَعْضُ الشُّعَرَاءِ، وَهُوَ إبْرَاهِيمُ بْنُ حَسَّانَ: وَاعْلَمْ أَنَّ بِالْعَقْلِ تُعْرَفُ "}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_6", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَقَدْ يَنْقَسِمُ قِسْمَيْنِ: غَرِيزِيٍّ وَمُكْتَسَبٍ. فَالْغَرِيزِيُّ هُوَ الْعَقْلُ الْحَقِيقِيُّ."}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_8", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَقَالَ قَوْمٌ: هُوَ جَوْهَرٌ لَطِيفٌ يُفْصَلُ بِهِ بَيْنَ حَقَائِقِ الْمَعْلُومَاتِ. وَمَنْ قَالَ ب"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_9", "reason": "high_symbol_ratio:0.440", "chunk_text": "فَقَالَتْ طَائِفَةٌ مِنْهُمْ مَحَلُّهُ الدِّمَاغُ؛ لِأَنَّ الدِّمَاغَ مَحَلُّ الْحِسِّ. وَقَالَتْ طَ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_10", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهَذَا الْقَوْلُ فِي الْعَقْلِ بِأَنَّهُ جَوْهَرٌ لَطِيفٌ فَاسِدٌ مِنْ وَجْهَيْنِ: أَحَدِهِمَا إنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_11", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَلَوْ أَوْجَبَ سَائِرُهَا مَا يُوجِبُ بَعْضُهَا لَاسْتَغْنَى الْعَاقِلُ بِوُجُودِ نَفْسِهِ عَنْ وُج"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_12", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَلَوْ كَانَ الْعَقْلُ جَوْهَرًا لَجَازَ أَنْ يَكُونَ عَقْلٌ بِغَيْرِ عَاقِلٍ كَمَا جَازَ أَنْ يَكُو"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_13", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَقَالَ آخَرُونَ: الْعَقْلُ هُوَ الْمُدْرِكُ لِلْأَشْيَاءِ عَلَى مَا هِيَ عَلَيْهِ مِنْ حَقَائِقِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_14", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَقَالَ آخَرُونَ مِنْ الْمُتَكَلِّمِينَ الْعَقْلُ هُوَ جُمْلَةُ عُلُومٍ ضَرُورِيَّةٍ وَهَذَا الْحَدُ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_15", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْحَدُّ إنَّمَا هُوَ بَيَانُ الْمَحْدُودِ بِمَا يَنْفِي عَنْهُ الْإِجْمَالَ وَالِاحْتِمَالَ. وَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_16", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَذَلِكَ نَوْعَانِ: أَحَدُهُمَا مَا وَقَعَ عَنْ دَرَكِ الْحَوَاسِّ. وَالثَّانِي مَا كَانَ مُبْتَدِئً"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_17", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَأَمَّا مَا كَانَ وَاقِعًا عَنْ دَرَكِ الْحَوَاسِّ فَمِثْلُ الْمَرْئِيَّاتِ الْمُدْرَكَةِ بِالنَّظَ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_18", "reason": "high_symbol_ratio:0.416", "chunk_text": "لَعَلِمَ. وَأَمَّا مَا كَانَ مُبْتَدِئًا فِي النُّفُوسِ فَكَالْعِلْمِ بِأَنَّ الشَّيْءَ لَا يَخْلُو "}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_19", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهَذَا النَّوْعُ مِنْ الْعِلْمِ لَا يَجُوزُ أَنْ يَنْتَفِيَ عَنْ الْعَاقِلِ مَعَ سَلَامَةِ حَالِهِ،"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_20", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَلِذَلِكَ قَالَ عَامِرُ بْنُ قَيْسٍ: إذَا عَقْلُك عَقَلَك عَمَّا لَا يَنْبَغِي فَأَنْتَ عَاقِلٌ. وَ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_21", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَكُلُّ مَنْ نَفَى أَنْ يَكُونَ الْعَقْلُ جَوْهَرًا أَثْبَتَ مَحَلَّهُ فِي الْقَلْبِ؛ لِأَنَّ الْقَل"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_22", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ اللَّهُ تَعَالَى: ﴿ أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَتَكُونَ لَهُمْ قُلُوبٌ يَعْقِلُونَ بِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_23", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَفِي قَوْله تَعَالَى: ﴿ يَعْقِلُونَ بِهَا ﴾ ، تَأْوِيلَانِ: أَحَدُهُمَا: يَعْلَمُونَ بِهَا، وَالثَّ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_24", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَهَذِهِ جُمْلَةُ الْقَوْلِ فِي الْعَقْلِ الْغَرِيزِيِّ. وَأَمَّا الْعَقْلُ الْمُكْتَسَبُ فَهُوَ نَت"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_25", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَلَيْسَ لِهَذَا حَدٌّ؛ لِأَنَّهُ يَنْمُو إنْ اُسْتُعْمِلَ وَيَنْقُصُ إنْ أُهْمِلَ. وَنَمَاؤُهُ يَكُ"}
{"source": "wikisource", "raw_id": "arwikisource:178802:469737#chunk_26", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَلِذَلِكَ حَمِدَتْ الْعَرَبُ آرَاءَ الشُّيُوخِ حَتَّى قَالَ بَعْضُهُمْ: الْمَشَايِخُ أَشْجَارُ الْو"}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_13", "reason": "high_symbol_ratio:0.401", "chunk_text": "قَبْلِكُمْ مَسَّتْهُمُ الْبَأْساءُ وَالضَّرَّاءُ وَزُلْزِلُوا حَتَّى يَقُولَ الرَّسُولُ وَالَّذِينَ "}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_32", "reason": "high_symbol_ratio:0.405", "chunk_text": "====[سورة الأنعام (6): الآيات 116 الى 121]==== وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ "}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_104", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَأَنِ اعْبُدُونِي هذا صِراطٌ مُسْتَقِيمٌ. وَلَقَدْ أَضَلَّ مِنْكُمْ جِبِلًّا كَثِيرًا أَفَلَمْ تَكُ"}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_163", "reason": "high_symbol_ratio:0.479", "chunk_text": "وَلَنُسْكِنَنَّكُمُ الْأَرْضَ مِنْ بَعْدِهِمْ »."}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_642", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَأَغْوَيْناكُمْ إِنَّا كُنَّا غاوِينَ. فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذابِ مُشْتَرِكُونَ »."}
{"source": "wikisource", "raw_id": "arwikisource:35914:101064#chunk_682", "reason": "high_symbol_ratio:0.429", "chunk_text": "ضاحِكَةٌ مُسْتَبْشِرَةٌ. وَوُجُوهٌ يَوْمَئِذٍ عَلَيْها غَبَرَةٌ. تَرْهَقُها قَتَرَةٌ. أُولئِكَ هُمُ "}
