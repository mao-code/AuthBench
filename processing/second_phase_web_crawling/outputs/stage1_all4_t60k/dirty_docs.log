{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_84", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَالْعَارِفُونَ يَقُولُونَ: قِيمَةُ كُلِّ امْرِئٍ ما يَطْلُبُ. وَفِي بَعْضِ الْكُتُبِ الْمُتَقَدِّمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_85", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَهَؤُلَاءِ الْمُتَفَلْسِفَةُ لَمْ يَذْكُرُوا هَذَا فِي كَمَالِ النَّفْسِ، وَإِنَّمَا جَعَلُوا كَمَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_86", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَلَمْ يَتَعَرَّضُوا لِمُرَادِ الرُّوحِ الَّذِي يُحِبُّهُ لِذَاتِهِ. مَعَ أَنَّهُمْ إِنَّمَا تَكَلَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_87", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَدْ بَسَطْنَا غَلَطَهُمْ فِي هَذَا الْأَصْلِ مِنْ وُجُوهٍ فِي غَيْرِ هَذَا الْمَوْضِعِ، وَبَيَّنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_88", "reason": "high_symbol_ratio:0.446", "chunk_text": "أَصْلُهُ قَوْلُ الْقَلْبِ، وَعَمَلُ الْقَلْبِ الْمُتَضَمِّنُ عِلْمَ الْقَلْبِ وَإِرَادَتَهُ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_89", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِذَا كَانَ لَا بُدَّ لِلنَّفْسِ مِنْ مُرَادٍ مَحْبُوبٍ لِذَاتِهِ لَا تَصْلُحُ إِلَّا بِهِ، وَلَا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_90", "reason": "high_symbol_ratio:0.405", "chunk_text": "مَعْبُودًا مَحْبُوبًا لِنَفْسِهِ إِلَّا اللَّهُ، فَلَوْ كَانَ فِي السَّمَاوَاتِ وَالْأَرْضِ إِلَهٌ إ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_92", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَهَؤُلَاءِ الْمُتَفَلْسِفَةُ لَا يَعْرِفُونَ ذَلِكَ، فَلَيْسَ عِنْدَهُمْ مِنْ صَلَاحِ النَّفْسِ وَك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_93", "reason": "high_symbol_ratio:0.444", "chunk_text": "بِالِاخْتِيَارِ إِنَّمَا قِوَامُهُ بِعِلَّتِهِ الْغَائِيَّةِ الَّتِي يَتَحَرَّكُ لِأَجْلِهَا، وَغَاي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_94", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَجَعَلُوا قِوَامَ الْعَالَمِ كُلِّهِ بِالْعِلَّةِ الْأُولَى مِنْ حَيْثُ هُوَ مُتَشَبِّهٌ بِهِ؛ لِأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_95", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَمَعْلُومٌ أَنَّ الْحَرَكَةَ الْإِرَادِيَّةَ تَطْلُبُ مُرَادًا مَحْبُوبًا لِنَفْسِهَا، وَتَسْتَلْزِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_96", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْغَائِبَةِ، وَذَلِكَ بَاطِلٌ كَبُطْلَانِ التَّسَلْسُلِ فِي الْعِلَلِ الْفَاعِلِيَّةِ بِصَرِيحِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_97", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَإِذَا كَانَ الْفَاعِلُ بِاخْتِيَارٍ يَسْتَلْزِمُ مُرَادًا لِنَفْسِهِ مَحْبُوبًا، فَلَا بُدَّ أَنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_98", "reason": "high_symbol_ratio:0.426", "chunk_text": "غَيْرَهُ، كَمَا قَدْ بُسِطَ هَذَا فِي مَوْضِعٍ آخَرَ، وَبُيِّنَ أَنَّهُ يَمْتَنِعُ أَنْ يَكُونَ مَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_99", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَكَمَا يَمْتَنِعُ أَنْ يَكُونَ لِلْعَالَمِ رَبَّانِ قَادِرَانِ، يَمْتَنِعُ أَنْ يَكُونَ لِلْعَالَمِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_100", "reason": "high_symbol_ratio:0.422", "chunk_text": "كَذَلِكَ يَمْتَنِعُ أَنْ يَكُونَ إِلَهَانِ مَعْبُودَانِ مَحْبُوبَانِ لِذَاتِهِمَا؛ لِأَنَّ كَوْنَ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_101", "reason": "high_symbol_ratio:0.424", "chunk_text": "لِهَذَا يُنَاقِضُ أَنْ يَكُونَ لَهُ شَرِيكٌ فَضْلًا عَنْ أَنْ يَكُونَ لِغَيْرِهِ. وَكُلُّ مَنْ أَحَب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_102", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْقَوْلُ الثَّانِي: قَوْلُ مَنْ يَقُولُ: إِنَّ اللَّهَ عَوَّضَ النَّاسَ بِالتَّكْلِيفِ بِالْعِبَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_103", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَهَؤُلَاءِ قَدْ يَجْعَلُونَ الْوَاجِبَاتِ الشَّرْعِيَّةَ لُطْفًا فِي الْوَاجِبَاتِ الْعَقْلِيَّةِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_104", "reason": "high_symbol_ratio:0.438", "chunk_text": "وَالْقَوْلُ الثَّالِثُ: قَوْلُ مَنْ يَقُولُ: بَلِ اللَّهُ أَمَرَ بِذَلِكَ لَا لِحِكْمَةٍ مَطْلُوبَةٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_105", "reason": "high_symbol_ratio:0.436", "chunk_text": "الْقَوْلُ الرَّابِعُ: قَوْلُ سَلَفِ الْأُمَّةِ وَأَئِمَّتِهَا، وَهُوَ أَنَّ نَفْسَ مَعْرِفَةِ اللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_107", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَإِذَا عُرِفَ مَذَاهِبُ النَّاسِ فِي مَقَاصِدِ الْعِبَادَاتِ فَهُمْ أَيْضًا مُخْتَلِفُونَ فِي صِفَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_108", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالثَّانِي: قَوْلُ مَنْ يَقُولُ: إِنَّ أَفْضَلَهَا مَا كَانَ أَدْعَى إِلَى تَحْصِيلِ الْوَاجِبَاتِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_109", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالرَّابِعُ وَهُوَ الصَّوَابُ: أَنَّ أَفْضَلَهَا مَا كَانَ لِلَّهِ أَطْوَعَ، وَلِلْعَبْدِ أَنْفَعَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_110", "reason": "high_symbol_ratio:0.432", "chunk_text": "ثُمَّ هَؤُلَاءِ قَدْ يُفَضِّلُونَ الْجُوعَ، وَالسَّهَرَ، وَالصَّمْتَ، وَالْخَلْوَةَ، وَنَحْوَ ذَلِكَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_111", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْيَهُودِ، وَالنَّصَارَى. فَإِنَّ الْيَهُودَ خَالَفُوا مُوسَى فِي الْجِهَادِ، وَعَصَوْهُ، وَالنَّصَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_112", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَأَمَّا عَلَى قَوْلِ نُفَاةِ التَّعْلِيلِ، وَرَدِّ ذَلِكَ إِلَى مَشِيئَةِ اللَّهِ: فَيَكُونُ الْأَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_113", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَأَمَّا عَلَى الْقَوْلِ الرَّابِعِ: فَإِنَّ عِلْمَ أَنَّ اللَّهَ أَمَرَ بِهِ يَتَضَمَّنُ طَاعَةَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_115", "reason": "high_symbol_ratio:0.449", "chunk_text": "فَلْيَتَدَبَّرِ الْإِنْسَانُ عُقُولَ الْمُسْلِمِينَ وَأَخْلَاقَهَمْ، وَعَدْلَهَمْ، يَظْهَرُ لَهُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_116", "reason": "high_symbol_ratio:0.410", "chunk_text": "ثُمَّ صِفَاتُ عِبَادَاتِهِمْ فِيهَا مِنَ الْكَمَالِ، وَالِاعْتِدَالِ، كَالطَّهَارَةِ، وَالِاصْطِفَاف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_117", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَأَمَّا حُكْمُ الْمُسْلِمِينَ فِي الْحُدُودِ وَالْحُقُوقِ فَلَا يَخْفَى عَلَى عَاقِلٍ فَضْلُهُ. حَت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_118", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَلَيْسَ فِي الْإِنْجِيلِ حُكْمٌ عَامٌّ، بَلْ عَامَّتُهُ، وَإِنَّمَا فِيهِ الْأَمْرُ بِالزُّهْدِ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_119", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَقَدْ ذَكَرْنَا فِي كَوْنِ الْمُسْلِمِينَ مُعْتَدِلِينَ مُتَوَسِّطِينَ بَيْنَ الْيَهُودِ وَالنَّصَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_121", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطِ وَعِيسَى وَأَيُّوبَ وَيُونُسَ وَهَارُونَ وَسُلَيْمَانَ وَآتَي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_122", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَضَعَ نَامُوسًا سِيَاسِيًّا وَقَانُونًا عَدْلِيًّا يَنْفَعُ بِهِ الْخَلْقَ، وَيَحْمِلُهُمْ بِهِ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_123", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَإِنْ كَانَ وَاضِعُ النَّامُوسِ مُخْتَصًّا بِقُوَّةٍ قُدْسِيَّةٍ يَنَالُ بِهَا الْعِلْمَ بِسُهُولَة"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_124", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَلَكِنْ لَمَّا كَانَتْ هَذِهِ مَوْجُودَةً لِكَثِيرٍ مِنَ الْخَلْقِ، وَلَمْ يَصِلْ بِهَا إِلَى قَرِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_125", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَإِمَّا أَنْ يَكُونَ رَجُلًا كَاذِبًا فَاجِرًا أَفَّاكًا أَثِيمًا يَتَعَمَّدُ الْكَذِبَ وَالظُّلْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_126", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَمَنْ يَظُنُّ الْكَذِبَ صِدْقًا وَالْبَاطِلَ حَقًّا، وَالضَّلَالَ هُدًى، وَالْغَيَّ رُشْدًا، وَالظُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_127", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَذَلِكَ لِأَنَّهُ إِمَّا أَنْ يَكُونَ قَصْدُهُ الْإِثْمَ وَالْعُدْوَانَ، أَوْ قَصْدُهُ الْبِرَّ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_128", "reason": "high_symbol_ratio:0.444", "chunk_text": "جَازِمًا بِذَلِكَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_129", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ كَانَ جَازِمًا بِذَلِكَ كَانَ هَذَا هُوَ النَّبِيُّ الْمَعْصُومُ الَّذِي لَا يُخْبِرُ إِلَّا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_130", "reason": "high_symbol_ratio:0.424", "chunk_text": "يُخْبِرُ بِهِ مِنَ الْعِلْمِيَّاتِ، وَمَا يَأْمُرُهُمْ بِهِ مِنَ الْعَمَلِيَّاتِ فَإِنَّهُ لَا مَعْص"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_131", "reason": "high_symbol_ratio:0.426", "chunk_text": "إِلَّا أَنْ يَكُونَ نَبِيًّا، فَإِنَّ الْإِيمَانَ وَاجِبٌ بِكُلِّ مَا يَأْتِي بِهِ النَّبِيُّ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_132", "reason": "high_symbol_ratio:0.407", "chunk_text": "قَالَ تَعَالَى: قُولُوا آمَنَّا بِاللَّهِ وَمَا أُنْزِلَ إِلَيْنَا وَمَا أُنْزِلَ إِلَى إِبْرَاهِيمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_133", "reason": "high_symbol_ratio:0.430", "chunk_text": "أَنَّهُ رَسُولٌ كَإِبْرَاهِيمَ، وَمُوسَى، وَعِيسَى بَلْ أَخْبَرَ أَنَّهُ سَيِّدُ، وَلَدِ آدَمَ، وَأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_134", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْكُتُبِ مَعَ تَصْدِيقِهِ لِذَلِكَ، وَحِينَئِذٍ فَإِنْ كَانَ عَالِمًا بِصِدْقِ نَفْسِهِ فَهُوَ نَبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_135", "reason": "high_symbol_ratio:0.437", "chunk_text": "يُتَصَوَّرُ اسْتِمْرَارُهُ عَلَى هَذَا بَلْ لَا بُدَّ أَنْ يَتَبَيَّنَ لَهُ، وَلِغَيْرِهِ أَنَّهُ صَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_136", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَإِنَّ مَنْ ظَنَّ صِدْقَ نَفْسِهِ فِي مِثْلِ هَذِهِ الدَّعْوَى، وَلَيْسَ بِصَادِقٍ يَكُونُ مِنْ أَج"}
