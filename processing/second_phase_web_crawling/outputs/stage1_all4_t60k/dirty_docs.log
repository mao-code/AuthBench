{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_378", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهَذَا الْحُكْمُ ثَابِتٌ فِي أَهْلِ الْكِتَابِ بِاتِّفَاقِ الْمُسْلِمِينَ، كَمَا دَلَّ عَلَيْهِ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_380", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَسَاوَى بِهَذَا الْقَوْلِ بَيْنَ سَائِرِ النَّاسِ: الْيَهُودِ وَالْمُسْلِمِينَ وَغَيْرِهِمْ. وَالْج"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_381", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَكَذَلِكَ الصَّابِئُونَ مِنْ حِينِ بُعِثَ إِلَيْهِمْ رَسُولٌ فَكَذَّبُوهُ، فَهُمْ كُفَّارٌ. فَإِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_383", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَكَذَلِكَ يُقَالُ لِلْيَهُودِيِّ، إِنِ احْتَجَّ بِهَا عَلَى صِحَّةِ دِينِهِ. وَأَيْضًا، فَإِنَّ الن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_386", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَإِنَّ الْعَرَبَ مِنْ وَلَدِ إِسْمَاعِيلَ، وَغَيْرِهِ الَّذِينَ كَانُوا جِيرَانَ الْبَيْتِ الْعَتِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_389", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَقَدْ تَقَدَّمَ أَنَّهُ كَفَّرَ أَهْلَ الْكِتَابِ الَّذِينَ بَدَّلُوا دِينَ مُوسَى وَالْمَسِيحِ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_390", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَلَكِنَّ هَؤُلَاءِ النَّصَارَى سَلَكُوا فِي الْقُرْآنِ مَا سَلَكُوهُ فِي التَّوْرَاةِ وَالْإِنْجِيل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_391", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْفِتْنَةِ وَابْتِغَاءَ تَأْوِيلِهِ وَمَا يَعْلَمُ تَأْوِيلَهُ إِلَّا اللَّهُ وَالرَّاسِخُونَ فِي ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_393", "reason": "high_symbol_ratio:0.405", "chunk_text": "صَدَقْتَنَا وَنَكُونَ عَلَيْهَا مِنَ الشَّاهِدِينَ * قَالَ عِيسَى ابْنُ مَرْيَمَ اللَّهُمَّ رَبَّنَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_394", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَالْمَائِدَةُ هِيَ الْقُرْبَانُ الْمُقَدَّسُ الَّذِي يُتَقَرَّبُ بِهِ فِي كُلِّ قُدَّاسٍ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_395", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالْجَوَابُ أَنْ يُقَالَ: هَذَا كَذِبٌ ظَاهِرٌ عَلَى الْقُرْآنِ فِي هَذَا الْمَوْضِعِ، كَمَا كَذَبْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_396", "reason": "high_symbol_ratio:0.418", "chunk_text": "لَفْظَهُ وَمَعْنَاهُ، فَإِنَّهُمْ مُتَّفِقُونَ عَلَى أَنَّ الْمَائِدَةَ مَائِدَةٌ أَنْزَلَهَا اللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_397", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَفِي الْآيَةِ أَنَّ عِيسَى قَالَ: اللَّهُمَّ رَبَّنَا أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_398", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَفِي أَوَّلِ الْكَلَامِ: إِذْ قَالَ الْحَوَارِيُّونَ يَا عِيسَى ابْنَ مَرْيَمَ هَلْ يَسْتَطِيعُ رَب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_401", "reason": "high_symbol_ratio:0.424", "chunk_text": "الَّذِي لَمْ يَشْرَعْهُ، وَمَا نَسَخَهُ مِنْ شَرْعِ مُوسَى."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_402", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَكَمَا أَمَرَ الْمَسِيحَ أَنْ يُهْمِلَ الْمُبَدَّلَ وَالْمَنْسُوخَ مِنَ التَّوْرَاةِ الَّتِي جَاءَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_403", "reason": "high_symbol_ratio:0.406", "chunk_text": "إِلَيْنَا وَمَا أُنْزِلَ إِلَى إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_404", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالنَّصَارَى كَالْيَهُودِ، آمَنُوا بِبَعْضٍ وَكَفَرُوا بِبَعْضٍ، فَأَيُّمَا هُوَ اللَّائِقُ عِنْدَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_407", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَالْمُسْلِمُونَ لَمْ يُهْمِلُوا رُوحَ الْقُدُسِ، وَكَلِمَةَ اللَّهِ، وَقَدْ قَالَ تَعَالَى عَنْ كَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_408", "reason": "high_symbol_ratio:0.406", "chunk_text": "بَلْ هُمُ الَّذِينَ اتَّبَعُوا دِينَهُ وَدِينَ الرُّسُلِ قَبْلَهُ فَإِنَّ دِينَ الْأَنْبِيَاءِ عَلَي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_410", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَدِينُ الْمُرْسَلِينَ كُلِّهِمْ دِينٌ وَاحِدٌ، وَيَتَنَوَّعُ شَرْعُهُمْ وَمَنَاهِجُهُمْ كَتَنَوُّعِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_412", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالنَّصَارَى الَّذِينَ بَدَّلُوا دِينَ الْمَسِيحِ وَكَذَّبُوا مُحَمَّدًا بَرِيئُونَ مِنْ دِينِ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_413", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالْمُسْلِمُونَ أَشَدُّ تَعْظِيمًا لِلْمَسِيحِ وَاتِّبَاعًا لَهُ بِالْحَقِّ مِمَّنْ بَدَّلَ دِينَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_415", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمُرَادُ فِي تِلْكَ اللُّغَةِ أَنَّهُ مُصْطَفًى مَحْبُوبٌ لِلَّهِ، كَمَا يَنْقُلُونَهُ أَنَّهُ ق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_416", "reason": "high_symbol_ratio:0.400", "chunk_text": "وَزَعَمُوا أَنَّ الِابْنَ يُرَادُ بِهِ الِابْنُ بِالْوَضْعِ، وَهُوَ الْمَخْلُوقُ، وَهُوَ الِابْنُ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_417", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَكَذَلِكَ لَفْظُ رُوحِ الْقُدُسِ مَوْجُودٌ فِي غَيْرِ مَوْضِعٍ مِنْ كَلَامِ الْأَنْبِيَاءِ عَلَيْهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_418", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِنَّمَا يُرَادُ بِهِ مَا أَيَّدَ اللَّهُ بِهِ الْأَنْبِيَاءَ وَالْأَوْلِيَاءَ، وَيَجْعَلُهُ فِي ق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_419", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَهَكَذَا خَاتَمُ الرُّسُلِ، كَانَ يَقُولُ لِحَسَّانِ بْنِ ثَابِتٍ: إِنَّ رُوحَ الْقُدُسِ مَعَكَ مَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_420", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَدْ قَالَ اللَّهُ تَعَالَى عَنْ عِبَادِهِ الْمُؤْمِنِينَ: لَا تَجِدُ قَوْمًا يُؤْمِنُونَ بِاللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_421", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَرُوحُ الْقُدُسِ لَا اخْتِصَاصَ لِلْمَسِيحِ بِهَا، بَلْ مَا يُفَسَّرُ بِهِ اسْمُ الِابْنِ وَاسْمُ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_422", "reason": "high_symbol_ratio:0.438", "chunk_text": "فَأَمَّا نَفْسُ ذَاتِ اللَّهِ فَلَمْ تَحِلَّ فِي أَحَدٍ مِنَ الْبَشَرِ. وَالْمُسْلِمُونَ مَعَ شَهَاد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_423", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالنَّصَارَى يَدَّعُونَ أَنَّ اسْمَ الْمَسِيحِ اسْمُ اللَّاهُوتِ وَالنَّاسُوتِ وَأَنَّهُ إِلَهٌ تَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_425", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَ أَشْعِيَا: (قَالَ اللَّهُ: إِنِّي أَعْرِفُ بَنِي إِسْرَائِيلَ وَقُلُوبَهُمُ الْقَاسِيَةَ الْخَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_426", "reason": "high_symbol_ratio:0.422", "chunk_text": "الْقَرَابِينَ بِالسَّمِيدِ، كَمَا كَانَ بَنُو إِسْرَائِيلَ مِنْ قَبْلُ وَكَذَلِكَ بَاقِي الْأُمَمِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_427", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَالَ دَانْيَالُ النَّبِيُّ : (وَسَيَأْتِي عَلَى شَعْبِكَ وَقَرْيَةِ قُدْسِكَ سَبْعُونَ سَابُوعًا،"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_428", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَالَ مِيخَا النَّبِيُّ : (قَالَ اللَّهُ فِي آخِرِ الزَّمَانِ إِذَا أَتَى الْمَسِيحُ يَدْعُو الْأُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_429", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ عَامُوصُ النَّبِيُّ: (لَا تَذْبَحُوا الْعُجُولَ بَعْدُ فَإِنَّ الرَّبَّ سَيَأْتِي صِهْيُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_430", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَالْجَوَابُ مِنْ وُجُوهٍ: أَحَدُهَا: أَنَّ مَا يَحْتَجُّونَ بِهِ مِنَ النَّقْلِ عَنِ الْأَنْبِيَاءِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_431", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالرَّابِعُ: أَنْ يُعْلَمَ أَنَّ مَا ذَكَرُوهُ مِنْ كَلَامِ الْأَنْبِيَاءِ دَلِيلٌ عَلَى مَا ادَّعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_432", "reason": "high_symbol_ratio:0.414", "chunk_text": "الْوَجْهُ الثَّانِي: أَنَّ هَذِهِ النُّعُوتَ الْمَذْكُورَةَ عَنْ \" أَشْعِيَا \" وَغَيْرِهِ مِنَ الْأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_433", "reason": "high_symbol_ratio:0.418", "chunk_text": "إِنَّمَا كَانُوا يُصَلُّونَ فِي بَيْتِ الْمَقْدِسِ، وَيَزُورُونَ بَيْتَ الْمَقْدِسِ نَفْسَهُ، وَأَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_434", "reason": "high_symbol_ratio:0.418", "chunk_text": "غِلَافٍ مِنْ ذَهَبَ وَحَمَلَتْهُ، وَبَنَتْ كَنِيسَةَ الْقُمَامَةِ فِي مَوْضِعِهِ، كَمَا ذَكَرَ ذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_435", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَمِنْ ذَلِكَ الْوَقْتِ أَظْهَرُوا الصَّلِيبَ، وَجَعَلُوا \" عِيدَ الصَّلِيبِ \"، وَلَمْ يَشْرَعْ ذَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_436", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْوَجْهُ الثَّالِثُ: أَنَّ مَا ذَكَرُوهُ عَنْ \" دَانْيَالَ \" لَا يَتَضَمَّنُ مَدْحَ دِينِهِمْ بَعْد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_437", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَهَذَا كُلُّهُ إِنَّمَا يَدُلُّ عَلَى نَسْخِ شَرْعِ التَّوْرَاةِ، وَبُطَلَانِ دَوْلَةِ الْيَهُودِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_438", "reason": "high_symbol_ratio:0.417", "chunk_text": "دَوْلَتَهُمْ وَكَذَلِكَ فَعَلَ بِالنَّصَارَى لَمَّا بَعَثَ اللَّهُ مُحَمَّدًا أَزَالَ دَوْلَتَهُمْ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_439", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَكَذَلِكَ مَا ذَكَرُوهُ عَنْ \" مِيخَا \" وَ \" عَامُوسَ \" إِنَّمَا يَدُلُّ عَلَى مَجِيءِ الْمَسِيحِ ،"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_440", "reason": "high_symbol_ratio:0.429", "chunk_text": "هَذَا إِذَا سَمَّى الشَّرْعَ الْمُؤَقَّتَ بِغَايَةٍ مَجْهُولَةٍ نَسْخًا، فَإِنَّ الْأَوَّلَ لَمْ يُب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_441", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَأَمَّا إِذَا كَانَ الْأَوَّلُ بَشَّرَ بِالثَّانِي، وَكَانَتْ شَرِيعَةُ الْأَوَّلِ مُؤَقَّتَةٌ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_442", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَأَمَّا مَا حُكِيَ عَنْ أَشْعِيَا عَنِ اللَّهِ أَنَّهُ قَالَ: فَإِذَا ظَهَرْتَ إِلَى الْأُمَمِ فَهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_443", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَيَسْتَعْلِنُ مِنْ جِبَالِ فَارَانَ. وَمَعْلُومٌ عِنْدَ جَمِيعِ أَهْلِ الْمِلَلِ أَنَّ اللَّهَ سُبْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_444", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَدْ قَالَ تَعَالَى: هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_445", "reason": "high_symbol_ratio:0.407", "chunk_text": "قَالَ أُبَيُّ بْنُ كَعْبٍ وَغَيْرُهُ: مَثَلُ نُورِهِ فِي قَلْبِ الْمُؤْمِنِ. وَقَالَ تَعَالَى: يَا أ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_447", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَفِي التِّرْمِذِيِّ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: اتَّقُوا فِرَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_448", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ التِّرْمِذِيُّ: حَدِيثٌ حَسَنٌ، وَقَدْ جَاءَ عَنْ بَعْضِ السَّلَفِ أَنَّ قُلُوبَ الْمُؤْمِنِين"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_449", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمَخْلُوقُ الَّذِي تَظْهَرُ مَحَبَّتُهُ وَذِكْرُهُ وَطَاعَتُهُ فِي بَعْضِ الْبِلَادِ، يُقَالُ فُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_450", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَلِهَذَا لَمَّا ذَكَرَ تَعَالَى آيَةَ النُّورِ وَقَالَ: اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَث"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_452", "reason": "high_symbol_ratio:0.400", "chunk_text": "وَكَذَلِكَ مَا فِي الْكُتُبِ مِنْ ظُهُورِهِ بِبَيْتِ الْمَقْدِسِ فَهُوَ كَظُهُورِهِ بِطُورِ سَيْنَاء"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_453", "reason": "high_symbol_ratio:0.403", "chunk_text": "نَاسُوتٌ بِطَرِيقِ الْأَوْلَى وَالْأَحْرَى وَالنَّصَارَى يَزْعُمُونَ أَنَّهُ اتَّحَدَ هُوَ وَالنَّاس"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_455", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالْجَوَابُ: أَنَّ الْأَمْرَ إِذَا كَانَ عَلَى مَا قَالُوهُ مِنْ ثُبُوتِ هَذِهِ الْكَلِمَاتِ عَنْ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_456", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَالْمَسِيحُ عِنْدَهُمْ كَمَا أَخْبَرَ اللَّهُ عَنْهُ، بِقَوْلِهِ تَعَالَى لِمَرْيَمَ: إِنَّ اللَّهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_457", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَأَمَّا قَوْلُهُمْ: إِنَّ هَذَا وَغَيْرَهُ مَوْجُودٌ فِي كُتُبِ أَعْدَائِنَا الْيَهُودِ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_458", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَيُقَالُ لَهُمْ لَا رَيْبَ أَنَّ الْيَهُودَ يُخَالِفُونَكُمْ فِي تَفْسِيرِ الْكُتُبِ، فَأَنْتُمْ تُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_459", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْوَاجِبُ فِي الْكُتُبِ إِذَا تَنَازَعَتِ الْأُمَمُ فِي تَفْسِيرِهَا أَنْ يَبِينَ الْحَقُّ الَّذِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_462", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالْجَوَابُ: أَنَّ نَقْلَهُمْ عَنْهُ أَنَّهُ قَالَ: إِنَّهُ لَمْ يُرْسَلْ إِلَيْهِمْ كَذِبٌ ظَاهِرٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_464", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَدْ كَتَبَ النَّبِيُّ بِهَذِهِ الْآيَةِ إِلَى قَيْصَرَ مَلِكِ النَّصَارَى الَّذِي اسْمُهُ هِرَقْل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_465", "reason": "high_symbol_ratio:0.449", "chunk_text": "يَقْتَضِي أَنَّهُ لَمْ يُنْذِرِ الْأُمِّيِّينَ، وَلَيْسَ فِيهِ أَنَّهُ لَا يُنْذِرُ غَيْرَهُمْ، كَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_466", "reason": "high_symbol_ratio:0.415", "chunk_text": "يَقْتَضِي إِنْذَارَ قَوْمِهِ وَلَا يُنَافِي أَنْ يُنْذِرَ غَيْرَهُمْ مِنَ الْعَرَبِ كَمَا أَنَّ قَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_467", "reason": "high_symbol_ratio:0.417", "chunk_text": "لَا يَمْنَعُ أَنْ يَكُونَ غَيْرُ قُرَيْشٍ مَأْمُورِينَ بِعِبَادَةِ رَبِّ هَذَا الْبَيْتِ، بَلْ أَمَر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_468", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَإِنْ قِيلَ: فَقَدْ سَكَتَ عَنْ مَا سِوَى الْأُمِّيِّينَ فِي هَذَا، فَيُشْعِرُ بِالنَّفْيِ بِدَلِيل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_470", "reason": "high_symbol_ratio:0.416", "chunk_text": "فِي ضَلَالٍ مُبِينٍ * قُلْ لَا تُسْأَلُونَ عَمَّا أَجْرَمْنَا وَلَا نُسْأَلُ عَمَّا تَعْمَلُونَ * قُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_471", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَإِنَّهُ لَمَّا دَعَاهُمْ إِلَى التَّوْحِيدِ وَبَيَّنَ أَنَّ مَا يَدْعُونَهُ مِنْ دُونِ اللَّهِ لَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_472", "reason": "high_symbol_ratio:0.418", "chunk_text": "ثُمَّ ذَكَرَ بَعْدَ هَذَا أَنَّهُ لَا رَازِقَ يَرْزُقُ مِنَ السَّمَاءِ وَالْأَرْضِ إِلَّا اللَّهُ دَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_473", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَلَمَّا ذَكَرَ مَا دَلَّ عَلَى وُجُوبِ تَوْحِيدِهِ، وَبَيَانِ أَنَّ أَهْلَ التَّوْحِيدِ هُمْ عَلَى "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_474", "reason": "high_symbol_ratio:0.408", "chunk_text": "يَقُولُ: إِنَّ أَحَدَ الْفَرِيقَيْنِ أَهْلِ التَّوْحِيدِ الَّذِينَ لَا يَعْبُدُونَ إِلَّا اللَّهَ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_475", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهَذَا مِنَ الْإِنْصَافِ فِي الْخِطَابِ الَّذِي كُلُّ مَنْ سَمِعَهُ مِنْ وَلِيٍّ وَعَدُوٍّ قَالَ لِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_477", "reason": "high_symbol_ratio:0.410", "chunk_text": "تَبَيَّنَ أَنَّ أَهْلَ التَّوْحِيدِ عَلَى الْهُدَى، وَأَهْلَ الشِّرْكِ عَلَى الضَّلَالِ، وَهَذَا مِم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_481", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَنَظِيرُ هَذَا قَوْلُهُ: قُلْ لَا أَقُولُ لَكُمْ عِنْدِي خَزَائِنُ اللَّهِ وَلَا أَعْلَمُ الْغَيْبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_482", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهَذَا قَالَهُ نُوحٌ أَوَّلُ الرُّسُلِ، وَأُمِرَ مُحَمَّدٌ آخِرُ الرُّسُلِ أَنْ يَقُولَهُ، وَمِثْلُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_483", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَهَذَا وَنَحْوُهُ يَتَضَمَّنُ اعْتِرَافَهُ بِأَنَّهُ عَبْدُ اللَّهِ وَرَسُولٌ مِنَ اللَّهِ لَا يَتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_484", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَتَبَيِّنَ أَنَّهُ لَا يَتَعَدَّى حَدَّ الرِّسَالَةِ، وَهُوَ كَقَوْلِهِ تَعَالَى: وَمَا مُحَمَّدٌ إ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_486", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَقَالَ تَعَالَى: قُلْ مَا كُنْتُ بِدْعًا مِنَ الرُّسُلِ وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلَا بِكُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_487", "reason": "high_symbol_ratio:0.418", "chunk_text": "يَقُولُ لَا أَدَّعِي عِلْمَ الْغَيْبِ، إِنْ أَتَّبِعُ إِلَّا مَا يُوحَى إِلَيَّ وَمَا أَنَا إِلَّا ن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_488", "reason": "high_symbol_ratio:0.415", "chunk_text": "نَبِيٌّ مُرْسَلٌ. وَلَيْسَ مِنْ شَرْطِ الرَّسُولِ أَنْ يَعْلَمَ كُلَّ مَا يَكُونُ وَقَوْلُهُ تَعَالَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_489", "reason": "high_symbol_ratio:0.405", "chunk_text": "نَفْيٌ لِعِلْمِهِ بِجَمِيعِ مَا يُفْعَلُ بِهِ وَبِهِمْ وَهَذَا لَا يَعْلَمُهُ إِلَّا اللَّهُ - تَبَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_490", "reason": "high_symbol_ratio:0.422", "chunk_text": "عَلَى قَلْبِ بَشَرٍ)، وَأَيْضًا هَذَا مَأْثُورٌ عَنْ غَيْرِهِ مِنَ الْأَنْبِيَاءِ عَلَيْهِمُ السَّلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_491", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَدْ قَالَ لَهُ بَعْدَ ذَلِكَ: إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا * لِيَغْفِرَ لَكَ اللَّهُ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_492", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَالَ تَعَالَى: هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_493", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَفِي الْقُرْآنِ وَالْأَحَادِيثِ عَنْهُ مِنَ الْإِخْبَارِ بِمَا سَيَكُونُ فِي الدُّنْيَا وَفِي الْآخ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_494", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْمُسْلِمُونَ مِنْ حِينِ خَرَجَ جِنْكِزْ خَانْ مَلِكُهُمُ الْأَكْبَرُ وَأَوْلَادُهُ وَأَوْلَادُ أَو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_495", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَقَدْ أَخْبَرَ بِهَذَا قَبْلَ ظُهُورِهِ بِأَكْثَرَ مِنْ سِتِّمِائَةِ سَنَةٍ، وَقَوْلِهِ: لَا تَقُوم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_496", "reason": "high_symbol_ratio:0.419", "chunk_text": "مَقْتَلَةً عَظِيمَةً مَشْهُورَةً (وَسَيَأْتِي - إِنْ شَاءَ اللَّهُ - بَعْضُ أَخْبَارٍ أَنَّهُ شَاهَد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_497", "reason": "high_symbol_ratio:0.411", "chunk_text": "ثُمَّ قَالُوا: مَعَ الْأَمْرِ لَهُ فِي فَاتِحَةِ الْكِتَابِ أَنْ يَسْأَلَ الْهِدَايَةَ إِلَى الصِّرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_498", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَالْمُنْعَمُ عَلَيْهِمْ نَحْنُ النَّصَارَى وَالْمَغْضُوبُ عَلَيْهِمْ فَلَا - يُشَكُّ أَنَّهُمُ - ال"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_499", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَالْجَوَابُ: أَمَّا قَوْلُهُمْ: الْمُنْعَمُ عَلَيْهِمْ نَحْنُ النَّصَارَى، فَمِنَ الْعَجَائِبِ الَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_500", "reason": "high_symbol_ratio:0.418", "chunk_text": "أَلَمْ يَعْرِفِ الْعَامَّ وَالْخَاصَّ عِلْمًا ضَرُورِيًّا لَا تُمْكِنُ الْمُنَازَعَةُ فِيهِ مِنْ دِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_501", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَهَلْ يَنْسِبُ مُحَمَّدًا - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّم - وَأُمَّتَهُ إِلَى أَنَّهُمْ فِي كُلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_502", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَأُمَّتُهُ أَخَذُوا ذَلِكَ جَمِيعَهُ عَنْهُ مَنْقُولًا عَنْهُ بِالنَّقْلِ الْمُتَوَاتِرِ بِإِجْمَاع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_503", "reason": "high_symbol_ratio:0.434", "chunk_text": "وَمُحَمَّدٌ إِنْ كَانَ رَسُولًا صَادِقًا، فَقَدْ كَفَّرَ النَّصَارَى، وَأَمَرَ بِجِهَادِهِمْ، وَتَبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_504", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَقَدْ تَقَدَّمَ غَيْرَ مَرَّةِ قَوْلُهُ تَعَالَى: لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ ثَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_505", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَمَنْ يَقُولُ عَنِ النَّصَارَى مِثْلَ هَذِهِ الْأَقْوَالِ هَلْ يَأْمُرُ أُمَّتَهُ فِي كُلِّ صَلَاةٍ"}
