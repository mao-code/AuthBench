{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_350", "reason": "high_symbol_ratio:0.414", "chunk_text": "الْمِثَالُ الثَّانِيَ عَشَرَ : حَلْقُ الرَّأْسِ مُوجِبٌ لِلتَّخَيُّرِ بَيْنَ الصِّيَامِ وَالصَّدَقَة"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_351", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَلِمَا لَهُ مِنْ الْأَسْبَابِ حُكْمَانِ أَمْثِلَةٌ . أَحَدُهَا قَتْلُ الْخَطَأِ وَهُوَ مَعْفُوٌّ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_353", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْمِثَالُ الثَّالِثُ : التَّمَتُّعُ مُوجِبٌ لِحُكْمَيْنِ أَحَدُهُمَا الْهَدْيُ ، وَالثَّانِي الصِّي"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_354", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَأَمَّا السَّبُّ وَالضَّرْبُ فَإِنَّهُمَا مُوجِبَانِ لِلتَّحْرِيمِ وَالتَّعْزِيرِ مَا لَمْ يَنْتَهِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_357", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْمِثَالُ الرَّابِعُ : شُرْبُ الْخَمْرِ وَأَحْكَامُهُ التَّحْرِيمُ وَالتَّفْسِيقُ وَالْحَدُّ . الْم"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_358", "reason": "high_symbol_ratio:0.415", "chunk_text": "الْمِثَالُ السَّادِسُ : الظِّهَارُ وَهُوَ مُوجِبٌ لِلتَّحْرِيمِ وَالتَّفْسِيقِ وَالْكَفَّارَةِ الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_359", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَأَمَّا مَالُهُ مِنْ الْأَسْبَابِ أَرْبَعَةُ أَحْكَامٍ فَكَزِنَا الْبِكْرِ وَهُوَ مُوجِبٌ لِلتَّحْر"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_360", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَأَمَّا الْحَدَثُ الْأَصْغَرُ فَسَبَبٌ لِتَحْرِيمِ الصَّلَاةِ وَالطَّوَافِ وَسَجْدَةِ الشُّكْرِ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_362", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَإِنْ كَانَ خَارِجَ الْمَسْجِدِ فَإِنْ وَقَعَ فِي وَقْتِ مُلَابَسَةِ الْحَاجَةِ فَلَيْسَ بِمُفَسِّق"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_363", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَمِنْهَا : أَحْكَامُهُ فِي الْحَجِّ وَالْعُمْرَةِ وَهِيَ التَّحْرِيمُ وَالتَّفْسِيقُ وَالْكَفَّارَة"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_364", "reason": "high_symbol_ratio:0.403", "chunk_text": "إيجَابُهُ لِلتَّحْرِيمِ وَالتَّفْسِيقِ وَالْجَلْدِ وَالتَّغْرِيبِ ."}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_366", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَتَفْسِيقُهُ ، وَإِيجَابُهُ الْحَدَّ فِي كُلِّ وَاحِدَةٍ مِنْهُنَّ ، وَمِنْهَا تَحْرِيمُهُ الْجَمْع"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_367", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَمِنْهَا تَحْرِيمُهُ وَتَفْسِيقُهُ إذَا وَقَعَ بِشُبْهَةِ الشَّرِكَةِ ، وَإِيجَابِهِ لِبَعْضِ الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_368", "reason": "high_symbol_ratio:0.435", "chunk_text": "الْآخَرِ ، فَإِنْ تَعَلَّقَتْ بِالنِّسَاءِ فَلَهُنَّ مُهُورُ أَمْثَالِهِنَّ ، وَلَا حَدَّ عَلَيْهِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_370", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْمِثَالُ الثَّانِي : الرِّدَّةُ تَمْنَعُ صِحَّةَ النِّكَاحِ ابْتِدَاءً وَدَوَامًا إنْ وَقَعَتْ قَب"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_377", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالرَّقَبَةُ مَانِعَةٌ مِنْ ابْتِدَاءِ الصَّوْمِ وَغَيْرُ مَانِعَةٍ مِنْ دَوَامِهِ . فَصْلٌ فِي الش"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_378", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَحَدُهَا قَوْلُهُ : { فَمَنْ اعْتَدَى عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَى عَلَيْك"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_379", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْمِثَالُ الثَّالِثُ - قَوْلُهُ : { فَإِنْ طَلَّقَهَا فَلَا تَحِلُّ لَهُ مِنْ بَعْدُ حَتَّى تَنْكِح"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_380", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْمِثَالُ الرَّابِعُ - قَوْلُهُ عَلَيْهِ السَّلَامُ { مَنْ قَتَلَ قَتِيلًا فَلَهُ سَلَبُهُ . } الْم"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_381", "reason": "high_symbol_ratio:0.412", "chunk_text": "} وَأَمَّا التَّعْبِيرُ بِلَفْظِ الشَّرْطِ عَنْ أَسْبَابِ الْأَسْبَابِ الْمَحْذُوفَةِ فَلَهُ أَمْثِل"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_382", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْإِفْطَارُ سَبَبٌ لِصَوْمِ عِدَّةٍ مِنْ أَيَّامٍ أُخَرَ . الْمِثَالُ الثَّانِي وقَوْله تَعَالَى "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_384", "reason": "high_symbol_ratio:0.405", "chunk_text": "قَاعِدَةٌ فِي بَيَانِ الشُّبُهَاتِ الْمَأْمُورِ بِاجْتِنَابِهَا قَالَ عَلَيْهِ السَّلَامُ { : الْحَل"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_386", "reason": "high_symbol_ratio:0.424", "chunk_text": "هُوَ عِبَارَةٌ عَنْ تَعَلُّقِ الشَّرْعِ بِالْأَفْعَالِ ، وَكَذَلِكَ الْوَصْفُ بِالسَّبَبِيَّةِ وَالش"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_387", "reason": "high_symbol_ratio:0.403", "chunk_text": "النَّائِمِ وَالْمَجْنُونِ وَالْغَافِلِ عَنْهَا إنَّمَا هُوَ مِنْ مَجَازِ تَسْمِيَةِ الشَّيْءِ بِمَا "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_389", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَمِنْ الْأَفْعَالِ مَا هُوَ حَقِيقَتُهُ وَذَاتُهُ وَلَكِنَّهُ يُنْهَى عَنْهُ مَرَّةً لِقُبْحِ ثَمَر"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_390", "reason": "high_symbol_ratio:0.403", "chunk_text": "الْقِسْمُ الْأَوَّلُ : قَتْلُ مَنْ يَجِبُ قَتْلُهُ مِنْ الْكَافِرِينَ وَالْمُسْلِمِينَ وَهُوَ حَسَنٌ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_391", "reason": "high_symbol_ratio:0.409", "chunk_text": "الْقِسْمُ الثَّانِي : تَحْرِيمُ الْمُسْلِمِينَ وَهُوَ مُمَاثِلٌ فِي ذَاتِهِ لِقَتْلِ الْكَافِرِينَ و"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_392", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْقِسْمُ الثَّالِثُ : قَتْلُ مَنْ يَجُوزُ قَتْلُهُ بِالْقِصَاصِ مِنْ الْجُنَاةِ ، فَإِنَّهُ حَسَنٌ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_393", "reason": "high_symbol_ratio:0.422", "chunk_text": "الْمِثَالُ الثَّالِثُ : الْوَطْءُ مُتَّحِدٌ فِي حَقِيقَتِهِ وَذَاتِهِ لَكِنَّهُ يَحْرُمُ تَارَةً لِق"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_394", "reason": "high_symbol_ratio:0.409", "chunk_text": "مِثَالُهُ ، إذَا زِنَا بِأُمِّهِ فِي جَوْفِ الْكَعْبَةِ وَهُمَا صَائِمَانِ فِي رَمَضَانَ ، فَقَدْ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_395", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَإِنَّهُ بِالنَّظَرِ إلَى انْتِهَاكِ حُرْمَةِ الْكَعْبَةِ مُرْتَكِبٌ لِكَبِيرَةٍ مُوجِبَةٍ لِلتَّحْ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_396", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَالْجَلْدِ وَالتَّغْرِيبِ إنْ كَانَ بِكْرًا . وَكَذَلِكَ قَدْ يَجْمَعُ الْفِعْلُ الْوَاحِدُ مَصَالِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_397", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَسْبَابُ التَّحْرِيمِ وَالتَّحْلِيلِ ضَرْبَانِ : أَحَدُهُمَا قَائِمٌ بِالْمَحَلِّ الَّذِي يَتَعَل"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_398", "reason": "high_symbol_ratio:0.413", "chunk_text": "لِمَا قَامَ بِهَا مِنْ الصِّفَةِ الْقَاتِلَةِ ، وَكَذَلِكَ الصِّفَاتُ النِّسْبِيَّةُ كَالْأُمُومَةِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_399", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَأَمَّا الْقَائِمُ بِالْمَحَلِّ مِنْ أَسْبَابِ التَّحْلِيلِ فَهُوَ كُلُّ صِفَةٍ قَائِمَةٍ بِالْمَحَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_400", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَأَمَّا الْخَارِجُ عَنْ الْمَحَلِّ فَضَرْبَانِ : أَحَدُهُمَا الْأَسْبَابُ الْبَاطِلَةُ كَالْغَصْبِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_402", "reason": "high_symbol_ratio:0.404", "chunk_text": "يُغْصَبَانِ مِنْ ذِمِّيٍّ ، وَمَا كَانَ مِنْ هَذِهِ الْأَعْيَانِ مُتَّفَقًا عَلَى وَصْفِهِ الْقَائِم"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_403", "reason": "high_symbol_ratio:0.416", "chunk_text": "اجْتِنَابُهُ مِنْ تَرْكِ الشُّبُهَاتِ ، فَإِنَّهُ أَشْبَهُ الْمُحَلِّلِ مِنْ جِهَةِ قِيَامِ دَلِيلِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_405", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَدْ أَطْلَقَ الْفُقَهَاءُ أَنَّ اخْتِلَافَ الْعُلَمَاءِ شُبْهَةٌ وَلَيْسَ ذَلِكَ عَلَى إطْلَاقِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_406", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَجَلَّ فَنَذْكُرُ لِذَلِكَ أَمْثِلَةً : أَحَدُهَا : أَكْلُ ذِي نَابٍ مِنْ السِّبَاعِ وَمِخْلَبٍ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_407", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْمِثَالُ الثَّانِي : أَكْلُ الْبُرِّ وَالشَّعِيرِ وَالرُّطَبِ وَالْعِنَبِ وَالْإِبِلِ وَالْبَقَرِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_408", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْمِثَالُ الثَّالِثُ : نِكَاحُ الْمَخْلُوقَةِ مِنْ مَاءِ الزَّانِي إذَا عُقِدَ عَلَيْهَا عَقْدٌ لَو"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_409", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَدْ يُلْتَبَسُ مَا حُلَّ بِوَصْفِهِ وَسَبَبِهِ بِمَا حُرِّمَ بِوَصْفِهِ وَسَبَبِهِ وَلَهُ حَالَان"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_410", "reason": "high_symbol_ratio:0.409", "chunk_text": "الْحَالُ الثَّانِيَةُ : أَنَّ تَخْتَلِطَ أُخْتُهُ مِنْ الرَّضَاعِ بِأَهْلِ بَلَدٍ لَا يَنْحَصِرُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_411", "reason": "high_symbol_ratio:0.401", "chunk_text": "مَمْلُوكَةٍ لَكَانَ كَاخْتِلَاطِ الْأُخْتَيْنِ وَلَا اخْتَلَطَتْ حَمَامَةٌ مَمْلُوكَةٌ بِحَمَامٍ مُب"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_413", "reason": "high_symbol_ratio:0.408", "chunk_text": "( فَائِدَةٌ ) إذَا أَكَلَ بُرًّا مَغْصُوبًا أَوْ شَاةً مَغْصُوبَةً صَحَّ أَنْ يُقَالَ أَكَلَ حَرَامً"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_414", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْمُشْتَرَكِ ، فَإِنَّ الْمُشْتَرَكَ حَرَّمَ تَحْرِيمَ الْوَسَائِلِ وَهَذَا حَرَّمَ تَحْرِيمَ الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_415", "reason": "high_symbol_ratio:0.411", "chunk_text": "( فَائِدَةٌ ) مَا يَحْرُمُ بِوَصْفِهِ لَا يَحِلُّ إلَّا لِضَرُورَةٍ أَوْ إكْرَاهٍ ، وَمَا حُلَّ بِصِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_416", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِنْ قِيلَ : لَوْ وَطِئَ وَاحِدَةً مِنْ هَؤُلَاءِ بِسَبْقِهِ فَهَلْ يُوصَفُ وَطْؤُهُ بِالتَّحْلِيل"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_421", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْمِثَالُ الرَّابِعُ : الْفِسْقُ يُقَدَّرُ فِي الْفَاسِقِ مَعَ غَفْلَتِهِ عَنْهُ أَوْ مَعَ زَوَالِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_422", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْمِثَالُ الْخَامِسُ : الْإِخْلَاصُ وَالرِّيَاءُ فَإِنَّهُمَا يُقَدَّرَانِ مَعَ زَوَالِهِمَا ، وَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_424", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْمِثَالُ السَّابِعُ : تَقْدِيرُ الْعُلُومِ لِلْعُلَمَاءِ مَعَ غَيْبَتِهَا عَنْهُمْ ، فَيُقَدَّرُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_425", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَمَّا نُبُوَّةُ الْأَنْبِيَاءِ فَقَدْ جُعِلَ النَّبِيُّ بِمَعْنَى الْمُنْبِئِ عَنْ اللَّهِ فَإِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_427", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَإِنْ قِيلَ : مَا مَعْنَى وقَوْله تَعَالَى : { وَمِنْ شَرِّ حَاسِدٍ إذَا حَسَدَ } فَالْجَوَابُ أَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_431", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْمِثَالُ الثَّانِي عَشَرَ : الذِّمَمُ وَهِيَ تَقْدِيرُ أَمْرِ الْإِنْسَانِ يَصْلُحُ لِلِالْتِزَامِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_432", "reason": "high_symbol_ratio:0.405", "chunk_text": "الْمِثَالُ الثَّالِثَ عَشَرَ : الدُّيُونُ فَإِنَّهَا تُقَدَّرُ مَوْجُودَةً فِي الذِّمَمِ مِنْ غَيْرِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_433", "reason": "high_symbol_ratio:0.404", "chunk_text": "مُعْسِرًا فَإِنَّ مَالِكَهُ يُطَالَبُ بِزَكَاةِ مَا مَضَى وَإِنْ لَمْ يُفِضْ أَمْرُهُ إلَى التَّحَقُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_434", "reason": "high_symbol_ratio:0.426", "chunk_text": "الْمِثَالُ الْخَامِسَ عَشَرَ : تَقْدِيرُ الْمِلْكِ فِي الْمَمْلُوكَاتِ فَإِنَّهُ لَيْسَ أَمْرًا حَقِ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_435", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَأَمَّا إعْطَاءُ الْمَوْجُودِ حُكْمَ الْمَعْدُومِ فَلَهُ مِثَالَانِ - أَحَدُهُمَا وُجُودُ الْمَاءِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_436", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْمِثَالُ الثَّانِي : وُجُودُ الْمُكَفِّرِ الرَّقَبَةُ مَعَ احْتِيَاجِهِ إلَيْهَا وَاعْتِمَادُهُ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_437", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمِنْ التَّقْدِيرَاتِ : إعْطَاءُ الْمُتَأَخِّرِ حُكْمَ الْمُتَقَدِّمِ كَمَنْ رَمَى سَهْمًا أَوْ دَه"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_438", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَكَذَلِكَ لَوْ حَفَرَ بِئْرًا فِي مَحَلٍّ عُدْوَانًا فَوَقَعَ فِيهَا إنْسَانٌ بَعْدَ مَوْتِهِ وَجَب"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_439", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَمِنْ التَّقْدِيرَاتِ : إعْطَاءُ الْآثَارِ وَالصِّفَاتِ حُكْمَ الْأَعْيَانِ الْمَوْجُودَاتِ كَالْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_440", "reason": "high_symbol_ratio:0.416", "chunk_text": "عِنْدَ الْعَقْدِ مَعْدُومٌ . وَأَمَّا الْإِجَارَةُ فَإِنْ قُوبِلَتْ الْمَنْفَعَةُ بِمَنْفَعَةٍ كَانَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_442", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَأَمَّا الْقَرْضُ فَمُقَابَلَةُ مَوْجُودٍ بِمَعْدُومٍ . وَأَمَّا الْوَكَالَةُ فَإِذَنْ فِي مَعْدُوم"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_443", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَأَمَّا الْمُسَاقَاةُ وَالْمُزَارَعَةُ الْمُتَّفَقُ عَلَيْهِمَا فَمُقَابَلَةُ مَعْدُومٍ بِمَعْدُومٍ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_444", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَأَمَّا الْجَعَالَةُ فَإِنَّ عَيْنَ الْجَعْلِ كَانَ مُقَابَلَةَ مَعْلُومٍ بِمَعْدُومٍ ، وَإِنْ لَمْ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_445", "reason": "high_symbol_ratio:0.400", "chunk_text": "وَأَمَّا الْوَقْفُ فَهُوَ تَمْلِيكٌ لِمَنَافِعَ مَعْدُومَةٍ وَفَوَائِدَ مَعْقُودَةٍ تَارَةً لِمَوْجُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_447", "reason": "high_symbol_ratio:0.409", "chunk_text": "الْمِثَالُ الرَّابِعُ وَالْخَمْسُونَ : التَّمْثِيلُ بِالْجُنَاةِ إذَا مَثَّلُوا بِالْمَجْنِيِّ عَلَي"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_451", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَأَمَّا الْحَوَالَةُ فَتَتَعَلَّقُ بِدَيْنٍ فِي مُقَابَلَةِ دَيْنٍ ، وَهِيَ مُعَاوَضَةٌ عَلَى رَأْي"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_452", "reason": "high_symbol_ratio:0.409", "chunk_text": "مِنْ وَجْهٍ ، وَحُكْمُ الْمُعَاوَضَةِ مِنْ وَجْهٍ . وَأَمَّا الصُّلْحُ فَلَا يَخْرُجُ عَنْ كَوْنِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_453", "reason": "high_symbol_ratio:0.401", "chunk_text": "قَاعِدَةٌ فِيمَا يُقْبَلُ مِنْ التَّأْوِيلِ وَمَا لَا يُقْبَلُ مَنْ ذَكَرَ لَفْظًا ظَاهِرًا مَعَ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_454", "reason": "high_symbol_ratio:0.441", "chunk_text": "ظَنُّهُمَا ، وَلَيْسَ تَكْذِيبُ الظَّنِّ بِمُنَاقِضٍ لِتَحَقُّقِ الظَّنِّ ، فَكَأَنَّهُ قَالَ أَظُنُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_455", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَكَذَلِكَ قَوْلُ السَّيِّدِ لِمُكَاتَبِهِ إذَا أَدَّى النُّجُومَ اذْهَبْ فَأَنْتَ حُرٌّ ثُمَّ ظَهَر"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_456", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَأَمَّا قَبُولُهُ فِي الْبَاطِنِ فَلَهُ أَحْوَالٌ : إحْدَاهَا أَنْ يَكُونَ اللَّفْظُ قَابِلًا لِتَأ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_457", "reason": "high_symbol_ratio:0.423", "chunk_text": "لِأَمَتِهِ أَنْتِ حُرَّةٌ ثُمَّ قَالَ أَرَدْت حُرِّيَّةَ النَّفْسِ وَالْأَخْلَاقِ لَمْ يُقْبَلْ وَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_458", "reason": "high_symbol_ratio:0.401", "chunk_text": "يُصَدِّقَهُ الْمُسْتَحِقُّ ، وَلَا عِبْرَةَ بِمَا ذَكَرَهُ فِي الْحَاوِي فِي مِثْلِ هَذَا . الْحَالُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_459", "reason": "high_symbol_ratio:0.413", "chunk_text": "الْحَالُ الثَّالِثَةُ : أَنْ يَنْوِيَ وَضْعَ اللَّفْظِ اللُّغَوِيِّ عَلَى مَا لَا يَحْتَمِلُهُ فِي ا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_461", "reason": "high_symbol_ratio:0.410", "chunk_text": "مِثَالُهُ : إذَا حَلَفَ الْمُدَّعَى عَلَيْهِ مُتَأَوِّلًا لِيَمِينِهِ أَوْ مُعَلِّقًا لَهَا عَلَى ال"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_462", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَتَلَتْهُ وَمَا قَذَفَتْهُ وَتَأَوَّلَ يَمِينَهُ بِمَا يَصِحُّ فِي اللُّغَةِ مُبْطِلًا فِي ذَلِكَ ك"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_463", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَلَوْ ادَّعَى عَلَيْهِ بِحَقٍّ وَهُوَ مُعْسِرٌ بِهِ فَقَالَ الْمُدَّعَى عَلَيْهِ لَا يَسْتَحِقُّهُ "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_464", "reason": "high_symbol_ratio:0.407", "chunk_text": "لِأَنَّهُ لَوْ كَانَ مُعْتَبَرًا لَكَانَ مُؤَدِّيًا إلَى الْمَفَاسِدِ الَّتِي ذَكَرْنَا وَعَلَى هَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_465", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَكَذَلِكَ الْيَمِينُ فِي اللِّعَانِ إذَا تَأَوَّلَهَا أَحَدُ الزَّوْجَيْنِ لَمْ يَصِحَّ تَأْوِيلُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_466", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَكَذَلِكَ يَمِينُ الْمُدَّعِينَ فِي أَيْمَانِ الْقَسَامَةِ وَفِي رَدِّ الْوَدَائِعِ وَتُلْفِهَا . ف"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_467", "reason": "high_symbol_ratio:0.418", "chunk_text": "إذَا نَطَقَ الْأَعْجَمِيُّ بِكَلِمَةِ كُفْرٍ أَوْ أَيْمَانٍ أَوْ طَلَاقٍ أَوْ إعْتَاقٍ أَوْ بَيْعٍ أ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_468", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَإِنَّ الْإِرَادَةَ لَا تَتَوَجَّهُ إلَّا إلَى مَعْلُومٍ أَوْ مَظْنُونٍ ، وَإِنْ قَصَدَ الْعَرَبِيُ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_469", "reason": "high_symbol_ratio:0.413", "chunk_text": "بِمَدْلُولِهِ حَتَّى يَقْصِدُ إلَى اللَّفْظِ الدَّالِّ عَلَيْهِ ، وَكَثِيرًا مَا يُخَالِعُ الْجُهَّا"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_470", "reason": "high_symbol_ratio:0.400", "chunk_text": "( فَائِدَةٌ ) اللَّفْظُ مَحْمُولٌ عَلَى مَا يَدُلُّ عَلَيْهِ ظَاهِرُهُ فِي اللُّغَةِ أَوْ عُرْفِ الش"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_471", "reason": "high_symbol_ratio:0.415", "chunk_text": "بِالْمُصْحَفِ عِنْدَ أَصْحَابِ مَالِكٍ ، فَإِنَّهُ لَا يَخْطِرُ بِبَالِهِ الْكَلَامُ الْقَدِيمُ وَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_472", "reason": "high_symbol_ratio:0.415", "chunk_text": "( فَائِدَةٌ ) تَعْلِيقُ التَّصَرُّفِ عَلَى الْمَشِيئَةِ ضَرْبَانِ : أَحَدُهُمَا أَنْ يَجْزِمَ بِمَا "}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_473", "reason": "high_symbol_ratio:0.415", "chunk_text": "الضَّرْبُ الثَّانِي : أَنْ لَا يَجْزِمَ بِالتَّصَرُّفِ بَلْ يُعَلِّقُهُ عَلَى الْمَشِيئَةِ مُتَرَدِّ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_474", "reason": "high_symbol_ratio:0.410", "chunk_text": "التَّرْدِيدِ . فَصْلٌ فِيمَا أُثْبِتَ عَلَى خِلَافِ الظَّاهِرِ وَلَهُ أَمْثِلَةٌ أَحَدُهَا : إذَا اد"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_476", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْمِثَالُ الثَّالِثُ : إذَا أَتَتْ الزَّوْجَةُ بِالْوَلَدِ لِدُونِ أَرْبَعِ سِنِينَ مِنْ حِينِ طَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_477", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَإِنْ قِيلَ : إنَّمَا لَحِقَهُ لِأَنَّ الْأَصْلَ عَدَمُ الزِّنَا وَعَدَمُ الْوَطْءِ بِالشُّبْهَةِ و"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_478", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَالْحَضَانَةُ . الْمِثَالُ الرَّابِعُ : إذَا أَتَتْ بِوَلَدٍ لِسِتَّةِ أَشْهُرٍ مِنْ حِينِ تَزَوَّج"}
{"source": "wikisource", "raw_id": "arwikisource:2204:16600#chunk_479", "reason": "high_symbol_ratio:0.418", "chunk_text": "الْمِثَالُ الْخَامِسُ : لَوْ زَنَى بِهَا إنْسَانٌ ثُمَّ تَزَوَّجَتْ وَأَتَتْ بِوَلَدٍ لِتِسْعَةِ أَش"}
