{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_152", "reason": "high_symbol_ratio:0.437", "chunk_text": "====جمع==== جَمَعْتُ الشَّيْءَ جَمْعًا وَجَمَّعْتُهُ بِالتَّثْقِيلِ مُبَالَغَةٌ وَالْجَمْعُ الدَّقَل"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_153", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالْجَمْعُ أَيْضًا الْجَمَاعَةُ تَسْمِيَةً بِالْمَصْدَرِ وَيُجْمَعُ عَلَى جُمُوعٍ مِثْلُ فَلْسٍ وَف"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_155", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَضَرَبَهُ بِجُمْعِ كَفِّهِ بِضَمِّ الْجِيمِ أَيْ مَقْبُوضَةً وَأَخَذَ بِجُمْعِ ثِيَابِهِ أَيْ بِمُج"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_156", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَمَاتَتِ الْمَرْأَةُ بِجُمْعٍ بِالضَّمِّ وَالْكَسْرِ إذَا مَاتَتْ وَفِي بَطْنِهَا وَلَدٌ وَيُقَالُ "}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_157", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَالْمَجْمَعُ بِفَتْحِ الْمِيمِ وَكَسْرِهَا مِثْلُ الْمَطْلَعِ وَالْمَطْلَعُ يُطْلَقُ عَلَى الْجَمْع"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_158", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَجِمَاعُ الْإِثْمِ بِالْكَسْرِ وَالتَّخْفِيفِ جَمْعُهُ وَأَجْمَعْتُ الْمَسِيرَ وَالْأَمْرَ وَأَجْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_159", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَفِي حَدِيثٍ { مَنْ لَمْ يُجْمِعْ الصِّيَامَ قَبْلَ الْفَجْرِ فَلَا صِيَامَ لَهُ } أَيْ مَنْ لَمْ ي"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_160", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَجَمِيعَهُ فَتُؤَكِّدُ بِهِ كُلَّ مَا يَصِحُّ افْتِرَاقُهُ حِسًّا أَوْ حُكْمًا وَتُتْبِعُهُ الْمُؤَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_161", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْمَوْصُوفِ فَكَأَنَّهَا غَيْرُهُ. وَفِي حَدِيثٍ { فَصَلُّوا قُعُودًا أَجْمَعِينَ } فَغَلِطَ مَنْ ق"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_164", "reason": "high_symbol_ratio:0.413", "chunk_text": "====جمل==== الْجَمَلُ مِنَ الْإِبِلِ بِمَنْزِلَةِ الرَّجُلِ يَخْتَصُّ بِالذَّكَرِ قَالُوا وَلَا يُسَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_165", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَأَجْمَلْتُ الشَّيْءَ إجْمَالًا جَمَعْتُهُ مِنْ غَيْرِ تَفْصِيلٍ وَأَجْمَلْتُ فِي الطَّلَبِ رَفَقْت"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_166", "reason": "high_symbol_ratio:0.424", "chunk_text": "====جمم==== جَمَّ الشَّيْءُ جَمًّا مِنْ بَابِ ضَرَبَ كَثُرَ فَهُوَ جَمٌّ تَسْمِيَةٌ بِالْمَصْدَرِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_168", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَجَمَامُ الْفَرَسِ بِالْفَتْحِ لَا غَيْرُ رَاحَتُهُ. وَأَجَمَّ الشَّيْءُ بِالْأَلِفِ دَنَا وَحَضَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_169", "reason": "high_symbol_ratio:0.418", "chunk_text": "====جنب==== جَنْبُ الْإِنْسَانِ مَا تَحْتَ إبْطِهِ إلَى كَشْحِهِ وَالْجَمْعُ جُنُوبٌ مِثْلُ فَلْسٍ و"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_170", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالْجَنُوبُ هِيَ الرِّيحُ الْقِبْلِيَّةُ. وَذَاتُ الْجَنْبِ عِلَّةٌ صَعْبَةٌ وَهِيَ وَرَمٌ حَارٌّ ي"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_171", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالْجَنَابَةُ مَعْرُوفَةٌ يُقَالُ مِنْهَا أَجْنَبَ بِالْأَلِفِ وَجَنُبَ وِزَانُ قَرُبَ فَهُوَ جُنُب"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_172", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَالْجَارُ الْجُنُبُ قِيلَ رَفِيقُكَ فِي السَّفَرِ وَقِيلَ جَارُكَ مِنْ قَوْمٍ آخَرِينَ وَلَا تَكَاد"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_173", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْجَنِيبُ مِنْ أَجْوَدِ التَّمْرِ. وَالْجَنِيبَةُ الْفَرَسُ تُقَادُ وَلَا تُرْكَبُ فَعَيْلَةٌ بِم"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_174", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَالْجَنَابُ بِالْفَتْحِ الْفِنَاءُ وَالْجَانِبُ أَيْضًا. ====جنح==== جَنَحَ إلَى الشَّيْءِ يَجْنَحُ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_175", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَالْجُنَاحُ بِالضَّمِّ الْإِثْمُ. ====جند==== الْجُنْدُ الْأَنْصَارُ وَالْأَعْوَانُ وَالْجَمْعُ أَج"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_176", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَجَنَدُ بِفَتْحَتَيْنِ بَلَدٌ بِالْيَمَنِ. ====جنز==== جَنَزْتُ الشَّيْءَ أَجْنِزُهُ مِنْ بَابِ ضَر"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_177", "reason": "high_symbol_ratio:0.419", "chunk_text": "====جنس==== الْجِنْسُ الضَّرْبُ مِنْ كُلِّ شَيْءِ وَالْجَمْعُ أَجْنَاسٌ وَهُوَ أَعَمُّ مِنَ النَّوْع"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_178", "reason": "high_symbol_ratio:0.438", "chunk_text": "====جنف==== جَنِفَ جَنَفًا مِنْ بَابِ تَعِبَ ظَلَمَ وَأَجْنَفَ بِالْأَلِفِ مِثْلُهُ وقَوْله تَعَالَى"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_179", "reason": "high_symbol_ratio:0.434", "chunk_text": "====جنن==== الْجَنِينُ وَصْفٌ لَهُ مَا دَامَ فِي بَطْنِ أُمِّهِ وَالْجَمْعُ أَجِنَّةٌ مِثْلُ دَلِيلٍ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_180", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَالْجَانُّ الْوَاحِدُ مِنَ الْجِنِّ وَهُوَ الْحَيَّةُ الْبَيْضَاءُ أَيْضًا. وَالْجَنَّةُ الْجُنُونُ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_181", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالْجَنَّةُ بِالْفَتْحِ الْحَدِيقَةُ ذَاتُ الشَّجَرِ وَقِيلَ ذَاتُ النَّخْلِ وَالْجَمْعُ جَنَّاتٌ ع"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_182", "reason": "high_symbol_ratio:0.410", "chunk_text": "====جني==== جَنَيْتُ الثَّمَرَةَ أَجْنِيهَا وَاجْتَنَيْتُهَا بِمَعْنَاهُ وَالْجَنَى مِثْلُ الْحَصَى "}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_184", "reason": "high_symbol_ratio:0.407", "chunk_text": "====جهد==== الْجُهْدُ بِالضَّمِّ فِي الْحِجَازِ وَبِالْفَتْحِ فِي غَيْرِهِمْ الْوُسْعُ وَالطَّاقَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_185", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَجَهَدْتُ الدَّابَّةَ وَأَجْهَدْتُهَا حَمَلْتُ عَلَيْهَا فِي السَّيْرِ فَوْقَ طَاقَتهَا."}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_186", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَجَهَدْتُ اللَّبَنَ جَهْدًا مَزَجْتُهُ بِالْمَاءِ وَمَخَضْتُهُ حَتَّى اسْتَخْرَجْتُ زُبْدَهُ فَصَار"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_188", "reason": "high_symbol_ratio:0.426", "chunk_text": "====جهر==== جَهَرَ الشَّيْءُ يَجْهَرُ بِفَتْحَتَيْنِ ظَهَرَ وَأَجْهَرْتُهُ بِالْأَلِفِ أَظْهَرْتُهُ "}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_189", "reason": "high_symbol_ratio:0.450", "chunk_text": "وَالْجَوْهَرُ مَعْرُوفٌ وَزْنُهُ فَوْعَلٌ وَجَوْهَرُ كُلِّ شَيْءٍ مَا خُلِقَتْ عَلَيْهِ جِبِلَّتُهُ."}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_190", "reason": "high_symbol_ratio:0.416", "chunk_text": "====جهز==== جَهَازُ السَّفَرِ أُهْبَتُهُ وَمَا يُحْتَاجُ إلَيْهِ فِي قَطْعِ الْمَسَافَةِ بِالْفَتْحِ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_191", "reason": "high_symbol_ratio:0.422", "chunk_text": "الشَّدِّ وَالتِّرْحَالِ. وَجَهَزْتُ عَلَى الْجَرِيحِ مِنْ بَابِ نَفَعَ وَأَجْهَزْتُ إجْهَازًا إذَا أ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_192", "reason": "high_symbol_ratio:0.418", "chunk_text": "====جهض==== أَجْهَضَتِ النَّاقَةُ وَالْمَرْأَةُ وَلَدَهَا إجْهَاضًا أَسْقَطَتْهُ نَاقِصَ الْخَلْقِ ف"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_193", "reason": "high_symbol_ratio:0.429", "chunk_text": "====جهل==== جَهِلْتُ الشَّيْءَ جَهْلًا وَجَهَالَةً خِلَافُ عَلِمْتُهُ وَفِي الْمَثَلِ كَفَى بِالشَّك"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_194", "reason": "high_symbol_ratio:0.405", "chunk_text": "====جوب==== جَوَابُ الْكِتَابِ مَعْرُوفٌ وَجَوَابُ الْقَوْلِ قَدْ يَتَضَمَّنُ تَقْرِيرَهُ نَحْوُ نَع"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_195", "reason": "high_symbol_ratio:0.402", "chunk_text": "جَوْبًا قَطَعَهَا وَانْجَابَ السَّحَابُ انْكَشَفَ. ====جوح==== الْجَائِحَةُ الْآفَةُ يُقَالُ جَاحَتِ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_197", "reason": "high_symbol_ratio:0.406", "chunk_text": "====جود==== جَادَ الرَّجُلُ يَجُودُ مِنْ بَابِ قَالَ جُودًا بِالضَّمِّ تَكَرَّمَ فَهُوَ جَوَادٌ وَال"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_198", "reason": "high_symbol_ratio:0.405", "chunk_text": "كَرِيمٍ وَشَرِيفٍ فَاسْتُثْقِلَتِ الْكَسْرَةُ عَلَى الْوَاوِ فَحُذِفَتْ فَاجْتَمَعَتِ الْوَاوُ وَهِي"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_199", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَأَجَادَ الرَّجُلُ إجَادَةً أَتَى بِالْجَيِّدِ مِنْ قَوْلٍ أَوْ فِعْلٍ. ====جور==== جَارَ فِي حُكْم"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_201", "reason": "high_symbol_ratio:0.408", "chunk_text": "أَيْضًا جَارَةٌ وَالْجَارَةُ الضَّرَّةُ قِيلَ لَهَا جَارَةٌ اسْتِكْرَاهًا لِلَفْظِ الضَّرَّةِ وَكَان"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_202", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَأَجَارَهُ. ====جوز==== جَازَ الْمَكَانَ يَجُوزُهُ جَوْزًا وَجَوَازًا وَجِوَازًا سَارَ فِيهِ وَأَجَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_203", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَجَاوَزْتُ الشَّيْءَ وَتَجَاوَزْتُهُ تَعَدَّيْتُهُ وَتَجَاوَزْتُ عَنِ الْمُسِيءِ عَفَوْتُ عَنْهُ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_204", "reason": "high_symbol_ratio:0.420", "chunk_text": "====جوع==== جَاعَ الرَّجُلُ جَوْعًا وَالِاسْمُ الْجُوعُ بِالضَّمِّ وَجَوْعَةٌ وَهُوَ عَامُ الْمَجَاع"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_205", "reason": "high_symbol_ratio:0.411", "chunk_text": "====جوف==== الْجَوْفُ الْخَلَاءُ وَهُوَ مَصْدَرٌ مِنْ بَابِ تَعِبَ فَهُوَ أَجْوَفُ وَالِاسْمُ الْجَو"}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_206", "reason": "high_symbol_ratio:0.406", "chunk_text": "اطْعَنُوهُ فِي جَوْفِهِ. ====جول==== جَالَ الْفَرَسُ فِي الْمَيْدَانِ يَجُولُ جَوْلَةً وَجَوَلَانًا "}
{"source": "wikisource", "raw_id": "arwikisource:41099:108382#chunk_207", "reason": "high_symbol_ratio:0.417", "chunk_text": "====جون==== الْجَوْنُ يُطْلَقُ بِالِاشْتِرَاكِ عَلَى الْأَبْيَضِ وَالْأَسْوَدِ وَقَالَ بَعْضُ الْفُق"}
