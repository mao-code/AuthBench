{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_40", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَأَقْرَبَ الْقَوْمُ إذَا كَانَتْ إبِلُهُمْ قَوَارِبَ فَهُمْ قَارِبُونَ قَالَ ابْنُ الْقَطَّاعِ وَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_41", "reason": "high_symbol_ratio:0.409", "chunk_text": "الشَّيْءِ فَقَوْلُهُمْ أَمْحَلَ الْبَلَدُ فَهُوَ مَاحِلٌ أَيْ ذُو مَحْلٍ وَأَعْشَبَ فَهُوَ عَاشِبٌ أ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_42", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَسْهَبَ إذَا كَانَ فَصِيحًا فَاسْمُ الْفَاعِلِ عَلَى الْأَصْلِ وَأَعَمَّ وَأَخْوَلَ أَذَا كَثُرَتْ "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_43", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَ أَبُو زَيْدٍ: أُعِمَّ وَأُخْوِلَ بِالْبِنَاءِ فِيهِمَا لِلْمَفْعُولِ فَعَلَى هَذَا لَيْسَا م"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_44", "reason": "high_symbol_ratio:0.425", "chunk_text": "أَرْمَلَةٌ وَأَسْمَعَهُ فَهُوَ سَمِيعٌ وَشَذَّ مِنْ أَسْمَاءِ الْمَفْعُولِينَ أَلْفَاظٌ نَحْوُ أَجَن"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_45", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَالَ أَبُو زَيْدٍ: أَيْضًا مَجْنُونٌ وَمَزْكُومٌ وَمَحْزُونٌ وَمَكْرُوزٌ وَمَقْرُورٌ مِنَ الْقَرِ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_46", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالتَّقْدِيرُ أَضْعَفَهُ اللَّهُ فَضَعُفَ فَهُوَ ضَعِيفٌ وَأَسَامَ الرَّاعِي الْمَاشِيَةَ فَهِيَ سَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_47", "reason": "high_symbol_ratio:0.417", "chunk_text": "====فصل==== وَيُبْنَى مِنْ أُفْعِلَ عَلَى صِيغَةِ الْمَفْعُولِ مُفْعَلٌ لِلْمَصْدَرِ وَالزَّمَانِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_48", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالْمَمْسَى لِمَوْضِعِ الْإِصْبَاحِ وَالْإِمْسَاءِ وَلِوَقْتِهِ وَالْمَخْدَعُ مِنْ أَخْدَعْتُهُ إذَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_49", "reason": "high_symbol_ratio:0.410", "chunk_text": "====فصل==== وَأَمَّا الْمَصَادِرُ مِنْ أَفْعَلَ فَتَأْتِي عَلَى إفْعَالٍ بِكَسْرِ الْهَمْزَةِ فَرْقً"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_51", "reason": "high_symbol_ratio:0.407", "chunk_text": "هُوَ مَصْدَرٌ لِمُطَاوِعٍ مَحْذُوفٍ وَالتَّقْدِيرُ فَنَبَتُّمْ نَبَاتًا وَقِيلَ وُضِعَ مَوْضِعَ مَصْ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_52", "reason": "high_symbol_ratio:0.422", "chunk_text": "====فصل==== الثُّلَاثِيُّ الْمُجَرَّدُ لَيْسَ لِمَصْدَرِهِ قِيَاسٌ يَنْتَهِي إلَيْهِ بَلْ أَبْنِيَتُ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_53", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَالَ الْفَارَابِيُّ: قَالَ الْفَرَّاءُ بَابُ فَعَلَ بِالْفَتْحِ يَفْعُلُ بِالضَّمِّ أَوْ الْكَسْر"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_54", "reason": "high_symbol_ratio:0.436", "chunk_text": "====فصل==== إذَا جُمِعَ الِاسْمُ الثُّلَاثِيُّ عَلَى أَفْعَالٍ فَهَمْزَتُهُ مَفْتُوحَةٌ نَحْوُ سِنٍّ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_55", "reason": "high_symbol_ratio:0.426", "chunk_text": "====فصل==== إذَا جُعِلَ الْمِفْعَلُ مَكَانًا فَتَحْتَ الْمِيمَ فَالْمَقْطَعُ اسْمٌ لِلْمَوْضِعِ الَّ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_56", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَالْمُدُقِّ وَالْمُدْهُنِ وَالْمُكْحُلَةِ وَالْمُحْرُضَةِ وَالْمُنْصُلِ وَالْمُلَاءَةِ وَالْمُغْزُل"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_57", "reason": "high_symbol_ratio:0.407", "chunk_text": "====فصل==== وَجَاءَ فُعَّالٌ وَفُعَّالَةٌ بِالضَّمِّ كَثِيرًا فِيمَا هُوَ فَضْلَةٌ وَفِيمَا يُرْفَضُ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_58", "reason": "high_symbol_ratio:0.406", "chunk_text": "عَلَى الضَّمِّ وَإِنْ لَمْ يَكُنْ مِنَ الْبَابِ حَمْلًا عَلَى ضِدِّهِ لِأَنَّهُمْ قَدْ يَحْمِلُونَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_59", "reason": "high_symbol_ratio:0.427", "chunk_text": "====فصل==== الْجَمْعُ قِسْمَانِ جَمْعُ قِلَّةٍ وَجَمْعُ كَثْرَةٍ فَجَمْعُ الْقِلَّةِ قِيلَ خَمْسَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_60", "reason": "high_symbol_ratio:0.414", "chunk_text": "قَالَ لِحَسَّانَ قَلَّلْتَ جِفَانَكَ وَسُيُوفَكَ وَذَهَبَ جَمَاعَةٌ إلَى أَنَّ جَمْعَيِ السَّلَامَةِ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_62", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَالَ { كُتِبَ عَلَيْكُمْ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_63", "reason": "high_symbol_ratio:0.405", "chunk_text": "الثَّلَاثَةِ نَحْوُ دَرَاهِمَ وَدَنَانِيرَ أَوْ ثُلَاثِيًّا وَلَيْسَ لَهُ إلَّا جَمْعٌ وَاحِدٌ نَحْو"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_65", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَالَ ابْنُ السَّرَّاجِ: وَقَدْ يَجِيءُ أَفْعَالٌ فِي الْكَثْرَةِ قَالُوا قَتَبٌ وَأَقْتَابٌ وَرَس"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_67", "reason": "high_symbol_ratio:0.402", "chunk_text": "شُسُوعٍ وَثَلَاثَةِ قُرُوءٍ قَالَ وَفَعْلٌ بِفَتْحِ الْفَاءِ وَسُكُونِ الْعَيْنِ إذَا جَاوَزَ الْعَش"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_69", "reason": "high_symbol_ratio:0.418", "chunk_text": "====فصل==== إذَا جُمِعَتْ فُعْلَةٌ بِضَمِّ الْفَاءِ وَسُكُونِ الْعَيْنِ بِالْأَلِفِ وَالتَّاءِ فَإِن"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_70", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِنْ كَانَتِ اسْمًا فَتُضَمُّ الْعَيْنُ لِلْإِتْبَاعِ وَتَبْقَى سَاكِنَةً عَلَى لَفْظِ الْمُفْرَدِ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_71", "reason": "high_symbol_ratio:0.418", "chunk_text": "غُرَفٌ وَرُكَبٌ قَالَ وَبَنَاتُ الْوَاوِ كَذَلِكَ مِثْلُ خُطْوَةٍ وَخُطُوَاتٍ وَجَاءَ خُطًى وَمِنَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_72", "reason": "high_symbol_ratio:0.414", "chunk_text": "عَلَى مُرَادِفِهَا وَالْمُرَّةُ عِنْدَهُمْ بِمَعْنَى خَبِيثَةٍ فَحُمِلَتْ فِي الْجَمْعِ عَلَى مُرَاد"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_73", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَأَمَّا فَعْلَةٌ بِالْفَتْحِ فَتُسَكَّنُ فِي الصِّفَةِ أَيْضًا نَحْوُ ضَخْمَاتٍ وَصَعْبَاتٍ وَتُفْت"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_75", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَقَالَ { لَهُدِّمَتْ صَوَامِعُ وَبِيَعٌ وَصَلَوَاتٌ } وَبَعْضُ الْعَرَبِ يُسَكِّنُ الْعَيْنَ لِلتَّ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_76", "reason": "high_symbol_ratio:0.406", "chunk_text": "جَنَّةٌ وَجِنَانٌ وَأَمَّا فِعْلَةٌ بِالْكَسْرِ فَبَابُهَا فِعَلٌ فِي الْكَثِيرِ نَحْوُ سِدَرٍ وَجِز"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_78", "reason": "high_symbol_ratio:0.421", "chunk_text": "====فصل==== كُلُّ اسْمٍ ثُلَاثِيٍّ عَلَى فُعْلٍ بِضَمِّ الْفَاءِ وَسُكُونِ الْعَيْنِ فَبَنُو أَسَدٍ "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_79", "reason": "high_symbol_ratio:0.420", "chunk_text": "بِضَمَّتَيْنِ جَمْعُ جَدِيدٍ وَمَنَعَهُ الْأَكْثَرُونَ لِأَنَّ الِانْتِقَالَ مِنْ حَرَكَةٍ إلَى حَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_80", "reason": "high_symbol_ratio:0.412", "chunk_text": "====فصل==== يَجِيءُ اسْمُ الْمَفْعُولِ بِمَعْنَى الْمَصْدَرِ نَحْوُ الْمُشْتَرِي وَالْمَعْقُولِ وَال"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_81", "reason": "high_symbol_ratio:0.408", "chunk_text": "لَمْ يَكُنْ لَهُ اسْمُ مَفْعُولٍ بِأَنْ كَانَ لَازِمًا جُعِلَ كَأَنَّهُ مُتَعَدٍّ وَبُنِيَ مِنْهُ اس"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_82", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَالَ ابْنُ بَابْشَاذْ كُلُّ فِعْلٍ أَشْكَلَ عَلَيْكَ مَصْدَرُهُ فَابْنِ الْمِفْعَلَ مِنْهُ بِفَتْ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_83", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي التَّنْزِيلِ { وَلَقَدْ جَاءَهُمْ مِنَ الْأَنْبَاءِ مَا فِيهِ مُزْدَجَرٌ } أَيْ: ازْدِجَارٌ { "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_84", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ الشَّاعِرُ: أَلَمْ تَعْلَمْ مُسَرَّحِي الْقَوَافِي أَيْ تَسْرِيحِي، وَقَالَ زُهَيْرٌ: وَذُبْ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_86", "reason": "high_symbol_ratio:0.413", "chunk_text": "====فصل==== يَجِيءُ فَعِيلٌ بِكَسْرِ الْفَاءِ وَالْعَيْنِ وَهِيَ مُشَدَّدَةٌ لِلْمُبَالَغَةِ فِي الص"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_87", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَصِهْرِيجٌ. ====فصل==== الْفُعُولُ بِضَمِّ الْفَاءِ مِنْ أَبْنِيَةِ الْمَصَادِرِ لَا يَشْرَكُهَا فِ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_88", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَأَمَّا الْوُضُوءُ فَبِالضَّمِّ مَصْدَرٌ وَبِالْفَتْحِ مَا يَتَوَضَّأُ بِهِ وَالسُّحُورُ بِالضَّمِّ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_89", "reason": "high_symbol_ratio:0.409", "chunk_text": "====فصل==== يَجِيءُ الْمَصْدَرُ مِنْ فِعْلٍ ثُلَاثِيٍّ عَلَى تَفْعَالٍ بِفَتْحِ التَّاءِ نَحْوُ التَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_91", "reason": "high_symbol_ratio:0.422", "chunk_text": "====فصل==== إذَا كَانَ الْفِعْلُ الثُّلَاثِيُّ عَلَى فَعَلَ يَفْعِلُ وِزَانُ ضَرَبَ يَضْرِبُ وَهُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_92", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَفِي التَّنْزِيلِ { وَلَمْ يَجِدُوا عَنْهَا مَصْرِفًا } أَيْ مَوْضِعًا يَنْصَرِفُونَ إلَيْهِ وَشَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_94", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَإِنْ كَانَ مِنْ ذَوَاتِ التَّضْعِيفِ فَالْمَصْدَرُ بِالْفَتْحِ وَالْكَسْرِ مَعًا نَحْوُ فَرَّ مَفَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_97", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَالَ ابْنُ الْقُوطِيَّةِ أَيْضًا وَمِنَ الْعُلَمَاءِ مَنْ يُجِيزُ الْفَتْحَ وَالْكَسْرَ فِيهِمَا "}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_98", "reason": "high_symbol_ratio:0.403", "chunk_text": "بِالْفَتْحِ أَيْضًا وَمِنْهُمْ مَنْ يَقُولُ وَشَذَّ مَأْقِي الْعَيْنِ بِالْكَسْرِ قَالَ ابْنُ الْقَط"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_99", "reason": "high_symbol_ratio:0.403", "chunk_text": "مَقْعَدًا أَيْ قُعُودًا وَهَذَا مَقْعَدُهُ وَغَزَا مَغْزًى وَهَذَا مَغْزَاهُ، وَقَالَ مَقَالًا وَهَذ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_100", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ ابْنُ السِّكِّيتِ وَسَمِعَ الْفَرَّاءُ \" مَوْضِعٌ \" بِالْفَتْحِ مِنْ قَوْلِكَ وَضَعْتُ الشَّيْ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_101", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ الْفَارَابِيُّ: الْكَسْرُ عَلَى غَيْرِ قِيَاسٍ مَسْمُوعٌ لِأَنَّهَا كَانَتْ فِي الْأَصْلِ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:41123:108412#chunk_102", "reason": "high_symbol_ratio:0.409", "chunk_text": "اللُّغَتَيْنِ لِأَنَّ فِي مُضَارِعِ كُلِّ وَاحِدٍ الضَّمَّ وَالْكَسْرَ. وَإِنْ كَانَ عَلَى فَعِلَ بِ"}
