{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1239", "reason": "high_symbol_ratio:0.411", "chunk_text": "الْعَسْكَرِ، وَحَيْثُ تُوجِبُ الْعَادَةُ نَقْلَ الْحَاضِرِينَ لِمَا عَايَنُوهُ ثُمَّ لَا يَنْقُلُ ذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1240", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَإِقْرَارُ الْكَذِبِ، وَالسُّكُوتُ عَلَى رَدِّهِ أَعْظَمُ امْتِنَاعًا فِي الْعَادَةِ مِنَ الْكِتْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1241", "reason": "high_symbol_ratio:0.420", "chunk_text": "هَذَا أَعْظَمُ مِنْ تُوَفُّرِهَا عَلَى إِخْبَارِهِمْ بِمَا وَقَعَ ابْتِدَاءً، فَإِذَا كَانَتْ مِنَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1242", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَالْوَجَلِ، وَبَيْنَ صُفْرَتِهِ مِنَ الْحُزْنِ، وَالْخَوْفِ، وَبَيْنَ صُفْرَتِهِ مِنَ الْمَرَضِ، فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1243", "reason": "high_symbol_ratio:0.438", "chunk_text": "كَمَا قِيلَ: تُحَدِّثُنِي الْعَيْنَانِ مَا الْقَلْبُ كَاتِمٌ...."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1244", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْعَيْنُ تَعْرِفُ مِنْ عَيْنَيْ مُحَدِّثِهَا إِنْ كَانَ مِنْ حِزْبِهَا أَوْ مِنْ أَعَادِيهَا وَكَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1245", "reason": "high_symbol_ratio:0.418", "chunk_text": "يَقُولُ بِلِسَانِهِ مَا لَيْسَ فِي قَلْبِهِ، فَبَيَّنَ أَنَّهُ فِي لَحْنِ قَوْلِهِ يُعْلَمُ أَنَّهُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1246", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَدْ رُوِيَ عَنْ عُثْمَانَ بْنِ عَفَّانَ رَضِيَ اللَّهُ عَنْهُ \" مَا أَسَرَّ أَحَدٌ سَرِيرَةً إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1247", "reason": "high_symbol_ratio:0.415", "chunk_text": "مُضْغَةً إِذَا صَلَحَتْ صَلَحَ لَهَا سَائِرُ الْجَسَدِ، وَإِذَا فَسَدَتْ فَسَدَ لَهَا سَائِرُ الْجَس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1248", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَكَمَا قَالَ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ لِمَنْ رَآهُ يَعْبَثُ فِي الصَّلَاةِ: \" "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1249", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَمِنْ هَذَا الْبَابِ قَوْلُهُ تَعَالَى: لَا تَجِدُ قَوْمًا يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1250", "reason": "high_symbol_ratio:0.438", "chunk_text": "بِالزِّنَا: \" إِنِّي أُرَاهَا تَسْتَهِلُّ بِهِ اسْتِهْلَالَ مَنْ لَا يَعْرِفُ أَنَّهُ حَرَامٌ \" فَإِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1251", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالرَّجُلُ الصَّادِقُ الْبَارُّ يَظْهَرُ عَلَى وَجْهِهِ مِنْ نُورِ صِدْقِهِ، وَبَهْجَةِ وَجْهِهِ سِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1252", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَدْ رُوِيَ عَنِ ابْنِ عَبَّاسٍ أَنَّهُ قَالَ: إِنَّ لِلْحَسَنَةِ لَنُورًا فِي الْقَلْبِ، وَضِيَاء"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1253", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَدْ يَكُونُ الرَّجُلُ مِمَّنْ لَا يَتَعَمَّدُ الْكَذِبَ لَكِنْ يَعْتَقِدُ اعْتِقَادَاتٍ بَاطِلَةً"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1254", "reason": "high_symbol_ratio:0.413", "chunk_text": "تَظْهَرُ يَوْمَ الْقِيَامَةِ ظُهُورًا تَامًّا."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1255", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ تَعَالَى: وَيَوْمَ الْقِيَامَةِ تَرَى الَّذِينَ كَذَبُوا عَلَى اللَّهِ وُجُوهُهُمْ مُسْوَدَّةٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1256", "reason": "high_symbol_ratio:0.442", "chunk_text": "وُجُوهُ أَهْلِ السُّنَّةِ وَالْجَمَاعَةِ، وَتَسْوَدُّ وُجُوهُ أَهْلِ الْبِدْعَةِ وَالْفُرْقَةِ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1257", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالْمَقْصُودُ أَنَّ مَا فِي الْقُلُوبِ مِنْ قَصْدِ الصِّدْقِ وَالْمَحَبَّةِ وَالْبِرِّ وَنَحْوِ ذَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1258", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَرُبَّمَا غَلِطَ، لَكِنَّ الْعَادَةَ الْغَالِبَةَ أَنَّهُ يَتَبَيَّنُ ذَلِكَ بَعْدُ لِعَامَّةِ النَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1260", "reason": "high_symbol_ratio:0.449", "chunk_text": "قَالَ: فَلَسْتَ تَعْرِفُهُ وَرُوِيَ أَنَّهُ قَالَ: لَعَلَّكَ رَأَيْتَهُ يَرْكَعُ رَكَعَاتٍ فِي الْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1261", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَذَلِكَ أَنَّ الْمُنَافِقَ قَدْ يُظْهِرُ الصَّلَاةَ فَمَنْ لَمْ يَخْبُرْهُ لَا يَعْرِفُ بَاطِنَ أَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1262", "reason": "high_symbol_ratio:0.420", "chunk_text": "فِي قُلُوبِ الْعِبَادِ فَوَجَدَ قَلْبَ مُحَمَّدٍ خَيْرَ قُلُوبِ الْعِبَادِ فَاصْطَفَاهُ لِرِسَالَتِه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1263", "reason": "high_symbol_ratio:0.437", "chunk_text": "أُولَئِكَ أَصْحَابُ مُحَمَّدٍ أَبَرُّ هَذِهِ الْأُمَّةِ قُلُوبًا، وَأَعْمَقُهَا عِلْمًا، وَأَقَلُّهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1264", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَإِذَا كَانَ مِنْ أَعْظَمِ بَلْ أَعْظَمَ أَهْلِ زَمَانِهِ صِدْقًا وَبِرًّا فَإِنَّهُ لَا بُدَّ أَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1265", "reason": "high_symbol_ratio:0.421", "chunk_text": "إِخْبَارِهِ مِنْ كَيْفِيَّتِهِ وَحَالِهِ مَا يُعْلَمُ بِهِ أَنَّهُ صَادِقٌ أَوْ كَاذِبٌ، وَإِنْ كَان"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1266", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَمِمَّا يَنْبَغِي أَنْ يُعْلَمَ أَنَّ النَّاسَ تَخْتَلِفُ أَحْوَالُهُمْ فِي الْمَعْرِفَةِ، وَالْخِب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1267", "reason": "high_symbol_ratio:0.426", "chunk_text": "الصَّادِقِ، وَكَذِبِ الْكَاذِبِ كَغَيْرِهِمَا مِنَ الْمَعْلُومَاتِ قَدْ يَكُونُ ضَرُورِيًّا، وَقَدْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1268", "reason": "high_symbol_ratio:0.424", "chunk_text": "بُدَّ مِنْ مَعْرِفَةِ الْقَلْبِ بِهِ، وَالنَّاسُ مُتَفَاوِتُونَ فِي ذَلِكَ، وَالدَّلِيلُ أَبَدًا هُو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1269", "reason": "high_symbol_ratio:0.423", "chunk_text": "كُلِّيَّةٍ، وَالْمُعَيَّنَاتُ قَدْ لَا يَحْتَاجُ فِيهَا إِلَى ذَلِكَ، وَإِنْ كَانَ لَا بُدَّ فِيهَا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1270", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَإِذَا كَانَ الْقَائِلُ: إِنِّي رَسُولُ اللَّهِ، إِمَّا أَنْ يَكُونَ مِنْ خِيَارِ النَّاسِ، وَأَصْد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1271", "reason": "high_symbol_ratio:0.429", "chunk_text": "الْكَذِبِ وَسَوَادِهِ وَقُبْحِهِ. يَتَبَيَّنُ بِذَلِكَ أَنَّ كَثِيرًا مِنَ النَّاسِ يَحْصُلُ لَهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1272", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَقَوْلُ بَعْضِ الْمُتَكَلِّمِينَ: مَا لَمْ يَكُنْ خَارِقًا لِلْعَادَةِ، لَا اخْتِصَاصَ لِلنَّبِيِّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1273", "reason": "high_symbol_ratio:0.428", "chunk_text": "فَيُقَالُ لَهُ: لَفْظُ خَرْقِ الْعَادَةِ لَفْظٌ مُجْمَلٌ، وَإِنَّ تَعَيُّنَ دَعْوَى النُّبُوَّةِ صِد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1274", "reason": "high_symbol_ratio:0.436", "chunk_text": "مَجْمُوعُهَا هُوَ الْمُخْتَصُّ بِالنَّبِيِّ، وَإِلَّا فَهُمْ يَقُولُونَ: إِنَّ مَا كَانَ مُعْجِزَةً "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1275", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَمِنْهُمْ مَنْ يُنْكِرُ خَرْقَ الْعَادَةِ أَنْ يَظْهَرَ عَلَى يَدِ غَيْرِ نَبِيٍّ، وَمِنْهُمْ مَنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1276", "reason": "high_symbol_ratio:0.431", "chunk_text": "مِنَ الْأَحْلَامِ وَالتَّخَيُّلِ، وَمَا يُصِيبُ أَهْلَ الْمَرَّةِ السَّوْدَاءِ مِمَّا يُشْبِهُ ذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1277", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَهَذَا هُوَ الْمَوْجُودُ فِي عَامَّةِ أَتْبَاعِ أَرِسْطُو، وَلَكِنْ مُتَأَخِّرُوهُمْ كَابْنِ سِينَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1278", "reason": "high_symbol_ratio:0.419", "chunk_text": "النُّبُوَّةِ مَشْهُورًا فِيهِمْ، وَقَدْ جَعَلَ اللَّهُ تَعَالَى مِنْ زَمَنِ الْخَلِيلِ فِي ذُرِّيَّت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1279", "reason": "high_symbol_ratio:0.413", "chunk_text": "هَؤُلَاءِ مَنْ قَالَ بِقَدَمِ الْعَالَمِ، بِخِلَافِ أَرِسْطُو قَالُوا: فَإِنَّهُ لَمْ يَقْدِمِ الشَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1280", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَذَكَرَ هَؤُلَاءِ كَمُحَمَّدِ بْنِ يُوسُفَ الْعَامِرِيِّ، وَغَيْرِهِ أَنَّ أَوَّلَ مَنْ لُقِّبَ بِا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1281", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَلِهَذَا لَمَّا اخْتَلَفَ قَوْلُ طَائِفَةٍ مِنْهُمْ كَأَبِي الْحَسَنِ وَأَتْبَاعِهِ: هَلْ يَجُوزُ ظ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1282", "reason": "high_symbol_ratio:0.421", "chunk_text": "ثُمَّ قِيلَ: لِأَنَّهُ يَسْتَلْزِمُ عَجْزَهُ عَنْ تَصْدِيقِ الرَّسُولِ إِذْ لَا طَرِيقَ إِلَيْهِ إِل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1283", "reason": "high_symbol_ratio:0.421", "chunk_text": "عَادِيًّا، وَإِمَّا أَنْ يَكُونَ لِاسْتِلْزَامِهِ الْعَجْزَ عَنْ تَصْدِيقِ النَّبِيِّ، وَذَلِكَ مُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1284", "reason": "high_symbol_ratio:0.423", "chunk_text": "الَّذِي ضَرَبْتُهُ فِي إِرْسَالِ الْمَلِكِ رَسُولًا، وَقَوْلِ رَسُولِهِ: إِنْ كُنْتَ صَادِقًا فَغَيِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1285", "reason": "high_symbol_ratio:0.448", "chunk_text": "وَقِيلَ لَكَ: الْمَلِكُ تُعْلَمُ عَادَتُهُ، وَيُعْلَمُ أَنَّهُ فَعَلَ ذَلِكَ لِلتَّصْدِيقِ، وَالرَّب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1286", "reason": "high_symbol_ratio:0.431", "chunk_text": "فَقُلْتَ: بَلْ يَخْلُقُ شَيْئًا مُقَارِنًا لِشَيْءٍ كَالْعَادِيَّاتِ، وَهَذَا مِنْهَا. فَقِيلَ لَكَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1287", "reason": "high_symbol_ratio:0.428", "chunk_text": "فَقُلْتَ: قَدْ نَعْلَمُ ذَلِكَ بِلَا تَكَرُّرٍ، وَجَعَلْتَ ذَلِكَ مِنْ بَابِ الدَّلَالَةِ الْوَضْعِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1288", "reason": "high_symbol_ratio:0.427", "chunk_text": "لِأَجْلِ شَيْءٍ تَنَاقُضًا. فَقُلْتَ: لَا يُشْتَرَطُ فِي الْعِلْمِ الضَّرُورِيِّ الْعِلْمُ بِأَنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1289", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَقِيلَ لَكَ: هَبْ أَنَّهُ كَذَلِكَ لَكِنْ لَا يَحْصُلُ الْعِلْمُ الضَّرُورِيُّ مَعَ الْعِلْمِ بِمَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1290", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْمَقْصُودُ أَنَّ مَا يَذْكُرُهُ هَؤُلَاءِ وَأَمْثَالُهُمْ مِنَ النُّظَّارِ، بَلْ وَعَامَّةُ النَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1291", "reason": "high_symbol_ratio:0.422", "chunk_text": "بِمَا لَمْ يُحِيطُوا بِعِلْمِهِ وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1292", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَلِهَذَا تَجِدُ مَنْ سَلَكَ طَرِيقًا مِنَ الطُّرُقِ إِمَّا فِي إِثْبَاتِ الْعِلْمِ بِالصَّانِعِ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1293", "reason": "high_symbol_ratio:0.417", "chunk_text": "يُثْبِتُونَهُ. وَلِهَذَا الَّذِينَ اتَّفَقُوا عَلَى أَنَّهُ لَا طَرِيقَ إِلَّا الْمُعْجِزَاتُ تَنَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1294", "reason": "high_symbol_ratio:0.422", "chunk_text": "قِيلَ لَهُمُ: الدَّلِيلُ هُوَ الَّذِي يَكُونُ مُسْتَلْزِمًا لِلْمَدْلُولِ يَلْزَمُ مِنْ تَحَقُّقِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1296", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَمَّا مَا لَا يُوجَدُ إِلَّا وُجِدَتِ النُّبُوَّةُ فَهُوَ دَلِيلٌ، فَقَدْ تَبَيَّنَ أَنَّ كُلَّ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1297", "reason": "high_symbol_ratio:0.412", "chunk_text": "مُسْتَلْزِمًا لَهَا إِلَّا خَارِقٌ لِلْعَادَةِ. فَقَوْلُ الْقَائِلِ: لَا يُعْلَمُ صِدْقُهُ إِلَّا بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1298", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَأَمَّا مَا يُوجَدُ بِدُونِهَا كَمَا يُوجَدُ مَعَهَا كَالْأُمُورِ الَّتِي تَكُونُ لِلصَّادِقِ فِي د"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1299", "reason": "high_symbol_ratio:0.421", "chunk_text": "بَلِ الْكَاذِبُ لَا يَكُونُ لَهُ مِنَ الْأَدِلَّةِ إِلَّا مَا يَسْتَلْزِمُ كَذِبَهُ فَكُلُّ مَا يَدُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1300", "reason": "high_symbol_ratio:0.429", "chunk_text": "رَأَوُا الْكَاذِبَ، وَسَمِعُوا كَلَامَهُ، تَبَيَّنَ لَهُمْ كَذِبُهُ تَارَةً بِعِلْمٍ ضَرُورِيٍّ، وَت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1301", "reason": "high_symbol_ratio:0.424", "chunk_text": "يَصِيرَ يَقِينًا. وَهَذَا الطَّرِيقُ سَلَكَهَا طَوَائِفُ مِنَ النَّاسِ، وَمِمَّنْ نَبَّهَ عَلَى ذَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1302", "reason": "high_symbol_ratio:0.434", "chunk_text": "فَرُوِّينَا عَنِ التِّرْمِذِيِّ، وَابْنِ قَانِعٍ، وَغَيْرِهِمَا بِأَسَانِيدِهِمْ أَنَّ عَبْدَ اللَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1303", "reason": "high_symbol_ratio:0.423", "chunk_text": "رَوَاهُ غَيْرُ وَاحِدٍ كَعَبْدِ الْوَهَّابِ الثَّقَفِيِّ، وَمُحَمَّدِ بْنِ جَعْفَرٍ، وَابْنِ أَبِي ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1304", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَعَنْ أَبِي رَمْثَةَ الْبَلَوِيِّ قَالَ: أَتَيْتُ النَّبِيَّ وَمَعِي لِيَ ابْنٌ لِي فَأَرَيْتُهُ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1305", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَرَوَى مُسْلِمٌ فِي صَحِيحِهِ، وَغَيْرُهُ عَنِ ابْنِ عَبَّاسٍ أَنَّ ضِمَادًا قَدِمَ مَكَّةَ، وَكَان"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1306", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَقَالَ: لَوْ أَنِّي رَأَيْتُ هَذَا الرَّجُلَ لَعَلَّ اللَّهَ يَشْفِيهِ عَلَى يَدَيَّ. قَالَ: فَلَقِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1307", "reason": "high_symbol_ratio:0.437", "chunk_text": "فَقَالَ: أَعِدْ عَلَيَّ كَلِمَاتِكَ هَؤُلَاءِ. فَأَعَادَهُنَّ رَسُولُ اللَّهِ ثَلَاثَ مَرَّاتٍ. قَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1308", "reason": "high_symbol_ratio:0.430", "chunk_text": "هَاتِ يَدَكَ أُبَايِعْكَ عَلَى الْإِسْلَامِ. فَبَايَعَهُ فَقَالَ رَسُولُ اللَّهِ : وَعَلَى قَوْمِكَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1309", "reason": "high_symbol_ratio:0.421", "chunk_text": "الْحَدِيثَ. وَقَالَ جَامِعُ بْنُ شَدَّادٍ: كَانَ مِنَّا رَجُلٌ يُقَالُ لَهُ طَارِقٌ فَأَخْبَرَ أَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1310", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَأَخَذَ بِخِطَامِهِ وَسَارَ إِلَى الْمَدِينَةِ فَقُلْنَا: بِعْنَا رَجُلًا لَا نَدْرِي مَنْ هُوَ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1311", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَأَصْبَحْنَا فَجَاءَ رَجُلٌ بِتَمْرٍ فَقَالَ: أَنَا رَسُولُ رَسُولِ اللَّهِ إِلَيْكُمْ يَأْمُرُكُمْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1312", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَفِي خَبَرِ الْجَلَنْدِيِّ مَلِكِ غَسَّانَ لَمَّا بَلَغَهُ رَسُولُ رَسُولِ اللَّهِ يَدْعُوهُ إِلَى "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1313", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَقَالَ نِفْطَوَيْهِ فِي قَوْلِهِ تَعَالَى: يَكَادُ زَيْتُهَا يُضِيءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌ؛ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1314", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْقُرْآنَ الَّذِي هُوَ نَفْسُهُ آيَةٌ مُسْتَلْزِمَةٌ لِصِدْقِهِ، وَنَفْسُ كَلَامِهِ وَإِخْبَارُهُ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1315", "reason": "high_symbol_ratio:0.429", "chunk_text": "بَلْ خَدِيجَةُ قَالَتْ لَهُ: كَلَّا، وَاللَّهِ لَا يُخْزِيكَ اللَّهُ أَبَدًا، إِنَّكَ لَتَصِلُ الرَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1316", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَأَبُو بَكْرٍ كَانَ مِنْ أَعْقَلِ النَّاسِ وَأَخْيَرِهِمْ، وَكَانَ مُعَظَّمًا فِي قُرَيْشٍ لِعِلْمِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1317", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَكَذَلِكَ هِرَقْلُ مَلِكُ النَّصَارَى لَمَّا أَرْسَلَ إِلَيْهِ النَّبِيُّ يَدْعُوهُ إِلَى الْإِسْلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1318", "reason": "high_symbol_ratio:0.425", "chunk_text": "هَلْ هُنَا أَحَدٌ مِنْ قَوْمِ هَذَا الرَّجُلِ الَّذِي يَزْعُمُ أَنَّهُ نَبِيٌّ؟ قَالُوا: نَعَمْ قَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1319", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَأَجْلَسُونِي بَيْنَ يَدَيْهِ، وَأَجْلَسُوا أَصْحَابِي خَلْفِي فَدَعَا بِتُرْجُمَانِهِ فَقَالَ: قُل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1320", "reason": "high_symbol_ratio:0.429", "chunk_text": "قَالَ: فَقَالَ أَبُو سُفْيَانَ: وَأَيْمِ اللَّهِ لَوْلَا مَخَافَةُ أَنْ يُؤْثَرَ عَلَيَّ الْكَذِبُ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1321", "reason": "high_symbol_ratio:0.429", "chunk_text": "ثُمَّ قَالَ لِتُرْجُمَانِهِ: سَلْهُ كَيْفَ حَسَبُهُ فِيكُمْ؟ قَالَ: قُلْتُ: هُوَ فِينَا ذُو حَسَبٍ. "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1322", "reason": "high_symbol_ratio:0.435", "chunk_text": "قَالَ: فَهَلْ كُنْتُمْ تَتَّهِمُونَهُ بِالْكَذِبِ قَبْلَ أَنْ يَقُولَ مَا قَالَ؟ قُلْتُ: لَا. قَالَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1323", "reason": "high_symbol_ratio:0.431", "chunk_text": "قَالَ: أَيَزِيدُونَ أَمْ يَنْقُصُونَ؟ قُلْتُ: لَا بَلْ يَزِيدُونَ قَالَ: فَهَلْ يَرْتَدُّ أَحَدٌ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1324", "reason": "high_symbol_ratio:0.417", "chunk_text": "قَالَ: فَهَلْ يَغْدِرُ؟ قُلْتُ: لَا، وَنَحْنُ مِنْهُ عَلَى مُدَّةٍ مَا نَدْرِي مَا هُوَ صَانِعٌ فِيه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1325", "reason": "high_symbol_ratio:0.428", "chunk_text": "قَالَ: فَوَاللَّهِ مَا أَمْكَنَنِي مِنْ كَلِمَةٍ أُدْخِلُ فِيهَا شَيْئًا غَيْرَ هَذِهِ قَالَ: فَهَلْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1326", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَهُمْ أَتْبَاعُ الرُّسُلِ، وَسَأَلْتُكَ: هَلْ كُنْتُمْ تَتَّهِمُونَهُ بِالْكَذِبِ قَبْلَ أَنْ يَقُو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1327", "reason": "high_symbol_ratio:0.434", "chunk_text": "قَاتَلْتُمُوهُ؟ فَزَعَمْتَ أَنَّكُمْ قَاتَلْتُمُوهُ فَيَكُونُ الْحَرْبُ بَيْنَكُمْ وَبَيْنَهُ سِجَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1328", "reason": "high_symbol_ratio:0.450", "chunk_text": "ثُمَّ قَالَ: بِمَ يَأْمُرُكُمْ؟ قُلْتُ: يَأْمُرُنَا بِالصَّلَاةِ، وَالزَّكَاةِ، وَالصِّلَةِ، وَالْعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1329", "reason": "high_symbol_ratio:0.419", "chunk_text": "ثُمَّ دَعَا بِكِتَابِ رَسُولِ اللَّهِ فَقَرَأَهُ فَإِذَا فِيهِ: \" بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1330", "reason": "high_symbol_ratio:0.418", "chunk_text": "أَرْبَابًا مِنْ دُونِ اللَّهِ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ } وَفِي رِو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1331", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمَا اسْتَدَلَّ بِهِ مَلِكُ النَّصَارَى هِرَقْلُ مِنَ الْعِلْمِ بِصِفَاتِهِ هُوَ اسْتِدْلَالٌ عَلَى"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1333", "reason": "high_symbol_ratio:0.430", "chunk_text": "ثُمَّ قَالَ: وَهَذَا كِتَابٌ أَنْزَلْنَاهُ مُبَارَكٌ مُصَدِّقُ الَّذِي بَيْنَ يَدَيْهِ؛ لَمَّا قَامَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1334", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَمِنَ النَّاسِ مَنْ يُقِرُّ بِالرُّسُلِ فِي الْجُمْلَةِ لَكِنْ لَا يُؤْمِنُ بِمَا يَجِبُ مِنْ حَقِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1336", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَتَوْفِيقًا * أُولَئِكَ الَّذِينَ يَعْلَمُ اللَّهُ مَا فِي قُلُوبِهِمْ فَأَعْرِضْ عَنْهُمْ وَعِظْهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1337", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَلِيَقْتَرِفُوا مَا هُمْ مُقْتَرِفُونَ * أَفَغَيْرَ اللَّهِ أَبْتَغِي حَكَمًا وَهُوَ الَّذِي أَنْزَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1338", "reason": "high_symbol_ratio:0.409", "chunk_text": "الرُّسُلُ هُمْ ثَلَاثَةُ أَصْنَافٍ: أَهْلُ التَّخْيِيلِ مِنَ الْمَلَاحِدَةِ الْمُتَفَلْسِفَةِ وَالْب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1339", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَأَهْلُ التَّحْرِيفِ وَالتَّأْوِيلِ: الَّذِينَ يُؤَوِّلُونَ كَلَامَهُمْ عَلَى مَا يُخَالِفُ مُرَادَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1340", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَهْلُ التَّجْهِيلِ: الَّذِينَ يَقُولُونَ ذَلِكَ الْكَلَامَ لَيْسَ لَهُ مَعْنًى يَعْلَمُهُ الرَّسُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1341", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَأَمَّا مَنْ قَالَ: إِنَّ الرُّسُلَ وَغَيْرَهُمْ يَعْلَمُونَ الْمَعْنَى الَّذِي بَيَّنَهُ اللَّهُ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1342", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَالْمَقْصُودُ هُنَا أَنَّ الْكَلَامَ فِي النُّبُوَّاتِ تَارَةً فِي جِنْسِهَا، وَتَارَةً فِي شَخْصِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1343", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالَّذِينَ يَحْتَاجُونَ إِلَى مَعْرِفَةِ النَّبِيِّ الْمُعَيَّنِ نَوْعَانِ: نَوْعٌ عَرَفُوا أَنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1344", "reason": "high_symbol_ratio:0.418", "chunk_text": "نَبِيًّا سَيُبْعَثُ، وَمَنْ كَانَ يَعْلَمُ جِنْسَ الرُّسُلِ، وَلَا يَدْرِي هَلْ يُبْعَثُ نَبِيٌّ أَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1345", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَهَذَا مِمَّا لَا يُمْكِنُ اخْتِلَافُ الْأَنْبِيَاءِ فِيهِ، إِذْ كَانَ كُلُّ مَا يُخْبِرُ بِهِ النَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1346", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَمَا أَخْبَرَ بِهِ مُحَمَّدٌ هُوَ أَكْمَلُ وَأَكْثَرُ مِمَّا أَخْبَرَ بِهِ مُوسَى، وَالْمَسِيحُ صَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1347", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَقَدْ يَظُنُّ بَعْضُ الْغَالِطِينَ تَنَاقُضَ بَعْضِ أَخْبَارِ الْأَنْبِيَاءِ كَمَا يَظُنُّ بَعْضُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1348", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالصِّدْقِ، وَالْعَدْلِ، وَتَحْرِيمِ الْأَجْنَاسِ الْأَرْبَعَةِ، وَهِيَ الْفَوَاحِشُ مَا ظَهَرَ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1349", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَقَدْ تَنَازَعَ النَّاسُ فِي مِثْلِ هَذَا: هَلْ يُمْكِنُ نَسْخُهُ وَتَنَوُّعُ الشَّرَائِعِ بِهِ؟ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1351", "reason": "high_symbol_ratio:0.403", "chunk_text": "تَتَفَرَّقُوا فِيهِ كَبُرَ عَلَى الْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ وَقَالَ تَعَالَى: فَأَقِمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1352", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَهَذَا مَبْسُوطٌ فِي مَوْضِعٍ آخَرَ."}
{"source": "wikisource", "raw_id": "arwikisource:23932:75049#chunk_39", "reason": "high_symbol_ratio:0.408", "chunk_text": "وقال تعالى: { وَيُعَلِّمُهُ الْكِتَابَ وَالْحِكْمَةَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ * وَرَسُولا إِلَى"}
{"source": "wikisource", "raw_id": "arwikisource:23932:75049#chunk_40", "reason": "high_symbol_ratio:0.406", "chunk_text": "عَلَيْكُمْ وَجِئْتُكُمْ بِآيَةٍ مِنْ رَبِّكُمْ فَاتَّقُوا اللَّهَ وَأَطِيعُونِ * إِنَّ اللَّهَ رَبِّ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_23", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَدْ سَرَدَهَا مُفَصَّلَة ثُمَّ قَالَ : فَسُبْحَانَ الَّذِي دَقَّتْ فِي كُلّ شَيْء حِكْمَته ."}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_43", "reason": "high_symbol_ratio:0.412", "chunk_text": "== إِنَّ فِرْعَوْنَ عَلَا فِي الْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَعًا يَسْتَضْعِفُ طَائِفَةً مِنْهُمْ ي"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_68", "reason": "high_symbol_ratio:0.408", "chunk_text": "== وَقَالَتْ لِأُخْتِهِ قُصِّيهِ فَبَصُرَتْ بِهِ عَنْ جُنُبٍ وَهُمْ لَا يَشْعُرُونَ (11) == وَقَالَت"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_70", "reason": "high_symbol_ratio:0.401", "chunk_text": "== وَحَرَّمْنَا عَلَيْهِ الْمَرَاضِعَ مِنْ قَبْلُ فَقَالَتْ هَلْ أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَك"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_74", "reason": "high_symbol_ratio:0.420", "chunk_text": "== فَرَدَدْنَاهُ إِلَى أُمِّهِ كَيْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ وَلِتَعْلَمَ أَنَّ وَعْدَ اللَّ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_79", "reason": "high_symbol_ratio:0.408", "chunk_text": "== وَدَخَلَ الْمَدِينَةَ عَلَى حِينِ غَفْلَةٍ مِنْ أَهْلِهَا فَوَجَدَ فِيهَا رَجُلَيْنِ يَقْتَتِلَان"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_89", "reason": "high_symbol_ratio:0.405", "chunk_text": "== فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ فَإِذَا الَّذِي اسْتَنْصَرَهُ بِالْأَمْسِ يَسْتَ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_104", "reason": "high_symbol_ratio:0.400", "chunk_text": "== فَجَاءَتْهُ إِحْدَاهُمَا تَمْشِي عَلَى اسْتِحْيَاءٍ قَالَتْ إِنَّ أَبِي يَدْعُوكَ لِيَجْزِيَكَ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_116", "reason": "high_symbol_ratio:0.406", "chunk_text": "== قَالَ إِنِّي أُرِيدُ أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ عَلَى أَنْ تَأْجُرَنِي ثَمَانِي"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_131", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَقَالَ الرَّبّ عَزَّ وَجَلَّ قَضَى أَبَرّهمَا وَأَبْقَاهُمَا أَوْ قَالَ أَزْكَاهُمَا ."}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_152", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَعِنْد ذَلِكَ \" وَلَّى مُدْبِرًا وَلَمْ يُعَقِّب\" أَيْ وَلَمْ يَكُنْ يَلْتَفِت لِأَنَّ طَبْع الْبَش"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_158", "reason": "high_symbol_ratio:0.405", "chunk_text": "== قَالَ رَبِّ إِنِّي قَتَلْتُ مِنْهُمْ نَفْسًا فَأَخَافُ أَنْ يَقْتُلُونِ (33) == قَالَ رَبِّ إِنِّ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_161", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْوَاحِد وَلِهَذَا قَالَ : \" إِنِّي أَخَاف أَنْ يُكَذِّبُونِ \" وَقَالَ مُحَمَّد بْن إِسْحَاق\" رِدْء"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_170", "reason": "high_symbol_ratio:0.500", "chunk_text": "بِاَللَّهِ عَزَّ وَجَلَّ ."}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_175", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَنَّهُ كَذَّبَهُ فِي أَنَّ اللَّه تَعَالَى أَرْسَلَهُ لِأَنَّهُ لَمْ يَكُنْ يَعْتَرِف بِوُجُودِ الص"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_185", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَوْله : \" بَصَائِر لِلنَّاسِ وَهُدًى وَرَحْمَة \" أَيْ مِنْ الْعَمَى وَالْغَيّ وَهُدَى إِلَى الْحَ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_195", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَرَّبْنَاهُ نَجِيًّا \" وَقَوْله تَعَالَى : \" وَلَكِنْ رَحْمَة مِنْ رَبّك \" أَيْ مَا كُنْت مُشَاهِ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_196", "reason": "high_symbol_ratio:0.405", "chunk_text": "== وَلَوْلَا أَنْ تُصِيبَهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُوا رَبَّنَا لَوْلَا أَر"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_213", "reason": "high_symbol_ratio:0.403", "chunk_text": "== قُلْ فَأْتُوا بِكِتَابٍ مِنْ عِنْدِ اللَّهِ هُوَ أَهْدَى مِنْهُمَا أَتَّبِعْهُ إِنْ كُنْتُمْ صَاد"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_214", "reason": "high_symbol_ratio:0.408", "chunk_text": "== فَإِنْ لَمْ يَسْتَجِيبُوا لَكَ فَاعْلَمْ أَنَّمَا يَتَّبِعُونَ أَهْوَاءَهُمْ وَمَنْ أَضَلُّ مِمَّ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_216", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَلَقَدْ وَصَّلْنَا لَهُمُ الْقَوْلَ لَعَلَّهُمْ يَتَذَكَّرُونَ (51) == وَلَقَدْ وَصَّلْنَا لَهُمُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_222", "reason": "high_symbol_ratio:0.401", "chunk_text": "== وَإِذَا يُتْلَى عَلَيْهِمْ قَالُوا آَمَنَّا بِهِ إِنَّهُ الْحَقُّ مِنْ رَبِّنَا إِنَّا كُنَّا مِن"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_225", "reason": "high_symbol_ratio:0.411", "chunk_text": "== أُولَئِكَ يُؤْتَوْنَ أَجْرَهُمْ مَرَّتَيْنِ بِمَا صَبَرُوا وَيَدْرَءُونَ بِالْحَسَنَةِ السَّيِّئَ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_235", "reason": "high_symbol_ratio:0.400", "chunk_text": "== إِنَّكَ لَا تَهْدِي مَنْ أَحْبَبْتَ وَلَكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ وَهُوَ أَعْلَمُ بِالْم"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_244", "reason": "high_symbol_ratio:0.411", "chunk_text": "== وَقَالُوا إِنْ نَتَّبِعِ الْهُدَى مَعَكَ نُتَخَطَّفْ مِنْ أَرْضِنَا أَوَلَمْ نُمَكِّنْ لَهُمْ حَر"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_248", "reason": "high_symbol_ratio:0.405", "chunk_text": "== وَكَمْ أَهْلَكْنَا مِنْ قَرْيَةٍ بَطِرَتْ مَعِيشَتَهَا فَتِلْكَ مَسَاكِنُهُمْ لَمْ تُسْكَنْ مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_254", "reason": "high_symbol_ratio:0.409", "chunk_text": "الزَّمَخْشَرِيّ وَابْن الْجَوْزِيّ وَغَيْرهمَا وَلَيْسَ بِبَعِيدٍ."}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_261", "reason": "high_symbol_ratio:0.415", "chunk_text": "فُرَادَى كَمَا خَلَقْنَاكُمْ أَوَّل مَرَّة وَتَرَكْتُمْ مَا خَوَّلْنَاكُمْ وَرَاء ظُهُوركُمْ وَمَا ن"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_262", "reason": "high_symbol_ratio:0.401", "chunk_text": "== قَالَ الَّذِينَ حَقَّ عَلَيْهِمُ الْقَوْلُ رَبَّنَا هَؤُلَاءِ الَّذِينَ أَغْوَيْنَا أَغْوَيْنَاهُ"}
{"source": "wikisource", "raw_id": "arwikisource:35696:287975#chunk_263", "reason": "high_symbol_ratio:0.409", "chunk_text": "يَعْبُدُونَ\" فَشَهِدُوا عَلَيْهِمْ أَنَّهُمْ أَغْوَوْهُمْ فَاتَّبَعُوهُمْ ثُمَّ تَبَرَّءُوا مِنْ عِب"}
