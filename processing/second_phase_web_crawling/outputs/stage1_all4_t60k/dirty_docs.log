{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_831", "reason": "high_symbol_ratio:0.419", "chunk_text": "الثَّانِي: تَسْمِيَتُهُمْ الرَّمْيَ سَبَبًا لِلْقَتْلِ مِنْ حَيْثُ إنَّهُ سَبَبٌ لِلْعِلَّةِ، وَهُوَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_832", "reason": "high_symbol_ratio:0.433", "chunk_text": "الثَّالِثِ: تَسْمِيَتُهُمْ ذَاتَ الْعِلَّةِ مَعَ تَخَلُّفِ وَصْفِهَا سَبَبًا، كَقَوْلِهِمْ: الْكَفَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_833", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَمِلْكُ النِّصَابِ هُوَ سَبَبُ الزَّكَاةِ دُونَ الْحَوْلِ مَعَ أَنَّهُ لَا بُدَّ مِنْهُمَا فِي الْو"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_834", "reason": "high_symbol_ratio:0.413", "chunk_text": "الرَّابِعِ: تَسْمِيَتُهُمْ الْمُوجِبَ سَبَبًا فَيَكُونُ السَّبَبُ بِمَعْنَى الْعِلَّةِ، وَهَذَا أَبْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_835", "reason": "high_symbol_ratio:0.417", "chunk_text": "[الْفَصْلُ الثَّانِي فِي وَصْفِ السَّبَبِ بِالصِّحَّةِ وَالْبُطْلَانِ وَالْفَسَادِ] ِ وَصْفُ السَّبَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_836", "reason": "high_symbol_ratio:0.405", "chunk_text": "اعْلَمْ أَنَّ هَذَا يُطْلَقُ فِي الْعِبَادَاتِ تَارَةً وَفِي الْعُقُودِ أُخْرَى، وَإِطْلَاقُهُ فِي ا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_837", "reason": "high_symbol_ratio:0.433", "chunk_text": "حَتَّى إنَّ صَلَاةَ مَنْ ظَنَّ أَنَّهُ مُتَطَهِّرٌ صَحِيحَةٌ فِي اصْطِلَاحِ الْمُتَكَلِّمِينَ؛ لِأَن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_838", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَهَذِهِ الصَّلَاةُ فَاسِدَةٌ عِنْدَ الْفُقَهَاءِ؛ لِأَنَّهَا غَيْرُ مُجْزِئَةٍ، وَكَذَلِكَ مَنْ قَط"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_839", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَأَمَّا إذَا أُطْلِقَ فِي الْعُقُودِ فَكُلُّ سَبَبٍ مَنْصُوبٍ لِحُكْمٍ إذَا أَفَادَ حُكْمَهُ الْمَق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_840", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَالْبَاطِلُ هُوَ الَّذِي لَا يُثْمِرُ؛ لِأَنَّ السَّبَبَ مَطْلُوبٌ لِثَمَرَتِهِ، وَالصَّحِيحُ هُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_841", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَالْعَقْدُ إمَّا صَحِيحٌ وَإِمَّا بَاطِلٌ وَكُلُّ بَاطِلٍ فَاسِدٌ وَأَبُو حَنِيفَةَ أَثْبَتَ قِسْمً"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_842", "reason": "high_symbol_ratio:0.417", "chunk_text": "بِأَصْلِهِ وَوَصْفِهِ جَمِيعًا بَيْنَ الْمَشْرُوعِ بِأَصْلِهِ وَوَصْفِهِ جَمِيعًا، فَلَوْ صَحَّ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_843", "reason": "high_symbol_ratio:0.417", "chunk_text": "[الْفَصْلُ الثَّالِثُ فِي وَصْفِ الْعِبَادَةِ بِالْأَدَاءِ وَالْقَضَاءِ وَالْإِعَادَةِ] وَصْفِ الْعِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_844", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَالْإِعَادَةُ اسْمٌ لِمِثْلِ مَا فُعِلَ، وَالْقَضَاءُ اسْمٌ لِفِعْلٍ مِثْلِ مَا فَاتَ وَقْتُهُ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_845", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَلَوْ أَخَّرَ وَعَاشَ قَالَ الْقَاضِي - رَحِمَهُ اللَّهُ -: مَا يَفْعَلُهُ هَذَا قَضَاءً؛ لِأَنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_846", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَهَذَا غَيْرُ مَرْضِيٍّ عِنْدَنَا، فَإِنَّهُ لَمَّا انْكَشَفَ خِلَافُ مَا ظَنَّ زَالَ حُكْمُهُ وَصَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_847", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَإِنَّمَا أَوْجَبْنَا الْبِدَارَ بِقَرِينَةِ الْحَاجَةِ، وَإِلَّا فَالْأَدَاءُ فِي جَمِيعِ الْأَوْق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_848", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَإِذًا الصَّحِيحُ أَنَّ اسْمَ الْقَضَاءِ مَخْصُوصٌ بِمَا عُيِّنَ وَقْتُهُ شَرْعًا ثُمَّ فَاتَ الْوَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_849", "reason": "high_symbol_ratio:0.425", "chunk_text": "دَقِيقَةٌ: اعْلَمْ أَنَّ الْقَضَاءَ قَدْ يُطْلَقُ مَجَازًا وَقَدْ يُطْلَقُ حَقِيقَةً فَإِنَّهُ تِلْو"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_850", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَلِلْأَدَاءِ أَرْبَعَةُ أَحْوَالٍ الْأُولَى: أَنْ يَكُونَ وَاجِبًا، فَإِذَا تَرَكَهُ الْمُكَلَّفُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_851", "reason": "high_symbol_ratio:0.414", "chunk_text": "الثَّانِيَةُ: أَنْ لَا يَجِبَ الْأَدَاءُ كَالصِّيَامِ فِي حَقِّ الْحَائِضِ فَإِنَّهُ حَرَامٌ، فَإِذَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_853", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَجَعْلُ هَذَا الِاسْمِ مَجَازًا أَوْلَى مِنْ مُخَالَفَةِ الْإِجْمَاعِ، إذْ لَا خِلَافَ أَنَّهُ لَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_854", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ قِيلَ: فَلِمَ تَنْوِي قَضَاءَ رَمَضَانَ؟ قُلْنَا: إنْ عَنَيْتَ بِذَلِكَ أَنَّهَا تَنْوِي قَضَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_856", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَلَعَلَّ سَبَبَ اخْتِصَاصِ اشْتِهَارِهِ أَنَّ الصِّبَا يَمْنَعُ أَصْلَ التَّكْلِيفِ، وَالْحَائِضُ م"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_857", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْحَالَةُ الثَّالِثَةُ: حَالَةُ الْمَرِيضِ وَالْمُسَافِرِ إذَا لَمْ يَجِبْ عَلَيْهِمَا لَكِنَّهُمَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_858", "reason": "high_symbol_ratio:0.413", "chunk_text": "إلَّا أَنَّ هَذَا الْبَدَلَ لَا يُمْكِنُ إلَّا بَعْدَ فَوَاتِ الْأَوَّلِ، وَالْأَوَّلُ سَابِقٌ بِالز"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_859", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْأَظْهَرُ أَنَّ تَسْمِيَةَ صَوْمِ الْمُسَافِرِ قَضَاءً مَجَازٌ، أَوْ الْقَضَاءُ اسْمٌ مُشْتَرَكٌ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_860", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَالنَّائِمُ وَالنَّاسِي يَقْضِيَانِ وَلَا خِطَابَ عَلَيْهِمَا؛ لِأَنَّهُمَا لَا يُكَلَّفَانِ."}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_861", "reason": "high_symbol_ratio:0.409", "chunk_text": "قُلْنَا: هُمَا مَنْسُوبَانِ إلَى الْغَفْلَةِ وَالتَّقْصِيرِ، وَلَكِنَّ اللَّهَ تَعَالَى عَفَا عَنْهُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_862", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهُوَ فَاسِدٌ؛ لِأَنَّ سِيَاقَ الْكَلَامِ يُفْهِمُنَا إضْمَارَ الْإِفْطَارِ، وَمَعْنَاهُ مَنْ كَانَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_863", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَيَعْنِي: فَضَرَبَ فَانْفَجَرَتْ؛ وَلِأَنَّ أَصْحَابَ رَسُولِ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَس"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_864", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَهُوَ فَاسِدٌ؛ لِأَنَّ الْآيَةَ لَا تُفْهِمُ إلَّا الرُّخْصَةَ فِي التَّأْخِيرِ وَتَوْسِيعَ الْوَقْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_865", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْحَالَةُ الرَّابِعَةُ: حَالُ الْمَرِيضُ، فَإِنْ كَانَ لَا يَخْشَى الْمَوْتَ مِنْ الصَّوْمِ فَهُوَ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_866", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَيُمْكِنُ أَنْ يُقَالَ: قَدْ قِيلَ لِلْمَرِيضِ كُلْ فَكَيْفَ يُقَالُ لَهُ لَا تَأْكُلْ، وَهُوَ مَعْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_867", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَيُمْكِنُ أَنْ يُجَابَ بِأَنَّهُ قِيلَ لَهُ لَا تُهْلِكْ نَفْسَكَ وَقِيلَ لَهُ صُمْ، فَلَمْ يَعْصِ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_868", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَهَذِهِ احْتِمَالَاتٌ يَتَجَاذَبُهَا الْمُجْتَهِدُونَ. فَإِنْ قُلْنَا: لَا يَنْعَقِدُ صَوْمُهُ فَتَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_869", "reason": "high_symbol_ratio:0.414", "chunk_text": "[الْفَصْلُ الرَّابِعُ فِي الْعَزِيمَةِ وَالرُّخْصَةِ] الْعَزِيمَةِ وَالرُّخْصَةِ. اعْلَمْ أَنَّ الْع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_870", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَسُمِّيَ بَعْضُ الرُّسُلِ أُولِي الْعَزْمِ لِتَأْكِيدِ قَصْدِهِمْ فِي طَلَبِ الْحَقِّ. وَالْعَزِيمَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_871", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالرُّخْصَةُ فِي اللِّسَانِ عِبَارَةٌ عَنْ الْيُسْرِ وَالسُّهُولَةِ، يُقَالُ: رَخُصَ السِّعْرُ إذَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_872", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْجُمْلَةِ فَهَذَا الِاسْمُ يُطْلَقُ حَقِيقَةً وَمَجَازًا، فَالْحَقِيقَةُ فِي الرُّتْبَةِ الْعُلْيَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_874", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَيَتَرَدَّدُ بَيْنَ هَاتَيْنِ الدَّرَجَتَيْنِ صُوَرٌ بَعْضُهَا أَقْرَبُ إلَى الْحَقِيقَةِ وَبَعْضُه"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_875", "reason": "high_symbol_ratio:0.413", "chunk_text": "أَمَّا التَّيَمُّمُ عِنْدَ عَدَمِ الْمَاءِ فَلَا يَحْسُنُ تَسْمِيَتُهُ رُخْصَةً؛ لِأَنَّهُ لَا يُمْك"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_876", "reason": "high_symbol_ratio:0.409", "chunk_text": "نَعَمْ تَجْوِيزُ ذَلِكَ عِنْدَ الْمَرَضِ أَوْ الْجِرَاحَةِ أَوْ بُعْدِ الْمَاءِ عَنْهُ أَوْ بَيْعِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_877", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ قِيلَ: إنْ كَانَ سَبَبُ وُجُوبِ الْوُضُوءِ مُنْدَفِعًا عِنْدَ فَقْدِ الْمَاءِ فَسَبَبُ تَحْرِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_878", "reason": "high_symbol_ratio:0.408", "chunk_text": "قُلْنَا الْمُحَرَّمُ فِي الْمَيْتَةِ الْخَبَثُ وَفِي الْخَمْرِ الْإِسْكَارُ وَفِي الْكُفْرِ كَوْنُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_879", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَإِنْ قِيلَ: فَالرُّخَصُ تَنْقَسِمُ إلَى مَا يُعْصَى بِتَرْكِهِ كَتَرْكِ أَكْلِ الْمَيْتَةِ وَالْإِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_880", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْعِقَابُ. فَمِنْ حَيْثُ إسْقَاطُ الْعِقَابِ عَنْ فِعْلِهِ هُوَ فُسْحَةُ رُخْصَةٍ، وَمِنْ حَيْثُ إي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_881", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَمَّا سَبَبُ الْفَرْقِ فَأُمُورٌ مَصْلَحِيَّةٌ رَآهَا الْمُجْتَهِدُونَ، وَقَدْ اخْتَلَفُوا فِيهَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_882", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَمِنْهَا السَّلَمُ، فَإِنَّهُ بَيْعُ مَا لَا يُقْدَرُ عَلَى تَسْلِيمِهِ فِي الْحَالِ فَقَدْ يُقَالُ"}
