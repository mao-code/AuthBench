{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_124", "reason": "high_symbol_ratio:0.402", "chunk_text": "فقال: {لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ وَقَالَ الْمَسِي"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_221", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْكِتَابِ وَأُخَرُ مُتَشَابِهَاتٌ فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_342", "reason": "high_symbol_ratio:0.418", "chunk_text": "بَعْضُهُمْ لِبَعْضٍ ظَهِيرًا} {قُلْ فَأْتُوا بِعَشْرِ سُوَرٍ مِثْلِهِ مُفْتَرَيَاتٍ وَادْعُوا مَنِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_434", "reason": "high_symbol_ratio:0.423", "chunk_text": "وقال: {سَيُهْزَمُ الْجَمْعُ وَيُوَلُّونَ الدُّبُرَ}. وقال: {وَلَوْ قَاتَلَكُمُ الَّذِينَ كَفَرُوا لَ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_437", "reason": "high_symbol_ratio:0.404", "chunk_text": "وقال: {لَنْ يَضُرُّوكُمْ إِلَّا أَذًى وَإِنْ يُقَاتِلُوكُمْ يُوَلُّوكُمُ الْأَدْبَارَ ثُمَّ لَا يُنْ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_596", "reason": "high_symbol_ratio:0.412", "chunk_text": "وقال تعالى: {آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ كُلٌّ آمَنَ بِال"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_626", "reason": "high_symbol_ratio:0.406", "chunk_text": "قال تعالى: {وَأَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ لَئِنْ جَاءَتْهُمْ آيَةٌ لَيُؤْمِنُنَّ بِهَا"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_630", "reason": "high_symbol_ratio:0.402", "chunk_text": "قال تعالى: {وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ فَ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_631", "reason": "high_symbol_ratio:0.402", "chunk_text": "بِأَيْدِيهِمْ لَقَالَ الَّذِينَ كَفَرُوا إِنْ هَذَا إِلَّا سِحْرٌ مُبِينٌ وَقَالُوا لَوْلَا أُنْزِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_635", "reason": "high_symbol_ratio:0.409", "chunk_text": "أَبَعَثَ اللَّهُ بَشَرًا رَسُولًا قُلْ لَوْ كَانَ فِي الْأَرْضِ مَلَائِكَةٌ يَمْشُونَ مُطْمَئِنِّينَ"}
{"source": "wikisource", "raw_id": "arwikisource:52348:130314#chunk_640", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَكُفْرِهِمْ بِآيَاتِ اللَّهِ وَقَتْلِهِمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَقَوْلِهِمْ قُلُوبُنَا غُل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_1", "reason": "high_symbol_ratio:0.421", "chunk_text": "عِلْمٍ وَعَمَلٍ بِحَسَبِهِمْ، وَيَقُومُ بِهِ مَا يَقُومُ مِنْ مَصَالِحِ دُنْيَاهُمْ، وَهَذَا مِنَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_2", "reason": "high_symbol_ratio:0.414", "chunk_text": "قَالَ تَعَالَى: سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى الَّذِي خَلَقَ فَسَوَّى وَالَّذِي قَدَّرَ فَهَدَى و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_3", "reason": "high_symbol_ratio:0.436", "chunk_text": "بَعْدَ الْمَوْتِ، إِمَّا لِلْأَرْوَاحِ فَقَطْ، وَإِمَّا لِلْأَبْدَانِ فَقَطْ، وَإِمَّا لِمَجْمُوعِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_4", "reason": "high_symbol_ratio:0.422", "chunk_text": "لَكِنَّ عَامَّةَ بَنِي آدَمَ عَلَى أَنَّ الْعَدْلَ خَيْرٌ مِنَ الظُّلْمِ، وَالصِّدْقَ خَيْرٌ مِنَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_5", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَأَمَّا الْمَعَادُ فَهُوَ إِمَّا لِلْأَرْوَاحِ أَوْ لِلْأَبْدَانِ، وَإِنَّ النَّاسَ بَعْدَ الْمَوْت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_6", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَذَلِكَ أَنَّ أَهْلَ الْأَرْضِ فِي الْمَعَادِ عَلَى أَرْبَعَةِ أَقْوَالٍ: أَحَدُهَا: وَهُوَ مَذْهَب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_7", "reason": "high_symbol_ratio:0.405", "chunk_text": "أَمْرَ الْقِيَامَتَيْنِ: الْقِيَامَةِ الصُّغْرَى بِالْمَوْتِ، وَالْقِيَامَةِ الْكُبْرَى حِينَ يَقُوم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_8", "reason": "high_symbol_ratio:0.425", "chunk_text": "السَّابِقُونَ أُولَئِكَ الْمُقَرَّبُونَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_9", "reason": "high_symbol_ratio:0.405", "chunk_text": "ثُمَّ ذَكَرَ سُبْحَانَهُ حَالَ الْأَصْنَافِ الثَّلَاثَةِ فِي الْقِيَامَةِ الْكُبْرَى وَقَالَ فِي آخِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_10", "reason": "high_symbol_ratio:0.476", "chunk_text": "وَتَصْلِيَةُ جَحِيمٍ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_11", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَكَذَلِكَ فِي سُورَةِ الْقِيَامَةِ: لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ وَلَا أُقْسِمُ بِالنَّفْسِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_12", "reason": "high_symbol_ratio:0.407", "chunk_text": "آخِرِ السُّورَةِ: كَلَّا إِذَا بَلَغَتِ التَّرَاقِيَ وَقِيلَ مَنْ رَاقٍ وَظَنَّ أَنَّهُ الْفِرَاقُ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_13", "reason": "high_symbol_ratio:0.431", "chunk_text": "فِي صِفَتِهِ - فَقَالَ: إِنَّهُ يُخْبِرُكُمْ بِكُلِّ مَا يَأْتِي، وَيُعَرِّفُكُمْ جَمِيعَ مَا لِلرَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_14", "reason": "high_symbol_ratio:0.437", "chunk_text": "مِنْ مُتَكَلِّمِيهِمُ الْمُبْتَدِعَةِ، الَّذِينَ ذَمَّهُمُ السَّلَفُ وَالْأَئِمَّةُ. وَالْقَوْلُ الث"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_15", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَهَذَا لَمْ يَقُلْهُ أَحَدٌ مِنْ أَهْلِ الْمِلَلِ لَا الْمُسْلِمِينَ وَلَا الْيَهُودِ وَلَا النَّصَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_16", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَلَكِنَّ مَنْ تَفَلْسَفَ مِنْ هَؤُلَاءِ فَوَافَقَ سَلَفَهُ مِنَ الصَّابِئَةِ وَالْفَلَاسِفَةِ الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_17", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَحَقِيقَةُ قَوْلِهِمْ أَنَّ الْأَنْبِيَاءَ كَذَبُوا لِلْمَصْلَحَةِ، وَهَؤُلَاءِ مَلَاحِدَةٌ كُفَّار"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_18", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَإِنْ كَانَ هَؤُلَاءِ كَثِيرِينَ مَوْجُودِينَ فِيمَنْ يَتَظَاهَرُ بِأَنَّهُ مِنْ أَهْلِ الْمِلَلِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_19", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَهَؤُلَاءِ الْقَائِلُونَ بِمَعَادِ الْأَرْوَاحِ فَقَطْ، مِنْهُمْ مَنْ يَقُولُ بِأَنَّ الْأَرْوَاحَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_20", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْقَوْلُ الرَّابِعُ: إِنْكَارُ الْمَعَادَيْنِ جَمِيعًا، كَمَا هُوَ قَوْلُ أَهْلِ الْكُفْرِ مِنَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_21", "reason": "high_symbol_ratio:0.411", "chunk_text": "إِذِ الْمَقْصُودُ هُنَا أَنَّ كُلَّ مَا عِنْدَ أَهْلِ الْكِتَابِ بَلْ وَسَائِرِ أَهْلِ الْأَرْضِ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_23", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَعُقَلَاءُ جَمِيعِ الْأُمَمِ تَأْمُرُ بِالْعَدْلِ وَمَكَارِمِ الْأَخْلَاقِ، وَتَنْهَى عَنِ الظُّلْم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_24", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَالْهِنْدُ، وَالْيُونَانُ، وَالْفُرْسُ فِي ذَلِكَ أَكْمَلُ مِنْ كُفَّارِ التُّرْكِ، وَالْبَرْبَرِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_25", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمَعْلُومٌ عِنْدَ الِاعْتِبَارِ أَنَّ الْأُمَمَ الَّذِينَ لَهُمْ كِتَابٌ كَالْيَهُودِ، وَالنَّصَارَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_26", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَكُلُّ طَرِيقٍ صَحِيحٍ مِنَ الطُّرُقِ الْعَقْلِيَّةِ، وَالْإِلْهَامِيَّةِ، وَغَيْرِهَا، شَارَكَ أَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_27", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَيَمْتَازُ أَهْلُ الْكِتَابِ بِعُلُومٍ وَأَعْمَالٍ أَخَذُوهَا عَنِ الْأَنْبِيَاءِ، لَيْسَ فِي قُوَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_28", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَإِنَّ جِنْسَ أَهْلِ الْكِتَابِ وَلَوْ كَانَ مَنْسُوخًا مُبَدَّلًا أَحْسَنُ حَالًا مِمَّنْ لَا كِتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_29", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَلِهَذَا لَمَّا ذَكَرَ اللَّهُ سُبْحَانَهُ فِي قِصَّةِ سُلَيْمَانَ بَرَاءَتَهُ عَنْ ذَلِكَ، وَكَانَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_30", "reason": "high_symbol_ratio:0.415", "chunk_text": "الَّتِي يَسْتَخْدِمُونَ بِهَا الْجِنَّ، وَيَقُولُونَ: إِنَّ سُلَيْمَانَ كَانَ يَسْتَخْدِمُهُمْ بِهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_31", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَقَدْ ذَكَرَ ذَلِكَ عُلَمَاءُ الْمُسْلِمِينَ فِي تَفْسِيرِ قَوْلِهِ تَعَالَى: وَلَمَّا جَاءَهُمْ رَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_32", "reason": "high_symbol_ratio:0.407", "chunk_text": "مِنْهُمَا مَا يُفَرِّقُونَ بِهِ بَيْنَ الْمَرْءِ وَزَوْجِهِ وَمَا هُمْ بِضَارِّينَ بِهِ مِنْ أَحَدٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_33", "reason": "high_symbol_ratio:0.424", "chunk_text": "سُبْحَانَهُ أَنَّ سُلَيْمَانَ لَمْ يَكْفُرْ وَلَكِنَّ الشَّيَاطِينَ كَفَرُوا، وَأَنَّهُمْ يُعَلِّمُو"}
