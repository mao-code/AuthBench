{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1869", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَالْمَخْلَصُ الثَّانِي اشْتِرَاطُ انْقِرَاضِ الْعَصْرِ، وَهُوَ مُشْكِلٌ فَإِنَّ اشْتِرَاطَهُ تَحَكُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1871", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَإِذَا انْقَسَمَ الْإِجْمَاعُ إلَى مَا هُوَ حُجَّةٌ وَإِلَى مَا لَيْسَ بِحُجَّةٍ وَلَا فَاصِلَ سَقَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1872", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَلَا يَتَخَلَّصُ مِنْ هَذَا إلَّا مَنْ أَنْكَرَ تَصَوُّرَ الْإِجْمَاعِ عَنْ اجْتِهَادٍ، وَعِنْدَ ذَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1874", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَهَذَا مُشْكِلٌ، فَإِنَّهُ زِيَادَةُ شَرْطٍ فِي الْإِجْمَاعِ وَالْحُجَجُ الْقَاطِعَةُ لَا تَقْبَلُ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1875", "reason": "high_symbol_ratio:0.432", "chunk_text": "الْمَخْلَصُ الْخَامِسُ: هَذَا وَهُوَ أَنَّ الْأَخِيرَ لَيْسَ بِحُجَّةٍ وَلَا يُحَرِّمُ الْقَوْلَ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1876", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَهَذَا أَيْضًا مُشْكِلٌ؛ لِأَنَّ قَوْلَهُ - عَلَيْهِ السَّلَامُ -: «لَا تَجْتَمِعُ أُمَّتِي عَلَى ا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1877", "reason": "high_symbol_ratio:0.409", "chunk_text": "بِدَلِيلِ السَّمْعِ فَكَذَلِكَ هَذَا. فَإِنْ قِيلَ: فَإِذَا ذَهَبَ جَمِيعُ الْأُمَّةِ مِنْ الصَّحَاب"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1878", "reason": "high_symbol_ratio:0.402", "chunk_text": "قُلْنَا: لَا إشْكَالَ عَلَى الطَّرِيقِ الْأَوَّلِ إلَّا هَذَا، وَسَبِيلُ قَطْعِهِ أَنْ يُقَالَ: لَا "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1879", "reason": "high_symbol_ratio:0.464", "chunk_text": "كَافَّةً، وَهُوَ مُمْتَنِعٌ سَمْعًا وَاَللَّهُ أَعْلَمُ."}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1880", "reason": "high_symbol_ratio:0.406", "chunk_text": "[مَسْأَلَةٌ أَجْمَعَتْ الصَّحَابَةُ عَلَى حُكْمٍ ثُمَّ ذَكَرَ وَاحِدٌ مِنْهُمْ حَدِيثًا عَلَى خِلَاف"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1881", "reason": "high_symbol_ratio:0.416", "chunk_text": "انْقِرَاضِ الْعَصْرِ فَلْيُعْتَبَرْ. قُلْنَا: عَنْهُ مَخْلَصَانِ أَحَدُهُمَا: أَنَّ هَذَا فَرْضٌ مُح"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1882", "reason": "high_symbol_ratio:0.420", "chunk_text": "الثَّانِي: أَنَّا نَنْظُرُ إلَى أَهْلِ الْإِجْمَاعِ، فَإِنْ أَصَرُّوا تَبَيَّنَ أَنَّهُ حَقٌّ وَأَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1883", "reason": "high_symbol_ratio:0.413", "chunk_text": "كَانَ مَا أَجْمَعُوا عَلَيْهِ حَقًّا فِي ذَلِكَ الزَّمَانِ إذْ لَمْ يُكَلِّفْهُمْ اللَّهُ مَا لَمْ ي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1884", "reason": "high_symbol_ratio:0.401", "chunk_text": "فَإِنْ قِيلَ: فَإِنْ جَازَ هَذَا فَلِمَ لَا يَجُوزُ أَنْ يُقَالَ: إذَا أَجْمَعَتْ الْأُمَّةُ عَنْ اج"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1885", "reason": "high_symbol_ratio:0.419", "chunk_text": "تَغَيَّرَ ظَنُّهُ تَغَيَّرَ فَرْضُهُ وَحُرِّمَ عَلَيْهِ مَا كَانَ سَائِغًا لَهُ، وَلَا يَكُونُ هَذَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1886", "reason": "high_symbol_ratio:0.408", "chunk_text": "قُلْنَا: مَا أَجْمَعُوا عَلَيْهِ عَنْ اجْتِهَادٍ لَا يَجُوزُ خِلَافُهُ بَعْدَهُ لَا؛ لِأَنَّهُ حَقٌّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1887", "reason": "high_symbol_ratio:0.414", "chunk_text": "بِالِاجْتِهَادِ فَإِنَّهُ لَا يُشْتَرَطُ فِيهِ أَنْ لَا يَتَغَيَّرَ الِاجْتِهَادُ بَلْ يَحْرُمُ خِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1888", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِنْ قِيلَ: فَلَوْ ظَهَرَ لِلتَّابِعِينَ ذَلِكَ الْخَبَرُ عَلَى خِلَافِ مَا أَجْمَعَتْ الصَّحَابَة"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1889", "reason": "high_symbol_ratio:0.414", "chunk_text": "[مَسْأَلَةٌ الْإِجْمَاعُ لَا يَثْبُتُ بِخَبَرِ الْوَاحِدِ] ِ خِلَافًا لِبَعْضِ الْفُقَهَاءِ، وَالسِّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1890", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ قِيلَ: فَلْيَثْبُتْ فِي حَقِّ وُجُوبِ الْعَمَلِ بِهِ إنْ لَمْ يَكُنْ الْعَمَلُ بِهِ مُخَالِفً"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1891", "reason": "high_symbol_ratio:0.412", "chunk_text": "قُلْنَا: إنَّمَا يَثْبُتُ الْعَمَلُ بِخَبَرِ الْوَاحِدِ اقْتِدَاءً بِالصَّحَابَةِ وَإِجْمَاعِهِمْ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1892", "reason": "high_symbol_ratio:0.437", "chunk_text": "هَذَا هُوَ الْأَظْهَرُ، وَلَسْنَا نَقْطَعُ بِبُطْلَانِ مَذْهَبِ مَنْ يَتَمَسَّكُ بِهِ فِي حَقِّ الْع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1893", "reason": "high_symbol_ratio:0.430", "chunk_text": "[مَسْأَلَةٌ الْأَخْذُ بِأَقَلِّ مَا قِيلَ لَيْسَ تَمَسُّكًا بِالْإِجْمَاعِ] خِلَافًا لِبَعْضِ الْفُق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1894", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَمِثَالُهُ: أَنَّ النَّاسَ اخْتَلَفُوا فِي دِيَةِ الْيَهُودِيِّ فَقِيلَ: إنَّهَا مِثْلُ دِيَةِ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1896", "reason": "high_symbol_ratio:0.414", "chunk_text": "[الْأَصْلُ الرَّابِعُ دَلِيلُ الْعَقْلِ وَالِاسْتِصْحَابِ] ِ اعْلَمْ أَنَّ الْأَحْكَامَ السَّمْعِيَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1897", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَانْتِفَاءُ الْأَحْكَامِ مَعْلُومٌ بِدَلِيلِ الْعَقْلِ قَبْلَ وُرُودِ السَّمْعِ، وَنَحْنُ عَلَى اسْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1898", "reason": "high_symbol_ratio:0.409", "chunk_text": "شَوَّالٍ عَلَى النَّفْيِ الْأَصْلِيِّ، وَإِذَا أَوْجَبَ عِبَادَةً فِي وَقْتٍ بَقِيَتْ الذِّمَّةُ بَع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1900", "reason": "high_symbol_ratio:0.420", "chunk_text": "الْعِلْمِ بِوُرُودِ السَّمْعِ وَعَدَمُ الْعِلْمِ لَا يَكُونُ حُجَّةً. قُلْنَا: انْتِفَاءُ الدَّلِيلِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1901", "reason": "high_symbol_ratio:0.415", "chunk_text": "أَمَّا الظَّنُّ فَالْمُجْتَهِدُ إذَا بَحَثَ عَنْ مَدَارِكِ الْأَدِلَّةِ فِي وُجُوبِ الْوَتْرِ وَالْأ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1902", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَإِنْ قِيلَ: وَلِمَ يَسْتَحِيلُ أَنْ يَكُونَ وَاجِبًا وَلَا يَكُونُ عَلَيْهِ دَلِيلٌ أَوْ يَكُونُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1904", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَإِنْ قِيلَ: فَيَقْدِرُ كُلُّ عَامِّيٍّ أَنْ يَنْفِيَ مُسْتَنِدًا إلَى أَنَّهُ لَمْ يَبْلُغْهُ الدَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1905", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَإِنْ قِيلَ: وَهَلْ لِلِاسْتِصْحَابِ مَعْنًى سِوَى مَا ذَكَرْتُمُوهُ؟ قُلْنَا: يُطْلَقُ الِاسْتِصْح"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1906", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَالثَّانِي: اسْتِصْحَابُ الْعُمُومِ إلَى أَنْ يَرِدَ تَخْصِيصٌ وَاسْتِصْحَابُ النَّصِّ إلَى أَنْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1907", "reason": "high_symbol_ratio:0.414", "chunk_text": "الثَّالِثُ: اسْتِصْحَابُ حُكْمٍ دَلَّ الشَّرْعُ عَلَى ثُبُوتِهِ وَدَوَامِهِ، كَالْمِلْكِ عِنْدَ جَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1908", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَالِاسْتِصْحَابُ لَيْسَ بِحُجَّةٍ إلَّا فِيمَا دَلَّ الدَّلِيلُ عَلَى ثُبُوتِهِ وَدَوَامِهِ بِشَرْط"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1909", "reason": "high_symbol_ratio:0.402", "chunk_text": "بِالْعُمُومِ وَجُمْلَةٍ مِنْ الْقَرَائِنِ عِنْدَ الْجَمِيعِ، وَتِلْكَ الْقَرَائِنُ تَكْرِيرَاتٌ وَتَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1910", "reason": "high_symbol_ratio:0.455", "chunk_text": "الْبَحْثِ وَالطَّلَبِ."}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1912", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْحَوَادِثِ، فَنَحْنُ نَسْتَصْحِبُ دَوَامَ الصَّلَاةِ إلَى أَنْ يَدُلَّ دَلِيلٌ عَلَى كَوْنِ رُؤْيَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1913", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَهَذَا فَاسِدٌ؛ لِأَنَّ هَذَا الْمُسْتَصْحِبَ لَا يَخْلُو إمَّا أَنْ يُقِرَّ بِأَنَّهُ لَمْ يَقُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1914", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَإِنْ أَقَرَّ بِأَنَّهُ لَمْ يَدُلَّ فَسَنُبَيِّنُ وُجُوبَ الدَّلِيلِ عَلَى النَّافِي، وَإِنْ ظَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1917", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْبَرَاءَةِ الْأَصْلِيَّةِ بِشَرْطِ أَنْ لَا يَدُلَّ السَّمْعُ فَلَا يَبْقَى لَهُ دَلَالَةٌ مَعَ وُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1918", "reason": "high_symbol_ratio:0.427", "chunk_text": "إذْ قَوْلُهُ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -: «لَا صِيَامَ لِمَنْ لَمْ يُبَيِّتْ الصِّيَامَ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1919", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَهَاهُنَا الْمُخَالِفُ لَا يُسَلِّمُ شُمُولَ الْإِجْمَاعِ مَحَلَّ الْخِلَافِ، إذْ يَسْتَحِيلُ الْإِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1920", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ قِيلَ: الْإِجْمَاعُ يُحَرِّمُ الْخِلَافَ فَكَيْفَ يَرْتَفِعُ بِالْخِلَافِ؟ قُلْنَا: هَذَا الْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1925", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَإِنْ قِيلَ: لَيْسَ هُوَ مَأْمُورًا بِالشُّرُوعِ فَقَطْ بَلْ بِالشُّرُوعِ مَعَ الْإِتْمَامِ. قُلْنَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1927", "reason": "high_symbol_ratio:0.428", "chunk_text": "ثُمَّ هُوَ ضَعِيفٌ، لِأَنَّهُ إنْ أَرَدْتُمْ بِالْبُطْلَانِ إحْبَاطَ ثَوَابِهِ فَلَا نُسَلِّمُ أَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1928", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَإِنْ قِيلَ: الْأَصْلُ أَنَّهُ لَا يَجِبُ شَيْءٌ بِالشَّكِّ وَوُجُوبُ اسْتِئْنَافِ الصَّلَاةِ مَشْك"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1929", "reason": "high_symbol_ratio:0.408", "chunk_text": "قُلْنَا: هَذَا يُعَارِضُهُ أَنَّ وُجُوبَ الْمُضِيِّ فِي هَذِهِ الصَّلَاةِ مَشْكُوكٌ فِيهِ، وَبَرَاءَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1930", "reason": "high_symbol_ratio:0.416", "chunk_text": "ثُمَّ نَقُولُ: مَنْ يُوجِبُ الِاسْتِئْنَافَ يُوجِبُهُ بِدَلِيلٍ يَغْلِبُ عَلَى الظَّنِّ كَمَا يَرْفَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1932", "reason": "high_symbol_ratio:0.409", "chunk_text": "قُلْنَا:، لِأَنَّهُمْ لَمْ يَسْتَصْحِبُوا الْإِجْمَاعَ بَلْ النَّفْيَ الْأَصْلِيَّ الَّذِي دَلَّ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1933", "reason": "high_symbol_ratio:0.417", "chunk_text": "[مَسْأَلَةٌ النَّافِيَ هَلْ عَلَيْهِ دَلِيلٌ] مَسْأَلَةٌ اخْتَلَفُوا فِي أَنَّ النَّافِيَ هَلْ عَلَي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1934", "reason": "high_symbol_ratio:0.424", "chunk_text": "يُطَالَبُ الشَّاكُّ بِالدَّلِيلِ، فَإِنَّهُ يَعْتَرِفُ بِالْجَهْلِ وَعَدَمِ الْمَعْرِفَةِ. وَإِنْ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1935", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَإِنْ لَمْ يَعْرِفْهُ ضَرُورَةً فَإِنَّمَا عَرَفَهُ عَنْ تَقْلِيدٍ أَوْ عَنْ نَظَرٍ، فَالتَّقْلِيدُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1937", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَالثَّانِي: أَنَّ الدَّلِيلَ إذَا سَقَطَ عَنْ هَؤُلَاءِ لَمْ يَعْجَزْ أَنْ يُعَبِّرَ الْمُثْبِتُ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1938", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَلَهُمْ فِي الْمَسْأَلَةِ شُبْهَتَانِ. الشُّبْهَةُ الْأُولَى: قَوْلُهُمْ: إنَّهُ لَا دَلِيلَ عَلَى "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1939", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالْجَوَابُ مِنْ أَرْبَعَةِ أَوْجُهٍ: الْأَوَّلُ: أَنَّ ذَلِكَ لَيْسَ لِكَوْنِهِ نَافِيًا وَلَا لِد"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1940", "reason": "high_symbol_ratio:0.408", "chunk_text": "بَلْ ذَلِكَ بِحُكْمِ الشَّرْعِ لِقَوْلِهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ -: «الْبَيِّنَةُ عَلَى"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1941", "reason": "high_symbol_ratio:0.406", "chunk_text": "عَلَيْهِ؟ بَلْ الْمُدَّعِي أَيْضًا لَا دَلِيلَ عَلَيْهِ،؛ لِأَنَّ قَوْلَ الشَّاهِدِينَ لَا يُحَصِّلُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1942", "reason": "high_symbol_ratio:0.415", "chunk_text": "دَلِيلًا بِحُكْمِ الشَّرْعِ، فَإِنْ جَازَ ذَلِكَ فَيَمِينُ الْمُدَّعَى عَلَيْهِ أَيْضًا لَازِمٌ فَلْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1943", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالْجَوَابُ الثَّانِي: أَنَّ الْمُدَّعَى عَلَيْهِ يَدَّعِي عِلْمَ الضَّرُورَةِ بِبَرَاءَةِ ذِمَّةِ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1944", "reason": "high_symbol_ratio:0.414", "chunk_text": "الْخَوْفِ وَمَا جَرَى مَجْرَاهُ، وَعِنْدَ ذَلِكَ يَسْتَوِي الْإِثْبَاتُ وَالنَّفْيُ، فَإِنَّهُ لَوْ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1945", "reason": "high_symbol_ratio:0.406", "chunk_text": "الثَّالِثُ: أَنَّ النَّافِيَ فِي مَجْلِسِ الْحُكْمِ عَلَيْهِ دَلِيلٌ وَهِيَ الْيَمِينُ كَمَا عَلَى ا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1947", "reason": "high_symbol_ratio:0.429", "chunk_text": "الرَّابِعُ: أَنَّ يَدَ الْمُدَّعَى عَلَيْهِ دَلِيلٌ عَلَى نَفْيِ مِلْكِ الْمُدَّعِي وَهُوَ ضَعِيفٌ؛ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1949", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَمَعْلُومٌ أَنَّهُمَا لَمْ تَفْسُدَا، فَدَلَّ ذَلِكَ عَلَى نَفْيِ الثَّانِي. وَيُمْكِنُ إثْبَاتُهُ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1950", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَلَا ضَرُورَةَ مَعَ الْخِلَافِ وَلَا دَلِيلَ فَيَدُلُّ ذَلِكَ عَلَى الِانْتِفَاءِ. وَهَذَا فَاسِدٌ،"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1951", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَلَا يُمْكِنُهُ أَنْ يَتَمَسَّكَ بِالِاسْتِصْحَابِ بِأَنْ يَقُولَ مَثَلًا: الْأَصْلُ عَدَمُ إلَهٍ ث"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1952", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَلَوْ كَلَّفْنَاهُ مِنْ غَيْرِ رَسُولٍ مُصَدَّقٍ بِالْمُعْجِزَةِ يُبَلِّغُ إلَيْنَا تَكْلِيفَهُ كَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1953", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَأَمَّا قَوْلُهُمْ: لَوْ ثَبَتَ إلَهٌ ثَانٍ لَكَانَ لِلَّهِ تَعَالَى عَلَيْهِ دَلِيلٌ، فَهُوَ تَحَك"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1954", "reason": "high_symbol_ratio:0.412", "chunk_text": "الثَّانِي: أَنَّهُ يَجُوزُ أَنْ يُنَصِّبَ عَلَيْهِ دَلِيلًا وَنَحْنُ لَا نَتَنَبَّهُ لَهُ وَيَتَنَبَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1957", "reason": "high_symbol_ratio:0.408", "chunk_text": "أَمَّا الشَّرْعِيَّاتُ فَقَدْ تَصَادَفَ الدَّلِيلُ عَلَيْهَا مِنْ الْإِجْمَاعِ كَنَفْيِ وُجُوبِ صَوْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1958", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَقَدْ لَا يُسَاعِدُ مِثْلُ هَذَا الدَّلِيلِ فَنَبْحَثُ عَنْ مَدَارِكِ الْإِثْبَاتِ، فَإِذَا لَمْ نَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1959", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَحَيْثُ أَوْرَدْنَا فِي تَصَانِيفِ الْخِلَافِ أَنَّ النَّافِيَ لَا دَلِيلَ عَلَيْهِ أَرَدْنَا بِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1960", "reason": "high_symbol_ratio:0.403", "chunk_text": "فَإِنْ قِيلَ: دَلِيلُ الْعَقْلِ مَشْرُوطٌ بِانْتِفَاءِ السَّمْعِ وَانْتِفَاءُ السَّمْعِ غَيْرُ مَعْل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1961", "reason": "high_symbol_ratio:0.413", "chunk_text": "قُلْنَا: قَدْ بَيَّنَّا أَنَّ انْتِفَاءَهُ تَارَةً يُعْلَمُ كَمَا فِي انْتِفَاءِ وُجُوبِ صَوْمِ شَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1962", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَإِنْ قِيلَ: أَلَيْسَ لِلِاسْتِقْصَاءِ غَايَةٌ مَحْدُودَةٌ بَلْ لِلْبَحْثِ بِدَايَةٌ وَوَسَطٌ وَنِه"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1963", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَإِنْ قِيلَ: الْبَيْتُ مَحْصُورٌ وَطَلَبُ الْيَقِينِ فِيهِ مُمْكِنٌ وَمَدَارِكُ الشَّرْعِ غَيْرُ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1964", "reason": "high_symbol_ratio:0.408", "chunk_text": "قُلْنَا: إنْ كَانَ ذَلِكَ فِي ابْتِدَاءِ الْإِسْلَامِ قَبْلَ انْتِشَارِ الْأَخْبَارِ فَفَرْضُ كُلِّ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1966", "reason": "high_symbol_ratio:0.428", "chunk_text": "[خَاتِمَة الْقُطْبِ مَا يُظَنُّ أَنَّهُ مِنْ أُصُولِ الْأَدِلَّةِ وَلَيْسَ مِنْهَا] [الْأَصْلُ الْأَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1967", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَهَذِهِ أَيْضًا لَا بُدَّ مِنْ شَرْحِهَا. الْأَصْلُ الْأَوَّلُ مِنْ الْأُصُولِ الْمَوْهُومَةِ: شَرْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1968", "reason": "high_symbol_ratio:0.440", "chunk_text": "وَنُقَدِّمُ عَلَى هَذَا الْأَصْلِ مَسْأَلَةً، وَهِيَ أَنَّهُ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - ق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1969", "reason": "high_symbol_ratio:0.403", "chunk_text": "ثُمَّ مِنْهُمْ مَنْ نَسَبَهُ إلَى نُوحٍ - عَلَيْهِ السَّلَامُ - وَقَوْمٌ نَسَبُوهُ إلَى إبْرَاهِيمَ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1970", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَإِنْ قِيلَ: الدَّلِيلُ الْقَاطِعُ أَنَّهُ لَمْ يَكُنْ عَلَى مِلَّةٍ أَنَّهُ لَوْ كَانَ لَافْتَخَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1971", "reason": "high_symbol_ratio:0.410", "chunk_text": "قُلْنَا: هَذَا يُعَارِضُهُ أَنَّهُ لَوْ كَانَ مُنْسَلِخًا عَنْ التَّكْلِيفِ وَالتَّعَبُّدِ بِالشَّرَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1972", "reason": "high_symbol_ratio:0.409", "chunk_text": "عَلَى التَّوَاتُرِ عَنْهُمَا عُمُومُ صِيغَةٍ حَتَّى نَنْظُرَ فِي فَحْوَاهُ فَلَا مُسْتَنَدَ لِهَذِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1973", "reason": "high_symbol_ratio:0.432", "chunk_text": "الثَّانِي: أَنَّهُ رُبَّمَا كَانَ زَمَانُهُ زَمَانَ فَتْرَةِ الشَّرَائِعِ وَانْدِرَاسِهَا وَتَعَذُّر"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1974", "reason": "high_symbol_ratio:0.416", "chunk_text": "قُلْنَا: هَذَا فَاسِدٌ مِنْ وَجْهَيْنِ: أَحَدُهُمَا: أَنَّ شَيْئًا مِنْ ذَلِكَ لَمْ يَتَوَاتَرْ بِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1975", "reason": "high_symbol_ratio:0.420", "chunk_text": "الثَّانِي: أَنَّهُ رُبَّمَا ذَبَحَ الْحَيَوَانَ بِنَاءً عَلَى أَنَّهُ لَا تَحْرِيمَ إلَّا بِالسَّمْع"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1976", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَنَرْجِعُ الْآنَ إلَى الْأَصْلِ الْمَقْصُودِ، وَهُوَ أَنَّهُ بَعْدَ بَعْثَتِهِ هَلْ كَانَ مُتَعَبِّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1977", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَزَعَمَ بَعْضُ الْقَدَرِيَّةِ أَنَّهُ لَا يَجُوزُ بَعْثَةُ نَبِيٍّ إلَّا بِشَرْعٍ مُسْتَأْنَفٍ، فَإ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1978", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَيَلْزَمُهُمْ عَلَى هَذَا تَجْوِيزُ بَعْثَتِهِ بِمِثْلِ ذَلِكَ الشَّرِيعَةِ إذَا كَانَتْ قَدْ انْدَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1979", "reason": "high_symbol_ratio:0.406", "chunk_text": "فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثٍ} [يس: 14] وَكَمَا أَرْسَلَ مُوسَى وَهَارُونَ وَدَاوُد وَسُلَي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1980", "reason": "high_symbol_ratio:0.413", "chunk_text": "ثُمَّ كَلَامُهُمْ بِنَاءً عَلَى طَلَبِ الْفَائِدَةِ فِي أَفْعَالِ اللَّهِ تَعَالَى، وَهُوَ تَحَكُّمٌ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1981", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَاقِعَةٌ لَزِمَهُ اتِّبَاعُ دِينِهِمْ إلَّا إذَا نَزَلَ عَلَيْهِ وَحْيٌ مُخَالِفٌ لِمَا سَبَقَ فَإِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1982", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَسَلَّمَ - وَصَوَّبَهُ. وَلَوْ كَانَ ذَلِكَ مِنْ مَدَارِك الْأَحْكَامِ لَمَا جَازَ الْعُدُولُ إلَى "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1983", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَإِنْ قِيلَ: إنَّمَا لَمْ يَذْكُرْ التَّوْرَاةَ وَالْإِنْجِيلَ؛ لِأَنَّ فِي الْكِتَابِ آيَاتٌ تَدُل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1984", "reason": "high_symbol_ratio:0.408", "chunk_text": "قُلْنَا سَنُبَيِّنُ سُقُوطَ تَمَسُّكِهِمْ بِتِلْكَ الْآيَاتِ، بَلْ فِيهِ قَوْله تَعَالَى {لِكُلٍّ جَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1985", "reason": "high_symbol_ratio:0.406", "chunk_text": "ثُمَّ نَقُولُ: فِي الْكِتَابِ مَا يَدُلُّ عَلَى اتِّبَاعِ السُّنَّةِ وَالْقِيَاسِ فَكَانَ يَنْبَغِي "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1986", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَإِنْ قِيلَ: انْدَرَجَتْ التَّوْرَاةُ وَالْإِنْجِيلُ تَحْتَ الْكِتَابِ فَإِنَّهُ اسْمٌ يَعُمُّ كُلَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1987", "reason": "high_symbol_ratio:0.425", "chunk_text": "قُلْنَا: إذَا ذُكِرَ الْكِتَابُ وَالسُّنَّةُ لَمْ يَسْبِقْ إلَى فَهْمِ الْمُسْلِمِينَ شَيْءٌ سِوَى ا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_1988", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَرَقَةً مِنْ التَّوْرَاةِ فَغَضِبَ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ - حَتَّى احْمَرَّتْ عَيْنَاه"}
