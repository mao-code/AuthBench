{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_556", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَفِيهِمَا عَنْ أَنَسٍ أَيْضًا أَنَّ النَّبِيَّ وَأَصْحَابَهُ بِالزَّوْرَاءِ، - وَالزَّوْرَاءُ بِالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_557", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْهُ قَالَ: رَأَيْتُ رَسُولَ اللَّهِ وَحَانَتْ صَلَاةُ الْعَصْرِ، فَالْتَمَسَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_558", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: فَرَأَيْتُ الْمَاءَ يَنْبُعُ مِنْ تَحْتِ أَصَابِعِهِ، حَتَّى تَوَضَّئُوا مِنْ عِنْدِ آخِرِهِم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_559", "reason": "high_symbol_ratio:0.436", "chunk_text": "فَلَقَدْ رَأَيْتُ الْمَاءَ يَتَفَجَّرُ مِنْ بَيْنِ أَصَابِعِهِ، فَتَوَضَّأَ النَّاسُ وَشَرِبُوا، فَج"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_560", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي صَحِيحِ الْبُخَارِيِّ، عَنْ جَابِرٍ أَيْضًا قَالَ: عَطِشَ النَّاسُ يَوْمَ الْحُدَيْبِيَةِ وَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_561", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَوَضَعَ يَدَهُ فِي الرَّكْوَةِ فَجَعَلَ الْمَاءُ يَثُورُ بَيْنَ أَصَابِعِهِ كَأَمْثَالِ الْعُيُونِ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_562", "reason": "high_symbol_ratio:0.440", "chunk_text": "قُلْتُ: كَمْ كُنْتُمْ؟ قَالَ: لَوْ كُنَّا مِائَةَ أَلْفٍ لَكَفَانَا، كُنَّا خَمْسَ عَشْرَةَ مِائَةً."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_563", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي الْبُخَارِيِّ عَنِ الْبَرَاءِ بْنِ عَازِبٍ قَالَ: تَعُدُّونَ أَنْتُمُ الْفَتْحَ فَتْحَ مَكَّةَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_564", "reason": "high_symbol_ratio:0.422", "chunk_text": "نَحْنُ وَرِكَابَنَا، وَكُنَّا أَلْفًا وَأَرْبَعَمِائَةٍ، أَوْ أَكْثَرَ مِنْ ذَلِكَ. وَفِي صَحِيحِ مُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_565", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَعَنِ ابْنِ عَبَّاسٍ قَالَ: وَدَعَا النَّبِيُّ بِلَالًا فَطَلَبَ بِلَالٌ الْمَاءَ، ثُمَّ جَاءَ، فَق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_566", "reason": "high_symbol_ratio:0.449", "chunk_text": "فَقَالَ: النَّبِيُّ : فَهَلْ مِنْ شَنٍّ؟ فَأَتَاهُ بِشَنٍّ فَبَسَطَ كَفَّيْهِ فِيهَا فَانْبَعَثَتْ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_567", "reason": "high_symbol_ratio:0.419", "chunk_text": "قَالَ: فَكَانَ ابْنُ مَسْعُودٍ يَشْرَبُ وَغَيْرُهُ يَتَوَضَّأُ. وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_568", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : عَلَى رِسْلِكُمْ. حِينَ سَمِعَهُمْ يَقُولُونَ ذَلِكَ، فَوَضَعَ رَسُولُ الل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_569", "reason": "high_symbol_ratio:0.415", "chunk_text": "ثُمَّ قَالَ: أَسْبِغُوا الطَّهُورَ. فَوَالَّذِي هُوَ ابْتَلَانِي بِبَصَرِي لَقَدْ رَأَيْتُ الْعُيُون"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_570", "reason": "high_symbol_ratio:0.412", "chunk_text": "رَوَاهُمَا الدَّارِمِيُّ فِي مُسْنَدِهِ. وَفِي صَحِيحِ الْبُخَارِيِّ عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_571", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَجَاءُونَا بِإِنَاءٍ فِيهِ مَاءٌ قَلِيلٌ، فَأَدْخَلَ يَدَهُ فِي الْإِنَاءِ، ثُمَّ قَالَ: حَيَّ عَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_572", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَلَقَدْ رَأَيْتُ الْمَاءَ يَنْبُعُ مِنْ بَيْنِ أَصَابِعِ النَّبِيِّ ، وَلَقَدْ كُنَّا نَسْمَعُ تَسْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_573", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَرَوَى مُسْلِمٌ فِي صَحِيحِهِ عَنْ مُعَاذِ بْنِ جَبَلٍ قَالَ: خَرَجْنَا مَعَ رَسُولِ اللَّهِ عَامَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_574", "reason": "high_symbol_ratio:0.417", "chunk_text": "مِنْ مَائِهَا شَيْئًا، حَتَّى آتِيَ. فَجِئْنَاهَا وَقَدْ سَبَقَنَا إِلَيْهَا رَجُلَانِ، وَالْعَيْنُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_575", "reason": "high_symbol_ratio:0.402", "chunk_text": "فَسَبَّهُمَا رَسُولُ اللَّهِ وَقَالَ لَهُمَا مَا شَاءَ اللَّهُ أَنْ يَقُولَ، ثُمَّ غَرَفُوا بِأَيْدِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_576", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ حَدِيثُ جَابِرٍ الَّذِي رَوَاهُ عُبَادَةُ بْنُ الْوَلِيدِ، وَقَدْ تَقَدَّمَ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_577", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَقَالَ: أَلَا وَضُوءَ، أَلَا وَضُوءَ. قَالَ: قُلْتُ: يَا رَسُولَ اللَّهِ، مَا وَجَدْتُ فِي الرَّكْب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_578", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَأَتَيْتُ رَسُولَ اللَّهِ ، فَقُلْتُ: يَا رَسُولَ اللَّهِ، إِنِّي لَمْ أَجِدْ فِيهَا إِلَّا قَطْرَة"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_579", "reason": "high_symbol_ratio:0.443", "chunk_text": "قَالَ: اذْهَبْ، فَأْتِنِي بِهِ. فَأَتَيْتُهُ بِهِ فَأَخَذَهُ بِيَدِهِ، فَجَعَلَ يَتَكَلَّمُ بِشَيْءٍ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_580", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَقُلْتُ: يَا جَفْنَةَ الرَّكْبِ. فَأُتِيتُ بِهَا تُحْمَلُ، فَوَضَعْتُهَا بَيْنَ يَدَيْهِ، فَقَالَ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_581", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَصَبَبْتُ عَلَيْهِ، وَقُلْتُ: بِاسْمِ اللَّهِ. فَرَأَيْتُ الْمَاءَ يَفُورُ مِنْ بَيْنِ أَصَابِعِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_582", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: فَأَتَى النَّاسُ، فَاسْتَقَوْا حَتَّى رَوَوْا. قَالَ: فَقُلْتُ: هَلْ بَقِيَ أَحَدٌ لَهُ حَاجَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_583", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي الصَّحِيحَيْنِ، عَنْ عِمْرَانَ بْنِ حُصَيْنٍ، قَالَ: كُنْتُ مَعَ النَّبِيِّ فِي مَسِيرٍ لَهُ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_584", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَالَ: ارْتَحِلُوا. فَسَارَ بِنَا حَتَّى إِذَا ابْيَضَّتِ الشَّمْسُ، نَزَلَ فَصَلَّى بِنَا الْغَدَاة"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_585", "reason": "high_symbol_ratio:0.437", "chunk_text": "فَقَالَ لَهُ: عَلَيْكَ بِالصَّعِيدِ، فَإِنَّهُ يَكْفِيكَ. فَتَيَمَّمَ بِالصَّعِيدِ فَصَلَّى، ثُمَّ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_586", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَبَيْنَمَا نَحْنُ نَسِيرُ إِذَا نَحْنُ بِامْرَأَةٍ سَادِلَةٍ رِجْلَيْهَا بَيْنَ مَزَادَتَيْنِ، فَقُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_587", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَقُلْتُ: كَمْ بَيْنَ أَهْلِكِ وَبَيْنَ الْمَاءِ؟ قَالَتْ: مَسِيرَةُ يَوْمٍ وَلَيْلَةٍ. قُلْنَا: انْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_588", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَتْ: وَمَا رَسُولُ اللَّهِ؟ فَلَمْ نُمَلِّكْهَا مِنْ أَمْرِهَا شَيْئًا، حَتَّى انْطَلَقْنَا بِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_589", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَأَمَرَ بِرَاوِيَتِهَا فَأُنِيخَتْ، فَمَجَّ فِي الْعَزْلَاوَيْنِ الْعُلْيَاوَيْنِ، ثُمَّ بَعَثَ بِر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_590", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَجَمَعْنَا لَهَا مِنْ كِسَرٍ، وَتَمْرٍ، وَصَرَّ لَهَا صُرَّةً، فَقَالَ لَهَا: اذْهَبِي فَأَطْعِمِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_591", "reason": "high_symbol_ratio:0.441", "chunk_text": "فَلَمَّا أَتَتْ أَهْلَهَا قَالَتْ: لَقَدْ لَقِيتُ أَسْحَرَ الْبَشَرِ، أَوْ إِنَّهُ لَنَبِيٌّ كَمَا ز"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_592", "reason": "high_symbol_ratio:0.436", "chunk_text": "فَهَدَى اللَّهُ عَزَّ وَجَلَّ ذَلِكَ الْقَوْمَ بِتِلْكَ الْمَرْأَةِ فَأَسْلَمَتْ وَأَسْلَمُوا."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_593", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَبِي قَتَادَةَ قَالَ: خَطَبَنَا رَسُولُ اللَّهِ ، فَقَالَ: إِنَّكُمْ تَسِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_594", "reason": "high_symbol_ratio:0.445", "chunk_text": "ثُمَّ قَالَ: أَصْبَحَ النَّاسُ فَقَدُوا نَبِيَّهُمْ. فَقَالَ: أَبُو بَكْرٍ، وَعُمَرُ: إِنَّ رَسُولَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_595", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَقَالَ النَّاسُ: إِنَّ رَسُولَ اللَّهِ بَيْنَ أَيْدِيكُمْ فَإِنْ تُطِيعُوا أَبَا بَكْرٍ، وَعُمَرَ ت"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_596", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَقَالَ: لَا هُلْكَ عَلَيْكُمْ. ثُمَّ قَالَ: أَطْلِقُوا لِي غُمَرِي. قَالَ: وَدَعَا بِالْمِيضَأَةِ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_597", "reason": "high_symbol_ratio:0.423", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : أَحْسِنُوا الْمَلْأَ كُلُّكُمْ سَيَرْوَى. قَالَ: فَفَعَلُوا، فَجَعَلَ رَسُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_598", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَقُلْتُ: لَا أَشْرَبُ حَتَّى يَشْرَبَ رَسُولُ اللَّهِ، قَالَ: إِنَّ سَاقِيَ الْقَوْمِ آخِرُهُمْ شُر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_599", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ: عَبْدُ اللَّهِ بْنُ رَبَاحٍ: إِنِّي لَأُحَدِّثُ بِهَذَا الْحَدِيثِ فِي مَسْجِدِ الْجَامِعِ إِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_600", "reason": "high_symbol_ratio:0.466", "chunk_text": "فَقُلْتُ: أَنْتَ أَعْلَمُ. فَقَالَ: مِمَّنْ أَنْتَ؟ قُلْتُ: مِنَ الْأَنْصَارِ. قَالَ: أَنْتُمْ أَعْل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_601", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَالَ: عِمْرَانُ: لَقَدْ شَهِدْتُ تِلْكَ اللَّيْلَةَ وَمَا شَعَرْتُ أَنَّ أَحَدًا حَفِظَهُ كَمَا حَف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_602", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ: فَأُدْلِيَتْ إِلَيَّ دَلْوٌ، وَرَسُولُ اللَّهِ عَلَى شَفَةِ الرَّكِيِّ، فَجَعَلْنَا فِيهَا نِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_603", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَفِي الْحَدِيثِ الَّذِي رَوَاهُ الْإِمَامُ أَحْمَدُ وَالتِّرْمِذِيُّ وَأَبُو دَاوُدَ وَابْنُ مَاجَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_604", "reason": "high_symbol_ratio:0.422", "chunk_text": "يَدِهِ، وَدَعَا فِيهِنَّ، ثُمَّ قَالَ: اذْهَبُوا بِهَذِهِ الْحَصَيَاتِ فَإِذَا أَتَيْتُمُ الْبِئْرَ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_605", "reason": "high_symbol_ratio:0.407", "chunk_text": "قَالَ الصُّدَاي: فَفَعَلْنَا مَا قَالَ لَنَا، فَمَا اسْتَطَعْنَا بَعْدُ أَنْ نَنْظُرَ إِلَى قَعْرِهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_606", "reason": "high_symbol_ratio:0.410", "chunk_text": "قَالَ: فَأْتِنِي بِهِ. قَالَ: فَأَتَاهُ بِإِنَاءٍ فِيهِ شَيْءٌ مِنْ مَاءٍ قَلِيلٍ، قَالَ: فَجَعَلَ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_608", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَأَخْرَجَتْ لِي جِرَابًا فِيهِ صَاعٌ مِنْ شَعِيرٍ، وَلَنَا بُهَيْمَةٌ دَاجِنٌ، قَالَ: فَذَبَحَتْ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_609", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: فَجِئْتُ فَسَارَرْتُهُ، فَقُلْتُ: يَا رَسُولَ اللَّهِ، إِنَّا ذَبَحْنَا بُهَيْمَةً لَنَا، وَط"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_610", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ: قَدْ فَعَلْتُ الَّذِي قُلْتِ لِي. فَأَخْرَجْتُ لَهُ عَجِينًا فَبَصَقَ فِيهِ وَبَارَكَ، ثُمَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_611", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَهُمْ أَلْفٌ فَأُقْسِمُ بِاللَّهِ لَأَكَلُوا حَتَّى تَرَكُوهُ، وَانْحَرَفُوا، وَإِنَّ بُرْمَتَنَا ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_612", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَفِي رِوَايَةٍ قَالَ جَابِرٌ: إِنَّا يَوْمَ الْخَنْدَقِ نَحْفِرُ فَعَرَضَتْ كُدْيَةٌ شَدِيدَةٌ فَجَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_613", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَقَالَ: أَنَا نَازِلٌ. فَقَامَ وَبَطْنُهُ مَعْصُوبٌ بِحَجَرٍ، وَلِبَثْنَا ثَلَاثًا لَا نَذُوقُ ذَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_614", "reason": "high_symbol_ratio:0.448", "chunk_text": "فَقُلْتُ: طُعَيِّمٌ لِي، فَقُمْ أَنْتَ يَا رَسُولَ اللَّهِ، وَرَجُلٌ أَوْ رَجُلَانِ. قَالَ: كَمْ هُو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_615", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ: قُلْ لَهَا: لَا تَنْزِعُ الْبُرْمَةَ، وَلَا الْخُبْزَ مِنَ التَّنُّورِ حَتَّى آتِيَ. قَالَ: ق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_616", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَلَمَّا دَخَلَ عَلَى امْرَأَتِهِ قَالَ: وَيْحَكِ، جَاءَ النَّبِيُّ بِالْمُهَاجِرِينَ وَالْأَنْصَارِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_617", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَفِي الصَّحِيحَيْنِ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ: قَالَ أَبُو طَلْحَةَ لِأُمِّ سُلَيْمٍ: قَدْ س"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_618", "reason": "high_symbol_ratio:0.431", "chunk_text": "نَعَمْ. فَقَالَ: بِالطَّعَامِ؟ فَقُلْتُ: نَعَمْ. فَقَالَ رَسُولُ اللَّهِ لِمَنْ مَعَهُ: قُومُوا. قَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_619", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَقَالَتْ: اللَّهُ وَرَسُولُهُ أَعْلَمُ. قَالَ: فَانْطَلَقَ أَبُو طَلْحَةَ حَتَّى لَقِيَ رَسُولَ الل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_620", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَأَتَتْ بِذَلِكَ الْخُبْزِ فَفُتَّ، وَعَصَرَتْ عَلَيْهِ أُمُّ سُلَيْمٍ عُكَّةً لَهَا فَأَدَمَتْهُ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_621", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَأَذِنَ لَهُمْ فَأَكَلُوا حَتَّى شَبِعُوا ثُمَّ خَرَجُوا، ثُمَّ قَالَ: ائْذَنْ لِعَشَرَةٍ. فَأَذِنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_622", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي طَرِيقِ الْبُخَارِيِّ ثَمَانُونَ، وَقَالَ فِي رِوَايَةٍ: ثُمَّ أَكَلَ رَسُولُ اللَّهِ وَأَبُو "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_623", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنْ سَلَمَةَ قَالَ: كُنَّا مَعَ رَسُولِ اللَّهِ فِي غَزْوَةِ خَيْبَرَ فَأَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_624", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَبِي هُرَيْرَةَ، وَأَبِي سَعِيدٍ، وَسَلَمَةَ بْنِ الْأَكْوَعِ، وَاللَّفْظ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_625", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: فَفَعَلَ، فَجَاءَ ذُو الْبُرِّ بِبُرِّهِ، وَذُو التَّمْرِ بِتَمْرِهِ، وَذُو النَّوَى بِنَوَاه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_626", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ: فَدَعَا عَلَيْهَا حَتَّى مَلَأَ الْقَوْمُ أَزْوَادَهُمْ، قَالَ: فَقَالَ عِنْدَ ذَلِكَ: أَشْهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_627", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَفِي لَفْظٍ آخَرَ قَالَ: لَمَّا كَانَ يَوْمَ غَزْوَةِ تَبُوكَ أَصَابَ النَّاسَ مَجَاعَةٌ، فَقَالُوا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_628", "reason": "high_symbol_ratio:0.431", "chunk_text": "قَالَ: فَجَاءَ عُمَرُ، فَقَالَ: يَا رَسُولَ اللَّهِ، إِنْ فَعَلْتَ قَلَّ الظَّهْرُ. وَفِي رِوَايَةٍ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_629", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : نَعَمْ. فَدَعَا بِنِطَعٍ فَبَسَطَهُ، ثُمَّ دَعَا بِفَضْلِ أَزْوَادِهِمْ. ق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_630", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: فَدَعَا رَسُولُ اللَّهِ بِالْبَرَكَةِ، ثُمَّ قَالَ: خُذُوا فِي أَوْعِيَتِكُمْ. قَالَ: فَأَخَذ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_631", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَرَوَى الْبُخَارِيُّ مِنْ حَدِيثِ سَلَمَةَ بْنِ الْأَكْوَعِ قَالَ: خَرَجْنَا مَعَ رَسُولِ اللَّهِ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_632", "reason": "high_symbol_ratio:0.444", "chunk_text": "فِيهَا نُطْفَةٌ، فَأَفْرَغَهَا فِي قَدَحٍ، فَتَوَضَّأْنَا كُلُّنَا نُدَغْفِقُهُ دَغْفَقَةً أَرْبَعَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_633", "reason": "high_symbol_ratio:0.416", "chunk_text": "ثُمَّ جَاءَ بَعْدَ ذَلِكَ ثَمَانِيَةٌ، فَقَالُوا: هَلْ مِنْ طَهُورٍ؟ فَقَالَ رَسُولُ اللَّهِ : فَرِغ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_634", "reason": "high_symbol_ratio:0.419", "chunk_text": "قَالَ: لَوْ تَرَكْتِيهَا مَا زَالَ قَائِمًا. وَرَوَى مُسْلِمٌ فِي صَحِيحِهِ عَنْ جَابِرٍ أَيْضًا قَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_635", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَنَسِ بْنِ مَالِكٍ قَالَ: تَزَوَّجَ النَّبِيُّ زَيْنَبَ فَدَخَلَ بِأَهْلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_636", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَقُلْ: بَعَثَتْ بِهَذَا أُمِّي إِلَيْكَ وَهِيَ تُقْرِئُكَ السَّلَامَ، وَتَقُولُ: إِنَّ هَذَا لَكَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_637", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: فَذَهَبْتُ بِهَا إِلَى رَسُولِ اللَّهِ فَقُلْتُ: إِنَّ أُمِّي تُقْرِئُكَ السَّلَامَ وَتَقُولُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_638", "reason": "high_symbol_ratio:0.403", "chunk_text": "فَقَالَ: ضَعْهُ، ثُمَّ قَالَ: اذْهَبْ فَادْعُ فُلَانًا وَفُلَانًا وَفُلَانًا وَمَنْ لَقِيتَ، وَسَمَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_639", "reason": "high_symbol_ratio:0.440", "chunk_text": "قَالَ: فَدَخَلُوا حَتَّى امْتَلَأَتِ الصُّفَّةُ وَالْحُجْرَةُ، فَقَالَ رَسُولُ اللَّهِ : لِيَتَحَلَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_640", "reason": "high_symbol_ratio:0.429", "chunk_text": "قَالَ: فَأَكَلُوا حَتَّى شَبِعُوا. قَالَ: فَخَرَجَتْ طَائِفَةٌ، وَدَخَلَتْ طَائِفَةٌ حَتَّى أَكَلُوا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_641", "reason": "high_symbol_ratio:0.440", "chunk_text": "وَذَكَرَ نُزُولَ آيَةِ الْحِجَابِ. وَرَوَى الْبُخَارِيُّ عَنْ أَنَسٍ أَيْضًا: أَنَّ أُمَّ سُلَيْمٍ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_642", "reason": "high_symbol_ratio:0.438", "chunk_text": "فَخَرَجَ إِلَيْهِ أَبُو طَلْحَةَ فَقَالَ: يَا رَسُولَ اللَّهِ، إِنَّمَا هُوَ شَيْءٌ صَنَعَتْهُ أُمُّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_643", "reason": "high_symbol_ratio:0.433", "chunk_text": "حَتَّى عَدَّ أَرْبَعِينَ، ثُمَّ أَكَلَ النَّبِيُّ ، ثُمَّ قَامَ فَجَعَلْتُ أَنْظُرُ هَلْ نَقَصَ مِنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_644", "reason": "high_symbol_ratio:0.437", "chunk_text": "رَوَاهُ النَّسَائِيُّ، وَالتِّرْمِذِيُّ، وَقَالَ: حَدِيثٌ حَسَنٌ صَحِيحٌ، وَرَوَاهُ الدَّارِمِيُّ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_645", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي الْبُخَارِيِّ عَنْ أَبِي هُرَيْرَةَ أَنَّهُ كَانَ يَقُولُ: وَاللَّهِ الَّذِي لَا إِلَهَ إِلَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_646", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَتَبَسَّمَ حِينَ رَآنِي، وَعَرَفَ مَا فِي وَجْهِي وَمَا فِي نَفْسِي، ثُمَّ قَالَ: أَبَا هِرٍّ، قُلْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_647", "reason": "high_symbol_ratio:0.435", "chunk_text": "قَالَ: أَبَا هِرٍّ. قُلْتُ: لَبَّيْكَ يَا رَسُولَ اللَّهِ، قَالَ: الْحَقْ أَهْلَ الصُّفَّةِ فَادْعُه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_648", "reason": "high_symbol_ratio:0.414", "chunk_text": "قَالَ: وَأَهْلُ الصُّفَّةِ أَضْيَافُ الْإِسْلَامِ لَا يَأْوُونَ إِلَى أَهْلٍ وَلَا إِلَى مَالٍ، إِذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_649", "reason": "high_symbol_ratio:0.446", "chunk_text": "رَسُولِهِ بُدٌّ، فَأَتَيْتُهُمْ فَدَعَوْتُهُمْ، فَأَقْبَلُوا، فَأَذِنَ لَهُمْ، وَأَخَذُوا مَجَالِسَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_650", "reason": "high_symbol_ratio:0.444", "chunk_text": "قَالَ: خُذْ فَأَعْطِهِمْ. فَأَخَذْتُ الْقَدَحَ، فَجَعَلْتُ أُعْطِيهِ الرَّجُلَ فَيَشْرَبُ حَتَّى يَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_651", "reason": "high_symbol_ratio:0.437", "chunk_text": "قَالَ: بَقِيتُ أَنَا وَأَنْتَ. قُلْتُ: صَدَقْتَ يَا رَسُولَ اللَّهِ، قَالَ: اقْعُدْ فَاشْرَبْ، فَقَع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_652", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَشَرِبْتُ، فَمَا زَالَ يَقُولُ: اشْرَبْ، حَتَّى قُلْتُ: لَا وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أَجِد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_653", "reason": "high_symbol_ratio:0.457", "chunk_text": "قَالَ: فَأَرِنِي. فَأَعْطَيْتُهُ الْقَدَحَ، فَحَمِدَ اللَّهَ وَسَمَّى، وَشَرِبَ الْفَضْلَةَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_654", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ قَالَ: كُنَّا مَعَ رَسُول"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_655", "reason": "high_symbol_ratio:0.418", "chunk_text": "حُزَّةً مِنْ سَوَادِ بَطْنِهَا، إِنْ كَانَ شَاهِدًا أَعْطَاهُ، وَإِنْ كَانَ غَائِبًا خَبَّأَ لَهُ، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_656", "reason": "high_symbol_ratio:0.402", "chunk_text": "===فصل: من آيات النبوة تكثير الثمار=== وَأَمَّا تَكْثِيرُ الثِّمَارِ فَفِي صَحِيحِ الْبُخَارِيِّ، عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_657", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَالَ: اذْهَبْ فَبَيْدِرْ كُلَّ تَمْرٍ عَلَى نَاحِيَةٍ. فَفَعَلْتُ، ثُمَّ دَعَوْتُهُ، فَلَمَّا نَظَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_658", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَمَا زَالَ يَكِيلُ لَهُمْ حَتَّى أَدَّى اللَّهُ عَنْ وَالِدِي أَمَانَتَهُ، وَأَنَا أَرْضَى أَنْ يُؤ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_659", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَفِي رِوَايَةٍ: أَنَّ أَبَاهُ تَرَكَ عَلَيْهِ ثَلَاثِينَ وَسْقًا لِرَجُلٍ مِنَ الْيَهُودِ، فَاسْتَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_660", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَجَدَّ لَهُ بَعْدَ مَا رَاحَ رَسُولُ اللَّهِ ثَلَاثِينَ وَسْقًا، وَفَضَلَ لَهُ سَبْعَةَ عَشَرَ وَسْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_661", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَذَهَبَ جَابِرٌ إِلَى عُمَرَ، فَأَخْبَرَهُ، فَقَالَ عُمَرُ: لَقَدْ عَلِمْتُ حِينَ مَشَى فِيهَا رَسُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_662", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَرَوَى الْإِمَامُ أَحْمَدُ وَالتِّرْمِذِيُّ وَغَيْرُهُمَا حَدِيثَ مِزْوَدِ أَبِي هُرَيْرَةَ قَالَ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_663", "reason": "high_symbol_ratio:0.455", "chunk_text": "قَالَ: فَصَفَّهُنَّ بَيْنَ يَدَيْهِ، قَالَ: ثُمَّ دَعَا، فَقَالَ لِي: اجْعَلْهُنَّ فِي مِزْوَدِكَ، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_664", "reason": "high_symbol_ratio:0.417", "chunk_text": "قَالَ: فَجَعَلْتُ مِنْهُ كَذَا وَكَذَا وَسْقًا فِي سَبِيلِ اللَّهِ، وَنَأْكُلُ وَنُطْعِمُ، وَكَانَ ل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_665", "reason": "high_symbol_ratio:0.423", "chunk_text": "رَوَاهُ التِّرْمِذِيُّ عَنْ عِمْرَانَ بْنِ مُوسَى الْقَزَّازِ، عَنْ حَمَّادٍ بِنَحْوِهِ، وَقَالَ: حَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_666", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَرَوَاهُ الْحَافِظُ عَبْدُ الْغَنِيِّ وَغَيْرُهُ مِنْ طَرِيقٍ أُخْرَى، عَنْ مُحَمَّدِ بْنِ سِيرِينَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_667", "reason": "high_symbol_ratio:0.438", "chunk_text": "فَجِئْتُ بِالْمِزْوَدِ، وَقَالَ: هَاتِ نِطَعًا. فَجِئْتُ بِالنِّطَعِ فَبَسَطَهُ، فَأَدْخَلَ يَدَهُ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_668", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَجَعَلَ يَضَعُ كُلَّ تَمْرَةٍ، وَيُسَمِّي حَتَّى أَتَى عَلَى التَّمْرِ، فَقَالَ بِهِ هَكَذَا، فَجَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_669", "reason": "high_symbol_ratio:0.444", "chunk_text": "فَقَعَدْتُ فَأَكَلَ، وَأَكَلْتُ، قَالَ، وَفَضَلَ تَمْرٌ فَأَخَذَهُ، فَأَدْخَلَهُ فِي الْمِزْوَدِ، فَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_670", "reason": "high_symbol_ratio:0.421", "chunk_text": "قَالَ: فَمَا كُنْتُ أُرِيدُ تَمْرًا إِلَّا أَدْخَلْتُ يَدِي فَأَخَذْتُ مِنْهُ خَمْسِينَ وَسْقًا فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_671", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَرَوَاهُ مِنْ طَرِيقِ يَزِيدَ بْنِ أَبِي مَنْصُورٍ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ: أُصِبْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_672", "reason": "high_symbol_ratio:0.444", "chunk_text": "قَالَ: فَائْتِنِي بِهِ. فَأَتَيْتُهُ بِهِ، فَأَدْخَلَ يَدَهُ فَأَخْرَجَ قَبْضَةً فَبَسَطَهَا، ثُمَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_673", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَأَكَلُوا حَتَّى شَبِعُوا، ثُمَّ أَدْخَلَ يَدَهُ فَأَخْرَجَ قَبْضَةً فَبَسَطَهَا، ثُمَّ قَالَ: ادْع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_674", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَمَا زَالَ يَصْنَعُ كَذَلِكَ حَتَّى أَطْعَمَ الْجَيْشَ كُلَّهُمْ وَشَبِعُوا، ثُمَّ قَالَ: خُذْ مَا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_675", "reason": "high_symbol_ratio:0.437", "chunk_text": "قَالَ: أَبُو هُرَيْرَةَ: فَقَبَضْتُ عَلَى أَكْثَرَ مِمَّا جِئْتُ بِهِ، ثُمَّ قَالَ أَبُو هُرَيْرَةَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_676", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَرَوَى الْإِمَامُ أَحْمَدُ فِي مُسْنَدِهِ، ثَنَا يَعْلَى بْنُ عُبَيْدٍ، ثَنَا إِسْمَاعِيلُ، عَنْ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_677", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَقَالَ: يَا رَسُولَ اللَّهِ، مَا بَقِيَ إِلَّا آصُعٌ مِنْ تَمْرٍ مَا أُرَاهُ يَقِيظُنِي. قَالَ: قَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_678", "reason": "high_symbol_ratio:0.421", "chunk_text": "قَالَ: سَمْعٌ وَطَاعَةٌ. قَالَ: فَأَخْرَجَ عُمَرُ الْمِفْتَاحَ مِنْ حُجْزَتِهِ، فَفَتَحَ الْبَابَ، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_679", "reason": "high_symbol_ratio:0.456", "chunk_text": "فَأَخَذَ كُلُّ رَجُلٍ مِنَّا مَا أَحَبَّ، ثُمَّ الْتَفَتُّ، وَكُنْتُ مِنْ آخَرِ الْقَوْمِ، وَكَأَنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_680", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَرَوَاهُ أَبُو دَاوُدَ عَنْ عَبْدِ الرَّحِيمِ بْنِ مُطَرِّفٍ، عَنْ عِيسَى بْنِ يُونُسَ، عَنْ إِسْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_682", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرِ بْنِ سَمُرَةَ، عَنِ النَّبِيِّ أَنَّهُ قَالَ: إِنِّي لَأَعْرِفُ حَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_683", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَفِي التِّرْمِذِيِّ، عَنْ عَلِيٍّ، قَالَ: كُنْتُ مَعَ النَّبِيِّ بِمَكَّةَ فَخَرَجْنَا فِي بَعْضِ ن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_685", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ عَنْ سَلَمَةَ بْنِ الْأَكْوَعِ قَالَ: غَزَوْنَا مَعَ رَسُولِ اللَّهِ حُنَيْنً"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_686", "reason": "high_symbol_ratio:0.401", "chunk_text": "جَمِيعًا وَمَرَرْتُ عَلَى رَسُولِ اللَّهِ مُنْهَزِمًا وَهُوَ عَلَى بَغْلَتِهِ الشَّهْبَاءِ، فَقَالَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_687", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَلَمَّا غَشُوا النَّبِيَّ نَزَلَ عَنِ الْبَغْلَةِ، ثُمَّ قَبَضَ قَبْضَةً مِنَ الْأَرْضِ، وَاسْتَقْب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_688", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَمَا خَلَقَ اللَّهُ مِنْهُمْ إِنْسَانًا إِلَّا مَلَأَ عَيْنَيْهِ تُرَابًا بِتِلْكَ الْقَبْضَةِ، فَو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_689", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ، عَنِ الْعَبَّاسِ بْنِ عَبَدِ الْمُطَّلِبِ قَالَ: شَهِدْتُ مَعَ رَسُولِ اللَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_690", "reason": "high_symbol_ratio:0.412", "chunk_text": "بِرِكَابِ رَسُولِ اللَّهِ إِرَادَةَ أَنْ لَا تُسْرِعَ، فَقَالَ رَسُولُ اللَّهِ : أَيْ عَبَّاسُ، نَاد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_691", "reason": "high_symbol_ratio:0.406", "chunk_text": "يَا لَبَّيْكَ يَا لَبَّيْكَ. قَالَ: فَاقْتَتَلُوا وَالْكُفَّارَ، وَالدَّعْوَةُ فِي الْأَنْصَارِ يَقُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_692", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَنَظَرَ رَسُولُ اللَّهِ ، وَهُوَ عَلَى بَغْلَتِهِ كَالْمُتَطَاوِلِ عَلَيْهَا إِلَى قِتَالِهِمْ، فَق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_693", "reason": "high_symbol_ratio:0.425", "chunk_text": "ثُمَّ أَخَذَ رَسُولُ اللَّهِ حَصَيَاتٍ فَرَمَى وُجُوهَ الْكُفَّارِ، ثُمَّ قَالَ: انْهَزَمُوا وَرَبِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_694", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: فَذَهَبْتُ أَنْظُرُ فَإِذَا الْقِتَالُ عَلَى هَيْئَتِهِ فِيمَا أَرَى، فَوَاللَّهِ مَا هُوَ إِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_695", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَجَعَلَ رَسُولُ اللَّهِ يُنَاشِدُ رَبَّهُ مَا وَعَدَهُ مِنْ نَصْرِهِ وَيَقُولُ: اللَّهُمَّ إِنْ تَه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_696", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَبُو بَكْرٍ يَقُولُ: بَعْدَ مُنَاشَدَتِكَ رَبَّكَ يَا رَسُولَ اللَّهِ فَإِنَّ اللَّهَ سَيُنْجِزُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_697", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَخَفَقَ رَسُولُ اللَّهِ خَفْقَةً، ثُمَّ هَبَّ، فَقَالَ رَسُولُ اللَّهِ : أَبْشِرْ يَا أَبَا بَكْرٍ،"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_698", "reason": "high_symbol_ratio:0.414", "chunk_text": "حَصْبَاءَ ثُمَّ اسْتَقْبَلَ بِهَا قُرَيْشًا، فَنَفَخَ بِهَا وُجُوهَهُمْ، وَقَالَ: شَاهَتِ الْوُجُوهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_699", "reason": "high_symbol_ratio:0.439", "chunk_text": "فَحَمَلَ الْمُسْلِمُونَ وَهَزَمَ اللَّهُ قُرَيْشًا، وَقُتِلَ مَنْ قُتِلَ مِنْ أَشْرَافِهِمْ، وَأُسِر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_700", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَفِي حَدِيثِ ابْنِ أَبِي طَلْحَةَ، عَنِ ابْنِ عَبَّاسٍ، فَقَالَ لَهُ جِبْرِيلُ: خُذْ قَبْضَةً مِنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_702", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَقَالَ تَعَالَى: إِذْ تَقُولُ لِلْمُؤْمِنِينَ أَلَنْ يَكْفِيَكُمْ أَنْ يُمِدَّكُمْ رَبُّكُمْ بِثَلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_703", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ تَعَالَى فِي حُنَيْنٍ: ثُمَّ أَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_704", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَقَالَ تَعَالَى فِي الْهِجْرَةِ: ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_706", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي الصَّحِيحَيْنِ وَاللَّفْظُ لِمُسْلِمٍ عَنِ ابْنِ عَبَّاسٍ، عَنْ عُمَرَ بْنِ الْخَطَّابِ قَالَ:"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_707", "reason": "high_symbol_ratio:0.432", "chunk_text": "حَتَّى أَسْقَطَ رِدَاءَهُ عَنْ مَنْكِبَيْهِ، فَأَتَاهُ أَبُو بَكْرٍ فَأَخَذَ رِدَاءَهُ فَأَلْقَاهُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_708", "reason": "high_symbol_ratio:0.445", "chunk_text": "فَأَنْزَلَ اللَّهُ عَزَّ وَجَلَّ: إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_709", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَالَ أَبُو زُمَيْلٍ: فَحَدَّثَنِي ابْنُ عَبَّاسٍ قَالَ: بَيْنَمَا رَجُلٌ مِنَ الْمُسْلِمِينَ يَوْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_710", "reason": "high_symbol_ratio:0.440", "chunk_text": "فَنَظَرَ إِلَى الْمُشْرِكِ أَمَامَهُ فَخَرَّ مُسْتَلْقِيًا فَنَظَرَ إِلَيْهِ فَإِذَا قَدْ خُطِمَ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_711", "reason": "high_symbol_ratio:0.417", "chunk_text": "ذَلِكَ مِنْ مَدَدِ السَّمَاءِ الثَّالِثَةِ \" فَقَتَلُوا يَوْمَئِذٍ سَبْعِينَ، وَأَسَرُوا سَبْعِينَ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_712", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَذَكَرَ الْبُخَارِيُّ فِي هَذَا الْحَدِيثِ فَخَرَجَ يَعْنِي النَّبِيَّ ، وَهُوَ يَقُولُ سَيُهْزَمُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_713", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ ابْنُ إِسْحَاقَ: حَدَّثَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرِ بْنِ حَزْمٍ عَنْ بَعْضِ بَنِي س"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_714", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَلَمَّا نَزَلَتِ الْمَلَائِكَةُ، وَرَآهَا إِبْلِيسُ، وَأَوْحَى اللَّهُ إِلَيْهِمْ: أَنِّي مَعَكُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_715", "reason": "high_symbol_ratio:0.429", "chunk_text": "إِيَّاكُمْ فَإِنَّهُ عَلَى مَوْعِدٍ مِنْ مُحَمَّدٍ وَأَصْحَابِهِ. ثُمَّ قَالَ: وَاللَّاتِ وَالْعُزَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_716", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ قَالَ: رَأَيْتُ يَوْمَ أُحُدٍ عَنْ يَمِينِ النَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_717", "reason": "high_symbol_ratio:0.417", "chunk_text": "رَسُولُ اللَّهِ مِنَ الْخَنْدَقِ، وَضَعَ السِّلَاحَ فَاغْتَسَلَ فَأَتَاهُ جِبْرِيلُ ، وَهُوَ يَنْفُض"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_718", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : فَأَيْنَ؟ فَأَشَارَ إِلَى بَنِي قُرَيْظَةَ فَقَاتَلَهُمْ رَسُولُ اللَّهِ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_719", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَرَوَى الْبُخَارِيُّ عَنْ أَنَسٍ قَالَ: كَأَنِّي أَنْظُرُ إِلَى الْغُبَارِ سَاطِعًا فِي زُقَاقِ بَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_720", "reason": "high_symbol_ratio:0.408", "chunk_text": "بَدْرٍ: \" هَذَا جِبْرِيلُ آخِذٌ بِرَأْسِ فَرَسِهِ عَلَيْهِ أَدَاةُ الْحَرْبِ \" وَفِي الصَّحِيحَيْنِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_721", "reason": "high_symbol_ratio:0.419", "chunk_text": "قَدْ أَظَلَّتْنِي فَنَظَرْتُ فَإِذَا فِيهَا جِبْرِيلُ فَنَادَانِي فَقَالَ: إِنَّ اللَّهَ قَدْ سَمِعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_722", "reason": "high_symbol_ratio:0.436", "chunk_text": "قَالَ: فَنَادَانِي مَلَكُ الْجِبَالِ، وَسَلَّمَ عَلَيَّ ثُمَّ قَالَ: يَا مُحَمَّدُ: إِنَّ اللَّهَ قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_723", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : \" بَلْ أَرْجُو أَنْ يُخْرِجَ اللَّهُ مِنْ أَصْلَابِهِمْ مَنْ يَعْبُدُ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_725", "reason": "high_symbol_ratio:0.405", "chunk_text": "إِلَيْنَا وَمَا أُنْزِلَ إِلَى إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطِ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_726", "reason": "high_symbol_ratio:0.422", "chunk_text": "أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_727", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَكُلٌّ مِنْ هَذِهِ الْأَخْبَارِ الثَّلَاثَةِ الْعَامَّةِ قَدْ وَقَعَ كَمَا أَخْبَرَ، وَفِي هَذَا عِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_728", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْعَرَبِ، وَكَانَ أَهْلُ مَكَّةَ أَهْلُ الْحَرَمِ أَعَزَّ النَّاسِ وَأَشْرَفَهُمْ يُعَظِّمُهُمْ جَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_729", "reason": "high_symbol_ratio:0.413", "chunk_text": "إِنْعَامِ اللَّهِ عَلَيْهِ النِّعْمَةَ الَّتِي لَمْ يُنْعِمِ اللَّهُ بِهَا عَلَى غَيْرِهِمْ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_730", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَكَانَ أَهْلُ مَكَّةَ مُعَظَّمِينَ لِأَنَّهُمْ جِيرَانُ الْبَيْتِ، وَلِأَنَّهُمْ أَشْرَفُ بَنِي إِس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_731", "reason": "high_symbol_ratio:0.433", "chunk_text": "فَضْلُ مَدِينَتِهِمْ، وَكَذَلِكَ كَفَى اللَّهُ مُحَمَّدًا مَنْ عَادَاهُ، وَانْتَقَمَ مِنْهُمْ، وَلَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_732", "reason": "high_symbol_ratio:0.406", "chunk_text": "آمِنَةً مُطْمَئِنَّةً يَأْتِيهَا رِزْقُهَا رَغَدًا مِنْ كُلِّ مَكَانٍ فَكَفَرَتْ بِأَنْعُمِ اللَّهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_733", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَفِي الصَّحِيحَيْنِ عَنْ أَبِي هُرَيْرَةَ قَالَ: قَالَ أَبُو جَهْلٍ هَلْ يُعَفِّرُ مُحَمَّدٌ وَجْهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_734", "reason": "high_symbol_ratio:0.435", "chunk_text": "قَالَ: وَاللَّاتِ وَالْعُزَّى لَئِنْ رَأَيْتُهُ يَفْعَلُ ذَلِكَ لَأَطَأَنَّ عَلَى رَقَبَتِهِ. فَمَا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_735", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : \" لَوْ دَنَا مِنِّي لَاخْتَطَفَتْهُ الْمَلَائِكَةُ عُضْوًا عُضْوًا \" وَأَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_736", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَأَبِي بَكْرٍ مِنْ مَكَّةَ إِلَى الْمَدِينَةِ قَالَ فِيهِ: وَاتَّبَعَنَا سُرَاقَةُ بْنُ مَالِكِ بْن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_737", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَقَالَ: لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا. فَدَعَا عَلَيْهِ رَسُولُ اللَّهِ فَارْتَطَمَتْ فَرَسُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_739", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي لَفْظٍ: \" فَسَاخَ فَرَسُهُ فِي الْأَرْضِ إِلَى بَطْنِهِ، وَوَثَبَ عَنْهُ فَقَالَ: يَا مُحَمَّد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_740", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَبَيْنَمَا أَنَا جَالِسٌ فِي مَجْلِسِ قَوْمِي بَنِي مُدْلِجٍ إِذْ أَقْبَلَ رَجُلٌ مِنْهُمْ حَتَّى ق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_741", "reason": "high_symbol_ratio:0.430", "chunk_text": "قَالَ سُرَاقَةُ: فَعَرَفْتُ أَنَّهُمْ هُمْ فَقُلْتُ: لَيْسُوا بِهِمْ، وَلَكِنَّكَ رَأَيْتَ فُلَانًا "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_742", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَاسْتَخْرَجْتُ مِنْهَا الْأَزْلَامَ فَاسْتَقْسَمْتُ بِهَا فَخَرَجَ الَّذِي أَكْرَهُ فَرَكِبْتُ وَعَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_743", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَوَقَفُوا، فَرَكِبْتُ فَرَسِي حَتَّى جِئْتُهُمْ، وَوَقَعَ فِي نَفْسِي حِينَ لَقِيتُ مَا لَقِيتُ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_744", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَذَكَرَ تَمَامَ الْحَدِيثِ. وَفِي الصَّحِيحَيْنِ عَنْ جَابِرٍ قَالَ: غَزَوْنَا مَعَ رَسُولِ اللَّهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_745", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَقَالَ: مَنْ يَمْنَعُكَ مِنِّي؟ قُلْتُ: اللَّهُ، فَشَامَ السَّيْفَ، فَهَا هُوَ ذَا جَالِسٌ \" ثُمَّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_746", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَفِي صَحِيحِ الْحَاكِمِ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ الصِّدِّيقِ قَالَ: كَانَ فُلَانٌ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_747", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَنَسِ بْنِ مَالِكٍ قَالَ: كَانَ رَجُلٌ نَصْرَانِيٌّ فَأَسْلَمَ، وَقَرَأَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_748", "reason": "high_symbol_ratio:0.420", "chunk_text": "فَقَالَ رَسُولُ اللَّهِ : \" اللَّهُمَّ اجْعَلْهُ آيَةً \" فَأَمَاتَهُ اللَّهُ فَأَصْبَحَ وَقَدْ لَفَظ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_749", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَحَفَرُوا لَهُ فَأَعْمَقُوا مَا اسْتَطَاعُوا، فَأَصْبَحَ وَقَدْ لَفَظَتْهُ الْأَرْضُ فَقَالُوا مِثْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_750", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَرَوَى الْإِمَامُ أَحْمَدُ مِنْ حَدِيثِ ابْنِ إِسْحَاقَ قَالَ: حَدَّثَنِي يَحْيَى بْنُ عُرْوَةَ عَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_751", "reason": "high_symbol_ratio:0.412", "chunk_text": "لَقَدْ صَبَرْنَا مِنْهُ عَلَى أَمْرٍ عَظِيمٍ. أَوْ كَمَا قَالُوا. فَبَيْنَمَا هُمْ فِي ذَلِكَ إِذْ ط"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_752", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَالَ: فَعَرَفْتُ ذَلِكَ فِي وَجْهِهِ، ثُمَّ مَضَى فَلَمَّا مَرَّ الثَّانِيَةَ غَمَزُوهُ بِمِثْلِهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_753", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْقَاسِمِ، انْصَرِفْ رَاشِدًا، فَوَاللَّهِ مَا كُنْتَ جَهُولًا. فَانْصَرَفَ رَسُولُ اللَّهِ ، حَتَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_754", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَبَيْنَمَا هُمْ فِي ذَلِكَ طَلَعَ رَسُولُ اللَّهِ فَوَثَبُوا إِلَيْهِ وَثْبَةَ رَجُلٍ وَاحِدٍ فَأَح"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_755", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: فَيَقُولُ رَسُولُ اللَّهِ : \" نَعَمْ أَنَا الَّذِي أَقُولُ ذَلِكَ \"."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_756", "reason": "high_symbol_ratio:0.416", "chunk_text": "قَالَ: فَلَقَدْ رَأَيْتُ رَجُلًا مِنْهُمْ أَخَذَ بِمَجْمَعِ رِدَائِهِ، وَقَامَ أَبُو بَكْرٍ دُونَهُ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_757", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالْأَسْوَدُ بْنُ الْمُطَّلِبِ أَبُو زَمْعَةَ مِنْ بَنِي أَسَدِ بْنِ عَبْدِ الْعُزَّى، وَالْحَارِثُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_758", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَأَوْمَأَ إِلَى أَخْمَصِ الْعَاصِ بْنِ وَائِلٍ فَقَالَ: مَا صَنَعْتَ؟ قَالَ: كُفِيتَهُ. فَأَمَّا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_759", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَجَعَلُوا يَقُولُونَ: مَا نَرَى شَيْئًا، فَلَمْ يَزَلْ كَذَلِكَ حَتَّى عَمِيَتْ عَيْنَاهُ. وَأَمَّا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_760", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَّا الْحَارِثُ بْنُ عَيْطَلٍ فَأَخَذَهُ الْمَاءُ الْأَصْفَرُ فِي بَطْنِهِ حَتَّى خَرَجَ خَرْؤُه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_761", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَأَمَّا الْعَاصُ بْنُ وَائِلٍ فَرَكِبَ إِلَى الطَّائِفِ عَلَى حِمَارٍ فَرَبَضَ بِهِ فِي شَبْرَقَةٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_762", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقِيلَ: دَخَلَتْ فِي رَأْسِهِ شَبْرَقَةٌ فَمَاتَ. رَوَاهُ ابْنُ أَبِي حَاتِمٍ فِي تَفْسِيرِهِ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_763", "reason": "high_symbol_ratio:0.413", "chunk_text": "قَالَ: ثَنَا يُونُسُ بْنُ حَبِيبٍ ثَنَا أَبُو دَاوُدَ ثَنَا أَبُو عَوَانَةَ ثَنَا أَبُو بِشْرٍ عَنْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_764", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَأَهْلَكَهُمُ اللَّهُ، كُلٌّ مِنْهُمْ أَصَابَهُ عَذَابٌ سِوَى عَذَابِ صَاحَبِهِ، وَذَكَرَ تَفْصِيلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_765", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَقَالَ مُحَمَّدُ بْنُ إِسْحَاقَ ثَنَا يَزِيدُ بْنُ رُومَانَ عَنْ عُرْوَةَ، وَغَيْرِهِ مِنَ الْعُلَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_766", "reason": "high_symbol_ratio:0.450", "chunk_text": "فَانْتَقَضَ فَمَاتَ."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_767", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمَرَّ بِهِ الْعَاصُ بْنُ وَائِلٍ فَأَشَارَ إِلَى إِخْمَصِ قَدَمِهِ فَذَكَرَ مِثْلَ مَا تَقَدَّمَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_768", "reason": "high_symbol_ratio:0.415", "chunk_text": "تَسَلَّطَ عَلَيْهِ بِالْأَذَى، وَشَقَّ قَمِيصَهُ، فَقَالَ رَسُولُ اللَّهِ : \" اللَّهُمَّ سَلِّطْ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_769", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَتَلَنِي وَهُوَ بِمَكَّةَ وَأَنَا بِالشَّامِ، فَعَدَا عَلَيْهِ الْأَسَدُ مِنْ بَيْنِ الْقَوْمِ، وَأ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_770", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ قَالَ: بَيْنَمَا رَسُولُ اللَّهِ يُصَلِّي عِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_771", "reason": "high_symbol_ratio:0.429", "chunk_text": "اللَّهِ ، وَالنَّبِيُّ سَاجِدٌ مَا رَفَعَ رَأْسَهُ حَتَّى انْطَلَقَ إِنْسَانٌ إِلَى فَاطِمَةَ فَجَاء"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_772", "reason": "high_symbol_ratio:0.431", "chunk_text": "رَبِيعَةَ، وَالْوَلِيدِ بْنِ عُتْبَةَ، وَأُمَيَّةَ بْنِ خَلَفٍ، وَعُقْبَةَ بْنِ أَبِي مُعَيْطٍ، وَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_773", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَعَنْهُ قَالَ: اسْتَقْبَلَ رَسُولُ اللَّهِ الْقِبْلَةَ، وَدَعَا عَلَى سِتَّةِ نَفَرٍ فَذَكَرَهُ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_774", "reason": "high_symbol_ratio:0.448", "chunk_text": "وَقَالَ: غَيَّرَتْهُمُ الشَّمْسُ، وَكَانَ يَوْمًا حَارًّا."}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_775", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَيَدْخُلُ فِي هَذَا الْبَابِ مَا لَمْ يَزَلِ النَّاسُ يَرَوْنَهُ وَيَسْمَعُونَهُ مِنَ انْتِقَامِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_776", "reason": "high_symbol_ratio:0.413", "chunk_text": "هَذَا الْبَابِ مَا فِيهِ عِبْرَةٌ لِأُولِي الْأَلْبَابِ، وَمِنَ الْمَعْرُوفِ الْمَشْهُورِ الْمُجَرَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_777", "reason": "high_symbol_ratio:0.448", "chunk_text": "كِتَابَهُ مَزَّقَ اللَّهُ مُلْكَ الْأَكَاسِرَةِ كُلَّ مُمَزَّقٍ، وَلَمَّا أَكْرَمَ هِرَقْلُ وَالْمُق"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_779", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَمَعْلُومٌ أَنَّ مَنْ عَوَّدَهُ اللَّهُ إِجَابَةَ دُعَائِهِ لَا يَكُونُ إِلَّا مَعَ صَلَاحِهِ وَدِي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_780", "reason": "high_symbol_ratio:0.410", "chunk_text": "ضَالًّا فِي ذَلِكَ، وَالَّذِي يَأْتِيهِ الشَّيْطَانُ فَإِنَّ هَذَا حَالُ مَنْ هُوَ جَاهِلٌ بِحَالِ ن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_781", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَالْأَوَامِرِ مُخَالِفٌ مِنْ كُلِّ وَجْهٍ لِمَا يَأْتِي بِهِ الشَّيْطَانُ، وَمَنِ اسْتَقْرَأَ أَحْو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_782", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَالشَّيْطَانُ الَّذِي يَقُولُ لِمَنْ لَيْسَ بِنَبِيٍّ: إِنَّكَ نَبِيٌّ صَادِقٌ، وَاللَّهُ أَرْسَلَن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_783", "reason": "high_symbol_ratio:0.413", "chunk_text": "بَعْضِ مَا تُخْبِرُهُ بِهِ تَحْقِيقًا لِقَوْلِهِ تَعَالَى: هَلْ أُنَبِّئُكُمْ عَلَى مَنْ تَنَزَّلُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_784", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْأَنْبِيَاءُ مَعْصُومُونَ مِنَ الْإِقْرَارِ عَلَى الْخَطَأِ فِيمَا يُبَلِّغُونَهُ عَنِ اللَّهِ ب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_785", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَمَنْ كَانَ يَأْتِيهِ صَادِقٌ وَكَاذِبٌ مِثْلَ ابْنِ صَيَّادٍ، وَمِثْلَ كَثِيرٍ مِنَ الْعُبَّادِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_786", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَمِثْلَ إِخْبَارِ الصَّادِقِ لَهُ بِأَنَّ هَذَا كَذِبٌ، فَإِذَا أَتَاهُ الشَّيْطَانُ بِالْكَذِبِ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_787", "reason": "high_symbol_ratio:0.427", "chunk_text": "أَنَّهُ كَاذِبٌ فَلَا يَكُونُ مِثْلَ ابْنِ صَيَّادٍ وَنَحْوِهِ، مِمَّنْ يُعْرَفُ أَنَّهُ يَأْتِيهِ ص"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_788", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَلِهَذَا يُوجَدُ الْكُهَّانُ الَّذِينَ يَعْرِفُونَ كَذِبَ مَنْ يُخْبِرُهُمْ كَثِيرًا، وَكَذَلِكَ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_789", "reason": "high_symbol_ratio:0.420", "chunk_text": "لَهُ بِالصِّدْقِ نَاصِحًا لَهُ لَا بُدَّ أَنْ يُبَيِّنَ لَهُ ذَلِكَ فَلَا يُصِرُّ عَلَى اعْتِقَادِ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_790", "reason": "high_symbol_ratio:0.434", "chunk_text": "وَأَمَّا نُزُولُ الشَّيْطَانِ مَرَّةً أَوْ مَرَّتَيْنِ فَقَدْ يَكُونُ عَلَى مَنْ لَيْسَ بِأَفَّاكٍ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_791", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَإِنَّ النَّاسَ تَنَازَعُوا: هَلْ يَجُوزُ أَنْ يُلْقِيَ الشَّيْطَانُ عَلَى لِسَانِ النَّبِيِّ مَا ي"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_792", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالْمَقْصُودُ هُنَا ذِكْرُ بَعْضِ أَدْعِيَةِ النَّبِيِّ الَّتِي شُوهِدَ إِجَابَتُهَا، وَقَدْ تَقَدَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_793", "reason": "high_symbol_ratio:0.426", "chunk_text": "فَكَفَى الطَّعَامُ، وَهُوَ صَاعٌ مِنْ شَعِيرٍ لِأَلْفِ نَفَرٍ، وَكَذَلِكَ دُعَاؤُهُ لَمَّا نُزِحَتْ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_794", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَقَدْ تَقَدَّمَ دُعَاؤُهُ لِلَّذِي ذَهَبَ بَصَرُهُ فَأَبْصَرَ، وَدُعَاؤُهُ فِي الِاسْتِسْقَاءِ فَمَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_795", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرٍ قَالَ: لَمَّا نَزَلَ: قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_796", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْهُ قَالَ: \" سَأَلْتُ رَبِّي ثَلَاثًا فَأَعْطَانِي اثْنَتَيْنِ، وَمَنَعَنِي "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_797", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ مِنْ حَدِيثِ سَلَمَةَ بْنِ الْأَكْوَعِ قَالَ: جَعَلَ عَمِّي يَرْتَجِزُ وَيَقُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_798", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ: وَمَا اسْتَغْفَرَ رَسُولُ اللَّهِ لِإِنْسَانٍ يَخُصُّهُ إِلَّا اسْتُشْهِدَ. قَالَ: فَنَادَى ع"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_799", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: فَلَمَّا قَدِمْنَا خَيْبَرَ خَرَجَ مَلِكُهُمْ مَرْحَبٌ يَخْطِرُ بِسَيْفِهِ وَيَقُولُ: قَدْ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_800", "reason": "high_symbol_ratio:0.430", "chunk_text": "قَالَ سَلَمَةُ: فَخَرَجْتُ فِي نَفَرٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ تَعَالَى عَلَيْهِ وَس"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_801", "reason": "high_symbol_ratio:0.425", "chunk_text": "قَالَ: فَأَتَيْتُ النَّبِيُّ ، وَأَنَا أَبْكِي فَقُلْتُ: يَا رَسُولَ اللَّهِ، بَطَلَ عَمَلُ عَامِرٍ؟"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_802", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ: كَذَبَ مَنْ قَالَ ذَلِكَ، بَلْ لَهُ أَجْرُهُ مَرَّتَيْنِ \". وَفِي الصَّحِيحَيْنِ عَنْ أَنَسِ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_803", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَقَالَ: \" اللَّهُمَّ أَكْثِرْ مَالَهُ وَوَلَدَهُ، وَبَارِكْ لَهُ فِيمَا أَعْطَيْتَهُ \" وَرَوَى الْب"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_804", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَقَالَتْ أُمُّ سُلَيْمٍ: يَا رَسُولَ اللَّهِ، إِنَّ لِي خُوَيْصَّةً. فَقَالَ: \" مَا هِيَ؟ \" قَالَتْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_805", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَفِي رِوَايَةٍ لِمُسْلِمٍ: دَعَا لِي بِثَلَاثِ دَعَوَاتٍ قَدْ رَأَيْتُ مِنْهَا اثْنَتَيْنِ، وَأَنَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_806", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي التِّرْمِذِيِّ وَحَسَّنَهُ عَنْ أَبِي خَلْدَةَ قَالَ: قُلْتُ لِأَبِي الْعَالِيَةِ: سَمِعَ أَنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_807", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ عَنْ أَبِي هُرَيْرَةَ قَالَ: كُنْتُ أَدْعُو أُمِّي إِلَى الْإِسْلَامِ، وَهِيَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_808", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَإِذَا هُوَ مُجَافٍ، فَسَمِعَتْ أُمِّي خَشْفَ قَدَمِي فَقَالَتْ: مَكَانَكَ يَا أَبَا هُرَيْرَةَ، وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_809", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَأَتَيْتُهُ وَأَنَا أَبْكِي مِنَ الْفَرَحِ فَقُلْتُ: يَا رَسُولَ اللَّهِ أَبْشِرْ فَقَدِ اسْتَجَابَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_810", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أَنَسٍ أَنَّ النَّبِيَّ رَأَى عَلَى عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ أَثَرَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_811", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ: \" كَمْ سُقْتَ إِلَيْهَا؟ \" قَالَ: وَزْنَ نَوَاةٍ مِنْ ذَهَبٍ. قَالَ: \" فَبَارَكَ اللَّهُ لَكَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_812", "reason": "high_symbol_ratio:0.415", "chunk_text": "دُلَّنِي عَلَى السُّوقِ فَظَهَرَتْ بَرَكَةُ دَعْوَةِ رَسُولِ اللَّهِ ، فَبَلَغَ مِنْ مَالِ عَبْدِ ال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_813", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالَ: وَكَانَ عَامَّةُ مَالِهِ مِنَ التِّجَارَةِ. وَقَالَ مُحَمَّدُ بْنُ سِيرِينَ: اقْتَسَمَ نِسَاء"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_814", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَقَالَ الزُّهْرِيُّ: أَوْصَى عَبْدُ الرَّحْمَنِ لِمَنْ شَهِدَ بَدْرًا، فَوَجَدُوا مِائَةً، لِكُلِّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_815", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَقَالَ عَبْدُ اللَّهِ بْنُ جَعْفَرٍ: حَدَّثَتْنِي أُمُّ بَكْرٍ بِنْتُ الْمِسْوَرِ أَنَّ عَبْدَ الرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_816", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَفِي التِّرْمِذِيِّ وَصَحَّحَهُ وَرَوَاهُ ابْنُ حِبَّانَ فِي صَحِيحِهِ عَنِ ابْنِ عُمَرَ أَنَّ رَسُ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_817", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَظَهَرَ مِنْ عِزِّ الْإِسْلَامِ فِي إِمَارَتِهِ شَرْقًا وَغَرْبًا، وَفَتْحِ الشَّامِ وَالْعِرَاقِ و"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_818", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَفِي الصَّحِيحَيْنِ أَنَّ ابْنَ عَبَّاسٍ وَضَعَ لِلنَّبِيِّ لَمَّا أَتَى الْخَلَاءَ وَضُوءًا فَقَال"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_819", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَقَالَ فِيهِ ابْنُ مَسْعُودٍ: لَوْ أَدْرَكَ ابْنُ عَبَّاسٍ أَسْنَانَنَا لَمَا عَشَرَهُ مِنَّا أَحَد"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_820", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ جَابِرٍ قَالَ: كُنْتُ أَسِيرُ عَلَى جَمَلٍ قَدْ أَعْيَا، وَأَرَدْتُ أَنْ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_821", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَفِي رِوَايَةٍ: فَقَالَ لِي: \" مَا لِبَعِيرِكَ؟ \" فَقُلْتُ: عَلِيلٌ. قَالَ: فَتَخَلَّفَ رَسُولُ الل"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_822", "reason": "high_symbol_ratio:0.440", "chunk_text": "قَالَ: \" فَتَبِعْنِيهِ.... \" وَذَكَرَ الْحَدِيثَ. وَفِي التِّرْمِذِيِّ وَغَيْرِهِ: قَالَ النَّبِيُّ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_823", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَرَوَى الْحَاكِمُ فِي صَحِيحِهِ عَنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ قَالَ: مَرِضْتُ فَعَادَنِي رَسُو"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_824", "reason": "high_symbol_ratio:0.439", "chunk_text": "فَقَالَ: \" اللَّهُمَّ اشْفِهِ، اللَّهُمَّ عَافِهِ \" ثُمَّ قَالَ لِي: \" قُمْ \" فَقُمْتُ، فَمَا عَادَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_825", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَفِي الصَّحِيحَيْنِ عَنْ أُمِّ خَالِدٍ قَالَتْ: أُتِيَ رَسُولُ اللَّهِ بِثِيَابٍ فِيهَا خَمِيصَةٌ س"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_826", "reason": "high_symbol_ratio:0.427", "chunk_text": "اللَّهِ : \" ادْنُ مِنِّي \" فَمَسَحَ بِيَدِهِ عَلَى رَأْسِي وَلِحْيَتِي ثُمَّ قَالَ: \" اللَّهُمَّ جَم"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_827", "reason": "high_symbol_ratio:0.424", "chunk_text": "رَوَاهُ الْإِمَامُ أَحْمَدُ، وَقَالَ الْبَيْهَقِيُّ: إِسْنَادُهُ صَحِيحٌ، وَرَوَاهُ التِّرْمِذِيُّ، "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_828", "reason": "high_symbol_ratio:0.434", "chunk_text": "قَالَ: عَزْرَةُ: إِنَّهُ عَاشَ مِائَةً وَعِشْرِينَ سَنَةً، وَلَيْسَ فِي رَأْسِهِ إِلَّا شَعَرَاتٌ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_829", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَالَ الْبُخَارِيُّ فِي تَارِيخِهِ: ثَنَا يَعْقُوبُ بْنُ إِسْحَاقَ عَنْ حَنْظَلَةَ بْنِ حَنِيفَةَ "}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_830", "reason": "high_symbol_ratio:0.422", "chunk_text": "قَالَ: \" تَعَالَ يَا غُلَامُ \" فَأَخَذَ بِيَدِي، وَمَسَحَ بِرَأْسِي، وَقَالَ: \" بَارَكَ اللَّهُ فِيك"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_831", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَيُذْكَرُ عَنْ أَبِي سُفْيَانَ، وَاسْمُهُ مَدْلُوكٌ أَنَّهُ ذَهَبَ إِلَى النَّبِيِّ فَأَسْلَمَ فَدَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_832", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَكَانَ مُقَدَّمُ رَأْسِهِ مَوْضِعُ يَدِ النَّبِيِّ ، أَسْوَدَ، وَسَائِرُهُ أَبْيَضَ ذَكَرَهُ أَيْضً"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_833", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَرَوَى أَحْمَدُ فِي مُسْنَدِهِ بِإِسْنَادِهِ عَنْ أَبِي الْعَلَا قَالَ: كُنْتُ عِنْدَ قَتَادَةَ بْن"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_834", "reason": "high_symbol_ratio:0.414", "chunk_text": "قَالَ: وَكُنْتُ قَبْلُ مَا رَأَيْتُهُ إِلَّا وَرَأَيْتُهُ كَأَنَّ عَلَى وَجْهِهِ الدِّهَانَ. وَفِي م"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_835", "reason": "high_symbol_ratio:0.426", "chunk_text": "قَالَ: \" وَصَنَعْتَ كَيْفَ؟ \" فَحَدَّثْتُهُ الْحَدِيثَ فَقَالَ: \" اللَّهُمَّ بَارِكْ لَهُ فِي صَفْقَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_836", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَرَوَاهُ الْإِمَامُ أَحْمَدُ، وَفِي لَفْظٍ: فَكَانَ لَوِ اشْتَرَى التُّرَابَ لَرَبِحَ فِيهِ. رَوَاه"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_837", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَفِي صَحِيحِ مُسْلِمٍ عَنْ سَلَمَةَ بْنِ الْأَكْوَعِ أَنَّ رَجُلًا أَكَلَ عِنْدَ رَسُولِ اللَّهِ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_838", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ: \" لَا اسْتَطَعْتَ \" مَا مَنَعَهُ إِلَّا الْكِبْرُ. قَالَ: فَمَا رَفَعَهَا إِلَى فِيهِ. وَرَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_839", "reason": "high_symbol_ratio:0.418", "chunk_text": "قَالَ: فَنَزَلَ رَسُولُ اللَّهِ . قَالَ جَابِرٌ: فَقُمْتُ إِلَى غِرَارَةٍ لَنَا فَالْتَمَسْتُ فِيهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_840", "reason": "high_symbol_ratio:0.428", "chunk_text": "قَالَ: فَجَهَّزْتُهُ ثُمَّ أَدْبَرَ يَذْهَبُ إِلَى الظَّهْرِ، وَعَلَيْهِ ثَوْبَانِ لَهُ قَدْ خَلِقَا"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_841", "reason": "high_symbol_ratio:0.412", "chunk_text": "قَالَ: \" ادْعُهُ فَلْيَلْبَسْهُمَا \" ثُمَّ وَلَّى يَذْهَبُ، فَقَالَ رَسُولُ اللَّهِ : \" مَا لَهُ ضَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_842", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَرَوَاهُ أَبُو زُرْعَةَ عَنْ سَعِيدِ بْنِ سُلَيْمَانَ عَنِ اللَّيْثِ عَنْ هِشَامِ بْنِ سَعِيدٍ عَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_844", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَهَذِهِ الْأَخْبَارُ مِنْهَا مَا هُوَ فِي الْقُرْآنِ، وَمِنْهَا مَا هُوَ مُتَوَاتِرٌ يَعْلَمُهُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_845", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَسَمِعَهَا مِنَ الْأُمَّةِ أَكْثَرُ مِمَّنْ سَمِعَ وَنَقَلَ كَثِيرًا مِنْ آيَاتِ الْقُرْآنِ، وَأَكْ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_846", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَأَمَّا هَذِهِ الْآيَاتُ فَنَقَلَهَا أَكْثَرُ مِمَّنْ نَقَلَ مَوَاقِيتَ الصَّلَاةِ مِنْ جِهَةِ الْأ"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_847", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْيَسِيرَ لَمَّا صَبَّهُ جَابِرٌ فِي الْجَفْنَةِ وَامْتَلَأَتْ، وَمَلَأَ مِنْهَا جَمِيعُ الْعَسْكَر"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_848", "reason": "high_symbol_ratio:0.402", "chunk_text": "كَفَاهُمْ، وَشَاهَدُوا الطَّعَامَ الَّذِي جَمَعُوهُ عَلَى نِطْعٍ فَأَخَذُوا مِنْهُ حَتَّى كَفَاهُمْ؛"}
{"source": "wikisource", "raw_id": "arwikisource:40443:284948#chunk_849", "reason": "high_symbol_ratio:0.417", "chunk_text": "كَفَاهُمْ لِلْوُضُوءِ؛ وَكَذَلِكَ وَلِيمَةُ زَيْنَبَ كَانُوا ثَلَاثَمِائَةٍ فَأَكَلُوا مِنْ طَعَامٍ "}
