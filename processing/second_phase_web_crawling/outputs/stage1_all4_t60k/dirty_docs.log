{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_366", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَاسْتَعْمَلْتُهُ سَأَلْتُهُ أَنْ يَعْمَلَ. وَاسْتَعْمَلْتُ الثَّوْبَ وَنَحْوَهُ أَيْ أَعْمَلْتُهُ ف"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_367", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَالْعُمَالَةُ بِضَمِّ الْعَيْنِ أُجْرَةُ الْعَامِلِ وَالْكَسْرُ لُغَةٌ."}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_368", "reason": "high_symbol_ratio:0.407", "chunk_text": "====عمم==== عَمَّ الْمَطَرُ وَغَيْرُهُ عُمُومًا مِنْ بَابِ قَعَدَ فَهُوَ عَامٌّ وَالْعَامَّةُ خِلَاف"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_370", "reason": "high_symbol_ratio:0.418", "chunk_text": "إذَا دَخَلَتْ عَلَى إنَّ وَأَخَوَاتِهَا فَهَذَا فَرْقٌ بَيْنَ الْعَامِّ وَالْأَعَمِّ. وَالْعِمَامَةُ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_372", "reason": "high_symbol_ratio:0.427", "chunk_text": "====عمن==== عُمَانُ وِزَانُ غُرَابٍ مَوْضِعٌ بِالْيَمَنِ وَعَمَنَ بِالْمَكَانِ أَقَامَ بِهِ وَعَمَّا"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_373", "reason": "high_symbol_ratio:0.419", "chunk_text": "====عمه==== عَمِهَ فِي طُغْيَانِهِ عَمَهًا مِنْ بَابِ تَعِبَ إذَا تَرَدَّدَ مُتَحَيِّرًا وَتَعَامَهَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_374", "reason": "high_symbol_ratio:0.414", "chunk_text": "====عمي==== عَمِيَ عَمًى فَقَدَ بَصَرَهُ فَهُوَ أَعْمًى وَالْمَرْأَةُ عَمْيَاءُ وَالْجَمْعُ عُمْيٌ م"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_375", "reason": "high_symbol_ratio:0.438", "chunk_text": "====عنب==== الْعِنَبُ جَمْعُهُ أَعْنَابٌ وَالْعِنَبَةُ الْحَبَّةُ مِنْهُ وَلَا يُقَالُ لَهُ عِنَبٌ إ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_376", "reason": "high_symbol_ratio:0.423", "chunk_text": "====عنت==== الْعَنَتُ الْخَطَأُ وَهُوَ مَصْدَرٌ مِنْ بَابِ تَعِبَ وَالْعَنَتُ الْمَشَقَّةُ يُقَالُ أ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_377", "reason": "high_symbol_ratio:0.408", "chunk_text": "====عند==== عِنْدَ ظَرْفُ مَكَان وَيَكُونُ ظَرْفَ زَمَانٍ إذَا أُضِيفَ إلَى الزَّمَانِ نَحْوُ عِنْدَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_379", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَعَانَدَهُ مُعَانَدَةً عَارَضَهُ وَفَعَلَ مِثْلَ فِعْلِهِ قَالَ الْأَزْهَرِيُّ الْمُعَانِدُ الْمُعَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_380", "reason": "high_symbol_ratio:0.414", "chunk_text": "====عندلب==== وَالْعَنْدَلِيبُ قِيلَ هُوَ الْبُلْبُلُ وَقِيلَ هُوَ كَالْعُصْفُورِ يُصَوِّتُ أَلْوَان"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_381", "reason": "high_symbol_ratio:0.417", "chunk_text": "====عنز==== الْعَنَزَةُ عَصًا أَقَصَرُ مِنَ الرُّمْحِ وَلَهَا زُجٌّ مِنْ أَسْفَلِهَا وَالْجَمْعُ عَن"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_382", "reason": "high_symbol_ratio:0.421", "chunk_text": "====عنس==== عَنَسَتِ الْمَرْأَةُ تَعْنِسُ مِنْ بَابِ ضَرَبَ وَفِي لُغَةٍ عَنَسَتْ عُنُوسًا مِنْ بَاب"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_383", "reason": "high_symbol_ratio:0.408", "chunk_text": "أَهْلُهَا وَقَالَ اللَّيْثُ عَنَّسَهَا أَهْلُهَا أَمْسَكُوهَا عَنِ التَّزْوِيجِ وَسُئِلَ بَعْضُ التَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_384", "reason": "high_symbol_ratio:0.438", "chunk_text": "====عنف==== عَنُفَ بِهِ وَعَلَيْهِ عُنْفًا مِنْ بَابِ قَرُبَ إذَا لَمْ يَرْفُقْ بِهِ فَهُوَ عَنِيفٌ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_385", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَعُنْفُوَانُ الشَّيْءِ أَوَّلُهُ وَهُوَ فِي عُنْفُوَانِ شَبَابِهِ وَعَنَّفَهُ تَعْنِيفًا لَامَهُ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_386", "reason": "high_symbol_ratio:0.419", "chunk_text": "====عنق==== الْعُنُقُ الرَّقَبَةُ وَهُوَ مُذَكَّرٌ وَالْحِجَازُ تُؤَنِّثُ فَيُقَالُ هِيَ الْعُنُقُ و"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_387", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَالْعَنَاقُ الْأُنْثَى مِنْ وَلَدِ الْمَعْزِ قَبْلَ اسْتِكْمَالِهَا الْحَوْلَ وَالْجَمْعُ أَعْنُقٌ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_388", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَعَانَقْتُ الْمَرْأَةَ عِنَاقًا وَاعْتَنَقْتُهَا وَتَعَانَقْنَا وَهُوَ الضَّمُّ وَالِالْتِزَامُ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_389", "reason": "high_symbol_ratio:0.400", "chunk_text": "عنن رَجُلٌ عِنِّينٌ لَا يَقْدِرُ عَلَى إتْيَانِ النِّسَاءِ أَوْ لَا يَشْتَهِي النِّسَاءَ وَامْرَأَةٌ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_390", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ ثَعْلَبٌ وَغَيْرُهُ رَجُلٌ عِنِّينٌ بَيِّنُ التَّعْنِينِ وَالْعِنِينَةِ وَقَالَ فِي الْبَارِعِ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_391", "reason": "high_symbol_ratio:0.423", "chunk_text": "الثَّانِي دُونَ الْأَوَّلِ أَيْ لَوْ لَمْ يَشْتَهِ امْرَأَةً وَاشْتَهَى غَيْرَهَا لِأَنَّهُ يُقَالُ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_392", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَالْعُنَّةُ بِضَمِّ الْعَيْنِ وَفَتْحِهَا الِاعْتِرَاضُ بِالْفُضُولِ يُقَالُ عَنَّ عَنًّا مِنْ بَاب"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_393", "reason": "high_symbol_ratio:0.437", "chunk_text": "وَعِنَانُ الْفَرَسِ جَمْعُهُ أَعِنَّةٌ. وَأَعْنَنْتُهُ بِالْأَلِفِ جَعَلْتُ لَهُ عِنَانًا. وَعَنَنْت"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_394", "reason": "high_symbol_ratio:0.405", "chunk_text": "قَالَ ابْنُ السِّكِّيتِ وَشَرِكَةُ الْعِنَانِ كَأَنَّهَا مَأْخُوذَةٌ مِنْ عَنَّ لَهُمَا شَيْءٌ إذَا "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_395", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَ بَعْضُهُمْ: مَأْخُوذَةٌ مِنْ عِنَانِ الْفَرَسِ لِأَنَّهُ يَمْلِكُ بِهَا التَّصَرُّفَ فِي مَا"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_398", "reason": "high_symbol_ratio:0.441", "chunk_text": "وَعَنْوَنْتُ الْكِتَابَ جَعَلْتُ لَهُ عُنْوَانًا بِضَمِّ الْعَيْنِ وَقَدْ تُكْسَرُ. وَعُنْوَانُ كُلِ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_399", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَعَنْ حَرْفُ جَرٍّ وَمَعْنَاهُ الْمُجَاوَزَةُ إمَّا حِسًّا نَحْوُ جَلَسْتُ عَنْ يَمِينِهِ أَيْ مُتَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_400", "reason": "high_symbol_ratio:0.418", "chunk_text": "====عنو==== عَنَا عُنُوًّا مِنْ بَابِ قَعَدَ خَضَعَ وَذَلَّ وَالِاسْمُ الْعَنَاءُ بِالْفَتْحِ وَالْم"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_401", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَعَنِيَ الْأَسِيرُ مِنْ بَابِ تَعِبَ لُغَةٌ أَيْضًا وَمِنْهُ قِيلَ لِلْمَرْأَةِ عَانِيَةٌ لِأَنَّهَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_402", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَفُتِحَتْ مَكَّةُ عَنْوَةً أَيْ قَهْرًا. وَعَنَيْتُهُ عَنْيًا مِنْ بَابِ رَمَى قَصَدْتُهُ. وَاعْتَن"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_403", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَعَنَى اللَّهُ بِهِ حَفِظَهُ وَعَنَانِي كَذَا يَعْنِينِي عَرَضَ لِي وَشَغَلَنِي فَأَنَا مَعْنِيُّ ب"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_404", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَعُنِيتُ بِأَمْرِ فُلَانٍ بِالْبِنَاءِ لِلْمَفْعُولِ عِنَايَةً وَعُنِيًّا شُغِلْتُ بِهِ. وَلْتُعْنَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_405", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَعُنْوَانُ الْكِتَابِ بِضَمِّ الْعَيْنِ وَقَدْ تُكْسَرُ وَعَنْوَنْتُهُ جَعَلْتُ لَهُ عُنْوَانًا قَا"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_406", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَالَ أَبُو زَيْدٍ هَذَا فِي مَعْنَاةِ ذَاكَ وَفِي مَعْنَاهُ سَوَاءٌ أَيْ فِي مُمَاثَلَتِهِ وَمُشَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_408", "reason": "high_symbol_ratio:0.441", "chunk_text": "====عهد==== الْعَهْدُ الْوَصِيَّةُ يُقَالُ عَهِدَ إلَيْهِ يَعْهَدُ مِنْ بَابِ تَعِبَ إذَا أَوْصَاهُ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_409", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَفِي التَّنْزِيلِ { أَلَمْ أَعْهَدْ إلَيْكُمْ يَا بَنِي آدَمَ } وَالْعَهْدُ الْأَمَانُ وَالْمَوْثِق"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_410", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَالْمُعَاهَدَةُ الْمُعَاقَدَةُ وَالْمُحَالَفَةُ. وَعَهِدْتُهُ بِمَالٍ عَرَّفْتُهُ بِهِ وَالْأَمْرُ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_411", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَهُوَ قَرِيبُ الْعَهْدِ بِكَذَا أَيْ قَرِيبُ الْعِلْمِ وَالْحَالِ. وَعَهِدْتُهُ بِمَكَانِ كَذَا لَق"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_412", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَتَعَهَّدْتُ الشَّيْءَ تَرَدَّدْتُ إلَيْهِ وَأَصْلَحْتُهُ وَحَقِيقَتُهُ تَجْدِيدُ الْعَهْدِ بِهِ. و"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_413", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَفِي الْأَمْرِ عُهْدَةٌ أَيْ مَرْجِعٌ لِلْإِصْلَاحِ فَإِنَّهُ لَمْ يُحْكَمْ بَعْدُ فَصَاحِبُهُ يَرْ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_414", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَقَوْلُهُمْ عُهْدَتُهُ عَلَيْهِ مِنْ ذَلِكَ لِأَنَّ الْمُشْتَرِيَ يَرْجِعُ عَلَى الْبَائِعِ بِمَا ي"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_415", "reason": "high_symbol_ratio:0.415", "chunk_text": "====عهر==== عَهْر عَهَرًا مِنْ بَابِ تَعِبَ فَجَرَ فَهُوَ عَاهِرٌ وَعَهَرَ عُهُورًا مِنْ بَابِ قَعَد"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_416", "reason": "high_symbol_ratio:0.420", "chunk_text": "====عوج==== الْعَوَجُ بِفَتْحَتَيْنِ فِي الْأَجْسَادِ خِلَافُ الِاعْتِدَالِ وَهُوَ مَصْدَرٌ مِنْ بَا"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_417", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْعِوَجُ بِكَسْرِ الْعَيْنِ فِي الْمَعَانِي يُقَالُ فِي الدِّينِ عِوَجٌ وَفِي الْأَمْرِ عِوَجٌ وَ"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_418", "reason": "high_symbol_ratio:0.411", "chunk_text": "سَاكِنُ الْعَيْنِ مُثَقَّلُ الْجِيمِ وَلَا تَقُلْ مُعَوَّجَةٌ بِفَتْحِ الْعَيْنِ وَتَثْقِيلِ الْوَاو"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_419", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَالَ الْأَزْهَرِيُّ: وَأَجَازُوا عَوَّجْتُ الشَّيْءَ تَعْوِيجًا إذَا حَنَيْتَهُ فَهُوَ مُعَوَّجٌ "}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_420", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَالْعَاجُ أَنْيَابُ الْفِيلِ قَالَ اللَّيْثُ وَلَا يُسَمَّى غَيْرُ النَّابِ عَاجًا وَالْعَاجُ ظَهْر"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_421", "reason": "high_symbol_ratio:0.417", "chunk_text": "====عود==== عَادٌ اسْمُ رَجُلٍ مِنَ الْعَرَبِ الْأُولَى وَبِهِ سُمِّيَتِ الْقَبِيلَةُ قَوْمُ هُودٍ و"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_422", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَعَوَّدْتُهُ كَذَا فَاعْتَادَهُ وَتَعَوَّدَهُ أَيْ صَيَّرْتُهُ لَهُ عَادَةً. وَاسْتَعَدْتُ الرَّجُل"}
{"source": "wikisource", "raw_id": "arwikisource:41112:108395#chunk_423", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَأَعَدْتُ الشَّيْءَ رَدَدْتُهُ ثَانِيًا وَمِنْهُ إعَادَةُ الصَّلَاةِ. وَهُوَ مُعِيدٌ لِلْأَمْرِ أَي"}
