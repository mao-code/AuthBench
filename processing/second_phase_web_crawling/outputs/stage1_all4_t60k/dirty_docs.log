{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_320", "reason": "high_symbol_ratio:0.432", "chunk_text": "نَعَمْ إذَا قُلْتَ وَكُلُّ مَطْعُومٍ رِبَوِيٌّ لَزِمَ فِي السَّفَرْجَلِ، وَيَثْبُتُ ذَلِكَ بِعُمُومِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_321", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَإِنْ قُلْتَ: فَبِمَاذَا يُفَارِقُ هَذَا الضَّرْبُ الضَّرْبَيْنِ الْآخَرَيْنِ بَعْدَهُ؟ فَاعْلَمْ أ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_322", "reason": "high_symbol_ratio:0.418", "chunk_text": "النَّظْمُ الثَّانِي: أَنْ تَكُونَ الْعِلَّةُ حُكْمًا فِي الْمُقَدِّمَتَيْنِ، مِثَالُهُ قَوْلُنَا: ال"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_324", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَلَا الْجِسْمُ هُوَ الْبَارِي تَعَالَى. وَيُمْكِنُ بَيَانُ لُزُومِ النَّتِيجَةِ بِالرَّدِّ إلَى الن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_325", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَهَذَا النَّظْمُ هُوَ الَّذِي يُعَبِّرُ عَنْهُ الْفُقَهَاءُ بِالْفَرْقِ، إذْ يَقُولُونَ: الْجِسْمُ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_326", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَخَاصِّيَّةُ هَذَا النَّظْمِ أَنَّهُ لَا يُنْتِجُ إلَّا قَضِيَّةً نَافِيَةً سَالِبَةً، وَأَمَّا الن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_327", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَمِنْ شُرُوطِ هَذَا النَّظْمِ أَنْ تَخْتَلِفَ الْمُقَدِّمَتَانِ فِي النَّفْيِ وَالْإِثْبَاتِ، فَإِن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_328", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَنَظْمُهُ أَنْ يُقَال كُلُّ سَوَادٍ لَوْنٌ وَكُلُّ بَيَاضٍ لَوْنٌ، فَلَا يَلْزَمُ كُلُّ سَوَادٍ بَي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_329", "reason": "high_symbol_ratio:0.420", "chunk_text": "نَعَمْ كُلُّ شَيْئَيْنِ أُخْبِرَ عَنْ أَحَدِهِمَا بِمَا يُخْبَرُ عَنْ الْآخَرِ بِنَفْيِهِ يَجِبُ أَن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_330", "reason": "high_symbol_ratio:0.430", "chunk_text": "النَّظْمُ الثَّالِثُ: أَنْ تَكُونَ الْعِلَّةُ مُبْتَدَأً فِي الْمُقَدِّمَتَيْنِ، وَهَذَا يُسَمِّيهِ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_331", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَهَذَا إذَا اجْتَمَعَتْ شُرُوطُهُ أَنْتَجَ نَتِيجَةً خَاصَّةً لَا عَامَّةً، مِثَالُهُ قَوْلُنَا كُل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_332", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَكَذَلِكَ لَوْ قُلْتَ كُلُّ بُرٍّ مَطْعُومٌ وَكُلُّ بُرٍّ رِبَوِيٌّ، فَيَلْزَمُ مِنْهُ أَنَّ بَعْضَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_333", "reason": "high_symbol_ratio:0.425", "chunk_text": "النَّمَطُ الثَّانِي مِنْ الْبُرْهَانِ: وَهُوَ نَمَطُ التَّلَازُمِ. يَشْتَمِلُ عَلَى مُقَدِّمَتَيْنِ،"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_334", "reason": "high_symbol_ratio:0.436", "chunk_text": "وَلْنُسَمِّ هَذَا نَمَطَ التَّلَازُمِ، وَمِثَالُهُ قَوْلُنَا: إنْ كَانَ الْعَالَمُ حَادِثًا فَلَهُ م"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_335", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالْأُولَى اشْتَمَلَتْ عَلَى قَضِيَّتَيْنِ لَوْ أُسْقِطَ مِنْهُمَا حَرْفُ الشَّرْطِ لَانْفَصَلَتَا؛"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_336", "reason": "high_symbol_ratio:0.442", "chunk_text": "وَالثَّانِيَةُ قَوْلُنَا: فَلَهُ مُحْدِثٌ. وَلْنُسَمِّ الْقَضِيَّةَ الْأُولَى الْمُقَدَّمَ، وَلْنُسَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_337", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالْقَضِيَّةُ الثَّانِيَةُ اشْتَمَلَتْ عَلَى تَسْلِيمِ عَيْنِ الْقَضِيَّةِ الَّتِي سَمَّيْنَاهَا مُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_338", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَهَذَا النَّمَطُ يَتَطَرَّقُ إلَيْهِ أَرْبَعُ تَسْلِيمَاتٍ تَنْتُجُ مِنْهَا اثْنَتَانِ وَلَا تَنْتُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_339", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمِثَالُهُ مِنْ الْحِسِّ: إنْ كَانَ هَذَا سَوَادًا فَهُوَ لَوْنٌ، وَمَعْلُومٌ أَنَّهُ سَوَادٌ فَإِذ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_340", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَإِنْ كَانَ بَيْعُ الْغَائِبِ صَحِيحًا فَهُوَ يَلْزَمُ بِصَرِيحِ الْإِلْزَامِ، وَمَعْلُومٌ أَنَّهُ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_342", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَأَمَّا الَّذِي لَا يُنْتِجُ فَهُوَ تَسْلِيمُ عَيْنِ اللَّازِمِ، فَإِنَّا لَوْ قُلْنَا: إنْ كَانَتْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_343", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَكَذَلِكَ تَسْلِيمُ نَقِيضِ الْمُقَدَّمِ لَا يُنْتِجُ عَيْنَ اللَّازِمِ وَلَا نَقِيضَهُ، فَإِنَّا ل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_344", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَتَحْقِيقُ لُزُومِ النَّتِيجَةِ مِنْ هَذَا النَّمَطِ أَنَّهُ مَهْمَا جُعِلَ شَيْءٌ لَازِمًا لِشَيْء"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_345", "reason": "high_symbol_ratio:0.408", "chunk_text": "اللَّازِمِ. وَأَمَّا ثُبُوتُ الْأَعَمِّ فَلَا يُوجِبُ ثُبُوتَ الْأَخَصِّ فَإِنَّ ثُبُوتَ اللَّوْنِ ل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_346", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَأَمَّا انْتِفَاءُ الْأَخَصِّ فَلَا يُوجِبُ انْتِفَاءَ الْأَعَمِّ وَلَا ثُبُوتَهُ، فَإِنَّ انْتِفَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_347", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَإِنْ جُعِلَ الْأَخَصُّ لَازِمًا لِلْأَعَمِّ فَهُوَ خَطَأٌ، كَمَنْ يَقُولُ: إنْ كَانَ هَذَا لَوْنًا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_348", "reason": "high_symbol_ratio:0.414", "chunk_text": "فَإِنْ كَانَ اللَّازِمُ مُسَاوِيًا لِلْمُقَدَّمِ أَنْتَجَ مِنْهُ أَرْبَعَ تَسْلِيمَاتٍ، كَقَوْلِنَا:"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_349", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَكَذَلِكَ كُلُّ مَعْلُولٍ لَهُ عِلَّةٌ وَاحِدَةٌ، كَقَوْلِنَا: إنْ كَانَتْ الشَّمْسُ طَالِعَةً فَال"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_350", "reason": "high_symbol_ratio:0.440", "chunk_text": "النَّمَطُ الثَّالِثُ: نَمَطُ التَّعَانُدِ. وَهُوَ عَلَى ضِدِّ مَا قَبْلَهُ، وَالْمُتَكَلِّمُونَ يُسَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_351", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَهُوَ أَيْضًا يَرْجِعُ إلَى مُقَدِّمَتَيْنِ وَنَتِيجَةٍ، وَمِثَالُهُ: الْعَالَمُ إمَّا قَدِيمٌ وَإِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_352", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَهَذِهِ مُقَدِّمَةٌ وَهِيَ قَضِيَّتَانِ، الثَّانِيَةُ أَنْ تَسْلَمَ إحْدَى الْقَضِيَّتَيْنِ أَوْ نَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_353", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَبِالْجُمْلَةِ كُلُّ قِسْمَيْنِ مُتَنَاقِضِينَ مُتَقَابِلِينَ إذَا وُجِدَ فِيهِمَا شَرَائِطُ التَّن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_354", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَلَا يُشْتَرَطُ أَنْ تَنْحَصِرَ الْقَضِيَّةُ فِي قِسْمَيْنِ بَلْ شَرْطُهُ أَنْ تَسْتَوْفِي أَقْسَام"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_356", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَوْلُ مَنْ أَثْبَتَ رُؤْيَةَ اللَّهِ بِعِلَّةِ الْوُجُودِ يَكَادُ لَا يَنْحَصِرُ كَلَامُهُ إلَّا "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_357", "reason": "high_symbol_ratio:0.416", "chunk_text": "بِجِهَةِ مِنْ الرَّائِي مَثَلًا، فَإِنْ أَبْطَلَ هَذَا فَلَعَلَّهُ لِمَعْنًى آخَرَ إلَّا أَنْ يَتَكَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_358", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَهَذِهِ أَشْكَالُ الْبَرَاهِينِ، فَكُلُّ دَلِيلٍ لَا يُمْكِنُ رَدُّهُ إلَى وَاحِدٍ مِنْ هَذِهِ الْأ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_359", "reason": "high_symbol_ratio:0.403", "chunk_text": "[الْفَصْلُ الثَّانِي بَيَانِ مَادَّةِ الْبُرْهَانِ] الْفَصْلُ الثَّانِي مِنْ فَنِّ الْمَقَاصِدِ بَيَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_360", "reason": "high_symbol_ratio:0.419", "chunk_text": "مُقَدِّمَةٍ بُرْهَانٌ مُنْتِجٌ، بَلْ الْبُرْهَانُ الْمُنْتِجُ لَا يَنْصَاغُ إلَّا مِنْ مُقَدِّمَاتٍ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_361", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَلْنَذْكُرْ مَعْنَى الْيَقِينِ فِي نَفْسِهِ لِتُفْهَمَ ذَاتُهُ، وَلْنَذْكُرْ مُدْرَكَهُ لِتَفْهَمَ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_362", "reason": "high_symbol_ratio:0.411", "chunk_text": "أَمَّا الْيَقِينُ فَشَرْحُهُ أَنَّ النَّفْسَ إذَا أَذْعَنَتْ لِلتَّصْدِيقِ بِقَضِيَّةٍ مِنْ الْقَضَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_363", "reason": "high_symbol_ratio:0.425", "chunk_text": "آمِنَةً مِنْ الْخَطَأِ، بَلْ حَيْثُ لَوْ حُكِيَ لَهَا عَنْ نَبِيٍّ مِنْ الْأَنْبِيَاءِ أَنَّهُ أَقَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_365", "reason": "high_symbol_ratio:0.419", "chunk_text": "الْحَالَةُ الثَّانِيَةُ: أَنْ تُصَدِّقَ بِهَا تَصْدِيقًا جَزْمًا لَا تَتَمَارَى فِيهِ وَلَا تَشْعُرُ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_366", "reason": "high_symbol_ratio:0.413", "chunk_text": "ذَلِكَ فِيهَا تَوَقُّفًا. وَلْنُسَمِّ هَذَا الْجِنْسَ اعْتِقَادًا جَزْمًا وَهُوَ أَكْثَرُ اعْتِقَادَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_368", "reason": "high_symbol_ratio:0.402", "chunk_text": "وَالْقُوَّةُ فَإِنْ انْضَافَتْ إلَيْهِ تَجْرِبَةٌ لِصِدْقِهِمْ عَلَى الْخُصُوصِ زَادَتْ الْقُوَّةُ، "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_369", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالْمُحَدِّثُونَ يُسَمُّونَ أَكْثَرَ هَذِهِ الْأَحْوَالِ عِلْمًا وَيَقِينًا، حَتَّى يُطْلِقُوا الْق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_371", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَالْحَقُّ أَنَّ الْيَقِينَ هُوَ الْأَوَّلُ وَالثَّانِي مَظِنَّةُ الْغَلَطِ، فَإِذَا أَلَّفْتَ بُرْه"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_372", "reason": "high_symbol_ratio:0.444", "chunk_text": "وَالِاعْتِقَادُ الْجَزْمُ يَنْحَصِرُ فِي سَبْعَةِ أَقْسَامٍ: الْأَوَّلُ: الْأَوَّلِيَّاتُ."}
