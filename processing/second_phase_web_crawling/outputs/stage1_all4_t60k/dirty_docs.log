{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_769", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَعُلِمَ اتِّفَاقُ أَهْلِ الْمِلَلِ كُلِّهَا: الْمُسْلِمُونَ وَالْيَهُودُ وَالنَّصَارَى عَلَى أَنَّه"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_771", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَ تَعَالَى: وَكُلَّ إِنْسَانٍ أَلْزَمْنَاهُ طَائِرَهُ فِي عُنُقِهِ وَنُخْرِجُ لَهُ يَوْمَ الْقِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_772", "reason": "high_symbol_ratio:0.406", "chunk_text": "سَأَلَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ نَذِيرٌ قَالُوا بَلَى قَدْ جَاءَنَا نَذِيرٌ فَكَذَّبْنَا وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_775", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَالَ تَعَالَى: يَا أَهْلَ الْكِتَابِ قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ كَثِيرًا مِمَّا ك"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_777", "reason": "high_symbol_ratio:0.423", "chunk_text": "أَجْرَانِ وَإِنْ أَخْطَأَ فَلَهُ أَجْرٌ وَخَطَأُهُ مَحْطُوطٌ عَنْهُ فَأَمَّا مَنْ تَعَمَّدَ تَحْرِيف"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_779", "reason": "high_symbol_ratio:0.418", "chunk_text": "بِمُحَمَّدٍ مِنْ أَهْلِ الْمَدِينَةِ كَابْنِ التَّيْهَانِ وَغَيْرِهِ عَلَى هَذَا وَأَنَّهُمْ لَمْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_780", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَدْ تَنَازَعَ النَّاسُ هَلْ يُمْكِنُ مَعَ الِاجْتِهَادِ وَاسْتِفْرَاغِ الْوُسْعِ أَنْ لَا يُبَيَّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_781", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَإِذَا لَمْ يُبَيَّنْ لَهُ ذَلِكَ هَلْ يَسْتَحِقُّ الْعُقُوبَةَ فِي الْآخِرَةِ أَمْ لَا؟. وَتَنَازَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_782", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَالْمَقَامُ الثَّانِي: الْكَلَامُ فِي كُفْرِهِمْ وَاسْتِحْقَاقِهِمُ الْوَعِيدَ فِي الْآخِرَةِ. فَهَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_783", "reason": "high_symbol_ratio:0.418", "chunk_text": "قِيلَ: أَنَّهُ يُعَذَّبُ فِي النَّارِ مَنْ لَمْ يُؤْمِنْ وَإِنْ لَمْ يُرْسَلْ إِلَيْهِ رَسُولٌ لِقِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_784", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَقِيلَ: لَا حُجَّةَ عَلَيْهِ بِالْعَقْلِ بَلْ لَا يَجُوزُ أَنْ يُعَذَّبَ مَنْ لَمْ يَقُمْ عَلَيْهِ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_785", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَالْقَوْلُ الثَّالِثُ: وَعَلَيْهِ السَّلَفُ وَالْأَئِمَّةُ إِنَّهُ لَا يُعَذَّبُ إِلَّا مَنْ بَلَغَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_786", "reason": "high_symbol_ratio:0.424", "chunk_text": "قَالَ تَعَالَى: لِإِبْلِيسَ لَأَمْلَأَنَّ جَهَنَّمَ مِنْكَ وَمِمَّنْ تَبِعَكَ مِنْهُمْ أَجْمَعِينَ و"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_787", "reason": "high_symbol_ratio:0.409", "chunk_text": "أَخْبَرَتْ بِهِ الرُّسُلُ؛ كَمَا أَنَّا أَيْضًا لَا نَشْهَدُ بِالْإِيمَانِ وَالْجَنَّةِ إِلَّا لِمَن"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_788", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَإِذَا كَانَ كَذَلِكَ فَنَحْنُ نَشْهَدُ لِمَنْ كَانَ مُؤْمِنًا بِمُوسَى مُتَّبِعًا لَهُ أَنَّهُ مُؤ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_789", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَكَذَلِكَ مَنْ كَانَ مُؤْمِنًا بِالْمَسِيحِ مُتَّبِعًا لَهُ وَنَشْهَدُ لِمَنْ قَامَتْ عَلَيْهِ الْح"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_790", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَكَذَلِكَ مَنْ قَامَتْ عَلَيْهِ الْحُجَّةُ بِالْمَسِيحِ الَّذِينَ قَالَ اللَّهُ فِيهِمْ: قَالَ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_791", "reason": "high_symbol_ratio:0.401", "chunk_text": "شَدِيدًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ وَأَمَّا الَّذِينَ آمَنُوا وَعَمِل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_792", "reason": "high_symbol_ratio:0.432", "chunk_text": "يُعَذَّبَ وَإِنْ كَانَ مُخْطِئًا لِلْحَقِّ جَاهِلًا بِهِ ضَالًّا عَنْهُ كَالْمُجْتَهِدِ فِي طَلَبِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_794", "reason": "high_symbol_ratio:0.410", "chunk_text": "الْمَسِيحِ وَلَا مِنَ الْحَوَارِيِّينَ بَلْ وَلَا فِي أَتْبَاعِهِ مَنْ شَهِدَ صَلْبَهُ وَإِنَّمَا ال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_795", "reason": "high_symbol_ratio:0.436", "chunk_text": "قَتَلُوهُ وَمَا صَلَبُوهُ وَلَكِنْ شُبِّهَ لَهُمْ أَيْ شُبِّهَ لِلنَّاسِ الَّذِينَ أَخْبَرَهُمْ أُول"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_796", "reason": "high_symbol_ratio:0.415", "chunk_text": "الْجُمْهُورُ يَقُولُونَ: بَلْ شُبِّهَ لِلَّذِينَ يَقُولُونَ صَلَبُوهُ كَمَا قَدْ ذُكِرَتِ الْقِصَّةُ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_798", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَالطَّرَفُ الْآخَرُ يَقُولُ: بَلْ كُلُّ مَنْ غَلَطَ وَأَخْطَأَ فِي شَيْءٍ مِنْ ذَلِكَ فَإِنَّهُ مُس"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_799", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَالثَّالِثُ: الْوَسَطُ: أَنَّهُمْ لَا يُعْصَمُونَ وَلَا يُؤَثَّمُونَ بَلْ قَدْ يَكُونُونَ مُخْطِئِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_800", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَقَدْ ثَبَتَ فِي الصَّحِيحِ عَنْ عِيَاضِ بْنِ حِمَارٍ عَنِ النَّبِيِّ أَنَّهُ قَالَ: إِنَّ اللَّهَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_801", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَأَخْبَرَ أَنَّهُ مَقَتَهُمْ إِلَّا هَؤُلَاءِ الْبَقَايَا، وَالْمَقْتُ هُوَ الْبُغْضُ بَلْ أَشَدُّ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_802", "reason": "high_symbol_ratio:0.419", "chunk_text": "الرِّسَالَةِ وَلِهَذَا قَالَ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَى اللَّهِ حُجَّةٌ بَعْدَ الرُّسُلِ وَفِي"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_803", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَفِي رِوَايَةٍ مِنْ أَجْلِ ذَلِكَ بَعَثَ الرُّسُلَ مُبَشِّرِينَ وَمُنْذِرِينَ وَمَا أَحَدٌ أَحَبُّ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_804", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَدْ تَنَازَعَ النَّاسُ فِي حُسْنِ الْأَفْعَالِ وَقُبْحِهَا كَحُسْنِ الْعَدْلِ وَالتَّوْحِيدِ وَال"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_805", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْمُجْبِرَةِ كَالْجَهْمِ بْنِ صَفْوَانَ وَأَمْثَالِهِ، وَهُوَ قَوْلُ أَبِي الْحَسَنِ الْأَشْعَرِيِّ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_806", "reason": "high_symbol_ratio:0.419", "chunk_text": "قَالَ أَبُو الْخَطَّابِ مَحْفُوظُ بْنُ أَحْمَدَ وَهَذَا قَوْلُ أَكْثَرِ الْفُقَهَاءِ وَالْمُتَكَلِّم"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_807", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَهَذَا هُوَ الْمَنْقُولُ عَنْ أَبِي حَنِيفَةَ نَفْسِهِ وَعَلَيْهِ عَامَّةُ أَصْحَابِهِ وَكَثِيرٌ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_808", "reason": "high_symbol_ratio:0.449", "chunk_text": "بِمُجَرَّدِ مُخَالَفَتِهِمْ لِلْعَقْلِ كَقَوْلِ الْمُعْتَزِلَةِ وَالْحَنَفِيَّةِ وَأَبِي الْخَطَّابِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_809", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَمِنْهُمْ مَنْ يَقُولُ بَلْ لَا يُعَذَّبُونَ حَتَّى يُبْعَثَ إِلَيْهِمْ رَسُولٌ؛ كَمَا دَلَّ عَلَيْ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_810", "reason": "high_symbol_ratio:0.420", "chunk_text": "لَكِنَّ أَفْعَالَهُمْ تَكُونُ مَذْمُومَةً مَمْقُوتَةً يَذُمُّهَا اللَّهُ وَيُبْغِضُهَا وَيُوصَفُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_811", "reason": "high_symbol_ratio:0.423", "chunk_text": "قَالَ: \" إِنِّي مُبْتَلِيكَ وَمُبْتَلٍ بِكَ وَمُنْزِلٌ عَلَيْكَ كِتَابًا لَا يَغْسِلُهُ الْمَاءُ تَق"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_812", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَقَالَ: إِنِّي خَلَقْتُ عِبَادِي حُنَفَاءَ فَاجْتَالَتْهُمُ الشَّيَاطِينُ وَحَرَّمَتْ عَلَيْهِمْ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_813", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ: النَّبِيُّ فِي الْحَدِيثِ الصَّحِيحِ كُلُّ مَوْلُودٍ يُولَدُ عَلَى الْفِطْرَةِ - وَفِي رِوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_814", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَمَعَ مَقْتِ اللَّهِ لَهُمْ فَقَدْ أَخْبَرَ أَنَّهُ لَمْ يَكُنْ لِيُعَذِّبَهُمْ حَتَّى يَبْعَثَ إِل"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_815", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَقَوْلُ مَنْ قَالَ: أَنَّهُمْ كَانُوا مُعَذَّبِينَ بِدُونِ السَّمْعِ إِمَّا لِقِيَامِ الْحُجَّةِ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_816", "reason": "high_symbol_ratio:0.401", "chunk_text": "قَالَ تَعَالَى: وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا يَتْلُو "}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_817", "reason": "high_symbol_ratio:0.425", "chunk_text": "يُبَيِّنُ أَنَّهُ لَمْ يَكُنْ لِيُعَذِّبَ الْكُفَّارَ حَتَّى يَبْعَثَ إِلَيْهِمْ رَسُولًا، وَبَيَّنَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_819", "reason": "high_symbol_ratio:0.436", "chunk_text": "يُفَوِّضُوهَا، وَإِمَّا أَنْ يَتَأَوَّلُوهَا كَمَا يَصْنَعُ أَهْلُ الضَّلَالِ، يَتَّبِعُونَ الْمُتَش"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_820", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالثَّانِي: خَوَارِقُ ظَنُّوهَا آيَاتٍ وَهِيَ مِنْ أَحْوَالِ الشَّيَاطِينِ وَهَذَا مِمَّا ضَلَّ بِه"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_821", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالثَّالِثُ: أَخْبَارٌ مَنْقُولَةٌ إِلَيْهِمْ ظَنُّوهَا صِدْقًا وَهِيَ كَذِبٌ وَإِلَّا فَلَيْسَ مَع"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_822", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَإِذَا اسْتَفْسَرُوا عَنْ مَعَانِي تِلْكَ الْكَلِمَاتِ، وَفُرِّقَ بَيْنَ حَقِّهَا وَبَاطِلِهَا تَبَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_823", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَإِنْ تَكَلَّمُوا بِمَنْقُولٍ: فَإِمَّا أَنْ يَكُونَ صَحِيحًا لَكِنْ لَا يَدُلُّ عَلَى بَاطِلِهِمْ."}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_824", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَكَذَلِكَ مَا يَذْكُرُونَهُ مِنْ خَوَارِقِ الْعَادَاتِ: إِمَّا أَنْ يَكُونَ صَحِيحًا قَدْ ظَهَرَ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:40439:284945#chunk_825", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَإِمَّا أَنْ تَكُونَ قَدْ ظَهَرَتْ عَلَى يَدِ بَعْضِ الصَّالِحِينَ كَالْحَوَارِيِّينَ وَذَلِكَ لَا "}
