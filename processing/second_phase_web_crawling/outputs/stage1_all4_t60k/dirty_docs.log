{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1239", "reason": "high_symbol_ratio:0.408", "chunk_text": "قَالَتْ: كَانَ رَسُولُ اللَّهِ إِذَا أَرَادَ أَنْ يَخْرُجَ سَفَرًا أَقْرَعَ بَيْنَ نِسَائِهِ فَأَيَّ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1240", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَلَمَسْتُ صَدْرِي فَإِذَا عِقْدٌ لِي مِنْ جَزْعِ ظَفَارِ قَدْ وَقَعَ فَرَجَعْتُ فَالْتَمَسْتُ عِقْد"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1241", "reason": "high_symbol_ratio:0.412", "chunk_text": "مَنَازِلَهُمْ وَلَيْسَ بِهَا دَاعٍ وَلَا مُجِيبٌ فَتَيَمَّمْتُ مَنْزِلِي الَّذِي كُنْتُ فِيهِ فَبَيْ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1242", "reason": "high_symbol_ratio:0.400", "chunk_text": "فَوَطِئَ عَلَى يَدِهَا فَرَكِبْتُهُ، ثُمَّ انْطَلَقَ يَقُودُ بِي الرَّاحِلَةَ حَتَّى أَتَى الْجَيْشَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1243", "reason": "high_symbol_ratio:0.415", "chunk_text": "كَيْفَ تِيكُمْ؟ فَيَرِيبُنِي ذَلِكَ وَلَا أَشْعُرُ بِالشَّرِّ حَتَّى خَرَجْتُ بَعْدَ مَا نَقَهْتُ مِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1244", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَابْنُهَا مِسْطَحُ بْنُ أُثَاثَةَ بْنِ عَبَّادِ بْنِ الْمُطَّلِبِ فَأَقْبَلْنَا حَيْثُ فَرَغْنَا مِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1245", "reason": "high_symbol_ratio:0.428", "chunk_text": "أَبَوَيَّ؟ وَأَنَا حِينَئِذٍ أُرِيدُ أَنْ أَتَيَقَّنَ الْخَبَرَ مِنْ قِبَلِهِمَا فَأَذِنَ لِي رَسُول"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1246", "reason": "high_symbol_ratio:0.411", "chunk_text": "طَالِبٍ وَأُسَامَةَ بْنَ زَيْدٍ وَهُوَ حِينَئِذٍ يُرِيدُ أَنْ يَسْتَشِيرَهُمَا فِي فِرَاقِ أَهْلِهِ "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1247", "reason": "high_symbol_ratio:0.412", "chunk_text": "يَرِيبُكِ؟» فَقَالَتْ: بَرِيرَةُ: يَا رَسُولَ اللَّهِ وَالَّذِي بَعَثَكَ بِالْحَقِّ، مَا رَأَيْتُ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1248", "reason": "high_symbol_ratio:0.415", "chunk_text": "خَيْرًا، وَمَا كَانَ يَدْخُلُ عَلَى أَهْلِي إِلَّا مَعِي فَقَامَ سَعْدُ بْنُ مُعَاذٍ الْأَنْصَارِيُّ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1249", "reason": "high_symbol_ratio:0.410", "chunk_text": "مُنَافِقٌ تُجَادِلُ عَنِ الْمُنَافِقِينَ، قَالَتْ: فَثَارَ الْحَيَّانِ الْأَوْسُ وَالْخَزْرَجُ حَتَّ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1250", "reason": "high_symbol_ratio:0.411", "chunk_text": "فَجَلَسَتْ تَبْكِي مَعِي فَبَيْنَا نَحْنُ عَلَى حَالِنَا ذَلِكَ إِذْ دَخَلَ رَسُولُ اللَّهِ ثُمَّ جَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1251", "reason": "high_symbol_ratio:0.413", "chunk_text": "دَمْعِي حَتَّى مَا أُحِسُّ مِنْهُ بِقَطْرَةٍ فَقُلْتُ لِأَبِي: أَجِبْ عَنِّي رَسُولَ اللَّهِ فَقَالَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1252", "reason": "high_symbol_ratio:0.414", "chunk_text": "اعْتَرَفْتُ لَكُمْ بِأَمْرٍ وَاللَّهُ يَعْلَمُ أَنِي بَرِيئَةٌ لَتُصَدِّقُونِي وَاللَّهِ لَا أَجِدُ "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1253", "reason": "high_symbol_ratio:0.410", "chunk_text": "اللَّهِ فِي مَنَامِهِ رُؤْيَا يُبَرِّئُنِي اللَّهُ بِهَا قَالَتْ: فَوَاللَّهِ مَا رَامَ رَسُولُ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1254", "reason": "high_symbol_ratio:0.414", "chunk_text": "الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ} إِلَى عَشْرِ آيَاتٍ قَالَتْ: فَأَنْزَلَ اللَّهُ عَز"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1255", "reason": "high_symbol_ratio:0.413", "chunk_text": "الَّتِي كَانَ يُنْفِقُ عَلَيْهِ فَقَالَ: وَاللَّهِ لَا أَنْزَعُهَا مِنْهُ أَبَدًا، قَالَتْ: وَكَانَ "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1256", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَيَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ وَنَافِعٍ وَمَشْيَخَةِ أَهْلِ الْمَدِينَةِ عَنْ عَائِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1257", "reason": "high_symbol_ratio:0.413", "chunk_text": "أَخْبَرَنَا عَبْدُ الْوَهَّابِ الثَّقَفِيُّ قَالَ: سَمِعْتُ يَحْيَى بْنَ سَعِيدٍ يَقُولُ: سَمِعْتُ ع"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1258", "reason": "high_symbol_ratio:0.425", "chunk_text": "أَخْبَرَنَا عَبْدَةُ بْنُ سُلَيْمَانَ، نا مُحَمَّدُ بْنُ عَمْرٍو، عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1259", "reason": "high_symbol_ratio:0.410", "chunk_text": "عَلَيْهِ حَتَّى يَسْتَقْبِلَ 1107. أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى، عَنْ مُحَمَّدِ بْنِ عَمْرٍو بِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1260", "reason": "high_symbol_ratio:0.423", "chunk_text": "أَخْبَرَنَا سُفْيَانُ، حَدَّثَنِي جَامِعُ بْنُ أَبِي رَاشِدٍ، عَنْ مُنْذِرٍ الثَّوْرِيِّ، عَنِ الْحَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1261", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَتْ عَائِشَةُ: فَقُلْتُ: يَا رَسُولَ اللَّهِ وَفِيهِمْ أَهْلُ طَاعَةِ اللَّهِ؟ قَالَ: نَعَمْ، "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1262", "reason": "high_symbol_ratio:0.419", "chunk_text": "أَخْبَرَنَا وَكِيعٌ، نا سُفْيَانُ، عَنْ قَيْسِ بْنِ مُسْلِمٍ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ، عَنْ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1263", "reason": "high_symbol_ratio:0.413", "chunk_text": "أَخْبَرَنَا عَبْدُ الرَّزَّاقِ بِهَذَا الْإِسْنَادِ مِثْلَهُ وَقَالَ: وَشِيقَةُ ظَبْيٍ 1111. أَخْبَر"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1264", "reason": "high_symbol_ratio:0.408", "chunk_text": "1112. أَخْبَرَنَا الْمُلَائِيُّ بِهَذَا الْإِسْنَادِ مِثْلَهُ، وَقَالَ: فَقِيلَ لَهَا: مَا لَكِ وَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1265", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَالَ: وَكَانَتْ عَائِشَةُ تَقْتُلُهُنَّ 1114. أَخْبَرَنَا وَهْبُ بْنُ جَرِيرٍ، نا شُعْبَةُ، عَنْ سَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1266", "reason": "high_symbol_ratio:0.418", "chunk_text": "أَخْبَرَنَا أَبُو عَامِرٍ الْعَقَدِيُّ، نا زُهَيْرٌ، وَهُوَ ابْنُ مُحَمَّدٍ الْعَنْبَرِيُّ عَنْ عَبْ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1267", "reason": "high_symbol_ratio:0.411", "chunk_text": "أَخْبَرَنَا عِيسَى بْنُ يُونُسَ، نا مُحَمَّدُ بْنُ إِسْحَاقَ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْن"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1269", "reason": "high_symbol_ratio:0.405", "chunk_text": "أَخْبَرَنَا عُثْمَانُ بْنُ عُمَرَ، نا ابْنُ أَبِي ذِئْبٍ، عَنْ عِمْرَانَ بْنِ بَشِيرٍ، أَوْ بِشْرٍ ع"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1270", "reason": "high_symbol_ratio:0.426", "chunk_text": "أَخْبَرَنَا الْمُلَائِيُّ، نا جَعْفَرُ بْنُ بُرْقَانَ، عَنْ عَبْدِ اللَّهِ الْمَدِينِيِّ، عَنْ عَائِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1271", "reason": "high_symbol_ratio:0.413", "chunk_text": "أَخْبَرَنَا أَبُو عَامِرٍ الْعَقَدِيُّ، نا سَعِيدُ بْنُ مُسْلِمِ بْنِ بَانَكٍ، قَالَ: سَمِعْتُ عَامِ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1272", "reason": "high_symbol_ratio:0.435", "chunk_text": "أَخْبَرَنَا عَبْدُ الرَّزَّاقِ، عَنْ مَعْمَرٍ، عَنِ الزُّهْرِيِّ، عَنْ سَالِمٍ، عَنْ أَبِيهِ، قَالَ:"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1273", "reason": "high_symbol_ratio:0.415", "chunk_text": "قَالَ سَالِمٌ: وَكَانَتْ عَائِشَةُ تَقُولُ: فَقَدْ حَلَّ لَهُ كُلُّ شَيْءٍ إِلَّا النِّسَاءَ. وَتَقُ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1274", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَخْبَرَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، نا حَمَّادُ بْنُ سَلَمَةَ، عَنْ سُهَيْلِ بْنِ أ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1275", "reason": "high_symbol_ratio:0.403", "chunk_text": "أَخْبَرَنَا مُوسَى الْقَارِيُّ، نا زَائِدَةُ، عَنْ أَبِي حَصِينٍ، عَنْ أَبِي صَالِحٍ السَّمَّانِ، عَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1276", "reason": "high_symbol_ratio:0.425", "chunk_text": "أَخْبَرَنَا الْمُقْرِئُ، نا حَيْوَةُ، وَهُوَ ابْنُ شُرَيْحٍ حَدَّثَنِي نَافِعُ بْنُ سُلَيْمَانَ، أَن"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1277", "reason": "high_symbol_ratio:0.416", "chunk_text": "أَخْبَرَنَا عُثْمَانُ بْنُ عُمَرَ، نا ابْنُ أَبِي ذِئْبٍ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ، "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1278", "reason": "high_symbol_ratio:0.411", "chunk_text": "قَالَتْ: فَرَفَعَ رَسُولُ اللَّهِ يَدَيْهِ إِلَى السَّمَاءِ مَدًّا فَقَالَ: «اللَّهُمَّ إِنَّمَا أَن"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1279", "reason": "high_symbol_ratio:0.422", "chunk_text": "أَخْبَرَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِيُّ، نا مُحَمَّدُ بْنُ عَمْرٍو، حَدَّثَنِي أَبِي، عَنْ عَ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1280", "reason": "high_symbol_ratio:0.429", "chunk_text": "مِنْهَا قَالَتْ: وَكَانَ مِنْ أَعْظَمِ النَّاسِ وَأَطْوَلِهِمِ. قَالَتْ: فَأَنَا أَتَخَوَّفُ عَلَى أ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1281", "reason": "high_symbol_ratio:0.415", "chunk_text": ". . مَا أَحْسَنَ الْمَوْتَ إِذَا حَانَ الْأَجَلْ قَالَتْ: فَلَمَّا جَاوَزَنِي اقْتَحَمْتُ حَدِيقَةً "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1282", "reason": "high_symbol_ratio:0.411", "chunk_text": "لَهُ ابْنُ الْعَرِقَةِ فَقَالَ: خُذْهَا وَأَنَا ابْنُ الْعَرِقَةِ، فَقَالَ سَعْدٌ: عَرَّقَ اللَّهُ و"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1283", "reason": "high_symbol_ratio:0.425", "chunk_text": "فَرَجَعَ رَسُولُ اللَّهِ فَضَرَبَ قُبَّةً عَلَى سَعْدٍ فِي الْمَسْجِدِ فَوَضَعَ الْمُسْلِمُونَ السِّ"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1284", "reason": "high_symbol_ratio:0.406", "chunk_text": "الْقُبَّةِ الَّتِي ضَرَبَ رَسُولُ اللَّهِ فَحَاصَرُوهُمْ شَهْرًا أَوْ خَمْسًا وَعِشْرِينَ لَيْلَةً، "}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1285", "reason": "high_symbol_ratio:0.429", "chunk_text": "قَالَ أَبُو سَعِيدٍ الْخُدْرِيُّ: فَلَمَّا طَلَعَ عَلَى رَسُولِ اللَّهِ قَالَ: «قُومُوا إِلَى سَيِّد"}
{"source": "wikisource", "raw_id": "arwikisource:53499:257327#chunk_1286", "reason": "high_symbol_ratio:0.414", "chunk_text": "أَبْقَيْتَ مِنْ حَرْبِ قُرَيْشٍ عَلَى رَسُولِكَ شَيْئًا فَأَبْقِنِي فِيهِمْ، وَإِنْ كُنْتَ قَطَعْتَ "}
