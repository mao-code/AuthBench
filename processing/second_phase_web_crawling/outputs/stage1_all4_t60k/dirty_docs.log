{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_659", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْكُفْرَ لَهُمْ، وَكَذَلِكَ يَقْتَضِي النَّدْبَ لِنَيْلِ الثَّوَابِ، وَيَقُولُ: الْفِعْلُ وَالتَّرْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_660", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَأَمَّا قَوْلُهُمْ: إنَّهُ لَا يُسَمَّى عَاصِيًا، فَسَبَبُهُ أَنَّ الْعِصْيَانَ اسْم ذَمٍّ وَقَدْ أ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_661", "reason": "high_symbol_ratio:0.403", "chunk_text": "بِالنَّوْعِ وَإِلَى وَاحِدٍ بِالْعَدَدِ. أَمَّا الْوَاحِدُ بِالنَّوْعِ كَالسُّجُودِ مَثَلًا، فَإِنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_662", "reason": "high_symbol_ratio:0.413", "chunk_text": "وَذَهَبَ بَعْضُ الْمُعْتَزِلَةِ إلَى تَنَاقُضٍ، فَإِنَّ السُّجُودَ نَوْعٌ وَاحِدٌ مَأْمُورٌ بِهِ فَي"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_663", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَهَذَا خَطَأٌ فَاحِشٌ، فَإِنَّهُ إذَا تَغَايَرَ مُتَعَلَّقُ الْأَمْرِ وَالنَّهْيِ لَمْ يَتَنَاقَضْ،"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_664", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالْمُغَايَرَةُ تَارَةً تَكُونُ بِاخْتِلَافِ النَّوْعِ وَتَارَةً بِاخْتِلَافِ الْوَصْفِ وَتَارَةً ب"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_668", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَكَيْفَ يُثَابُ عَلَى مَا يُعَاقَبُ عَلَيْهِ وَفِعْلُهُ وَاحِدٌ هُوَ كَوْنٌ فِي الدَّارِ الْمَغْصُو"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_669", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَإِنْ كَانَ وَاحِدًا فِي نَفْسِهِ فَإِذَا كَانَ لَهُ وَجْهَانِ مُتَغَايِرَانِ يَجُوزُ أَنْ يَكُونَ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_670", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَكَذَلِكَ يُعْقَلُ مِنْ السَّيِّدِ أَنْ يَقُولَ لِعَبْدِهِ: \" صَلِّ الْيَوْمَ أَلْف رَكْعَةٍ وَخِطْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_671", "reason": "high_symbol_ratio:0.409", "chunk_text": "فَخَاطَ الثَّوْبَ فِي الدَّارِ وَصَلَّى أَلْفَ رَكْعَةٍ فِي تِلْكَ الدَّارِ، فَيَحْسُنُ مِنْ السَّيِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_672", "reason": "high_symbol_ratio:0.430", "chunk_text": "فَالْفِعْلُ وَإِنْ كَانَ وَاحِدًا فَقَدْ تَضَمَّنَ تَحْصِيلَ أَمْرَيْنِ مُخْتَلِفَيْنِ يَطْلُبُ أَحَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_673", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَلَوْ رَمَى سَهْمًا وَاحِدًا إلَى مُسْلِمٍ بِحَيْثُ يَمْرُقُ إلَى كَافِرٍ أَوْ إلَى كَافِرٍ بِحَيْث"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_674", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَإِنْ قِيلَ: ارْتِكَاب الْمَنْهِيِّ عَنْهُ إذَا أَخَلَّ بِشَرْطِ الْعِبَادَةِ أَفْسَدَهَا بِالِاتِّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_675", "reason": "high_symbol_ratio:0.415", "chunk_text": "تَكْلِيفِ الظَّلَمَةِ قَضَاءَ الصَّلَوَاتِ مَعَ كَثْرَتِهِمْ، وَكَيْفَ يُنْكِرُ سُقُوطَ نِيَّةِ التَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_676", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَقَدْ ذَهَبَ قَوْمٌ إلَى أَنَّ الصَّلَاةَ تَجِبُ فِي آخِرِ الْوَقْتِ وَالصَّبِيُّ إذَا صَلَّى فِي أ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_677", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَإِنْ قِيلَ مَنْ نَوَى الصَّلَاةَ فَقَدْ تَضَمَّنَتْ نِيَّتُهُ الْقُرْبَةَ قُلْنَا: إذَا صَحَّتْ ال"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_678", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَيَصِحُّ أَنْ يُقَالَ تَعَلَّقَتْ نِيَّةُ التَّقَرُّبِ بِبَعْضِ أَجْزَاءِ الصَّلَاةِ مِنْ الذِّكْرِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_679", "reason": "high_symbol_ratio:0.412", "chunk_text": "ثُمَّ كَيْفَ يَسْتَقِيمُ مِنْ الْمُعْتَزِلَةِ هَذَا وَعِنْدَهُمْ لَا يُعْلَمُ الْمَأْمُورُ كَوْنُهُ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_680", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَقَدْ بَيَّنَّا انْفِصَالَ أَحَدِهِمَا عَنْ الْآخَرِ؛ وَلِذَلِكَ يَجِدُ الْمُصَلِّي مِنْ نَفْسِهِ ن"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_681", "reason": "high_symbol_ratio:0.416", "chunk_text": "بِهِ. قُلْنَا: هُوَ مِنْ حَيْثُ إنَّهُ مُسْتَوْفٍ مَنَافِعَ الدَّارِ غَاصِبٌ وَمِنْ حَيْثُ إنَّهُ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_682", "reason": "high_symbol_ratio:0.405", "chunk_text": "فَهُمَا وَجْهَانِ مُخْتَلِفَانِ وَإِنْ كَانَ ذَاتُ الْفِعْلِ وَاحِدًا. الْجَوَابُ الثَّالِثُ: هُوَ أ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_683", "reason": "high_symbol_ratio:0.435", "chunk_text": "فَإِنْ قِيلَ: هَذِهِ الْمَسْأَلَةُ اجْتِهَادِيَّةٌ أَمْ قَطْعِيَّةٌ؟ قُلْنَا: هِيَ قَطْعِيَّةٌ وَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_684", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَإِنْ قِيلَ: ادَّعَيْتُمْ الْإِجْمَاعَ فِي هَذِهِ الْمَسْأَلَةِ وَقَدْ ذَهَبَ أَحْمَدُ بْنُ حَنْبَل"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_685", "reason": "high_symbol_ratio:0.423", "chunk_text": "ذِمَّتِهِ دَانِقٌ ظَلَمَ بِهِ، وَلَا يَصِحُّ بَيْعُهُ وَلَا صَلَاتُهُ وَلَا تَصَرُّفَاتُهُ، وَإِنَّه"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_686", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْمَكْرُوهُ وَالْوَاجِبُ فَلَا يَدْخُلُ مَكْرُوهٌ تَحْتَ الْأَمْرِ حَتَّى يَكُونَ شَيْءٌ وَاحِدٌ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_687", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَرُبَّمَا شَوَّشَ الْخُشُوعُ بِحَيْثُ لَا يَنْقَدِحُ صَرْفُ الْكَرَاهَةِ عَنْ الْمَأْمُورِ إلَى مَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_688", "reason": "high_symbol_ratio:0.403", "chunk_text": "عَنْهُ الْغَصْبُ وَهُوَ فِي جِوَارِهِ. [مَسْأَلَةٌ الْمُتَّفِقُونَ عَلَى صِحَّةِ الصَّلَاة فِي الدَّ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_690", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَيُقَالُ: الصَّوْمُ مِنْ حَيْثُ إنَّهُ صَوْمٌ مَشْرُوعٌ مَطْلُوبٌ وَمِنْ حَيْثُ إنَّهُ وَاقِعٌ فِي "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_691", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَالْبَيْعُ مِنْ حَيْثُ إنَّهُ بَيْعٌ مَشْرُوعٌ وَلَكِنْ مِنْ حَيْثُ وُقُوعُهُ مُقْتَرِنًا بِشَرْطٍ "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_692", "reason": "high_symbol_ratio:0.401", "chunk_text": "هَذَا قِسْمًا ثَالِثًا، وَزَعَمَ أَنَّ ذَلِكَ يُوجِبُ فَسَادَ الْوَصْفِ لَا انْتِفَاءَ الْأَصْلِ؛ لِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_693", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَإِنَّهُ قَالَ - عَلَيْهِ الصَّلَاةُ وَالسَّلَامُ -: «لَا صَلَاةَ إلَّا بِطُهُورٍ» فَهُوَ نَفْيٌ لِ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_694", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَالنَّظَرُ الثَّانِي نَظَرٌ فِي تَضَادِّ هَذِهِ الْأَوْصَافِ وَمَا يُعْقَلُ اجْتِمَاعُهُ وَمَا لَا "}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_695", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَيُعْقَل مِنْهُ أَنْ يَقُول أَنَا أَطْلُب مِنْك الْخِيَاطَةَ وَأَكْرَهُ دُخُولَ هَذِهِ الدَّارِ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_698", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَإِنْ قِيلَ: فَلِمَ صَحَّتْ الصَّلَاةُ فِي أَوْقَاتِ الْكَرَاهَةِ وَلِمَ صَحَّتْ الصَّلَاةُ الْوَاق"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_700", "reason": "high_symbol_ratio:0.412", "chunk_text": "فَقَطَعَ الشَّافِعِيُّ - رَحِمَهُ اللَّهُ - بِبُطْلَانِهِ؛ لِأَنَّهُ لَمْ يَظْهَرْ انْصِرَافُ النَّه"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_701", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَعَدَمِ التَّضَادِّ. وَأَمَّا النَّظَرُ فِي آحَادِ الْمَسَائِلِ أَنَّهَا مِنْ أَيِّ قِسْمٍ هِيَ فَإ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_702", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَلِيس عَلَى الْأُصُولِيِّ شَيْءٌ مِنْ ذَلِكَ. وَتَمَامُ النَّظَرِ فِي هَذَا بِبَيَانِ أَنَّ النَّهْ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_703", "reason": "high_symbol_ratio:0.422", "chunk_text": "[مَسْأَلَةٌ الْأَمْرُ بِالشَّيْءِ هَلْ هُوَ نَهْيٌ عَنْ ضِدِّهِ] ِ اخْتَلَفُوا فِي أَنَّ الْأَمْرَ ب"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_704", "reason": "high_symbol_ratio:0.416", "chunk_text": "الْمَعْنَيَيْنِ، فَالْمَعْنَيَانِ الْمَفْهُومَانِ مِنْهُ مُتَّحِدَانِ أَوْ أَحَدُهُمَا غَيْرُ الْآخَ"}
{"source": "wikisource", "raw_id": "arwikisource:177251:305874#chunk_705", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَالطَّرَفُ الثَّانِي: الْبَحْثُ عَنْ الْمَعْنَى الْقَائِمِ بِالنَّفْسِ، وَهُوَ أَنَّ طَلَبَ الْقِيَ"}
