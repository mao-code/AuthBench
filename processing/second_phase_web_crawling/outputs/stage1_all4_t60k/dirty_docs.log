{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_280", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَجَعَلَ الْأَعْمَالَ الْوَاقِعَةَ بَيْنَهُ وَبَيْنَ السَّيِّدِ كَالْمُعَامَلَةِ الْوَاقِعَةِ بَيْنَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_281", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَلَكِنَّ مَذْهَبَ الشَّافِعِيِّ رَحِمَهُ اللَّهُ مُشْكِلٌ مِنْ جِهَةِ أَنَّهُ شَرَطَ فِي الْكِتَابَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_282", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَلَوْ كَاتَبَهُ عَلَى ثَمَنِ دِرْهَمٍ وَأَجَّلَهُ مَثَلًا بِشَهْرٍ لَمْ يَصِحَّ عِنْدَ الشَّافِعِيِ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_283", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَأُجِيبَ عَنْهُ بِأَنَّهُ يَمْلِكُ الْمَبِيعَ فَيَكُونُ مُوسِرًا بِهِ ، وَهَذَا لَا يَسْتَقِيمُ ، ف"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_284", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَكَذَلِكَ لَوْ تَبَايَعَ اثْنَانِ عَيْنًا غَائِبَةً وَالْمُشْتَرِي مُعْسِرٌ ، وَهُمَا فِي بَرِّيَّة"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_285", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْمِثَالُ الثَّالِثُ وَالْعِشْرُونَ : اعْلَمْ أَنَّ اللَّهَ قَسَّمَ أَمْوَالَ الْمَصَالِحِ الْعَامَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_286", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَكَذَلِكَ مَوَارِيثُ الْبَنِينَ وَالْبَنَاتِ وَالْإِخْوَةِ وَالْأَخَوَاتِ عَلَى قَدْرِ الْحَاجَاتِ "}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_287", "reason": "high_symbol_ratio:0.411", "chunk_text": "لِكُلِّ وَاحِدٍ مِنْهُمَا السُّدُسَ مَعَ وُجُودِ الْأَوْلَادِ ، وَفَضْلِ الْأَبِ مَعَ الْأُمِّ مَعَ "}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_288", "reason": "high_symbol_ratio:0.422", "chunk_text": "أَضْعَافُ مَا يَحْصُلُ لِلْبَنَاتِ مَعَ قُرْبِهِنَّ ، إذْ يَحْصُلُ لِكُلِّ بِنْتٍ دِرْهَمٌ وَاحِدٌ ،"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_289", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَكَذَلِكَ خُولِفَ الْقِيَاسُ فِي الْإِخْوَةِ مَعَ الْجَدِّ لِأَنَّ كُلَّ وَاحِدٍ مِنْهُمَا يُدْلِي "}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_290", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْمِثَالُ الرَّابِعُ وَالْعِشْرُونَ : الْأَحْدَاثُ الْمُطَلَّقُونَ مُسْتَقِلُّونَ فِي التَّصَرُّفِ "}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_291", "reason": "high_symbol_ratio:0.417", "chunk_text": "النِّكَاحِ ."}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_292", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْمِثَالُ الْخَامِسُ وَالْعِشْرُونَ : قَوْلُ الرَّجُلِ لِزَوْجَتِهِ إنْ أَعْطَيْتنِي أَلْفًا فَأَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_293", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَقَاعِدَةُ الشَّافِعِيِّ أَنَّ الْعُقُودَ لَا تَنْعَقِدُ إلَّا بِالْأَفْعَالِ ، وَلَوْ قَالَ إنْ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_294", "reason": "high_symbol_ratio:0.401", "chunk_text": "الْمِثَالُ السَّادِسُ وَالْعِشْرُونَ : لَا يَجُوزُ إسْقَاطُ شَيْءٍ مِنْ حُقُوقِ الْمُوَلَّى عَلَيْهِ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_295", "reason": "high_symbol_ratio:0.407", "chunk_text": "الْمِثَالُ السَّابِعُ وَالْعِشْرُونَ : مَنْ أَتْلَفَ شَيْئًا عَمْدًا بِغَيْرِ حَقٍّ لَزِمَهُ الضَّمَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_296", "reason": "high_symbol_ratio:0.405", "chunk_text": "إحْدَاهَا : مَا أَتْلَفَهُ الْكُفَّارُ عَلَى الْمُسْلِمِينَ مِنْ النُّفُوسِ وَالْأَمْوَالِ فَإِنَّهُ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_297", "reason": "high_symbol_ratio:0.417", "chunk_text": "الصُّورَةُ الثَّانِيَةُ : مَا يُتْلِفُهُ الْمُرْتَدُّونَ فِي حَالِ الْقِتَالِ ، وَفِي تَضَمُّنِهِ مَ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_299", "reason": "high_symbol_ratio:0.404", "chunk_text": "الصُّورَةُ الرَّابِعَةُ : مَا يُتْلِفُهُ الْعَبِيدُ عَلَى السَّادَةِ فَإِنَّهُمْ لَا يَضْمَنُونَهُ م"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_300", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَأَمَّا مَا يُتْلِفُهُ الْعَبْدُ عَلَى غَيْرِ سَيِّدِهِ فَإِنَّهُ يَتَعَلَّقُ بِرَقَبَتِهِ خِلَافًا"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_301", "reason": "high_symbol_ratio:0.407", "chunk_text": "الصِّبْيَانِ وَالْمَجَانِينِ ثَابِتٌ مَعَ أَنَّهُ لَا يُنْسَبُ إلَيْهِمْ تَقْصِيرٌ بِسَبَبٍ وَلَا مُ"}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_302", "reason": "high_symbol_ratio:0.412", "chunk_text": "الصُّورَةُ الْخَامِسَةُ : أَنَّ الْإِمَامَ وَالْحَاكِمَ إذَا أَتْلَفَا شَيْئًا مِنْ النُّفُوسِ أَوْ "}
{"source": "wikisource", "raw_id": "arwikisource:2491:16601#chunk_303", "reason": "high_symbol_ratio:0.404", "chunk_text": "الصُّورَةُ السَّادِسَةُ : أَنَّ الْجَلَّادَ إذَا قَتَلَ بِالْحَدِّ أَوْ الْقِصَاصِ مَنْ لَا يَجُوزُ "}
