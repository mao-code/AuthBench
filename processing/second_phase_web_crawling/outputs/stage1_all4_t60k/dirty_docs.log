{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_7", "reason": "high_symbol_ratio:0.430", "chunk_text": "== وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَجْسَامُهُمْ وَإِنْ يَقُولُوا تَسْمَعْ لِقَوْلِهِمْ كَأَنَّهُمْ "}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_11", "reason": "high_symbol_ratio:0.407", "chunk_text": "== وَإِذَا قِيلَ لَهُمْ تَعَالَوْا يَسْتَغْفِرْ لَكُمْ رَسُولُ اللَّهِ لَوَّوْا رُءُوسَهُمْ وَرَأَيْ"}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_12", "reason": "high_symbol_ratio:0.431", "chunk_text": "تَعَالَى \" وَرَأَيْتهمْ يَصُدُّونَ وَهُمْ مُسْتَكْبِرُونَ."}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_13", "reason": "high_symbol_ratio:0.406", "chunk_text": "== سَوَاءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ لَنْ يَغْفِرَ اللَّهُ لَهُ"}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_47", "reason": "high_symbol_ratio:0.411", "chunk_text": "== يَقُولُونَ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ وَلِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_58", "reason": "high_symbol_ratio:0.414", "chunk_text": "== وَأَنْفِقُوا مِنْ مَا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ أَحَدَكُمُ الْمَوْتُ فَيَقُولَ رَبِ"}
{"source": "wikisource", "raw_id": "arwikisource:35731:377521#chunk_60", "reason": "high_symbol_ratio:0.417", "chunk_text": "هُوَ قَائِلُهَا وَمِنْ وَرَائِهِمْ بَرْزَخٌ إِلَى يَوْمِ يُبْعَثُونَ \" ."}
{"source": "wikisource", "raw_id": "ruwikisource:21338:5056587", "reason": "long_repeat_run:21", "chunk_text": ":::::::::::::::::::::: По материалу, заверенному :::::::::::::::::::::: Лака-Тыжменским сельсоветом "}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_14", "reason": "high_symbol_ratio:0.407", "chunk_text": "وقال تعالى: { وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ كَانَ مِن"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_16", "reason": "high_symbol_ratio:0.420", "chunk_text": "كما قال: { قَالَ أَرَأَيْتَكَ هَذَا الَّذِي كَرَّمْتَ عَلَيَّ لَئِنْ أَخَّرْتَنِ إِلَى يَوْمِ الْقِي"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_20", "reason": "high_symbol_ratio:0.400", "chunk_text": "وقال تعالى: { قُلْ أُوحِيَ إِلَيَّ أَنَّهُ اسْتَمَعَ نَفَرٌ مِنَ الْجِنِّ فَقَالُوا إِنَّا سَمِعْنَا"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_21", "reason": "high_symbol_ratio:0.406", "chunk_text": "وَأَنَّا لَمَسْنَا السَّمَاءَ فَوَجَدْنَاهَا مُلِئَتْ حَرَسًا شَدِيدًا وَشُهُبًا * وَأَنَّا كُنَّا ن"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_22", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَأَنَّا مِنَّا الْمُسْلِمُونَ وَمِنَّا الْقَاسِطُونَ فَمَنْ أَسْلَمَ فَأُولَئِكَ تَحَرَّوْا رَشَدًا"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_32", "reason": "high_symbol_ratio:0.410", "chunk_text": "وقال تعالى: { وَلَقَدْ صَدَّقَ عَلَيْهِمْ إِبْلِيسُ ظَنَّهُ فَاتَّبَعُوهُ إِلَّا فَرِيقًا مِنَ الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_33", "reason": "high_symbol_ratio:0.401", "chunk_text": "وقال تعالى: { يَابَنِي آدَمَ لَا يَفْتِنَنَّكُمُ الشَّيْطَانُ كَمَا أَخْرَجَ أَبَوَيْكُمْ مِنَ الْجَ"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_34", "reason": "high_symbol_ratio:0.405", "chunk_text": "وقال: { وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْن"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_35", "reason": "high_symbol_ratio:0.425", "chunk_text": "يُبْعَثُونَ * قَالَ فَإِنَّكَ مِنَ الْمُنْظَرِينَ * إِلَى يَوْمِ الْوَقْتِ الْمَعْلُومِ * قَالَ رَبِ"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_38", "reason": "high_symbol_ratio:0.409", "chunk_text": "{ وَقَالَ الشَّيْطَانُ لَمَّا قُضِيَ الْأَمْرُ إِنَّ اللَّهَ وَعَدَكُمْ وَعْدَ الْحَقِّ وَوَعَدْتُكُ"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_64", "reason": "high_symbol_ratio:0.403", "chunk_text": "وقال تعالى: { فَإِذَا قَرَأْتَ الْقُرْآنَ فَاسْتَعِذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ * إِنَّ"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_115", "reason": "high_symbol_ratio:0.408", "chunk_text": "وقال: { إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ * وَحِفْظًا مِنْ كُلِّ شَيْطَا"}
{"source": "wikisource", "raw_id": "arwikisource:23458:395961#chunk_128", "reason": "high_symbol_ratio:0.405", "chunk_text": "وقال تعالى: { وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا شَيَاطِينَ الْإِنْسِ وَالْجِنِّ يُوحِي ب"}
{"source": "wikisource", "raw_id": "arwikisource:10000:427826#chunk_52", "reason": "high_symbol_ratio:0.400", "chunk_text": "كَامِلَةٌ ذلِكَ لِمَن لَّمْ يَكُنْ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ وَاتَّقُواْ اللَّهَ وَاع"}
{"source": "wikisource", "raw_id": "arwikisource:10000:427826#chunk_53", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَسَبْعَةٍ إِذَا رَجَعْتُمْ تِلْكَ عَشَرَةٌ كَامِلَةٌ ذلِكَ لِمَن لَّمْ يَكُنْ أَهْلُهُ حَاضِرِي الْ"}
{"source": "wikisource", "raw_id": "arwikisource:63485:469618", "reason": "long_repeat_run:21", "chunk_text": "-------------------------------------------- هوامش: * : \"الهرد والكاشي والزباد\": الأول والثانس اسماء"}
{"source": "wikisource", "raw_id": "arwikisource:6806:21746#chunk_1", "reason": "high_symbol_ratio:0.402", "chunk_text": "عن زَيْد بْن خَالِدٍ الْجُهَنِيَّ صَاحِبَ رَسُولِ اللَّهِ يَقُولُ سُئِلَ رَسُولُ اللَّهِ عَنْ اللُّق"}
{"source": "wikisource", "raw_id": "arwikisource:6806:21746#chunk_4", "reason": "high_symbol_ratio:0.428", "chunk_text": "عَنْ ابْنِ عُمَرَ أَنَّ رَسُولَ اللَّهِ قَالَ لَا يَحْلُبَنَّ أَحَدٌ مَاشِيَةَ أَحَدٍ إِلَّا بِإِذْن"}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_22", "reason": "high_symbol_ratio:0.404", "chunk_text": "وَقَدْ سَرَدَهَا مُفَصَّلَة ثُمَّ قَالَ : فَسُبْحَان الَّذِي دَقَّتْ فِي كُلّ شَيْء حِكْمَته ."}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_28", "reason": "high_symbol_ratio:0.402", "chunk_text": "تَيْمِيَّةَ وَشَيْخنَا الْحَافِظ الْمُجْتَهِد أَبُو الْحَجَّاج الْمِزِّيّ وَحَكَاهُ لِي عَنْ اِبْن ت"}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_45", "reason": "high_symbol_ratio:0.401", "chunk_text": "== وَمِنَ النَّاسِ مَنْ يَشْتَرِي لَهْوَ الْحَدِيثِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ بِغَيْرِ عِلْمٍ و"}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_53", "reason": "high_symbol_ratio:0.405", "chunk_text": "== وَإِذَا تُتْلَى عَلَيْهِ آَيَاتُنَا وَلَّى مُسْتَكْبِرًا كَأَنْ لَمْ يَسْمَعْهَا كَأَنَّ فِي أُذُ"}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_65", "reason": "high_symbol_ratio:0.410", "chunk_text": "== وَلَقَدْ آَتَيْنَا لُقْمَانَ الْحِكْمَةَ أَنِ اشْكُرْ لِلَّهِ وَمَنْ يَشْكُرْ فَإِنَّمَا يَشْكُرُ"}
{"source": "wikisource", "raw_id": "arwikisource:35699:248977#chunk_74", "reason": "high_symbol_ratio:0.405", "chunk_text": "قَدْ تَزَوَّجَ وَوُلِدَ لَهُ أَوْلَاد فَمَاتُوا فَلَمْ يَبْكِ عَلَيْهِمْ وَكَانَ يَغْشَى السُّلْطَان"}
