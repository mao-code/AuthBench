{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_777", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَالتَّوْرَاةُ تَدُلُّ عَلَى تَعَدُّدِ الْكَلِمَاتِ، وَإِذَا كَانَ كَذَلِكَ، فَالْمَسِيحُ لَيْسَ هُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_778", "reason": "high_symbol_ratio:0.424", "chunk_text": "الثَّالِثُ: أَنَّ الْمَسِيحَ عِنْدَكُمْ هُوَ الْخَالِقُ، وَأَنْتُمْ مَعَ قَوْلِكُمْ: إِنَّهُ الِابْن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_779", "reason": "high_symbol_ratio:0.433", "chunk_text": "وَقَوْلُهُ: (بِكَلِمَتِهِ تَشَدَّدَتِ السَّمَاوَاتُ وَالْأَرْضُ) يَقْتَضِي أَنَّ الْكَلِمَةَ صِفَةُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_780", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَالرَّابِعُ: أَنَّ كَلِمَةَ اللَّهِ يُرَادُ بِهَا جِنْسُ كَلِمَاتِهِ، كَمَا قَالَ تَعَالَى: وَجَعَل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_781", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَأَمَّا نَقْلُكُمْ أَنَّهُ قَالَ: (وَبِرُوحِ فَاهْ جَمِيعُ قُوَّاتِهِنَّ) فَهَذِهِ الْكَلِمَةُ سَوَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_782", "reason": "high_symbol_ratio:0.416", "chunk_text": "اللَّهِ، وَادَّعَيْتُمْ أَنَّ الْأَنْبِيَاءَ سَمَّوْهُ بِذَلِكَ وَلَمْ تَذْكُرُوا نَقْلًا عَنِ الْأَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_784", "reason": "high_symbol_ratio:0.415", "chunk_text": "فَيُقَالُ هَذَا لَا حُجَّةَ فِيهِ لِأَنَّكُمُ ادَّعَيْتُمْ أَنَّ الْأَنْبِيَاءَ سَمَّتْ حَيَاةَ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_785", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَرُوحُ اللَّهِ يُرَادُ بِهَا الْمَلَكُ الَّذِي هُوَ رُوحٌ اصْطَفَاهُ اللَّهُ فَأَحَبَّهَا، كَمَا قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_786", "reason": "high_symbol_ratio:0.453", "chunk_text": "فَقَدْ أَخْبَرَ أَنَّهُ أَرْسَلَ إِلَيْهَا رُوحَهُ فَتَمَثَّلَ لَهَا بَشَرًا سَوِيًّا، وَتَبَيَّنَ أ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_787", "reason": "high_symbol_ratio:0.413", "chunk_text": "فَعُلِمَ أَنَّ الْمُرَادَ بِالرُّوحِ مَلَكٌ، هُوَ رُوحٌ اصْطَفَاهَا فَأَضَافَهَا إِلَيْهِ، كَمَا يُض"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_788", "reason": "high_symbol_ratio:0.438", "chunk_text": "كَقَوْلِهِ: نَاقَةَ اللَّهِ وَسُقْيَاهَا. وَقَوْلِهِ: وَطَهِّرْ بَيْتِيَ لِلطَّائِفِينَ وَالْقَائِمِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_789", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَقَوْلِهِ: عَيْنًا يَشْرَبُ بِهَا عِبَادُ اللَّهِ."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_790", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَالْمُضَافُ إِلَى اللَّهِ إِنْ كَانَ صِفَةً لَمْ تَقُمْ بِمَخْلُوقٍ كَالْعِلْمِ وَالْقُدْرَةِ وَالْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_791", "reason": "high_symbol_ratio:0.404", "chunk_text": "(عِبَادُ اللَّهِ)، كَذَلِكَ اخْتَصَّتِ الرُّوحُ الْمُصْطَفَاةُ بِأَنْ يُقَالَ لَهَا رُوحُ اللَّهِ. ب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_793", "reason": "high_symbol_ratio:0.427", "chunk_text": "وَإِذَا كَانَ كَذَلِكَ فَهَذَا اللَّفْظُ إِنْ كَانَ ثَابِتًا عَنِ النَّبِيِّ وَتُرْجِمَ تَرْجَمَةً ص"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_794", "reason": "high_symbol_ratio:0.427", "chunk_text": "الْمَلَكُ، ثُمَّ يَقُولُ: يَا رَبِّ رِزْقُهُ؟ فَيَقُولُ رَبُّكَ مَا يَشَاءُ، وَيَكْتُبُ الْمَلَكُ، ث"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_796", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَمِنْ هَذَا الْبَابِ قَوْلُهُ تَعَالَى: أَنِّي أَخْلُقُ لَكُمْ مِنَ الطِّينِ كَهَيْئَةِ الطَّيْرِ ف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_797", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَأَخْبَرَهُ أَنَّهُ يَخْلُقُ مِنَ الطِّينِ كَهَيْئَةِ الطَّيْرِ طَيْرًا بِإِذْنِ اللَّهِ، وَكَذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_798", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَلَا يَجُوزُ أَنْ يُرِيدَ بِهِ أَنَّ حَيَاةَ اللَّهِ خَلَقَتْنِي وَتُعَلِّمُنِي، فَإِنَّ الصِّفَةَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_799", "reason": "high_symbol_ratio:0.416", "chunk_text": "يَتَوَفَّى الْأَنْفُسَ حِينَ مَوْتِهَا وَالَّتِي لَمْ تَمُتْ فِي مَنَامِهَا. وَفِي مَوْضِعٍ آخَرَ: ح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_800", "reason": "high_symbol_ratio:0.441", "chunk_text": "وَفِي مَوْضِعٍ ثَالِثٍ: قُلْ يَتَوَفَّاكُمْ مَلَكُ الْمَوْتِ الَّذِي وُكِّلَ بِكُمْ ثُمَّ إِلَى رَبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_801", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَالْجَمِيعُ حَقٌّ، فَإِذَا وُجِدَ لَفْظٌ لَهُ مَعْنًى فِي كَلَامِ بَعْضِ الْأَنْبِيَاءِ، وَلَمْ يُو"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_802", "reason": "high_symbol_ratio:0.439", "chunk_text": "قَالُوا: وَقَوْلُهُ عَلَى لِسَانِ أَشْعِيَا النَّبِيِّ: (يَيْبَسُ الْقَتَادُ، وَيَجِفُّ الْعُشْبُ، و"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_803", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَيُقَالُ: إِمَّا أَنْ يُرِيدَ بِكَلِمَةِ اللَّهِ عِلْمَهُ، أَوْ كَلِمَةً مُعَيَّنَةً، أَوْ تَكُونُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_804", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَقَالَ النَّبِيُّ : مَنْ قَاتَلَ لِتَكُونَ كَلِمَةُ اللَّهِ هِيَ الْعُلْيَا فَهُوَ فِي سَبِيلِ اللَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_805", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَفِي قَوْلِهِ: قُلْ لَوْ كَانَ الْبَحْرُ مِدَادًا لِكَلِمَاتِ رَبِّي لَنَفِدَ الْبَحْرُ قَبْلَ أَنْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_806", "reason": "high_symbol_ratio:0.404", "chunk_text": "فَالْمُرَادُ بِذَلِكَ أَنَّ مَا قَالَهُ اللَّهُ فَهُوَ حَقٌّ ثَابِتٌ لَا يَبْطُلُ. كَمَا قَالَ تَعَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_807", "reason": "high_symbol_ratio:0.414", "chunk_text": "يَعْنِي بِتَمَامِهَا نَفَاذَ مَا وَعَدَهُمْ بِهِ مِنَ النَّصْرِ عَلَى فِرْعَوْنَ، وَإِهْلَاكِهِ، وَإ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_808", "reason": "high_symbol_ratio:0.435", "chunk_text": "وَقَالَ تَعَالَى: وَتَمَّتْ كَلِمَةُ رَبِّكَ صِدْقًا وَعَدْلًا. وَمِنْهُ قَوْلُهُ: وَاتْلُ مَا أُوحِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_809", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَقَوْلُهُ: سَيَقُولُ الْمُخَلَّفُونَ إِذَا انْطَلَقْتُمْ إِلَى مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_810", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَمِنْ هَذَا الْبَابِ قَوْلُ الْمَسِيحِ السَّمَاءُ وَالْأَرْضُ يَزُولَانِ، وَكَلَامِي لَا يَزُولُ، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_811", "reason": "high_symbol_ratio:0.418", "chunk_text": "أَبَدِيٌّ لَا يُوصَفُ بِالْبَقَاءِ دُونَ الْقِدَمِ وَلَوْ قُدِّرَ أَنَّهُ أَرَادَ بِالْكَلِمَةِ الْم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_812", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَمِمَّا يُوَضِّحُ هَذَا وَأَنَّهُ لَيْسَ الْمُرَادُ بِهِ مَا يَدَّعُونَهُ، أَنَّهُ قَالَ: وَكَلِمَة"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_813", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَعِنْدَهُمْ أَنَّ الْكَلِمَةَ الْمَوْلُودَةَ مِنَ الْأَبِ قَدِيمَةٌ أَزَلِيَّةٌ لَمْ تَزَلْ وَلَا ت"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_815", "reason": "high_symbol_ratio:0.408", "chunk_text": "فَيُقَالُ لَهُم: هَذَا عُمْدَتُكُمْ عَلَى مَا تَدَّعُونَهُ مِنَ الْأَقَانِيمِ الثَّلَاثَةِ وَلَيْسَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_816", "reason": "high_symbol_ratio:0.408", "chunk_text": "الْكَذِبِ عَلَى الْمَسِيحِ، وَهُوَ حَمْلٌ لِلَفْظِهِ عَلَى مَا لَمْ يَسْتَعْمِلْهُ هُوَ وَلَا غَيْرُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_817", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَلَوْ كَانَ لَفْظُ الِابْنِ يُسْتَعْمَلُ فِي صِفَةِ اللَّهِ لَسُمِّيَتْ حَيَاتُهُ ابْنًا، وَقُدْرَت"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_818", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَكَذَلِكَ رُوحُ الْقُدُسِ لَمْ يَسْتَعْمِلُوهَا فِي حَيَاةِ اللَّهِ، وَلَا أَرَادُوا بِهَذَا اللَّف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_819", "reason": "high_symbol_ratio:0.405", "chunk_text": "أَسْكُبُ مِنْ رُوحِي عَلَى كُلِّ قِدِّيسٍ) وَفِي زَبُورِ دَاوُدَ (رُوحُكَ الصَّالِحُ يَهْدِينِي فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_820", "reason": "high_symbol_ratio:0.408", "chunk_text": "يُوَضِّحُ هَذَا أَنَّهُمْ قَالُوا فِي أَمَانَتِهِم: (الَّذِي مِنْ أَجْلِنَا - نَحْنُ الْبَشَرَ - وَم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_821", "reason": "high_symbol_ratio:0.421", "chunk_text": "أَعُوذُ بِالرَّحْمَنِ مِنْكَ إِنْ كُنْتَ تَقِيًّا * قَالَ إِنَّمَا أَنَا رَسُولُ رَبِّكِ لِأَهَبَ لَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_823", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَقَالَ تَعَالَى: وَمَرْيَمَ ابْنَتَ عِمْرَانَ الَّتِي أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِنْ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_824", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَنُفِخَ فِيهَا مِنْ هَذَا الرُّوحِ فَكَانَ الْمَسِيحُ مَخْلُوقًا مِنْ هَذَا الرُّوحِ، وَمِنْ أُمِّه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_825", "reason": "high_symbol_ratio:0.409", "chunk_text": "الْكَلِمَةِ لَمْ يَكُنْ مُتَجَسِّدًا مِنْ رُوحِ الْقُدُسِ، وَإِنْ كَانَ مِنْ رُوحِ الْقُدُسِ لَمْ يَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_826", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَالنَّصَارَى بِفِرَقِهِمُ الثَّلَاثَةِ كُلُّهُمْ يَقُولُونَ: إِنَّمَا الْمُتَّحِدُ بِهِ أُقْنُومُ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_827", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَتَبَيَّنَ أَنَّ مَا ثَبَتَ عَنِ الْأَنْبِيَاءِ فَهُوَ حَقٌّ مُوَافِقٌ لِمَا أَخْبَرَ بِهِ مُحَمَّد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_828", "reason": "high_symbol_ratio:0.408", "chunk_text": "اللَّهِ، فَكَيْفَ يَجُوزُ أَنْ يُحْمَلَ لَفْظُ رُوحِ الْقُدُسِ عَلَى مَعْنًى لَمْ يَسْتَعْمِلْهُ فِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_829", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَهَلْ هَذَا إِلَّا مِنْ فِعْلِ مَنْ يُحَرِّفُ كَلَامَ الْأَنْبِيَاءِ، وَيَفْتَرِي الْكَذِبَ عَلَيْه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_832", "reason": "high_symbol_ratio:0.430", "chunk_text": "وَتَبَيَّنَ أَنَّ تَسْمِيَتَهُمْ لِعِلْمِ اللَّهِ وَكَلَامِهِ ابْنًا، وَتَسْمِيَتَهُمْ لِحَيَاتِهِ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_833", "reason": "high_symbol_ratio:0.425", "chunk_text": "كَمَا تَبَيَّنَ أَنَّهُ لَيْسَ لَهُ مُسْتَنَدٌ عَقْلِيٌّ، وَأَنَّ الْقَوْمَ مِمَّنْ قِيلَ فِيهِم: وَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_834", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَمِمَّنْ قِيلَ فِيهِم: أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ إِنْ هُمْ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_836", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَذَلِكَ مَعْرُوفٌ عِنْدَهُمْ مِنْ حِينِ ابْتَدَعُوا الْأَمَانَةَ الَّتِي لَهُمُ، الَّتِي وَضَعَهَا "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_837", "reason": "high_symbol_ratio:0.406", "chunk_text": "بِجِهَادِهِمْ؛ كَقَوْلِهِ تَعَالَى: لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ اب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_839", "reason": "high_symbol_ratio:0.429", "chunk_text": "فَيُقَالُ لَهُم: حَرَّفْتُمْ لَفْظَ الْآيَةِ وَمَعْنَاهَا؛ فَإِنَّ لَفْظَهَا: وَلَقَدْ سَبَقَتْ كَلِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_840", "reason": "high_symbol_ratio:0.428", "chunk_text": "فَالْكَلِمَةُ الَّتِي سَبَقَتْ لِعِبَادِهِ الْمُرْسَلِينَ قَوْلُهُ: إِنَّهُمْ لَهُمُ الْمَنْصُورُونَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_841", "reason": "high_symbol_ratio:0.432", "chunk_text": "وَقَوْلُهُ: وَكَذَلِكَ حَقَّتْ كَلِمَةُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا أَنَّهُمْ أَصْحَابُ النَّار"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_842", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَقَوْلُهُ: وَلَوْ شِئْنَا لَآتَيْنَا كُلَّ نَفْسٍ هُدَاهَا وَلَكِنْ حَقَّ الْقَوْلُ مِنِّي لَأَمْلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_843", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَالْكَلِمَةُ فِي لُغَةِ الْعَرَبِ: هِيَ الْجُمْلَةُ الْمُفِيدَةُ سَوَاءً كَانَتْ جُمْلَةً اسْمِيَّة"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_844", "reason": "high_symbol_ratio:0.421", "chunk_text": "قَالَ سِيبَوَيْهِ: وَاعْلَمْ أَنَّهُمْ يَحْكُونَ بِالْقَوْلِ مَا كَانَ كَلَامًا وَلَا يَحْكُونَ بِهِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_845", "reason": "high_symbol_ratio:0.406", "chunk_text": "قَالَ تَعَالَى: وَيُنْذِرَ الَّذِينَ قَالُوا اتَّخَذَ اللَّهُ وَلَدًا * مَا لَهُمْ بِهِ مِنْ عِلْمٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_846", "reason": "high_symbol_ratio:0.445", "chunk_text": "فَسَمَّى هَذِهِ الْجُمْلَةَ كَلِمَةً. وَقَالَ تَعَالَى: مَثَلًا كَلِمَةً طَيِّبَةً كَشَجَرَةٍ طَيِّب"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_847", "reason": "high_symbol_ratio:0.408", "chunk_text": "وَقَالَ تَعَالَى: إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ. وَقَالَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_848", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَقَالَ النَّبِيُّ : كَلِمَتَانِ حَبِيبَتَانِ إِلَى الرَّحْمَنِ خَفِيفَتَانِ عَلَى اللِّسَانِ، ثَقِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_849", "reason": "high_symbol_ratio:0.424", "chunk_text": "لَمَّا وَجَدَ بَعْضُهُمْ مَا سَمِعَهُ مِنْ كَلَامِ الْعَرَبِ أَنَّهُ يُرَادُ بِالْكَلِمَةِ الْجُمْلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_850", "reason": "high_symbol_ratio:0.426", "chunk_text": "وَمِنْهُمْ مَنْ يَجْعَلُ ذَلِكَ مَجَازًا، وَلَيْسَ الْأَمْرُ كَذَلِكَ، بَلْ هَذَا اصْطِلَاحُ هَؤُلَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_851", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَكَيْفَ يُقَالُ: إِنَّ هَذَا هُوَ الْمَجَازُ، وَإِنَّ هَذَا قَلِيلٌ وَكَثِيرٌ. كَمَا أَنَّ لَفْظَ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_852", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَقَوْلُهُ تَعَالَى: وَإِذْ لَمْ يَهْتَدُوا بِهِ فَسَيَقُولُونَ هَذَا إِفْكٌ قَدِيمٌ. وَقَوْلُهُ تَع"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_853", "reason": "high_symbol_ratio:0.421", "chunk_text": "ثُمَّ إِنَّ مِنْ أَهْلِ الْكَلَامِ مَنْ خَصَّ لَفْظَ الْقَدِيمِ بِمَا لَمْ يَسْبِقْهُ عَدَمٌ، أَوْ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_854", "reason": "high_symbol_ratio:0.436", "chunk_text": "فَتَبَيَّنَ أَنَّ مُرَادَهُ تَعَالَى بِقَوْلِهِ: وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْس"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_855", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَسَبَقَ مِنْهُ كَلِمَتُهُ بِمَا سَيَكُونُ مِنْ نَصْرِ الْمُرْسَلِينَ، وَمَلْءِ جَهَنَّمَ مِنَ الْجِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_857", "reason": "high_symbol_ratio:0.410", "chunk_text": "فَيُقَالُ: هَذَا مِمَّا لَا رَيْبَ فِيهِ، وَلَا حَجَّةَ لَكُمْ فِيهِ، بَلْ هُوَ حُجَّةٌ عَلَيْكُم، ف"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_858", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَقَالَ تَعَالَى: تِلْكَ الرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَى بَعْضٍ مِنْهُمْ مَنْ كَلَّمَ اللَّهُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_859", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَهَذَا لَيْسَ مُخْتَصًّا بِالْمَسِيحِ، بَلْ قَدْ أُيِّدَ غَيْرُهُ بِذَلِكَ، وَقَدْ ذَكَرُوا هُمْ أَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_860", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَعِنْدَ النَّصَارَى أَنَّ الْحَوَارِيِّينَ حَلَّتْ فِيهِمْ رُوحُ الْقُدُسِ، وَكَذَلِكَ عِنْدَهُمْ ر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_861", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَدْ قَالَ تَعَالَى: فَإِذَا قَرَأْتَ الْقُرْآنَ فَاسْتَعِذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيم"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_862", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَقَدْ قَالَ تَعَالَى فِي مَوْضِعٍ آخَرَ: نَزَلَ بِهِ الرُّوحُ الْأَمِينُ عَلَى قَلْبِكَ. وَقَالَ: ق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_863", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَقَدْ تَبَيَّنَ أَنَّ رُوحَ الْقُدُسِ هُنَا جِبْرِيلُ، وَقَالَ تَعَالَى: لَا تَجِدُ قَوْمًا يُؤْمِن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_865", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَقَالَ تَعَالَى: يُنَزِّلُ الْمَلَائِكَةَ بِالرُّوحِ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِه"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_867", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَبِكِلَا الْقَوْلَيْنِ فَسَّرَ الْمُفَسِّرُونَ قَوْلَهُ فِي الْمَسِيحِ وَأَيَّدْنَاهُ بِرُوحِ الْقُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_868", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَهُمْ إِمَّا أَنْ يُسَلِّمُوا أَنَّ رُوحَ الْقُدُسِ فِي حَقِّ غَيْرِهِ لَيْسَ الْمُرَادُ بِهَا حَيَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_869", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَإِمَّا أَنْ يَدَّعُوا أَنَّ الْمُرَادَ بِهَا حَيَاةُ اللَّهِ فِي حَقِّ الْأَنْبِيَاءِ وَالْحَوَارِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_870", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَيَلْزَمُهُمْ أَيْضًا أَنْ يَكُونَ فِي الْمَسِيحِ لَاهُوتَانِ: لَاهُوتُ الْكَلِمَةِ، وَلَاهُوتُ الر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_871", "reason": "high_symbol_ratio:0.423", "chunk_text": "ثُمَّ فِي قَوْلِهِ تَعَالَى: وَأَيَّدْنَاهُ بِرُوحِ الْقُدُسِ، يَمْتَنِعُ أَنْ يُرَادَ بِهَا حَيَاةُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_872", "reason": "high_symbol_ratio:0.427", "chunk_text": "فَتَبَيَّنَ أَنَّهُمْ يُرِيدُونَ أَنْ يُحَرِّفُوا الْقُرْآنَ كَمَا حَرَّفُوا غَيْرَهُ مِنَ الْكُتُبِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_873", "reason": "high_symbol_ratio:0.418", "chunk_text": "فصل قَالُوا: وَقَالَ أَيْضًا: وَكَلَّمَ اللَّهُ مُوسَى تَكْلِيمًا. فَيُقَالُ لَهُم: وَأَيُّ حُجَّةٍ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_874", "reason": "high_symbol_ratio:0.405", "chunk_text": "وَمَعْلُومٌ أَنَّ كَلَامَ اللَّهِ كَثِيرٌ كَالتَّوْرَاةِ وَالْإِنْجِيلِ وَالْقُرْآنِ، وَغَيْرِ ذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_875", "reason": "high_symbol_ratio:0.404", "chunk_text": "الْمَوْصُوفُ بِالْعِلْمِ، وَالْقُدْرَةِ، وَالْكَلَامِ الَّذِي كَلَّمَ بِهِ مُوسَى تَكْلِيمًا. فصل قَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_876", "reason": "high_symbol_ratio:0.407", "chunk_text": "فَيُقَالُ: أَمَّا قَوْلُهُ تَعَالَى: فَنَفَخْنَا فِيهِ مِنْ رُوحِنَا. وَقَوْلُهُ: فِي سُورَةِ الْأَن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_877", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَهَذَا قَدْ فَسَّرَهُ قَوْلُهُ تَعَالَى: فَأَرْسَلْنَا إِلَيْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرًا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_878", "reason": "high_symbol_ratio:0.428", "chunk_text": "وَفِي الْقِرَاءَةِ الْأُخْرَى: لِيَهَبَ لَكِ غُلَامًا زَكِيًّا. فَأَخْبَرَ أَنَّهُ رَسُولُهُ وَرُوحُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_879", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَكَذَلِكَ قَوْلُهُ: فَنَفَخْنَا فِيهَا مِنْ رُوحِنَا. وَهُوَ مِثْلُ قَوْلِهِ فِي آدَمَ : فَإِذَا سَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_880", "reason": "high_symbol_ratio:0.414", "chunk_text": "وَقَدْ شُبِّهَ الْمَسِيحُ بِآدَمَ فِي قَوْلِهِ: إِنَّ مَثَلَ عِيسَى عِنْدَ اللَّهِ كَمَثَلِ آدَمَ خَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_881", "reason": "high_symbol_ratio:0.407", "chunk_text": "وَالشُّبْهَةُ فِي هَذَا نَشَأَتْ عِنْدَ بَعْضِ الْجُهَّالِ مِنْ أَنَّ الْإِنْسَانَ إِذَا قَالَ: رُوح"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_882", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَالرَّبُّ تَعَالَى مُنَزَّهٌ عَنْ هَذَا، وَأَنَّهُ لَيْسَ مُرَكَّبًا مِنْ بَدَنٍ وَرُوحٍ، وَلَا يَج"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_883", "reason": "high_symbol_ratio:0.416", "chunk_text": "فصل قَالُوا: وَسَائِرُ الْمُسْلِمِينَ يَقُولُونَ: إِنَّ الْكِتَابَ كَلَامُ اللَّهِ، وَلَا يَكُونُ كَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_884", "reason": "high_symbol_ratio:0.422", "chunk_text": "فَيُقَالُ لَهُم: أَمَّا قَوْلُ الْمُسْلِمِينَ إِنَّ الْكِتَابَ - أَيِ الْقُرْآنَ - كَلَامُ اللَّهِ، "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_885", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَالْمُسْلِمُونَ يَقُولُونَ: إِنَّ اللَّهَ حَيٌّ مُتَكَلِّمٌ، وَإِنَّهُ تَكَلَّمَ بِالتَّوْرَاةِ وَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_886", "reason": "high_symbol_ratio:0.408", "chunk_text": "فِيهِمْ كَمَا تَنَازَعَ أَهْلُ الْكِتَابِ فِي كَلَامِ اللَّهِ، هَلْ هُوَ قَائِمٌ بِهِ، أَوْ مَخْلُوق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_887", "reason": "high_symbol_ratio:0.425", "chunk_text": "وَالَّذِي عَلَيْهِ سَلَفُ الْأُمَّةِ وَأَئِمَّتُهَا وَجُمْهُورُهَا، أَنَّ كَلَامَ اللَّهِ قَائِمٌ بِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_888", "reason": "high_symbol_ratio:0.415", "chunk_text": "وَأَحْدَثَ قَوْمٌ مِنْهُمْ بَعْدَ انْقِرَاضِ الصَّحَابَةِ وَأَكَابِرِ التَّابِعِينَ، بَعْدَ أَكْثَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_889", "reason": "high_symbol_ratio:0.419", "chunk_text": "وَظَهَرَتْ هَذِهِ الْمَقَالَةُ بَعْدَ الْمِائَةِ الثَّانِيَةِ، وَانْتَصَرَ لَهَا قَوْمٌ مِنَ الْوُلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_890", "reason": "high_symbol_ratio:0.421", "chunk_text": "وَكَذَلِكَ حَيَاتُهُ لَمْ يَقُلْ أَحَدٌ مِنْهُم: إِنَّ حَيَاتَهُ تَكُونُ إِلَهًا وَلَا رَبًّا، وَلَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_892", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَإِنْ أَرَادُوا بِقَوْلِهِم: جَوْهَرِيَّةً أَنَّ كُلَّ صِفَةٍ جَوْهَرٌ، فَهَذَا كَلَامٌ ظَاهِرُ الْ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_893", "reason": "high_symbol_ratio:0.434", "chunk_text": "وَالْأَوَّلُ: يَسْتَحِقُّ عِلَاجَ الْمَجَانِينِ. وَالثَّانِي: يَسْتَحِقُّ الْعُقُوبَةَ الَّتِي تَرْد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_894", "reason": "high_symbol_ratio:0.423", "chunk_text": "ثُمَّ إِنْ جَازَ أَنْ تَكُونَ الصِّفَةُ جَوْهَرًا كَانَتِ الْقُدْرَةُ أَيْضًا جَوْهَرًا. وَإِنْ أَرَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_895", "reason": "high_symbol_ratio:0.438", "chunk_text": "وَأَيْضًا فَالْكَلَامُ، وَإِنْ كَانَ قَائِمًا بِذَاتِهِ، فَقِيلَ: هُوَ مُتَعَلِّقٌ بِمَشِيئَتِهِ وَق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_896", "reason": "high_symbol_ratio:0.429", "chunk_text": "وَالْمُتَكَلِّمُ قِيلَ: هُوَ مَنْ فَعَلَ الْكَلَامَ وَلَوْ كَانَ مُنْفَصِلًا عَنْهُ، وَقِيلَ: هُوَ م"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_897", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَإِنْ أَرَادُوا بِالْجَوْهَرِيَّةِ أَنَّهَا ذَاتِيَّةٌ مُقَوِّمَةٌ، وَبَاقِي الصِّفَاتِ عَرَضِيَّةٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_898", "reason": "high_symbol_ratio:0.412", "chunk_text": "الْمِلَلِ، وَغَيْرِهِمْ كَمَا قَدْ بُسِطَ الْكَلَامُ عَلَيْهِ فِي الرَّدِّ عَلَى هَؤُلَاءِ الْمُتَفَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_899", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَتَارَةً يَتَصَوَّرُ الشَّيْءَ مُجْمَلًا، وَتَارَةً يَتَصَوَّرُهُ مُفَصَّلًا، وَمَا سَمَّوْهُ تَمَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_900", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَمَدْلُولُ اللَّفْظِ هُوَ بِحَسَبِ مَا يَعْنِيهِ الْمُتَكَلِّمُ وَيَقْصِدُهُ وَيَتَصَوَّرُهُ، وَهَذ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_901", "reason": "high_symbol_ratio:0.422", "chunk_text": "وَلِهَذَا لَمَّا كَانَ كَلَامُهُمْ بَاطِلًا لَمْ يُمْكِنْهُمْ ذِكْرُ فَرْقٍ صَحِيحٍ بَيْنَ الذَّاتِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_902", "reason": "high_symbol_ratio:0.435", "chunk_text": "ثُمَّ حُذَّاقُهُمْ يُفَسِّرُونَ الْوَسَطَ بِالدَّلِيلِ، كَمَا فَسَّرَهُ ابْنُ سِينَا."}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_903", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَمِنْهُمْ مَنْ يُفَسِّرُ الْوَسَطَ بِصِفَةٍ قَائِمَةٍ لِلْمَوْصُوفِ، كَمَا يُفَسِّرُهُ الرَّازِيُّ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_904", "reason": "high_symbol_ratio:0.424", "chunk_text": "فَمِنْهُمْ مَنْ يَكُونُ تَامَّ التَّصَوُّرِ فَيَعْلَمُ لُزُومَ الصِّفَةِ لِلْمَوْصُوفِ، بِلَا دَلِيل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_905", "reason": "high_symbol_ratio:0.439", "chunk_text": "وَهُمْ مُعْتَرِفُونَ بِأَنَّ مِنَ الْعَرَضِيَّاتِ مَا يَلْزَمُ، بِلَا وَسَطٍ، وَقَدْ مَثَّلُوا ذَلِك"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_906", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَهُمْ يَقُولُونَ مَا يَقُولُ ابْنُ سِينَا أَفْضَلُ مُتَأَخِّرِيهِم، وَغَيْرُهُ مِنْ أَنَّ الْعَرَضَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_907", "reason": "high_symbol_ratio:0.443", "chunk_text": "وَاللَّوْنُ الْمُنْقَسِمُ إِلَى السَّوْدَاءِ وَالْبَيَاضِ هُوَ ذَاتِيٌّ لِلْمُتَلَوِّنِ، وَالسَّوَاد"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_908", "reason": "high_symbol_ratio:0.420", "chunk_text": "قَالُوا: لِأَنَّ كَوْنَ هَذَا أَسْوَدَ وَأَبْيَضَ وَعَرَضًا قَائِمًا بِغَيْرِهِ، لَا يَفْتَقِرُ إِلَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_909", "reason": "high_symbol_ratio:0.403", "chunk_text": "وَمَعْلُومٌ أَنَّ هَذَا فَرْقٌ يَعُودُ إِلَى عِلْمِ الْعَالِمِ بِهَذِهِ الصِّفَاتِ، هَلْ هُوَ جَلِيٌ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_910", "reason": "high_symbol_ratio:0.410", "chunk_text": "صِفَاتِهَا اللَّازِمَةِ لَهَا - سَوَاءٌ فِي ذَلِكَ، وَلَيْسَتِ الْمَاهِيَّةُ مُرَكَّبَةً مِنْ هَذَا "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_911", "reason": "high_symbol_ratio:0.409", "chunk_text": "وَلَا الصِّفَاتُ جَوَاهِرُ مَوْجُودَةٌ فِي الْخَارِجِ لَهَا أَجْزَاءٌ كَأَجْزَاءِ الْأَجْسَامِ الْمُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_912", "reason": "high_symbol_ratio:0.424", "chunk_text": "وَلَكِنْ إِذَا قِيلَ فِي الْإِنْسَانِ: هُوَ جِسْمٌ حَسَّاسٌ تَامٌّ مُتَحَرِّكٌ بِالْإِرَادَةِ نَاطِق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_913", "reason": "high_symbol_ratio:0.416", "chunk_text": "وَالْجُمْلَةُ الَّتِي فِي ذِهْنِهِ وَلِسَانِهِ مُرَكَّبَةٌ مِنْ هَذِهِ الْأَجْزَاءِ لَا أَنَّ الْإِن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_914", "reason": "high_symbol_ratio:0.434", "chunk_text": "مُجَرَّدَةً مَوْجُودَةً فِي الْخَارِجِ. وَقَدْ رَدَّ ذَلِكَ عَلَيْهِمْ سَائِرُ الْعُقَلَاءِ، كَمَا ر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_915", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَقَالُوا: إِنَّ الْعَدَدَ الْمُجَرَّدَ، وَالْمِقْدَارَ الْمُجَرَّدَ إِنَّمَا يُوجَدُ فِي الذِّهْنِ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_916", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَأَثْبَتَ أَصْحَابُ أَفْلَاطُونَ الْكُلِّيَّاتِ الْعَقْلِيَّةَ فِي الْخَارِجِ الَّتِي يُسَمُّونَهَا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_917", "reason": "high_symbol_ratio:0.411", "chunk_text": "وَهَذِهِ كُلُّهَا إِنَّمَا تُتَصَوَّرُ فِي الْأَذْهَانِ لَا فِي الْأَعْيَانِ، بَلْ وَمَا أَثْبَتُوهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_918", "reason": "high_symbol_ratio:0.420", "chunk_text": "وَأَصْلُ قَوْلِهِمُ: الْمُجَرَّدَاتُ وَالْمُفَارِقَاتُ هُوَ مَأْخُوذٌ مِنْ مُفَارَقَةِ النَّفْسِ الن"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_919", "reason": "high_symbol_ratio:0.434", "chunk_text": "الْمُنَزَّلَةِ وَلِرُسُلِهِ، وَلِمَنِ اتَّبَعَهُمْ مِنْ جَمِيعِ أَهْلِ الْمِلَلِ، وَهَذِهِ الْأُمُور"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_920", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَالْمَقْصُودُ هُنَا التَّنْبِيهُ عَلَى أَنَّ تَفْرِيقَ هَؤُلَاءِ الْيُونَانِيِّينَ فِي الصِّفَاتِ ا"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_921", "reason": "high_symbol_ratio:0.415", "chunk_text": "أَحَدُ الْأَصْلَيْنِ: هُوَ مَا تَقَدَّمَ مِنْ جَعْلِهِمُ الصِّفَاتِ اللَّازِمَةَ لِلْمَوْصُوفِ هِيَ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_922", "reason": "high_symbol_ratio:0.401", "chunk_text": "وَالثَّانِي: زَعْمُهُمْ أَنَّ كُلَّ مَوْجُودٍ مُمْكِنٌ وَلَهُ فِي الْخَارِجِ مَاهِيَّةٌ هِيَ ذَاتُهُ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_923", "reason": "high_symbol_ratio:0.417", "chunk_text": "فَإِنَّهُ إِذَا أُرِيدَ بِالْمَاهِيَّةِ مَا يُتَصَوَّرُ فِي الذِّهْنِ، وَهُوَ الْمَقُولُ فِي جَوَابِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_924", "reason": "high_symbol_ratio:0.421", "chunk_text": "فَإِنَّهُ يُقَالُ لَهُمْ إِنْ أَرَدْتُمْ أَنَّ مَا يُتَصَوَّرُ فِي الذِّهْنِ مِنَ الْمُثَلَّثِ غَيْر"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_925", "reason": "high_symbol_ratio:0.414", "chunk_text": "الثَّانِي: الْمُثَلَّثُ الْمَوْجُودُ الَّذِي هُوَ زَاوِيَةُ الْحَائِطِ. وَإِنْ أَرَدْتُمْ أَنَّ فِي "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_926", "reason": "high_symbol_ratio:0.423", "chunk_text": "وَبَعْضُهُمْ يَخْتَلِفُ قَوْلُهُ وَيَتَنَاقَضُ، وَسَبَبُ ذَلِكَ عَدَمُ تَمْيِيزِهِمْ بَيْنَ مَا يُتَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_927", "reason": "high_symbol_ratio:0.419", "chunk_text": "فَلَزِمَ أَنْ يَكُونَ فِيهِ جِهَتَانِ، وَهَذَا مِنَ التَّرْكِيبِ الَّذِي زَعَمُوهُ مُنْتَفِيًا، وَذَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_928", "reason": "high_symbol_ratio:0.417", "chunk_text": "وَأَمَّا تَرْكِيبُ الْأَجْسَامِ مِنَ الْجَوَاهِرِ الْمُنْفَرِدَةِ أَوْ مِنَ الْمَادَّةِ وَالصُّورَةِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_929", "reason": "high_symbol_ratio:0.418", "chunk_text": "وَأَمَّا اتِّصَافُ الذَّاتِ بِصِفَاتٍ تَقُومُ بِهَا، فَهَذَا هُوَ الَّذِي يَعْرِفُهُ عَامَّةُ الْعُق"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_930", "reason": "high_symbol_ratio:0.420", "chunk_text": "ثُمَّ هُمْ يَقُولُونَ: الْمُرَكَّبُ يَفْتَقِرُ إِلَى أَجْزَائِهِ، وَأَجْزَاؤُهُ غَيْرُهُ، وَوَاجِبُ "}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_931", "reason": "high_symbol_ratio:0.431", "chunk_text": "وَمِنْهَا: أَنَّ لَفْظَ الْجُزْءِ لَيْسَ مُرَادُهُمْ جُزْءًا مُبَايِنًا لِلْجُمْلَةِ، فَإِنَّ جُزْءَ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_932", "reason": "high_symbol_ratio:0.410", "chunk_text": "وَمِنْهَا لَفْظُ الْغَيْرِ، فَإِنَّهُ يُرَادُ بِالْغَيْرَيْنِ مَا يَجُوزُ مُبَايَنَةُ أَحَدِهِمَا لِ"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_933", "reason": "high_symbol_ratio:0.418", "chunk_text": "فَصِفَاتُ الرَّبِّ عَزَّ وَجَلَّ اللَّازِمَةُ لَهُ لَا يَجُوزُ أَنْ تُفَارِقَهُ وَتُبَايِنَهُ، وَحِي"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_934", "reason": "high_symbol_ratio:0.412", "chunk_text": "وَلَفْظُ وَاجِبِ الْوُجُودِ يُرَادُ بِهِ الْمَوْجُودُ بِنَفَسِهِ الَّذِي لَا فَاعِلَ لَهُ، وَلَا عِل"}
{"source": "wikisource", "raw_id": "arwikisource:40441:284944#chunk_935", "reason": "high_symbol_ratio:0.427", "chunk_text": "لِلْأَفْلَاكِ مُسْتَلْزِمٌ لَهَا، فَيَجْعَلُونَهُ مَلْزُومًا لِمَفْعُولَاتِهِ، فَكَيْفَ يُنْكِرُونَ "}
